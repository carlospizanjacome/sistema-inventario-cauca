@using Almacen.Services
@inject UsuarioSesionService Sesion
@inject NavigationManager Navigation
@inject SeguridadService Seguridad
@inject IJSRuntime JS

<div class="sidebar @(Collapsed ? "is-collapsed" : "")">

    <!-- ═══════════ HEADER / LOGO ═══════════ -->
    <div class="sidebar-header">
        <div class="logo-avatar">
            <i class="bi bi-box-seam"></i>
        </div>
        <div class="logo-info">
            <h3>Almacén</h3>
            <p>Alcaldía de Popayán</p>
        </div>
    </div>

    <!-- ═══════════ BUSCADOR ═══════════ -->
    @if (!Collapsed)
    {
        <div class="sidebar-search">
            <i class="bi bi-search search-icon"></i>
            <input type="text"
                   placeholder="Buscar módulo…"
                   @bind="_filtro"
                   @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_filtro))
            {
                <button class="search-clear" @onclick="() => _filtro = string.Empty" title="Limpiar">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>
    }

    <!-- ═══════════ NAV ═══════════ -->
    <nav class="sidebar-nav">

        <!-- Tablero de Mando -->
        <NavLink class="nav-single" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door"></i>
            <span>Tablero de Mando</span>
        </NavLink>

        <!-- ═══ ESTRUCTURA ═══ -->
        @if (_puedeVer("instituciones.ver") || _puedeVer("sedes.ver") || _puedeVer("bloques.ver") || _puedeVer("aulas.ver"))
        {
            <div class="nav-group">
                <button class="nav-group-header" type="button" @onclick="@(() => ToggleSeccion("estructura"))">
                    <span>ESTRUCTURA</span>
                    <i class="bi bi-chevron-@(EstaAbierto("estructura") ? "down" : "up")"></i>
                </button>
                @if (EstaAbierto("estructura"))
                {
                    <div class="nav-group-body">
                        @if (_puedeVer("instituciones.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="instituciones">
                                <i class="bi bi-bank"></i>
                                <span>Instituciones</span>
                            </NavLink>
                        }
                        @if (_puedeVer("sedes.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="sedes">
                                <i class="bi bi-buildings"></i>
                                <span>Sedes</span>
                            </NavLink>
                        }
                        @if (_puedeVer("bloques.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="bloques">
                                <i class="bi bi-grid-3x3-gap"></i>
                                <span>Bloques</span>
                            </NavLink>
                        }
                        @if (_puedeVer("aulas.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="aulas">
                                <i class="bi bi-door-open"></i>
                                <span>Aulas</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        <!-- ═══ INVENTARIO ═══ -->
        @if (_puedeVer("categorias.ver") || _puedeVer("bienes.ver") || _puedeVer("toma_fisica.ver") || _puedeVer("kardex.ver"))
        {
            <div class="nav-group">
                <button class="nav-group-header" type="button" @onclick="@(() => ToggleSeccion("inventario"))">
                    <span>INVENTARIO</span>
                    <i class="bi bi-chevron-@(EstaAbierto("inventario") ? "down" : "up")"></i>
                </button>
                @if (EstaAbierto("inventario"))
                {
                    <div class="nav-group-body">
                        @if (_puedeVer("bienes.ver"))
                        {
                            <NavLink class="nav-btn inventario" href="bienes">
                                <i class="bi bi-box-seam"></i>
                                <span>Inventario</span>
                            </NavLink>
                        }
                        @if (_puedeVer("categorias.ver"))
                        {
                            <NavLink class="nav-btn prestamos" href="categorias">
                                <i class="bi bi-tags"></i>
                                <span>Categorías</span>
                            </NavLink>
                        }
                        @if (_puedeVer("kardex.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="kardex">
                                <i class="bi bi-journal-text"></i>
                                <span>Kárdex</span>
                            </NavLink>
                        }
                        @if (_puedeVer("consumo.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="consumo">
                                <i class="bi bi-boxes"></i>
                                <span>Consumo</span>
                            </NavLink>
                        }
                        @if (_puedeVer("toma_fisica.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="toma-fisica">
                                <i class="bi bi-clipboard-check"></i>
                                <span>Toma Física</span>
                            </NavLink>
                        }
                        @if (_puedeVer("mantenimiento.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="mantenimiento">
                                <i class="bi bi-tools"></i>
                                <span>Mantenimiento</span>
                            </NavLink>
                        }
                        @if (_puedeVer("garantias.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="garantias">
                                <i class="bi bi-shield-check"></i>
                                <span>Garantías</span>
                            </NavLink>
                        }
                        @if (_puedeVer("bienes.crear"))
                        {
                            <NavLink class="nav-btn-neutral" href="importar-excel">
                                <i class="bi bi-file-earmark-arrow-up"></i>
                                <span>Importar Excel</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        <!-- ═══ MOVIMIENTOS ═══ -->
        @if (_puedeVer("entradas.ver") || _puedeVer("salidas.ver") || _puedeVer("traslados.ver") || _puedeVer("prestamos.ver"))
        {
            <div class="nav-group">
                <button class="nav-group-header" type="button" @onclick="@(() => ToggleSeccion("movimientos"))">
                    <span>MOVIMIENTOS</span>
                    <i class="bi bi-chevron-@(EstaAbierto("movimientos") ? "down" : "up")"></i>
                </button>
                @if (EstaAbierto("movimientos"))
                {
                    <div class="nav-group-body">
                        @if (_puedeVer("entradas.ver"))
                        {
                            <NavLink class="nav-btn entradas" href="entradas">
                                <i class="bi bi-arrow-down-circle"></i>
                                <span>Entradas</span>
                            </NavLink>
                        }
                        @if (_puedeVer("salidas.ver"))
                        {
                            <NavLink class="nav-btn salidas" href="salidas">
                                <i class="bi bi-arrow-up-circle"></i>
                                <span>Salidas</span>
                            </NavLink>
                        }
                        @if (_puedeVer("traslados.ver"))
                        {
                            <NavLink class="nav-btn traslados" href="traslados">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Traslados</span>
                            </NavLink>
                        }
                        @if (_puedeVer("prestamos.ver"))
                        {
                            <NavLink class="nav-btn prestamos" href="prestamos">
                                <i class="bi bi-arrow-repeat"></i>
                                <span>Préstamos</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        <!-- ═══ PERSONAL ═══ -->
        @if (_puedeVer("funcionarios.ver"))
        {
            <div class="nav-group">
                <button class="nav-group-header" type="button" @onclick="@(() => ToggleSeccion("personal"))">
                    <span>PERSONAL</span>
                    <i class="bi bi-chevron-@(EstaAbierto("personal") ? "down" : "up")"></i>
                </button>
                @if (EstaAbierto("personal"))
                {
                    <div class="nav-group-body">
                        <NavLink class="nav-btn-neutral" href="funcionarios">
                            <i class="bi bi-person-badge"></i>
                            <span>Funcionarios</span>
                        </NavLink>
                    </div>
                }
            </div>
        }

        <!-- ═══ CONTABILIDAD ═══ -->
        @if (_puedeVer("depreciacion.ver"))
        {
            <div class="nav-group">
                <button class="nav-group-header" type="button" @onclick="@(() => ToggleSeccion("contabilidad"))">
                    <span>CONTABILIDAD</span>
                    <i class="bi bi-chevron-@(EstaAbierto("contabilidad") ? "down" : "up")"></i>
                </button>
                @if (EstaAbierto("contabilidad"))
                {
                    <div class="nav-group-body">
                        <NavLink class="nav-btn depreciacion" href="depreciacion">
                            <i class="bi bi-graph-down-arrow"></i>
                            <span>Depreciación</span>
                        </NavLink>
                    </div>
                }
            </div>
        }

        <!-- ═══ SEGURIDAD ═══ -->
        @if (_puedeVer("usuarios.ver") || _puedeVer("roles.ver") || _puedeVer("permisos.ver") || _puedeVer("roles.permisos") || _puedeVer("auditoria.ver"))
        {
            <div class="nav-group">
                <button class="nav-group-header" type="button" @onclick="@(() => ToggleSeccion("seguridad"))">
                    <span>SEGURIDAD</span>
                    <i class="bi bi-chevron-@(EstaAbierto("seguridad") ? "down" : "up")"></i>
                </button>
                @if (EstaAbierto("seguridad"))
                {
                    <div class="nav-group-body">
                        @if (_puedeVer("usuarios.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="usuarios">
                                <i class="bi bi-people"></i>
                                <span>Usuarios</span>
                            </NavLink>
                        }
                        @if (_puedeVer("roles.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="roles">
                                <i class="bi bi-person-badge"></i>
                                <span>Roles</span>
                            </NavLink>
                        }
                        @if (_puedeVer("permisos.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="permisos">
                                <i class="bi bi-shield-lock"></i>
                                <span>Permisos</span>
                            </NavLink>
                        }
                        @if (_puedeVer("roles.permisos"))
                        {
                            <NavLink class="nav-btn-neutral" href="rol-permisos">
                                <i class="bi bi-shield-check"></i>
                                <span>Asignar Permisos</span>
                            </NavLink>
                        }
                        @if (_puedeVer("auditoria.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="auditoria">
                                <i class="bi bi-shield-check"></i>
                                <span>Auditoría</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        <!-- ═══ CONFIGURACIÓN ═══ -->
        @if (_puedeVer("vidas_utiles.ver"))
        {
            <div class="nav-group">
                <button class="nav-group-header" type="button" @onclick="@(() => ToggleSeccion("configuracion"))">
                    <span>CONFIGURACIÓN</span>
                    <i class="bi bi-chevron-@(EstaAbierto("configuracion") ? "down" : "up")"></i>
                </button>
                @if (EstaAbierto("configuracion"))
                {
                    <div class="nav-group-body">
                        <NavLink class="nav-btn-neutral" href="vidas-utiles">
                            <i class="bi bi-clock-history"></i>
                            <span>Vidas Útiles</span>
                        </NavLink>
                    </div>
                }
            </div>
        }

        <!-- ═══ REPORTES ═══ -->
        @if (_puedeVer("reportes.ver") || _puedeVer("toma_fisica.ver"))
        {
            <div class="nav-group">
                <button class="nav-group-header" type="button" @onclick="@(() => ToggleSeccion("reportes"))">
                    <span>REPORTES</span>
                    <i class="bi bi-chevron-@(EstaAbierto("reportes") ? "down" : "up")"></i>
                </button>
                @if (EstaAbierto("reportes"))
                {
                    <div class="nav-group-body">
                        @if (_puedeVer("reportes.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="reportes">
                                <i class="bi bi-graph-up-arrow"></i>
                                <span>Reportes Consolidados</span>
                            </NavLink>
                            <NavLink class="nav-btn-neutral" href="reportes-normativos">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Reportes Normativos</span>
                            </NavLink>
                        }
                        @if (_puedeVer("toma_fisica.ver"))
                        {
                            <NavLink class="nav-btn-neutral" href="conciliacion">
                                <i class="bi bi-check2-square"></i>
                                <span>Conciliación</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

    </nav>

    <!-- ═══════════ FOOTER USUARIO ═══════════ -->
    @if (Sesion.UsuarioActual != null)
    {
        <div class="sidebar-footer">
            <div class="user-card" title="@Sesion.UsuarioActual.NombreCompleto">
                <div class="user-avatar">@InicialUsuario</div>
                <div class="user-info">
                    <div class="user-name">@Sesion.UsuarioActual.NombreCompleto</div>
                    <div class="user-email">@Sesion.UsuarioActual.Email</div>
                </div>
            </div>

            <button class="btn-logout" @onclick="CerrarSesion" title="Cerrar sesión">
                <i class="bi bi-box-arrow-right"></i>
                <span>Cerrar sesión</span>
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public bool Collapsed { get; set; }

    private string _filtro = string.Empty;
    private Dictionary<string, bool> _permisos = new();
    private Dictionary<string, bool> _seccionesAbiertas = new()
    {
        { "estructura", false },
        { "inventario", true },
        { "movimientos", true },
        { "personal", false },
        { "contabilidad", false },
        { "seguridad", false },
        { "configuracion", false },
        { "reportes", false }
    };

    private string InicialUsuario =>
        string.IsNullOrWhiteSpace(Sesion.UsuarioActual?.NombreCompleto)
            ? "U"
            : Sesion.UsuarioActual!.NombreCompleto.Substring(0, 1).ToUpper();

    protected override async Task OnInitializedAsync()
    {
        var codigos = new[]
        {
            "instituciones.ver", "sedes.ver", "bloques.ver", "aulas.ver",
            "categorias.ver", "bienes.ver", "bienes.crear", "proveedores.ver", "funcionarios.ver",
            "consumo.ver", "kardex.ver",
            "entradas.ver", "salidas.ver", "traslados.ver", "prestamos.ver",
            "depreciacion.ver", "reportes.ver", "toma_fisica.ver",
            "mantenimiento.ver", "garantias.ver",
            "usuarios.ver", "roles.ver", "permisos.ver", "roles.permisos",
            "vidas_utiles.ver", "auditoria.ver"
        };

        foreach (var c in codigos)
            _permisos[c] = await Seguridad.TienePermisoAsync(c);
    }

    private void ToggleSeccion(string key)
    {
        _seccionesAbiertas[key] = !_seccionesAbiertas.GetValueOrDefault(key, true);
    }

    private bool EstaAbierto(string key) => _seccionesAbiertas.GetValueOrDefault(key, true);

    private bool _puedeVer(string permiso) => _permisos.TryGetValue(permiso, out var ok) && ok;

    private void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}