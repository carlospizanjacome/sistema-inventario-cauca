@inherits LayoutComponentBase
@using Almacen.Components.Shared
@using Almacen.Services
@inject IJSRuntime JS
@inject UsuarioSesionService Sesion
@inject NavigationManager Nav

<div class="app-shell @(sidebarCollapsed ? "is-collapsed" : "") @(mobileOpen ? "is-mobile-open" : "")">

    <aside class="app-sidebar">
        <NavMenu Collapsed="sidebarCollapsed" />
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <button class="btn-toggle" @onclick="ToggleSidebar" title="Mostrar/ocultar menú">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-title">
                <span class="topbar-title-main">Sistema de Inventario y Almacén</span>
                <span class="topbar-title-sub">Alcaldía de Popayán</span>
            </div>

            @if (Sesion.UsuarioActual != null)
            {
                <div class="topbar-context">
                    @* Badge de contexto: Super-Admin o Institución *@
                    @if (Sesion.EsSuperAdmin)
                    {
                        <div class="context-badge context-super" title="Acceso total al sistema">
                            <i class="bi bi-shield-fill-check"></i>
                            <span>Super-Admin · Todas las instituciones</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Sesion.InstitucionNombre))
                    {
                        <div class="context-badge context-inst" title="@Sesion.InstitucionNombre">
                            <i class="bi bi-building"></i>
                            <span>@Sesion.InstitucionNombre</span>
                        </div>
                    }

                    @* Usuario + rol + logout *@
                    <div class="context-user">
                        <div class="context-avatar" title="@Sesion.UsuarioActual.NombreCompleto">
                            @ObtenerIniciales(Sesion.UsuarioActual.NombreCompleto)
                        </div>
                        <div class="context-user-info">
                            <span class="context-user-name" title="@Sesion.UsuarioActual.NombreCompleto">
                                @Sesion.UsuarioActual.NombreCompleto
                            </span>
                            <span class="context-user-role">
                                @(Sesion.UsuarioActual.NombreRol ?? "Usuario")
                            </span>
                        </div>
                        <button class="btn-icon" @onclick="CerrarSesion" title="Cerrar sesión">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </div>
                </div>
            }

            <div class="topbar-actions">
                <button class="btn-icon" title="Notificaciones">
                    <i class="bi bi-bell"></i>
                </button>
                <button class="btn-icon" title="Ayuda">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>

    <div class="app-backdrop" @onclick="CloseMobileSidebar"></div>

    <ToastContainer />
    <ConfirmDialog />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool sidebarCollapsed = false;
    private bool mobileOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("almacenLayout.getStorageItem", "sidebarCollapsed");
            if (saved == "true") { sidebarCollapsed = true; StateHasChanged(); }
        }
        catch { }
    }

    private async Task ToggleSidebar()
    {
        int width;
        try { width = await JS.InvokeAsync<int>("almacenLayout.getViewportWidth"); }
        catch { width = 1280; }

        if (width < 768) { mobileOpen = !mobileOpen; }
        else
        {
            sidebarCollapsed = !sidebarCollapsed;
            try
            {
                await JS.InvokeVoidAsync("almacenLayout.setStorageItem",
                    "sidebarCollapsed", sidebarCollapsed.ToString().ToLower());
            }
            catch { }
        }
    }

    private void CloseMobileSidebar() => mobileOpen = false;

    private void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    /// <summary>
    /// Devuelve las iniciales del nombre (máx 2) para el avatar del topbar.
    /// Ej: "Ana María Rodríguez" → "AM"
    /// </summary>
    private string ObtenerIniciales(string? nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "?";

        var partes = nombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "?";
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();

        // Toma primera letra del primer nombre + primera letra del primer apellido
        return (partes[0].Substring(0, 1) + partes[1].Substring(0, 1)).ToUpper();
    }
}

