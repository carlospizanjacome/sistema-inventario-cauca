@inherits LayoutComponentBase
@using Almacen.Components.Shared
@using Almacen.Services
@using Almacen.DTOs
@using Almacen.Interfaces
@inject IJSRuntime JS
@inject UsuarioSesionService Sesion
@inject NavigationManager Nav
@inject ISedeRepository SedeRepo

<div>
    <div class="app-shell @(sidebarCollapsed ? "is-collapsed" : "") @(mobileOpen ? "is-mobile-open" : "")">

        <aside class="app-sidebar">
            <NavMenu Collapsed="sidebarCollapsed" />
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="btn-toggle" @onclick="ToggleSidebar" title="Mostrar/ocultar menú">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-title">
                    <span class="topbar-title-main">Sistema de Inventario y Almacén</span>
                    <span class="topbar-title-sub">Alcaldía de Popayán</span>
                </div>

                @if (Sesion.UsuarioActual != null)
                {
                    <div class="topbar-context">
                        @if (Sesion.EsSuperAdmin)
                        {
                            <div class="context-badge context-super" title="Acceso total al sistema">
                                <i class="bi bi-shield-fill-check"></i>
                                <span>Super-Admin · Todas las instituciones</span>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(Sesion.InstitucionNombre))
                        {
                            <div class="context-badge context-inst" title="@Sesion.InstitucionNombre">
                                <i class="bi bi-building"></i>
                                <span>@Sesion.InstitucionNombre</span>
                            </div>
                        }

                        @* ⬇️ SELECTOR GLOBAL DE SEDE ⬇️ *@
                        @if (Sesion.PuedeVerTodasLasSedes)
                        {
                            <div class="context-badge context-sede" style="padding: 2px 10px; background: #f8fafc; border: 1px solid #e2e8f0;">
                                <i class="bi bi-geo-alt-fill" style="color: #4f46e5;"></i>
                                <select @bind="_sedeSeleccionadaId" @bind:after="CambiarSedeFiltro" style="border: none; background: transparent; color: #0f172a; font-size: 0.85rem; font-weight: 600; outline: none; cursor: pointer; margin-left: 6px;">
                                    <option value="-1">🌟 Todas las sedes</option>
                                    @foreach (var s in _sedes)
                                    {
                                        <option value="@s.Id">@s.Nombre</option>
                                    }
                                </select>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(Sesion.SedeNombre))
                        {
                            @* Etiqueta estática para Almacenistas *@
                            <div class="context-badge context-sede" title="Sede: @Sesion.SedeNombre">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@Sesion.SedeNombre</span>
                            </div>
                        }
                        @* ⬆️ FIN DEL SELECTOR ⬆️ *@

                        <div class="context-user">
                            <div class="context-avatar" title="@Sesion.UsuarioActual.NombreCompleto">
                                @ObtenerIniciales(Sesion.UsuarioActual.NombreCompleto)
                            </div>
                            <div class="context-user-info">
                                <span class="context-user-name" title="@Sesion.UsuarioActual.NombreCompleto">
                                    @Sesion.UsuarioActual.NombreCompleto
                                </span>
                                <span class="context-user-role">
                                    @(Sesion.UsuarioActual.NombreRol ?? "Usuario")
                                </span>
                            </div>
                            <button class="btn-icon" @onclick="CerrarSesion" title="Cerrar sesión">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                }

                <div class="topbar-actions">
                    <button class="btn-icon" title="Notificaciones">
                        <i class="bi bi-bell"></i>
                    </button>
                    <button class="btn-icon" title="Ayuda">
                        <i class="bi bi-question-circle"></i>
                    </button>
                </div>
            </header>

            <main class="app-content">
                @* ⬇️ AQUÍ ESTÁ LA MAGIA: La Key fuerza el refresco del contenido sin perder la sesión ⬇️ *@
                <div @key="_layoutKey">
                    @Body
                </div>
            </main>
        </div>

        <div class="app-backdrop" @onclick="CloseMobileSidebar"></div>
    </div>

    <ToastContainer />
    <ConfirmDialog />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool sidebarCollapsed = false;
    private bool mobileOpen = false;

    // Variable que usaremos para forzar el refresco
    private int _layoutKey = 0;

    private List<SedeDTO> _sedes = new();
    private int _sedeSeleccionadaId = -1;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.PuedeVerTodasLasSedes)
        {
            try
            {
                _sedes = (await SedeRepo.ObtenerTodasAsync()).ToList();

                // 👇 EL ARREGLO ESTÁ AQUÍ 👇
                _sedeSeleccionadaId = Sesion.VeTodasLasSedes ? -1 : (Sesion.SedeId ?? -1);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error cargando sedes en layout: " + ex.Message);
            }
        }
    }

    private void CambiarSedeFiltro()
    {
        int? sedeId = _sedeSeleccionadaId == -1 ? null : _sedeSeleccionadaId;
        string? sedeNombre = _sedeSeleccionadaId == -1 ? null : _sedes.FirstOrDefault(s => s.Id == _sedeSeleccionadaId)?.Nombre;

        Sesion.CambiarSedeFiltro(sedeId, sedeNombre);

        // En lugar de recargar la página entera (lo que saca al login),
        // incrementamos la Key para que Blazor destruya y recree solo la vista actual.
        _layoutKey++;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("almacenLayout.getStorageItem", "sidebarCollapsed");
            if (saved == "true") { sidebarCollapsed = true; StateHasChanged(); }
        }
        catch { }
    }

    private async Task ToggleSidebar()
    {
        int width;
        try { width = await JS.InvokeAsync<int>("almacenLayout.getViewportWidth"); }
        catch { width = 1280; }

        if (width < 768) { mobileOpen = !mobileOpen; }
        else
        {
            sidebarCollapsed = !sidebarCollapsed;
            try
            {
                await JS.InvokeVoidAsync("almacenLayout.setStorageItem",
                    "sidebarCollapsed", sidebarCollapsed.ToString().ToLower());
            }
            catch { }
        }
    }

    private void CloseMobileSidebar() => mobileOpen = false;

    private void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private string ObtenerIniciales(string? nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "?";

        var partes = nombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "?";
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();

        return (partes[0].Substring(0, 1) + partes[1].Substring(0, 1)).ToUpper();
    }
}