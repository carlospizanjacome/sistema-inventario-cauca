<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- ⬇️ FIX CRÍTICO: Permite que Bootstrap use unload sin que Blazor muera -->
    <meta http-equiv="Permissions-Policy" content="unload=*" />
    
    <base href="/" />

    <title>Sistema de Inventario y Almacén</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />

    <!-- Estilos globales -->
    <link rel="stylesheet" href="Almacen.styles.css" />
    <link rel="stylesheet" href="app.css" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>

    <!-- Loader inicial: se oculta cuando Blazor está listo -->
    <div id="app-loading">
        <div class="app-loading-spinner"></div>
        <div class="app-loading-text">Cargando sistema…</div>
    </div>

    <!-- Rutas de Blazor -->
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <!-- Blazor Error UI -->
    <div id="blazor-error-ui" data-nosnippet>
        Ocurrió un error inesperado.
        <a href="" class="reload">Recargar</a>
        <span class="dismiss">🗙</span>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         FUNCIONES JS CRÍTICAS — INLINE
         Deben ir ANTES de blazor.web.js para que Blazor las
         encuentre cuando las invoque desde C#.
         ═══════════════════════════════════════════════════════════ -->
    <script>
            // ─── Descarga de archivos (Excel, PDF, CSV, etc.) ───
            window.descargarArchivo = function (base64, nombre, mimeType) {
                try {
                    console.log('📥 descargarArchivo llamado:', nombre);

                    const binario = atob(base64);
                    const bytes = new Uint8Array(binario.length);
                    for (let i = 0; i < binario.length; i++) {
                        bytes[i] = binario.charCodeAt(i);
                    }

                    const blob = new Blob([bytes], {
                        type: mimeType || "application/octet-stream"
                    });

                    const url = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = nombre;
                    link.style.display = 'none';
                    document.body.appendChild(link);
                    link.click();

                    setTimeout(() => {
                        document.body.removeChild(link);
                        URL.revokeObjectURL(url);
                    }, 100);

                    console.log('✅ Descarga iniciada:', nombre);
                    return true;
                } catch (error) {
                    console.error('❌ Error al descargar:', error);
                    alert('Error: ' + error.message);
                    return false;
                }
            };

            console.log('✅ window.descargarArchivo registrada');
    </script>

    <!-- ═══════════════════════════════════════════════════════════
         SCRIPTS ESTÁTICOS Y LIBRERÍAS EXTERNAS
         TODOS deben ir ANTES de blazor.web.js
         ═══════════════════════════════════════════════════════════ -->
    <!-- Scripts propios -->
    <script src="js/layout.js"></script>
    <script src="js/qr-reader.js"></script>

    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/es.js"></script>

    <!-- Chart.js 4.4 (debe ir ANTES de cd-charts.js y dashboard-charts.js) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Scripts de gráficos (usan Chart.js ya cargado) -->
    <script src="js/dashboard-charts.js"></script>
    <script src="js/cd-charts.js"></script>

    <!-- Inicializador de Flatpickr -->
    <script>
            window.initFlatpickr = function (selector, initialValue) {
                try {
                    if (!window.flatpickr) {
                        console.warn('⚠ Flatpickr no está cargado');
                        return false;
                    }

                    // Asegurar idioma español
                    if (window.flatpickr.l10ns && window.flatpickr.l10ns.es) {
                        flatpickr.localize(flatpickr.l10ns.es);
                    }

                    const element = document.querySelector(selector);
                    if (!element) {
                        console.warn('⚠ No se encontró el elemento: ' + selector);
                        return false;
                    }

                    // Si ya tiene instancia, destruirla
                    if (element._flatpickr) {
                        element._flatpickr.destroy();
                    }

                    flatpickr(element, {
                        locale: "es",
                        dateFormat: "Y-m-d",
                        altInput: true,
                        altFormat: "d/m/Y",
                        defaultDate: initialValue || element.value || "today",
                        allowInput: false,
                        disableMobile: true,
                        static: false
                    });

                    console.log('✅ Flatpickr inicializado en: ' + selector);
                    return true;
                } catch (error) {
                    console.error('❌ Error al inicializar Flatpickr:', error);
                    return false;
                }
            };

            console.log('✅ window.initFlatpickr registrada');
    </script>

    <!-- ═══════════════════════════════════════════════════════════
         BLAZOR AL FINAL — Todos los scripts que Blazor invoca
         ya están cargados cuando Blazor arranca.
         ═══════════════════════════════════════════════════════════ -->
    <script src="_framework/blazor.web.js"></script>

    <!-- Script del loader -->
    <script>
            (function () {
                var loader = document.getElementById('app-loading');
                if (!loader) return;
                var oculto = false;
                function ocultarLoader() {
                    if (oculto) return;
                    oculto = true;
                    loader.style.opacity = '0';
                    setTimeout(function () { loader.style.display = 'none'; }, 150);
                }
                document.addEventListener('DOMContentLoaded', function () {
                    setTimeout(ocultarLoader, 400);
                });
                setTimeout(ocultarLoader, 2500);
                window.addEventListener('load', function () {
                    setTimeout(ocultarLoader, 200);
                });
            })();
    </script>

</body>

</html>