@using Almacen.Services
@implements IDisposable
@inject ToastService Toast

@if (_toasts.Any())
{
    <div style="position: fixed; top: 80px; right: 24px; z-index: 99999; display: flex; flex-direction: column; gap: 10px;">
        @foreach (var t in _toasts)
        {
            var bg = t.Tipo switch
            {
                ToastTipo.Success => "#16a34a",
                ToastTipo.Danger  => "#dc2626",
                ToastTipo.Warning => "#d97706",
                _                 => "#2563eb"
            };
            <div @key="t.Id" style="background: @bg; color: #fff; padding: 14px 18px; border-radius: 10px; box-shadow: 0 10px 25px rgba(15,23,42,.25); font-family: sans-serif; font-size: 14px; min-width: 280px;">
                <i class="bi @Icono(t.Tipo)"></i>
                <span style="margin-left: 8px;">@t.Texto</span>
            </div>
        }
    </div>
}

@code {
    private List<ToastMensaje> _toasts = new();

    protected override void OnInitialized()
    {
        Toast.OnShow += HandleToast;
    }

    private async void HandleToast(ToastMensaje t)
    {
        try
        {
            await InvokeAsync(() => { _toasts.Add(t); StateHasChanged(); });
            await Task.Delay(3500);
            await InvokeAsync(() => { _toasts.Remove(t); StateHasChanged(); });
        }
        catch { }
    }

    private static string Icono(ToastTipo tipo) => tipo switch
    {
        ToastTipo.Success => "bi-check-circle-fill",
        ToastTipo.Danger  => "bi-x-circle-fill",
        ToastTipo.Warning => "bi-exclamation-triangle-fill",
        _                 => "bi-info-circle-fill"
    };

    public void Dispose()
    {
        Toast.OnShow -= HandleToast;
    }
}