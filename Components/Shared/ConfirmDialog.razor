@using Almacen.Services
@implements IDisposable
@inject ConfirmService Confirm

@if (_visible)
{
    <div style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(3px); display: flex; align-items: center; justify-content: center; z-index: 99999; padding: 16px;"
         @onclick="Cancelar">
        <div style="background: #fff; border-radius: 16px; max-width: 460px; width: 100%; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.4); font-family: 'Segoe UI', system-ui, sans-serif;"
             @onclick:stopPropagation="true">

            @* ═══ HEADER ═══ *@
            <div style="padding: 24px 24px 20px; color: #fff; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; background: @_opciones.ColorBoton;">
                <i class="bi @_opciones.Icono" style="font-size: 2.5rem; opacity: 0.95;"></i>
                <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #fff;">@_opciones.Titulo</h3>
            </div>

            @* ═══ BODY ═══ *@
            <div style="padding: 24px 28px; text-align: center;">
                <p style="margin: 0; color: #475569; font-size: 0.95rem; line-height: 1.55;">@_opciones.Mensaje</p>
            </div>

            @* ═══ FOOTER ═══ *@
            <div style="display: flex; gap: 10px; padding: 0 24px 22px;">
                <button type="button"
                        style="flex: 1; padding: 11px 20px; border-radius: 10px; font-weight: 600; font-size: 0.9rem; cursor: pointer; border: none; background: #f1f5f9; color: #475569; font-family: inherit;"
                        @onclick="Cancelar">
                    @_opciones.TextoCancelar
                </button>
                <button type="button"
                        style="flex: 1; padding: 11px 20px; border-radius: 10px; font-weight: 600; font-size: 0.9rem; cursor: pointer; border: none; color: #fff; display: flex; align-items: center; justify-content: center; gap: 6px; font-family: inherit; background: @_opciones.ColorBoton;"
                        @onclick="Aceptar">
                    <i class="bi bi-check-lg"></i> @_opciones.TextoConfirmar
                </button>
            </div>

        </div>
    </div>
}

@code {
    private bool _visible = false;
    private ConfirmOpciones _opciones = new();
    private TaskCompletionSource<bool>? _tcs;

    protected override void OnInitialized()
    {
        Confirm.OnAsk += Preguntar;
    }

    private async Task<bool> Preguntar(ConfirmOpciones opciones)
    {
        _opciones = opciones;
        _visible = true;
        _tcs = new TaskCompletionSource<bool>();
        await InvokeAsync(StateHasChanged);
        return await _tcs.Task;
    }

    private void Aceptar()
    {
        _visible = false;
        _tcs?.TrySetResult(true);
        StateHasChanged();
    }

    private void Cancelar()
    {
        _visible = false;
        _tcs?.TrySetResult(false);
        StateHasChanged();
    }

    public void Dispose()
    {
        Confirm.OnAsk -= Preguntar;
    }
}