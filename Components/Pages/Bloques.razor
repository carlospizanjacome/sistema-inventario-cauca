@page "/bloques"
@rendermode InteractiveServer

@using Almacen.Components.Shared
@using Almacen.DTOs
@using Almacen.Helpers
@using Almacen.Interfaces
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IBloqueRepository BloqueRepo
@inject ISedeRepository SedeRepo
@inject ToastService Toast
@inject ConfirmService Confirm
@inject IJSRuntime JS

<PageTitle>Bloques · Almacén</PageTitle>

<div class="page-container page-crud @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-grid-3x3"></i> Bloques</h1>
                <p class="subtitle">Bloques o edificaciones dentro de cada sede</p>
            </div>

            <div class="header-actions">
                <button class="btn-nuevo" @onclick="AbrirFormulario">
                    <i class="bi bi-plus-lg"></i> Nuevo Bloque
                </button>
            </div>
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(_editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(_editando ? "Editar Bloque" : "Nuevo Bloque")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-grid-3x3"></i>
                    <div>
                        <div class="form-header-title">Bloques</div>
                        <div class="form-header-subtitle">Bloques o edificaciones dentro de cada sede</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="CerrarFormulario" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="_model" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="form-group">
                        <label>Sede *</label>
                        <div class="input-icon">
                            <i class="bi bi-building"></i>
                            <InputSelect @bind-Value="_model.SedeId" class="form-control">
                                <option value="0">— Seleccione —</option>
                                @foreach (var s in _sedes)
                                {
                                    <option value="@s.Id">@s.InstitucionNombre — @s.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="() => _model.SedeId" />
                    </div>

                    <div class="form-group">
                        <label>Nombre *</label>
                        <div class="input-icon">
                            <i class="bi bi-box"></i>
                            <InputText @bind-Value="_model.Nombre" class="form-control"
                                       placeholder="Ej: Bloque A" />
                        </div>
                        <ValidationMessage For="() => _model.Nombre" />
                    </div>

                    <div class="form-group">
                        <label>Descripción</label>
                        <div class="input-icon">
                            <i class="bi bi-chat-left-text"></i>
                            <InputText @bind-Value="_model.Descripcion" class="form-control"
                                       placeholder="Descripción del bloque" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Pisos</label>
                        <div class="input-icon">
                            <i class="bi bi-layers"></i>
                            <InputNumber @bind-Value="_model.Pisos" class="form-control" />
                        </div>
                        <ValidationMessage For="() => _model.Pisos" />
                    </div>

                    <div class="form-group checkbox-group">
                        <label>
                            <InputCheckbox @bind-Value="_model.Activo" />
                            Activo
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="CerrarFormulario">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(_editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(_editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">

        @* ═══ Barra de filtros ═══ *@
        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar bloque por nombre o descripción…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-tabla-derecha">

                @* ═══ Dropdown custom de sede ═══ *@
                <details class="dropdown-sede" id="dropdown-sede-bloques">
                    <summary class="dropdown-sede-trigger">
                        <i class="bi bi-building"></i>
                        <span>@(string.IsNullOrEmpty(_sedeSeleccionadaNombre) ? "Todas las sedes" : _sedeSeleccionadaNombre)</span>
                        <i class="bi bi-chevron-down dropdown-sede-chevron"></i>
                    </summary>

                    <div class="dropdown-sede-panel">
                        <div class="dropdown-sede-item @(_sedeSeleccionadaId is null ? "active" : "")"
                             @onclick="() => SeleccionarSede(null)">
                            <i class="bi bi-grid-3x3"></i>
                            <span>Todas las sedes</span>
                            @if (_sedeSeleccionadaId is null)
                            {
                                <i class="bi bi-check2 dropdown-sede-check"></i>
                            }
                        </div>

                        <div class="dropdown-sede-divider"></div>

                        @foreach (var s in _sedes)
                        {
                            <div class="dropdown-sede-item @(_sedeSeleccionadaId == s.Id ? "active" : "")"
                                 @onclick="() => SeleccionarSede(s)">
                                <i class="bi bi-building"></i>
                                <span>@s.Nombre</span>
                                @if (_sedeSeleccionadaId == s.Id)
                                {
                                    <i class="bi bi-check2 dropdown-sede-check"></i>
                                }
                            </div>
                        }
                    </div>
                </details>

                <span class="badge-total">
                    <i class="bi bi-grid-3x3"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> bloques
                    @if (!string.IsNullOrEmpty(_filtroTexto) || _sedeSeleccionadaId.HasValue)
                    {
                        <span class="filtro-activo-tag">· Filtrado</span>
                    }
                </span>
            </div>
        </div>

        @* ═══ Tabla ═══ *@
        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Institución</th>
                        <th>Sede</th>
                        <th>Bloque</th>
                        <th>Descripción</th>
                        <th>Pisos</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Cargando bloques…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3 text-muted">
                                @(string.IsNullOrEmpty(_filtroTexto) && !_sedeSeleccionadaId.HasValue
                                    ? "Sin bloques registrados."
                                    : "Sin resultados para los filtros aplicados.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td>@b.InstitucionNombre</td>
                                <td>@b.SedeNombre</td>
                                <td><strong>@b.Nombre</strong></td>
                                <td>@b.Descripcion</td>
                                <td>@b.Pisos</td>
                                <td>
                                    <span class="badge @(b.Activo ? "badge-ok" : "badge-off")">
                                        @(b.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn-icon me-1" @onclick="() => Editar(b)" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <button class="btn-icon danger" @onclick="() => Eliminar(b)" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="BloqueDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private ResultadoPaginado<BloqueDTO>? _pagina;
    private List<SedeDTO> _sedes = new();
    private BloqueDTO _model = new();
    private bool _editando = false;
    private bool _mostrarFormulario = false;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    // Filtro por sede
    private int? _sedeSeleccionadaId;
    private string _sedeSeleccionadaNombre = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _sedes = (await SedeRepo.ObtenerTodasAsync()).ToList();
        await Cargar();
    }

    private async Task Cargar()
    {
        _pagina = await BloqueRepo.ObtenerPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            _sedeSeleccionadaId);
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task SeleccionarSede(SedeDTO? sede)
    {
        _sedeSeleccionadaId = sede?.Id;
        _sedeSeleccionadaNombre = sede?.Nombre ?? string.Empty;
        _paginaActual = 1;

        // Cerrar el dropdown
        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('dropdown-sede-bloques')?.removeAttribute('open')");
        }
        catch { /* silencioso */ }

        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private void AbrirFormulario()
    {
        _model = new BloqueDTO { Activo = true, Pisos = 1 };
        _editando = false;
        _mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario = false;
        _model = new BloqueDTO();
        _editando = false;
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (_model.SedeId <= 0)
        {
            Toast.Error("Debe seleccionar una sede.");
            return;
        }

        try
        {
            if (_editando)
            {
                await BloqueRepo.ActualizarAsync(_model);
                Toast.Exito($"Bloque '{_model.Nombre}' actualizado. Puede seguir editando.");
            }
            else
            {
                await BloqueRepo.CrearAsync(_model);
                Toast.Exito($"Bloque '{_model.Nombre}' creado. Puede continuar registrando.");

                var sedeActual = _model.SedeId;
                var pisosActual = _model.Pisos;

                _model = new BloqueDTO
                {
                    Activo = true,
                    SedeId = sedeActual,
                    Pisos = pisosActual
                };

                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { /* silencioso */ }
            }

            await Cargar();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(BloqueDTO b)
    {
        _model = new BloqueDTO
        {
            Id = b.Id,
            SedeId = b.SedeId,
            Nombre = b.Nombre,
            Descripcion = b.Descripcion,
            Pisos = b.Pisos,
            Activo = b.Activo
        };
        _editando = true;
        _mostrarFormulario = true;
        StateHasChanged();
    }

    private async Task Eliminar(BloqueDTO b)
    {
        var ok = await Confirm.Peligroso(
            $"¿Eliminar el bloque '{b.Nombre}'? Esta acción no se puede deshacer.");
        if (!ok) return;

        if (await BloqueRepo.TieneAulasAsync(b.Id))
        {
            Toast.Error("No se puede eliminar: el bloque tiene aulas asociadas.");
            return;
        }

        try
        {
            await BloqueRepo.EliminarAsync(b.Id);
            Toast.Exito("Bloque eliminado correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }
}