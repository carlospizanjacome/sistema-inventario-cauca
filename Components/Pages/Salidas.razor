@page "/salidas"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject ISalidaRepository SalidaRepo
@inject IBienRepository BienRepo
@inject IFuncionarioRepository FuncRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject AuditoriaService Auditoria
@inject UsuarioSesionService Sesion

<PageTitle>Salidas · Almacén</PageTitle>

<div class="page-container page-crud @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-box-arrow-up"></i> Salidas / Bajas</h1>
                <p class="subtitle">Retiro definitivo de bienes del inventario</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo btn-nuevo-danger" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nueva Salida / Baja
                    </button>
                </div>
            }
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Salida" : "Nueva Salida / Baja")</span>
                </div>
                <div class="form-header-center">
                    <i class="bi bi-box-arrow-up"></i>
                    <div>
                        <div class="form-header-title">Salidas / Bajas</div>
                        <div class="form-header-subtitle">Retiro definitivo del inventario</div>
                    </div>
                </div>
                <button class="btn-cerrar-form" @onclick="Cancelar" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (editando && _esSalidaFormal)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-lock-fill"></i>
                    <div>
                        <strong>Esta es una salida formal.</strong>
                        <p>
                            Tiene Acta Comité y/o Denuncia penal radicada.
                            <br />
                            Solo se pueden modificar las <strong>observaciones</strong>.
                            Para modificar otros campos, <strong>anule esta salida y cree una nueva</strong>.
                        </p>
                    </div>
                </div>
            }

            <EditForm @key="salidaEditandoId" Model="salidaDTO" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-section">
                    <h4 class="form-section-title"><i class="bi bi-card-list"></i> Identificación</h4>
                    <div class="form-grid-3">

                        <div class="form-group" style="grid-column: span 2;">
                            <label>Bien *</label>
                            <div class="input-icon">
                                <i class="bi bi-box-seam"></i>
                                <InputSelect class="form-select"
                                             @bind-Value="salidaDTO.BienId"
                                             @bind-Value:after="OnBienCambiadoAsync"
                                             disabled="@_esSalidaFormal">
                                    <option value="0">— Seleccione bien —</option>
                                    @foreach (var b in bienes)
                                    {
                                        <option value="@b.Id">@b.Codigo — @b.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <ValidationMessage For="() => salidaDTO.BienId" class="form-error" />
                        </div>

                        <div class="form-group">
                            <label>Tipo de Baja *</label>
                            <div class="input-icon">
                                <i class="bi bi-x-circle"></i>
                                <InputSelect class="form-select" 
                                             @bind-Value="salidaDTO.TipoBaja"
                                             disabled="@_esSalidaFormal">
                                    <option value="Obsolescencia">Obsolescencia</option>
                                    <option value="Daño">Daño irreparable</option>
                                    <option value="Hurto">Hurto</option>
                                    <option value="Donacion">Donación</option>
                                    <option value="Transferencia">Transferencia</option>
                                    <option value="Otro">Otro</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Fecha Salida *</label>
                            <div class="input-icon">
                                <i class="bi bi-calendar-x"></i>
                                <InputDate class="form-control" 
                                           @bind-Value="salidaDTO.FechaSalida" 
                                           disabled="@_esSalidaFormal" />
                            </div>
                            <ValidationMessage For="() => salidaDTO.FechaSalida" class="form-error" />
                        </div>

                        <div class="form-group">
                            <label>N° Acta Comité</label>
                            <div class="input-icon">
                                <i class="bi bi-file-earmark-text"></i>
                                <InputText class="form-control" 
                                           @bind-Value="salidaDTO.NumeroActaComite"
                                           placeholder="Acta 001-2026"
                                           disabled="@_esSalidaFormal" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>N° Radicado Denuncia</label>
                            <div class="input-icon">
                                <i class="bi bi-shield-exclamation"></i>
                                <InputText class="form-control" 
                                           @bind-Value="salidaDTO.NumeroDenuncia"
                                           placeholder="Solo si es hurto"
                                           disabled="@_esSalidaFormal" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Valor de Salida <small class="text-muted">(auto)</small></label>
                            <div class="input-icon">
                                <i class="bi bi-currency-dollar"></i>
                                <InputMoneda class="form-control"
                                             @bind-Value="salidaDTO.ValorSalida"
                                             ReadOnly="true" />
                            </div>
                            <small class="form-hint">Se toma del valor de adquisición del bien</small>
                        </div>

                        <div class="form-group">
                            <label>Aprueba (Funcionario)</label>
                            <div class="input-icon">
                                <i class="bi bi-person-check"></i>
                                <InputSelect class="form-select" 
                                             @bind-Value="salidaDTO.FuncionarioApruebaId"
                                             disabled="@_esSalidaFormal">
                                    <option value="">— Sin asignar —</option>
                                    @foreach (var f in funcionarios)
                                    {
                                        <option value="@f.Id">@f.NombreCompleto</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="form-group" style="grid-column: span 2;">
                            <label>Motivo *</label>
                            <div class="input-icon">
                                <i class="bi bi-chat-left-text"></i>
                                <InputText class="form-control" 
                                           @bind-Value="salidaDTO.Motivo"
                                           placeholder="Descripción del motivo"
                                           disabled="@_esSalidaFormal" />
                            </div>
                            <ValidationMessage For="() => salidaDTO.Motivo" class="form-error" />
                        </div>

                        <div class="form-group form-group-full">
                            <label>Observaciones</label>
                            <div class="input-icon">
                                <i class="bi bi-chat-left-text textarea-icon"></i>
                                <InputTextArea class="form-control" rows="2" 
                                               @bind-Value="salidaDTO.Observaciones" />
                            </div>
                            <small class="form-hint">
                                @if (editando && _esSalidaFormal)
                                {
                                    <span>⚠️ Único campo editable de una salida formal.</span>
                                }
                            </small>
                        </div>

                    </div>
                </div>

                @if (editando && salidaEditandoId > 0)
                {
                    <div class="form-section">
                        <h4 class="form-section-title"><i class="bi bi-paperclip"></i> Soportes</h4>
                        <AdjuntosUploader EntidadTipo="salida" EntidadId="salidaEditandoId" />
                    </div>
                }

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="Cancelar">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi @(editando ? "bi-check-circle-fill" : "bi-box-arrow-up")"></i>
                        @(editando ? "Actualizar" : "Registrar Baja")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">

        <div class="filtros-toolbar">
            <div class="filtro-busqueda-principal">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por bien, motivo o acta…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-toolbar-actions">
                <button class="btn-filtros @(_mostrarFiltros ? "active" : "")"
                        @onclick="ToggleFiltros">
                    <i class="bi bi-sliders"></i>
                    <span>Filtros</span>
                    @if (_hayFiltrosAvanzados)
                    {
                        <span class="filtros-badge"></span>
                    }
                    <i class="bi @(_mostrarFiltros ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
        </div>

        @if (_mostrarFiltros)
        {
            <div class="panel-filtros">
                <div class="filtros-grid">
                    <div class="filtro-select">
                        <i class="bi bi-x-circle"></i>
                        <select @bind="_filtroTipo" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Todos los tipos</option>
                            <option value="Obsolescencia">Obsolescencia</option>
                            <option value="Daño">Daño irreparable</option>
                            <option value="Hurto">Hurto</option>
                            <option value="Donacion">Donación</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>

                    <div class="filtro-select">
                        <i class="bi bi-calendar"></i>
                        <input type="date" @bind="_filtroFechaDesde" @bind:after="AplicarFiltrosAvanzados" />
                    </div>

                    <div class="filtro-select">
                        <i class="bi bi-calendar"></i>
                        <input type="date" @bind="_filtroFechaHasta" @bind:after="AplicarFiltrosAvanzados" />
                    </div>
                </div>

                <div class="filtros-acciones">
                    <span class="badge-total">
                        <i class="bi bi-box-arrow-up"></i>
                        <strong>@(_pagina?.TotalRegistros ?? 0)</strong> salidas
                        @if (_hayFiltrosActivos)
                        {
                            <span class="filtro-activo-tag">· Filtrado</span>
                        }
                    </span>
                    @if (_hayFiltrosAvanzados)
                    {
                        <button class="btn-limpiar-filtros" @onclick="LimpiarTodosLosFiltros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Limpiar filtros
                        </button>
                    }
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Bien</th>
                        <th>Tipo Baja</th>
                        <th>Motivo</th>
                        <th>Acta</th>
                        <th>Denuncia</th>
                        <th class="text-end">Valor</th>
                        <th>Aprueba</th>
                        <th class="text-center" style="width: 110px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="9" class="text-center py-4 text-muted">Cargando salidas…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="9" class="text-center py-4 text-muted">Sin salidas registradas.</td></tr>
                    }
                    else
                    {
                        @foreach (var s in _pagina.Items)
                        {
                            var esFormal = !string.IsNullOrWhiteSpace(s.NumeroActaComite)
                                        || !string.IsNullOrWhiteSpace(s.NumeroDenuncia);
                            
                            <tr class="table-row-hover" @key="s.Id">
                                <td class="text-mono">@s.FechaSalida?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@s.BienNombre</strong>
                                        <small>@s.BienCodigo</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @GetClaseBadgeTipoBaja(s.TipoBaja)">@s.TipoBaja</span>
                                </td>
                                <td>@s.Motivo</td>
                                <td class="text-mono">@s.NumeroActaComite</td>
                                <td class="text-mono">
                                    @if (!string.IsNullOrEmpty(s.NumeroDenuncia))
                                    {
                                        <span class="text-danger">
                                            <i class="bi bi-shield-exclamation"></i> @s.NumeroDenuncia
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end num">@s.ValorSalida.ToString("C0", CulturaCOP)</td>
                                <td>@(s.FuncionarioNombre ?? "—")</td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        @if (puedeEditar)
                                        {
                                            <button type="button"
                                                    class="btn-action btn-action-edit"
                                                    @onclick="() => Editar(s)"
                                                    title="@(esFormal ? "Editar (solo observaciones)" : "Editar")">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }
                                        @if (puedeAnular)
                                        {
                                            <button type="button"
                                                    class="btn-action btn-action-delete"
                                                    @onclick="() => IntentarAnular(s)"
                                                    @onclick:stopPropagation="true"
                                                    title="@(esFormal 
                                                        ? "No se puede anular: tiene Acta/Denuncia" 
                                                        : "Anular salida (soft-delete)")">
                                                <i class="bi bi-slash-circle-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="SalidaDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   MODAL — Anular (FUERA del page-container para evitar overflow:hidden)
   ═══════════════════════════════════════════════════════════════ *@
@if (_modalAnulacionAbierto && _itemAAnular is not null)
{
    var s = _itemAAnular;

    <div class="modal-backdrop-det" @onclick="CancelarAnulacion">
        <div class="modal-det" @onclick:stopPropagation="true">

            <div class="modal-det-header">
                <div class="modal-det-header-left">
                    <span class="badge badge-off">Anular salida</span>
                    <h3>@s.BienNombre</h3>
                </div>
                <button type="button" class="modal-det-close" @onclick="CancelarAnulacion" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-det-body">
                <div class="det-section" style="background: #fffbeb; border-left: 4px solid #f59e0b;">
                    <h4><i class="bi bi-exclamation-triangle-fill"></i> ¿Qué es anular?</h4>
                    <p style="margin: 0;">
                        El registro <strong>NO se elimina de la base de datos</strong>. Se marca como "Anulada" y se excluye de los reportes operativos.
                        El historial completo queda disponible para auditoría y para el expediente del bien.
                    </p>
                    <p style="margin: 8px 0 0 0; font-size: 0.85rem;">
                        <i class="bi bi-info-circle"></i> <strong>Efecto:</strong> El bien será <strong>reactivado automáticamente</strong> (volverá a estar activo en el inventario).
                    </p>
                </div>

                <div class="det-section">
                    <h4><i class="bi bi-info-circle"></i> Salida a anular</h4>
                    <dl class="det-dl">
                        <dt>Bien</dt>
                        <dd><code>@s.BienCodigo</code> — @s.BienNombre</dd>
                        <dt>Tipo de baja</dt>
                        <dd><span class="badge @GetClaseBadgeTipoBaja(s.TipoBaja)">@s.TipoBaja</span></dd>
                        <dt>Motivo</dt>
                        <dd>@s.Motivo</dd>
                        <dt>Fecha</dt>
                        <dd>@s.FechaSalida?.ToString("dd/MM/yyyy")</dd>
                        <dt>Valor</dt>
                        <dd>@s.ValorSalida.ToString("C0", CulturaCOP)</dd>
                    </dl>
                </div>

                <div class="form-group form-group-full">
                    <label>Motivo de la anulación *</label>
                    <div class="input-icon">
                        <i class="bi bi-pencil-square"></i>
                        <InputTextArea class="form-control" rows="3"
                                       @bind-Value="_motivoAnulacion"
                                       placeholder="Ej: Error de digitación, baja duplicada, prueba del sistema..." />
                    </div>
                    <small class="text-muted">Este motivo quedará registrado en la bitácora de auditoría.</small>
                </div>
            </div>

            <div class="modal-det-footer">
                <button type="button" class="btn-det-cerrar" @onclick="CancelarAnulacion">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <button type="button" class="btn btn-save" @onclick="ConfirmarAnulacionAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_motivoAnulacion))">
                    <i class="bi bi-slash-circle-fill"></i> Confirmar Anulación
                </button>
            </div>

        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo CulturaCOP =
        System.Globalization.CultureInfo.GetCultureInfo("es-CO");

    [SupplyParameterFromQuery(Name = "bienId")]
    public int? BienIdQuery { get; set; }

    private ResultadoPaginado<SalidaDTO>? _pagina;
    private IEnumerable<Bien> bienes = [];
    private IEnumerable<FuncionarioDTO> funcionarios = [];

    private SalidaDTO salidaDTO = new();
    private SalidaDTO? _salidaAntesDeEditar;
    private bool editando = false;
    private int salidaEditandoId;
    private bool _mostrarFormulario = false;
    private bool _mostrarFiltros = false;
    private bool _esSalidaFormal = false;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private string? _filtroTipo;
    private DateTime? _filtroFechaDesde;
    private DateTime? _filtroFechaHasta;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeAnular;

    private bool _modalAnulacionAbierto = false;
    private SalidaDTO? _itemAAnular;
    private string _motivoAnulacion = "";

    private bool _hayFiltrosActivos =>
        !string.IsNullOrEmpty(_filtroTexto) ||
        !string.IsNullOrEmpty(_filtroTipo) ||
        _filtroFechaDesde.HasValue ||
        _filtroFechaHasta.HasValue;

    private bool _hayFiltrosAvanzados =>
        !string.IsNullOrEmpty(_filtroTipo) ||
        _filtroFechaDesde.HasValue ||
        _filtroFechaHasta.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("salidas.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear  = await Seguridad.TienePermisoAsync("salidas.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("salidas.editar");
        puedeAnular = await Seguridad.TienePermisoAsync("salidas.anular");

        bienes = await BienRepo.ObtenerTodosAsync();
        funcionarios = await FuncRepo.ObtenerTodosAsync();

        await Cargar();

        if (BienIdQuery.HasValue && BienIdQuery.Value > 0)
        {
            AbrirFormulario();
            salidaDTO.BienId = BienIdQuery.Value;
            await OnBienCambiadoAsync();
            StateHasChanged();
        }
    }

    private async Task Cargar()
    {
        var filtro = new FiltroMovimientoDTO
        {
            Texto = string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            Tipo = _filtroTipo,
            FechaDesde = _filtroFechaDesde,
            FechaHasta = _filtroFechaHasta
        };

        if (filtro.HayFiltros)
        {
            _pagina = await SalidaRepo.ObtenerPaginadoConFiltrosAsync(
                filtro, _paginaActual, _tamanoPagina);
        }
        else
        {
            _pagina = await SalidaRepo.ObtenerPaginadoAsync(
                _paginaActual, _tamanoPagina,
                string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
        }
    }

    private async Task OnBienCambiadoAsync()
    {
        var bienId = salidaDTO.BienId;

        if (bienId <= 0)
        {
            salidaDTO.ValorSalida = 0;
            return;
        }

        try
        {
            var bien = await BienRepo.ObtenerPorIdAsync(bienId);
            if (bien is not null)
            {
                salidaDTO.ValorSalida = bien.ValorAdquisicion;
            }
        }
        catch { }

        StateHasChanged();
    }

    private void AbrirFormulario()
    {
        salidaDTO = new SalidaDTO { FechaSalida = DateTime.Today, TipoBaja = "Obsolescencia" };
        editando = false;
        salidaEditandoId = 0;
        _salidaAntesDeEditar = null;
        _esSalidaFormal = false;
        _mostrarFormulario = true;
        _mostrarFiltros = false;
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
        salidaDTO = new SalidaDTO { FechaSalida = DateTime.Today, TipoBaja = "Obsolescencia" };
        editando = false;
        salidaEditandoId = 0;
        _salidaAntesDeEditar = null;
        _esSalidaFormal = false;
        _filtroTexto = string.Empty;
        StateHasChanged();
    }

    private void ToggleFiltros()
    {
        if (_mostrarFormulario)
        {
            _mostrarFormulario = false;
            salidaDTO = new SalidaDTO { FechaSalida = DateTime.Today, TipoBaja = "Obsolescencia" };
            editando = false;
            salidaEditandoId = 0;
            _salidaAntesDeEditar = null;
            _esSalidaFormal = false;
        }
        _mostrarFiltros = !_mostrarFiltros;
    }

    private async Task AplicarFiltrosAvanzados()
    {
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task LimpiarTodosLosFiltros()
    {
        _filtroTexto = string.Empty;
        _filtroTipo = null;
        _filtroFechaDesde = null;
        _filtroFechaHasta = null;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;
            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!editando && !puedeCrear) { Toast.Error("No tiene permiso para registrar salidas."); return; }
        if (editando && !puedeEditar) { Toast.Error("No tiene permiso para editar salidas."); return; }
        if (salidaDTO.BienId <= 0) { Toast.Error("Debe seleccionar un bien."); return; }
        if (salidaDTO.TipoBaja == "Hurto" && string.IsNullOrWhiteSpace(salidaDTO.NumeroDenuncia))
        {
            Toast.Error("Para tipo de baja 'Hurto' debe registrar el N° de denuncia penal.");
            return;
        }

        try
        {
            if (editando)
            {
                var antes = _salidaAntesDeEditar is null ? null : new
                {
                    _salidaAntesDeEditar.BienId,
                    _salidaAntesDeEditar.TipoBaja,
                    _salidaAntesDeEditar.Motivo,
                    _salidaAntesDeEditar.FechaSalida,
                    _salidaAntesDeEditar.NumeroActaComite,
                    _salidaAntesDeEditar.NumeroDenuncia,
                    _salidaAntesDeEditar.ValorSalida
                };

                await SalidaRepo.ActualizarAsync(salidaDTO);

                await Auditoria.RegistrarEdicionAsync(
                    modulo: "salidas",
                    objetoTipo: "Salida",
                    objetoId: salidaDTO.Id,
                    objetoCodigo: salidaDTO.NumeroActaComite,
                    objetoDescripcion: $"Salida de {salidaDTO.TipoBaja}",
                    antes: antes,
                    despues: new
                    {
                        salidaDTO.BienId,
                        salidaDTO.TipoBaja,
                        salidaDTO.Motivo,
                        salidaDTO.FechaSalida,
                        salidaDTO.NumeroActaComite,
                        salidaDTO.NumeroDenuncia,
                        salidaDTO.ValorSalida
                    },
                    motivo: _esSalidaFormal 
                        ? "Edición de observaciones (salida formal)" 
                        : "Edición de salida"
                );

                Toast.Exito("Salida actualizada correctamente");
                _filtroTexto = string.Empty;
                await Cargar();
                StateHasChanged();
            }
            else
            {
                if (await SalidaRepo.BienTieneSalidaAsync(salidaDTO.BienId))
                {
                    Toast.Error("Este bien ya tiene una salida registrada.");
                    return;
                }

                await SalidaRepo.CrearAsync(salidaDTO);
                await SalidaRepo.DesactivarBienAsync(salidaDTO.BienId);

                await Auditoria.RegistrarCreacionAsync(
                    modulo: "salidas",
                    objetoTipo: "Salida",
                    objetoId: salidaDTO.Id,
                    objetoCodigo: salidaDTO.NumeroActaComite,
                    objetoDescripcion: $"Salida de {salidaDTO.TipoBaja}",
                    despues: new
                    {
                        salidaDTO.BienId,
                        salidaDTO.TipoBaja,
                        salidaDTO.Motivo,
                        salidaDTO.FechaSalida,
                        salidaDTO.NumeroActaComite,
                        salidaDTO.NumeroDenuncia,
                        salidaDTO.ValorSalida
                    }
                );

                Toast.Exito("Salida registrada. El bien fue dado de baja.");
                Cancelar();
                await Cargar();
            }
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "la salida", "guardar");
        }
    }

    private void Editar(SalidaDTO s)
    {
        if (!puedeEditar) return;
        editando = true;
        salidaEditandoId = s.Id;
        _salidaAntesDeEditar = s;
        _mostrarFormulario = true;
        _mostrarFiltros = false;

        _esSalidaFormal = !string.IsNullOrWhiteSpace(s.NumeroActaComite)
                       || !string.IsNullOrWhiteSpace(s.NumeroDenuncia);

        salidaDTO.Id = s.Id;
        salidaDTO.BienId = s.BienId;
        salidaDTO.TipoBaja = s.TipoBaja;
        salidaDTO.Motivo = s.Motivo;
        salidaDTO.FechaSalida = s.FechaSalida;
        salidaDTO.NumeroActaComite = s.NumeroActaComite;
        salidaDTO.NumeroDenuncia = s.NumeroDenuncia;
        salidaDTO.ValorSalida = s.ValorSalida;
        salidaDTO.FuncionarioApruebaId = s.FuncionarioApruebaId;
        salidaDTO.Observaciones = s.Observaciones;

        _filtroTexto = string.Empty;
        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════
    // MÉTODOS DE ANULACIÓN (Soft-Delete)
    // ═══════════════════════════════════════════════════════════════

    private void IntentarAnular(SalidaDTO s)
    {
        if (!puedeAnular)
        {
            Toast.Error("No tiene permiso para anular salidas.");
            return;
        }

        if (s.EsFormal)
        {
            var motivos = new List<string>();
            if (!string.IsNullOrWhiteSpace(s.NumeroActaComite))
                motivos.Add($"Acta Comité '{s.NumeroActaComite}'");
            if (!string.IsNullOrWhiteSpace(s.NumeroDenuncia))
                motivos.Add($"Denuncia '{s.NumeroDenuncia}'");

            Toast.Warning(
                $"No se puede anular la salida del bien '{s.BienNombre}': " +
                $"tiene {string.Join(" y ", motivos)}. " +
                "Use el proceso administrativo de 'Anular Baja'.");
            return;
        }

        _itemAAnular = s;
        _motivoAnulacion = "";
        _modalAnulacionAbierto = true;
        StateHasChanged();
    }

    private void CancelarAnulacion()
    {
        _modalAnulacionAbierto = false;
        _itemAAnular = null;
        _motivoAnulacion = "";
    }

    private async Task ConfirmarAnulacionAsync()
    {
        if (_itemAAnular is null) return;
        if (string.IsNullOrWhiteSpace(_motivoAnulacion))
        {
            Toast.Warning("Debe ingresar un motivo para la anulación.");
            return;
        }

        try
        {
            await SalidaRepo.AnularAsync(_itemAAnular.Id, _motivoAnulacion);

            await Auditoria.RegistrarAnulacionAsync(
                modulo: "salidas",
                objetoTipo: "Salida",
                objetoId: _itemAAnular.Id,
                objetoCodigo: _itemAAnular.BienCodigo,
                objetoDescripcion: $"Anulación de salida para '{_itemAAnular.BienNombre}' — Tipo: {_itemAAnular.TipoBaja}",
                antes: new
                {
                    TipoBaja = _itemAAnular.TipoBaja,
                    Motivo = _itemAAnular.Motivo,
                    ValorSalida = _itemAAnular.ValorSalida,
                    Anulada = false
                },
                despues: new
                {
                    Anulada = true,
                    Motivo = _motivoAnulacion,
                    AnuladaPor = Sesion.UsuarioActual?.Id,
                    AnuladaFecha = DateTime.Now
                },
                motivo: _motivoAnulacion
            );

            Toast.Exito("Salida anulada. El bien fue reactivado.");
            CancelarAnulacion();
            await Cargar();
            StateHasChanged();
        }
        catch (InvalidOperationException iex)
        {
            Toast.Warning(iex.Message);
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "la salida", "anular");
        }
    }

    private static string GetClaseBadgeTipoBaja(string? tipo) => tipo switch
    {
        "Hurto"         => "badge-danger",
        "Daño"          => "badge-warn",
        "Obsolescencia" => "badge-neutral",
        "Donacion"      => "badge-info",
        "Transferencia" => "badge-info",
        _               => "badge-neutral"
    };
}