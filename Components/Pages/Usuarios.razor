@page "/usuarios"
@rendermode InteractiveServer

@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.DTOs
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject PermisoService Permisos
@inject NavigationManager Navigation
@inject SeguridadService Seguridad
@inject IJSRuntime JS
@inject IUsuarioRepository UsuarioRepository
@inject IRolRepository RolRepository
@inject IInstitucionRepository InstRepo
@inject UsuarioSesionService Sesion
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Usuarios · Almacén</PageTitle>

<div class="page-container page-crud">

    @* ═══════════════ PAGE HEADER (oculto si form abierto) ═══════════════ *@
    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-people-fill"></i> Usuarios</h1>
                <p class="subtitle">Administración de usuarios y accesos al sistema</p>
            </div>

            <div class="header-actions">
                @if (puedeCrear)
                {
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nuevo Usuario
                    </button>
                }
            </div>
        </div>
    }

    @* ═══════════════ FORM COLAPSABLE ═══════════════ *@
    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Usuario" : "Nuevo Usuario")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-people-fill"></i>
                    <div>
                        <div class="form-header-title">Usuarios</div>
                        <div class="form-header-subtitle">Administración de usuarios y accesos al sistema</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="() => CerrarFormulario()" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="usuarioDTO" OnValidSubmit="GuardarUsuario">
                <DataAnnotationsValidator />

                <div class="form-grid-3">
                    <div class="form-group" style="grid-column: span 2;">
                        <label>Nombre Completo *</label>
                        <div class="input-icon">
                            <i class="bi bi-person-fill"></i>
                            <InputText class="form-control" @bind-Value="usuarioDTO.NombreCompleto" placeholder="Ej: Juan Pérez Rodríguez" />
                        </div>
                        <ValidationMessage For="@(() => usuarioDTO.NombreCompleto)" />
                    </div>

                    <div class="form-group">
                        <label>Estado</label>
                        <div class="input-icon">
                            <i class="bi bi-check-circle-fill"></i>
                            <InputSelect class="form-control" @bind-Value="estadoString">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group" style="grid-column: span 2;">
                        <label>Correo Electrónico *</label>
                        <div class="input-icon">
                            <i class="bi bi-envelope-fill"></i>
                            <InputText class="form-control" type="email" @bind-Value="usuarioDTO.Email" placeholder="correo@ejemplo.com" />
                        </div>
                        <ValidationMessage For="@(() => usuarioDTO.Email)" />
                    </div>

                    <div class="form-group">
                        <label>Rol</label>
                        <div class="input-icon">
                            <i class="bi bi-person-badge-fill"></i>
                            <InputSelect class="form-control" @bind-Value="usuarioDTO.RolId">
                                <option value="">Seleccione...</option>
                                @if (roles != null)
                                {
                                    @foreach (var rol in roles)
                                    {
                                        <option value="@rol.Id">@rol.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group" style="grid-column: span 2;">
                        <label>Contraseña @(editando ? "" : "*")</label>
                        <div class="input-icon">
                            <i class="bi bi-shield-lock-fill"></i>
                            <InputText type="password" class="form-control" @bind-Value="usuarioDTO.Password"
                                       placeholder="@(editando ? "Dejar en blanco para mantener la actual" : "Mínimo 6 caracteres")" />
                        </div>
                        <ValidationMessage For="@(() => usuarioDTO.Password)" />
                    </div>

                    <div class="form-group">
                        <label>Institución</label>
                        <div class="input-icon">
                            <i class="bi bi-building"></i>
                            <InputSelect class="form-control" @bind-Value="usuarioDTO.InstitucionId"
                                         disabled="@(!Sesion.EsSuperAdmin)">
                                <option value="0">— Seleccione —</option>
                                @foreach (var inst in _instituciones)
                                {
                                    <option value="@inst.Id">@inst.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                        @if (!Sesion.EsSuperAdmin)
                        {
                            <small class="form-hint">Solo puede crear usuarios en su institución</small>
                        }
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="() => CerrarFormulario()">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }
    
    @* ═══════════════ CARD TABLE ═══════════════ *@
    <div class="card-table">

        @* Barra de búsqueda SIEMPRE visible *@
        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por nombre, email o rol…"
                       value="@_filtroTexto"
                       @oninput="OnFiltroInput" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
            <div class="filtro-info">
                <span class="badge-total">
                    <i class="bi bi-people-fill"></i>
                    <strong>@(_usuariosFiltrados?.Count() ?? 0)</strong> usuarios
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th style="width: 56px;"></th>
                        <th>Usuario</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Institución</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (usuarios == null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Cargando usuarios…</td></tr>
                    }
                    else if (!usuarios.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">No existen usuarios registrados.</td></tr>
                    }
                    else if (!_usuariosFiltrados!.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Sin resultados para "@_filtroTexto".</td></tr>
                    }
                    else
                    {
                        @foreach (var usuario in _usuariosFiltrados!)
                        {
                            <tr class="table-row-hover">
                                <td>
                                    <div class="user-avatar-circle">
                                        @ObtenerIniciales(usuario.NombreCompleto)
                                    </div>
                                </td>
                                <td>
                                    <div class="user-cell-info">
                                        <strong>@usuario.NombreCompleto</strong>
                                        <small>ID: @usuario.Id</small>
                                    </div>
                                </td>
                                <td>@usuario.Email</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(usuario.NombreRol))
                                    {
                                        <span class="role-badge">@usuario.NombreRol</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin rol</span>
                                    }
                                </td>
                                <td>
                                    @if (usuario.EsSuperAdmin)
                                    {
                                        <span class="badge-super-admin">
                                            <i class="bi bi-shield-fill-check"></i> Super-Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">@(usuario.InstitucionNombre ?? "Sin institución")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(usuario.Activo ? "badge-ok" : "badge-off")">
                                        @(usuario.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        @if (puedeEditar)
                                        {
                                            <button class="btn-action btn-action-edit"
                                                    @onclick="() => EditarUsuario(usuario)"
                                                    title="Editar usuario">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }
                                        @if (puedeEliminar && !usuario.EsSuperAdmin)
                                        {
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => ConfirmarEliminar(usuario.Id, usuario.NombreCompleto)"
                                                    title="Eliminar usuario">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private IEnumerable<Usuario>? usuarios;
    private UsuarioDTO usuarioDTO = new();
    private bool editando = false;
    private int usuarioEditandoId;
    private bool _mostrarFormulario = false;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    private IEnumerable<Rol>? roles;
    private List<InstitucionDTO> _instituciones = new();

    private string _filtroTexto = string.Empty;
    private IEnumerable<Usuario>? _usuariosFiltrados;

    private string estadoString
    {
        get => usuarioDTO.Activo.ToString().ToLower();
        set => usuarioDTO.Activo = bool.Parse(value);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("usuarios.ver"))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("usuarios.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("usuarios.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("usuarios.eliminar");

        await CargarUsuarios();

        roles = await RolRepository.ObtenerTodosAsync();

        if (Sesion.EsSuperAdmin)
        {
            _instituciones = (await InstRepo.ObtenerTodasAsync()).ToList();
        }
        else
        {
            var inst = await InstRepo.ObtenerPorIdAsync(Sesion.InstitucionId);
            if (inst != null) _instituciones = new List<InstitucionDTO> { inst };
        }
    }

    // ═══════════ CARGA ═══════════
    private async Task CargarUsuarios()
    {
        usuarios = await UsuarioRepository.ObtenerTodosAsync();
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (usuarios == null)
        {
            _usuariosFiltrados = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_filtroTexto))
        {
            _usuariosFiltrados = usuarios;
        }
        else
        {
            var f = _filtroTexto.ToLower().Trim();
            _usuariosFiltrados = usuarios.Where(u =>
                (u.NombreCompleto?.ToLower().Contains(f) ?? false) ||
                (u.Email?.ToLower().Contains(f) ?? false) ||
                (u.NombreRol?.ToLower().Contains(f) ?? false) ||
                (u.InstitucionNombre?.ToLower().Contains(f) ?? false)
            );
        }
    }

    private void OnFiltroInput(ChangeEventArgs e)
    {
        _filtroTexto = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        AplicarFiltro();
    }

    // ═══════════ ABRIR / CERRAR FORM ═══════════
    private void AbrirFormulario()
    {
        usuarioDTO = new UsuarioDTO
        {
            Activo = true,
            InstitucionId = Sesion.EsSuperAdmin ? 0 : Sesion.InstitucionId
        };
        editando = false;
        usuarioEditandoId = 0;
        _mostrarFormulario = true;

        // Limpiar filtro
        _filtroTexto = string.Empty;
        AplicarFiltro();
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario = false;
        usuarioDTO = new UsuarioDTO();
        editando = false;
        usuarioEditandoId = 0;
        _filtroTexto = string.Empty;
        AplicarFiltro();
        StateHasChanged();
    }

    // ═══════════ GUARDAR ═══════════
    private async Task GuardarUsuario()
    {
        if (!editando && !puedeCrear) return;
        if (editando && !puedeEditar) return;

        if (!editando && string.IsNullOrWhiteSpace(usuarioDTO.Password))
        {
            Toast.Error("La contraseña es requerida para nuevos usuarios.");
            return;
        }

        try
        {
            if (editando)
            {
                // ── EDICIÓN: guardar y MANTENER ABIERTO con los datos ──
                var usuarioActualizar = new Usuario
                {
                    Id = usuarioEditandoId,
                    NombreCompleto = usuarioDTO.NombreCompleto,
                    Email = usuarioDTO.Email,
                    PasswordHash = usuarioDTO.Password,
                    Activo = usuarioDTO.Activo,
                    RolId = usuarioDTO.RolId,
                    InstitucionId = usuarioDTO.InstitucionId,
                    EsSuperAdmin = false
                };

                await UsuarioRepository.ActualizarAsync(usuarioActualizar);
                Toast.Exito($"Usuario '{usuarioDTO.NombreCompleto}' actualizado. Puede seguir editando.");
            }
            else
            {
                // ── CREACIÓN: guardar y MANTENER ABIERTO, limpiar form ──
                var usuario = new Usuario
                {
                    NombreCompleto = usuarioDTO.NombreCompleto,
                    Email = usuarioDTO.Email,
                    PasswordHash = usuarioDTO.Password,
                    Activo = usuarioDTO.Activo,
                    RolId = usuarioDTO.RolId,
                    InstitucionId = usuarioDTO.InstitucionId,
                    EsSuperAdmin = false
                };

                await UsuarioRepository.CrearAsync(usuario);
                Toast.Exito($"Usuario '{usuarioDTO.NombreCompleto}' creado. Puede continuar registrando.");

                // Mantener institución y rol para registros masivos
                var institucionActual = usuarioDTO.InstitucionId;
                var rolActual = usuarioDTO.RolId;

                usuarioDTO = new UsuarioDTO
                {
                    Activo = true,
                    InstitucionId = institucionActual,
                    RolId = rolActual
                };

                // Enfocar el primer campo (Nombre)
                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { /* silencioso */ }
            }

            _filtroTexto = string.Empty;
            await CargarUsuarios();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    // ═══════════ EDITAR ═══════════
    private void EditarUsuario(Usuario usuario)
    {
        if (!puedeEditar) return;

        editando = true;
        usuarioEditandoId = usuario.Id;
        _mostrarFormulario = true;

        usuarioDTO = new UsuarioDTO
        {
            Id = usuario.Id,
            NombreCompleto = usuario.NombreCompleto,
            Email = usuario.Email,
            Activo = usuario.Activo,
            RolId = usuario.RolId,
            Password = string.Empty,
            InstitucionId = usuario.InstitucionId
        };

        _filtroTexto = string.Empty;
        AplicarFiltro();

        StateHasChanged();
    }

    // ═══════════ ELIMINAR ═══════════
    private async Task ConfirmarEliminar(int id, string nombre)
    {
        if (!puedeEliminar) return;

        var ok = await Confirm.Peligroso(
            $"¿Eliminar al usuario '{nombre}'? Esta acción no se puede deshacer.");
        if (!ok) return;

        try
        {
            bool eliminado = await UsuarioRepository.EliminarAsync(id);

            if (eliminado)
            {
                Toast.Exito("Usuario eliminado correctamente");
                await CargarUsuarios();
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    // ═══════════ UTILIDADES ═══════════
    private string ObtenerIniciales(string? nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "?";

        var partes = nombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "?";
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();

        return (partes[0].Substring(0, 1) + partes[1].Substring(0, 1)).ToUpper();
    }
}