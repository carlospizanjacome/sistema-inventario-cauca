@page "/entradas"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IEntradaRepository EntradaRepo
@inject IBienRepository BienRepo
@inject IFuncionarioRepository FuncRepo
@inject IProveedorRepository ProveedorRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Entradas · Almacén</PageTitle>

<div class="page-container page-crud">

    @* ═══════════════ PAGE HEADER (oculto cuando el form está abierto) ═══════════════ *@
    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-box-arrow-in-down"></i> Entradas</h1>
                <p class="subtitle">Registro de altas al inventario (FSE, donación, transferencia)</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nueva Entrada
                    </button>
                </div>
            }
        </div>
    }

    @* ═══════════════ FORM COLAPSABLE ═══════════════ *@
    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Entrada" : "Nueva Entrada")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-box-arrow-in-down"></i>
                    <div>
                        <div class="form-header-title">Entradas</div>
                        <div class="form-header-subtitle">Registro de altas al inventario</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="Cancelar" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="entradaEditandoId" Model="entradaDTO" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="bi bi-card-list"></i> Identificación
                    </h4>
                    <div class="form-grid-3">

                        <div class="form-group" style="grid-column: span 2;">
                            <label>Bien *</label>
                            <div class="input-icon">
                                <i class="bi bi-box-seam"></i>
                                <InputSelect class="form-select" @bind-Value="entradaDTO.BienId">
                                    <option value="0">— Seleccione bien —</option>
                                    @foreach (var b in bienes)
                                    {
                                        <option value="@b.Id">@b.Codigo — @b.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <ValidationMessage For="() => entradaDTO.BienId" class="form-error" />
                        </div>

                        <div class="form-group">
                            <label>Tipo Fuente *</label>
                            <div class="input-icon">
                                <i class="bi bi-tag"></i>
                                <InputSelect class="form-select" @bind-Value="entradaDTO.TipoFuente">
                                    <option value="FSE">Compra FSE</option>
                                    <option value="Donacion">Donación</option>
                                    <option value="Transferencia">Transferencia</option>
                                    <option value="Otro">Otro</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Fecha Entrada *</label>
                            <div class="input-icon">
                                <i class="bi bi-calendar-check"></i>
                                <InputDate class="form-control" @bind-Value="entradaDTO.FechaEntrada" />
                            </div>
                            <ValidationMessage For="() => entradaDTO.FechaEntrada" class="form-error" />
                        </div>

                        <div class="form-group">
                            <label>N° Factura</label>
                            <div class="input-icon">
                                <i class="bi bi-receipt"></i>
                                <InputText class="form-control" @bind-Value="entradaDTO.NumeroFactura"
                                           placeholder="Ej: FAC-2025-008" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Proveedor</label>
                            <div class="input-icon">
                                <i class="bi bi-shop"></i>
                                <InputSelect class="form-select" @bind-Value="entradaDTO.ProveedorId">
                                    <option value="">— Sin proveedor —</option>
                                    @foreach (var p in proveedores)
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Valor</label>
                            <div class="input-icon">
                                <i class="bi bi-currency-dollar"></i>
                                <InputNumber class="form-control" @bind-Value="entradaDTO.Valor" min="0" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Recibe (Funcionario)</label>
                            <div class="input-icon">
                                <i class="bi bi-person-check"></i>
                                <InputSelect class="form-select" @bind-Value="entradaDTO.FuncionarioRecibeId">
                                    <option value="">— Sin asignar —</option>
                                    @foreach (var f in funcionarios)
                                    {
                                        <option value="@f.Id">@f.NombreCompleto</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="form-group form-group-full">
                            <label>Observaciones</label>
                            <div class="input-icon">
                                <i class="bi bi-chat-left-text textarea-icon"></i>
                                <InputTextArea class="form-control" rows="2" @bind-Value="entradaDTO.Observaciones"
                                               placeholder="Observaciones sobre la entrada" />
                            </div>
                        </div>

                    </div>
                </div>

                @if (editando && entradaEditandoId > 0)
                {
                    <div class="form-section">
                        <h4 class="form-section-title">
                            <i class="bi bi-paperclip"></i> Soportes
                        </h4>
                        <AdjuntosUploader EntidadTipo="entrada" EntidadId="entradaEditandoId" />
                    </div>
                }

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="Cancelar">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    @* ═══════════════ CARD TABLE ═══════════════ *@
    <div class="card-table">

        @* Barra de filtros *@
        <div class="filtros-toolbar">

            <div class="filtro-busqueda-principal">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por bien, factura o proveedor…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-toolbar-actions">
                <button class="btn-filtros @(_mostrarFiltrosAvanzados ? "active" : "")"
                        @onclick="ToggleFiltrosAvanzados">
                    <i class="bi bi-sliders"></i>
                    <span>Filtros</span>
                    @if (_filtroAvanzado.HayFiltros)
                    {
                        <span class="filtros-badge"></span>
                    }
                    <i class="bi @(_mostrarFiltrosAvanzados ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
        </div>

        @* Filtros avanzados (colapsables) *@
        @if (_mostrarFiltrosAvanzados)
        {
            <div class="panel-filtros">
                <FiltrosMovimiento Filtro="_filtroAvanzado"
                                   OnCambio="AplicarFiltrosAvanzados"
                                   EtiquetaTipo="Fuente"
                                   OpcionesTipo="@(new[] { "FSE", "Donacion", "Transferencia", "Otro" })" />

                <div class="filtros-acciones">
                    <span class="badge-total">
                        <i class="bi bi-box-arrow-in-down"></i>
                        <strong>@(_pagina?.TotalRegistros ?? 0)</strong> entradas
                    </span>
                    @if (_filtroAvanzado.HayFiltros)
                    {
                        <button class="btn-limpiar-filtros" @onclick="LimpiarTodosLosFiltros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Limpiar filtros
                        </button>
                    }
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Bien</th>
                        <th>Fuente</th>
                        <th>Proveedor</th>
                        <th>Factura</th>
                        <th class="text-end">Valor</th>
                        <th>Recibe</th>
                        <th class="text-center" style="width: 110px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Cargando entradas…</td>
                        </tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Sin entradas registradas.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var e in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td class="text-mono">@e.FechaEntrada?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@e.BienNombre</strong>
                                        <small>@e.BienCodigo</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-info">@e.TipoFuente</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(e.ProveedorNombre))
                                    {
                                        <span>@e.ProveedorNombre</span>
                                    }
                                    else if (!string.IsNullOrEmpty(e.Proveedor))
                                    {
                                        <span class="text-muted">@e.Proveedor</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-mono">@e.NumeroFactura</td>
                                <td class="text-end num">@e.Valor.ToString("C0", CulturaCOP)</td>
                                <td>@(e.FuncionarioNombre ?? "—")</td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        @if (puedeEditar)
                                        {
                                            <button class="btn-action btn-action-edit"
                                                    @onclick="() => Editar(e)"
                                                    title="Editar / Adjuntos">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }
                                        @if (puedeEliminar)
                                        {
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => Eliminar(e.Id)"
                                                    title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="EntradaDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo CulturaCOP =
        System.Globalization.CultureInfo.GetCultureInfo("es-CO");

    private ResultadoPaginado<EntradaDTO>? _pagina;

    private IEnumerable<Bien> bienes = [];
    private IEnumerable<FuncionarioDTO> funcionarios = [];
    private IEnumerable<ProveedorDTO> proveedores = [];

    private EntradaDTO entradaDTO = new();
    private bool editando = false;
    private int entradaEditandoId;
    private bool _mostrarFormulario = false;
    private bool _mostrarFiltrosAvanzados = false;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    private FiltroMovimientoDTO _filtroAvanzado = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("entradas.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("entradas.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("entradas.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("entradas.eliminar");

        bienes = await BienRepo.ObtenerTodosAsync();
        funcionarios = await FuncRepo.ObtenerTodosAsync();
        proveedores = await ProveedorRepo.ObtenerTodosAsync();

        await Cargar();
    }

    private async Task Cargar()
    {
        if (_filtroAvanzado.HayFiltros)
        {
            _pagina = await EntradaRepo.ObtenerPaginadoConFiltrosAsync(
                _filtroAvanzado, _paginaActual, _tamanoPagina);
        }
        else
        {
            _pagina = await EntradaRepo.ObtenerPaginadoAsync(
                _paginaActual, _tamanoPagina,
                string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
        }
    }

    private void AbrirFormulario()
    {
        entradaDTO = new EntradaDTO
        {
            FechaEntrada = DateTime.Today,
            TipoFuente = "FSE"
        };
        editando = false;
        entradaEditandoId = 0;
        _mostrarFormulario = true;
        _mostrarFiltrosAvanzados = false;
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
        entradaDTO = new EntradaDTO
        {
            FechaEntrada = DateTime.Today,
            TipoFuente = "FSE"
        };
        editando = false;
        entradaEditandoId = 0;
        _filtroTexto = string.Empty;
        StateHasChanged();
    }

    private void ToggleFiltrosAvanzados()
    {
        if (_mostrarFormulario)
        {
            _mostrarFormulario = false;
            entradaDTO = new EntradaDTO
            {
                FechaEntrada = DateTime.Today,
                TipoFuente = "FSE"
            };
            editando = false;
            entradaEditandoId = 0;
        }

        _mostrarFiltrosAvanzados = !_mostrarFiltrosAvanzados;
    }

    private async Task AplicarFiltrosAvanzados()
    {
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task LimpiarTodosLosFiltros()
    {
        _filtroAvanzado = new FiltroMovimientoDTO();
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para registrar entradas.");
            return;
        }

        if (editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar entradas.");
            return;
        }

        if (entradaDTO.BienId <= 0)
        {
            Toast.Error("Debe seleccionar un bien.");
            return;
        }

        try
        {
            if (editando)
            {
                await EntradaRepo.ActualizarAsync(entradaDTO);
                Toast.Exito("Entrada actualizada correctamente");

                _filtroTexto = string.Empty;
                await Cargar();
                StateHasChanged();
            }
            else
            {
                if (await EntradaRepo.BienTieneEntradaAsync(entradaDTO.BienId))
                {
                    Toast.Error("Este bien ya tiene una entrada registrada.");
                    return;
                }

                await EntradaRepo.CrearAsync(entradaDTO);
                Toast.Exito("Entrada registrada correctamente");

                Cancelar();
                await Cargar();
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(EntradaDTO e)
    {
        if (!puedeEditar) return;

        editando = true;
        entradaEditandoId = e.Id;
        _mostrarFormulario = true;
        _mostrarFiltrosAvanzados = false;

        entradaDTO.Id = e.Id;
        entradaDTO.BienId = e.BienId;
        entradaDTO.TipoFuente = e.TipoFuente;
        entradaDTO.NumeroFactura = e.NumeroFactura;
        entradaDTO.FechaEntrada = e.FechaEntrada;
        entradaDTO.Valor = e.Valor;
        entradaDTO.ProveedorId = e.ProveedorId;
        entradaDTO.Proveedor = e.Proveedor;
        entradaDTO.FuncionarioRecibeId = e.FuncionarioRecibeId;
        entradaDTO.Observaciones = e.Observaciones;

        _filtroTexto = string.Empty;
        StateHasChanged();
    }

    private async Task Eliminar(int id)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar entradas.");
            return;
        }

        var ok = await Confirm.Peligroso("¿Eliminar esta entrada? Esta acción no se puede deshacer.");
        if (!ok) return;

        try
        {
            await EntradaRepo.EliminarAsync(id);
            Toast.Exito("Entrada eliminada correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }
}