@page "/entradas"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IEntradaRepository EntradaRepo
@inject IBienRepository BienRepo
@inject IFuncionarioRepository FuncRepo
@inject IProveedorRepository ProveedorRepo
@inject ISedeRepository SedeRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject AuditoriaService Auditoria
@inject UsuarioSesionService Sesion

<PageTitle>Entradas · Almacén</PageTitle>

<div class="page-container page-crud @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-box-arrow-in-down"></i> Entradas</h1>
                <p class="subtitle">Registro de altas al inventario (FSE, donación, transferencia)</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nueva Entrada
                    </button>
                </div>
            }
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Entrada" : "Nueva Entrada")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-box-arrow-in-down"></i>
                    <div>
                        <div class="form-header-title">Entradas</div>
                        <div class="form-header-subtitle">Registro de altas al inventario</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="Cancelar" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="entradaEditandoId" Model="entradaDTO" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                @* ═══ FILA 1: Bien | Tipo Fuente | Fecha | Sede ═══ *@
                <div class="form-fila-1">
                    <div class="ff-bien">
                        <label>Bien *</label>
                        @if (_bienSeleccionado != null)
                        {
                            <div class="bien-chip">
                                <i class="bi bi-box-seam-fill"></i>
                                <div class="bien-chip-info">
                                    <span class="bien-chip-codigo">@_bienSeleccionado.Codigo</span>
                                    <span class="bien-chip-nombre">@_bienSeleccionado.Nombre</span>
                                </div>
                                @if (!editando)
                                {
                                    <button type="button" class="bien-chip-cambiar" @onclick="CambiarBien" title="Cambiar bien">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bien-buscador">
                                <div class="bien-buscador-input">
                                    <i class="bi bi-search"></i>
                                    <input type="text"
                                           placeholder="Buscar por código o nombre…"
                                           value="@_textoBusquedaBien"
                                           @oninput="OnBusquedaBienInput"
                                           @onfocus="OnBusquedaBienFocus"
                                           @onkeydown="OnBusquedaBienKeyDown"
                                           autocomplete="off" />
                                    @if (!string.IsNullOrWhiteSpace(_textoBusquedaBien))
                                    {
                                        <button type="button" class="bien-buscador-clear"
                                                @onclick="LimpiarBusquedaBien"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>
                                @if (_mostrarDropdownBien)
                                {
                                    <div class="bien-dropdown" @onmousedown:preventDefault="true">
                                        @if (_bienesFiltrados.Any())
                                        {
                                            <div class="bien-dropdown-header">
                                                <span>@_bienesFiltrados.Count resultado(s)</span>
                                            </div>
                                            @foreach (var b in _bienesFiltrados.Take(20))
                                            {
                                                var bien = b;
                                                <button type="button" class="bien-dropdown-item"
                                                        @onclick="() => SeleccionarBienEntrada(bien)"
                                                        @onclick:stopPropagation="true">
                                                    <div class="bien-dropdown-item-top">
                                                        <code>@bien.Codigo</code>
                                                        <strong>@bien.Nombre</strong>
                                                    </div>
                                                    <div class="bien-dropdown-item-bottom">
                                                        @if (!string.IsNullOrWhiteSpace(bien.CategoriaNombre))
                                                        {
                                                            <span>@bien.CategoriaNombre</span>
                                                        }
                                                        <span>@bien.ValorAdquisicion.ToString("C0", CulturaCOP)</span>
                                                    </div>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="bien-dropdown-empty">
                                                <i class="bi bi-search"></i>
                                                <span>Sin resultados para "@_textoBusquedaBien"</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <ValidationMessage For="() => entradaDTO.BienId" class="form-error" />
                    </div>

                    <div class="ff-tipo">
                        <label>Tipo Fuente *</label>
                        <div class="input-icon">
                            <i class="bi bi-tag"></i>
                            <InputSelect class="form-control" @bind-Value="entradaDTO.TipoFuente">
                                <option value="FSE">Compra FSE</option>
                                <option value="Donacion">Donación</option>
                                <option value="Transferencia">Transferencia</option>
                                <option value="Otro">Otro</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="ff-fecha">
                        <label>Fecha Entrada *</label>
                        <div class="input-icon">
                            <i class="bi bi-calendar-check"></i>
                            <InputDate class="form-control" @bind-Value="entradaDTO.FechaEntrada" />
                        </div>
                        <ValidationMessage For="() => entradaDTO.FechaEntrada" class="form-error" />
                    </div>

                    <div class="ff-sede">
                        <label>Sede @(!Sesion.VeTodasLasSedes ? "" : "*")</label>
                        <div class="input-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                            <InputSelect class="form-control"
                                         @bind-Value="entradaDTO.SedeId"
                                         disabled="@(!Sesion.VeTodasLasSedes)">
                                @if (!Sesion.VeTodasLasSedes)
                                {
                                    <option value="@Sesion.SedeId">@Sesion.SedeNombre</option>
                                }
                                else
                                {
                                    <option value="">— Seleccione sede —</option>
                                    @foreach (var s in _sedes)
                                    {
                                        <option value="@s.Id">@s.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                @* ═══ FILA 2: N° Factura | Proveedor | Valor | Recibe ═══ *@
                <div class="form-fila-2">
                    <div class="ff-factura">
                        <label>N° Factura</label>
                        <div class="input-icon">
                            <i class="bi bi-receipt"></i>
                            <InputText class="form-control" @bind-Value="entradaDTO.NumeroFactura"
                                       placeholder="Ej: FAC-2025-008" />
                        </div>
                    </div>

                    <div class="ff-proveedor">
                        <label>Proveedor</label>
                        <div class="input-icon">
                            <i class="bi bi-shop"></i>
                            <InputSelect class="form-control" @bind-Value="entradaDTO.ProveedorId">
                                <option value="">— Sin proveedor —</option>
                                @foreach (var p in proveedores)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="ff-valor">
                        <label>Valor</label>
                        <div class="input-icon">
                            <i class="bi bi-currency-dollar"></i>
                            <InputMoneda class="form-control" @bind-Value="entradaDTO.Valor" />
                        </div>
                    </div>

                    <div class="ff-recibe">
                        <label>Recibe (Funcionario)</label>
                        <div class="input-icon">
                            <i class="bi bi-person-check"></i>
                            <InputSelect class="form-control" @bind-Value="entradaDTO.FuncionarioRecibeId">
                                <option value="">— Sin asignar —</option>
                                @foreach (var f in funcionarios)
                                {
                                    <option value="@f.Id">@f.NombreCompleto</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                @* ═══ FILA 3: Observaciones ═══ *@
                <div class="form-fila-3">
                    <div class="ff-observaciones">
                        <label>Observaciones</label>
                        <div class="input-icon">
                            <i class="bi bi-chat-left-text"></i>
                            <InputText class="form-control" @bind-Value="entradaDTO.Observaciones"
                                       placeholder="Observaciones sobre la entrada" />
                        </div>
                    </div>
                </div>

                @* ═══ Soporte adjuntos ═══ *@
                @if (editando && entradaEditandoId > 0)
                {
                    <div class="form-soportes">
                        <label><i class="bi bi-paperclip"></i> Soportes</label>
                        <AdjuntosUploader EntidadTipo="entrada" EntidadId="entradaEditandoId" />
                    </div>
                }

                @* ═══ FILA 4: Botones ═══ *@
                <div class="form-fila-4">
                    <div class="ff-botones">
                        <button type="button" class="btn btn-cancel" @onclick="Cancelar">
                            <i class="bi bi-x-lg"></i> Cerrar
                        </button>
                        <button type="submit" class="btn btn-save">
                            <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                            @(editando ? "Actualizar" : "Guardar")
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">

        @* ═══ BARRA SUPERIOR ═══ *@
        <div class="filtros-toolbar">
            <div class="filtro-busqueda-principal">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por bien, factura o proveedor…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-toolbar-actions">
                <span class="badge-total">
                    <i class="bi bi-box-arrow-in-down"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> entradas
                    @if (_hayFiltrosActivos)
                    {
                        <span class="filtro-activo-tag">· Filtrado</span>
                    }
                </span>

                <button class="btn-filtros @(_mostrarFiltros ? "active" : "")"
                        @onclick="ToggleFiltros">
                    <i class="bi bi-sliders"></i>
                    <span>Filtros</span>
                    @if (_hayFiltrosAvanzados)
                    {
                        <span class="filtros-badge"></span>
                    }
                    <i class="bi @(_mostrarFiltros ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
        </div>

        @* ═══ PANEL DE FILTROS ═══ *@
        @if (_mostrarFiltros)
        {
            <div class="panel-filtros">
                <div class="filtros-grid">
                    <div class="filtro-select">
                        <i class="bi bi-tag"></i>
                        <select @bind="_filtroTipo" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Todas las fuentes</option>
                            <option value="FSE">Compra FSE</option>
                            <option value="Donacion">Donación</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-calendar"></i>
                        <input type="date" placeholder="Desde" @bind="_filtroFechaDesde" @bind:after="AplicarFiltrosAvanzados" />
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-calendar"></i>
                        <input type="date" placeholder="Hasta" @bind="_filtroFechaHasta" @bind:after="AplicarFiltrosAvanzados" />
                    </div>
                    @if (_hayFiltrosAvanzados)
                    {
                        <button class="btn-limpiar-filtros" @onclick="LimpiarTodosLosFiltros">
                            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
                        </button>
                    }
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Bien</th>
                        <th>Fuente</th>
                        <th>Proveedor</th>
                        <th>Factura</th>
                        <th class="text-end">Valor</th>
                        <th>Recibe</th>
                        <th class="text-center" style="width: 110px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">Cargando entradas…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">Sin entradas registradas.</td></tr>
                    }
                    else
                    {
                        @foreach (var e in _pagina.Items)
                        {
                            <tr class="table-row-hover" @key="e.Id">
                                <td class="text-mono">@e.FechaEntrada?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@e.BienNombre</strong>
                                        <small>@e.BienCodigo</small>
                                    </div>
                                </td>
                                <td><span class="badge badge-info">@e.TipoFuente</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(e.ProveedorNombre))
                                    {
                                        <span>@e.ProveedorNombre</span>
                                    }
                                    else if (!string.IsNullOrEmpty(e.Proveedor))
                                    {
                                        <span class="text-muted">@e.Proveedor</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-mono">@e.NumeroFactura</td>
                                <td class="text-end num">@e.Valor.ToString("C0", CulturaCOP)</td>
                                <td>@(e.FuncionarioNombre ?? "—")</td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        @if (puedeEditar)
                                        {
                                            <button type="button" class="btn-action btn-action-edit" @onclick="() => Editar(e)" title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }
                                        @if (puedeAnular)
                                        {
                                            <button type="button" class="btn-action btn-action-delete" @onclick="() => IntentarAnular(e)" title="Anular">
                                                <i class="bi bi-slash-circle-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0 && !_mostrarFormulario)
        {
            <Paginador T="EntradaDTO" Resultado="_pagina" OnCambioPagina="CambioPagina" OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════
   MODAL — Anular
   ═══════════════════════════════════════════════════════════════ *@
@if (_modalAnulacionAbierto && _itemAAnular is not null)
{
    var e = _itemAAnular;
    <div class="modal-backdrop-det" @onclick="CancelarAnulacion">
        <div class="modal-det" @onclick:stopPropagation="true">
            <div class="modal-det-header">
                <div class="modal-det-header-left">
                    <span class="badge badge-off">Anular entrada</span>
                    <h3>@e.BienNombre</h3>
                </div>
                <button type="button" class="modal-det-close" @onclick="CancelarAnulacion" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-det-body">
                <div class="det-section" style="background: #fffbeb; border-left: 4px solid #f59e0b;">
                    <h4><i class="bi bi-exclamation-triangle-fill"></i> ¿Qué es anular?</h4>
                    <p style="margin: 0;">El registro <strong>NO se elimina</strong>. Se marca como "Anulada" y se excluye de los reportes. El historial queda para auditoría.</p>
                    <p style="margin: 8px 0 0 0; font-size: 0.85rem;"><i class="bi bi-info-circle"></i> <strong>Regla:</strong> solo si es la <strong>última entrada</strong> del bien.</p>
                </div>
                <div class="det-section">
                    <h4><i class="bi bi-info-circle"></i> Entrada a anular</h4>
                    <dl class="det-dl">
                        <dt>Bien</dt><dd><code>@e.BienCodigo</code> — @e.BienNombre</dd>
                        <dt>Fecha</dt><dd>@e.FechaEntrada?.ToString("dd/MM/yyyy")</dd>
                        <dt>Valor</dt><dd>@e.Valor.ToString("C0", CulturaCOP)</dd>
                    </dl>
                </div>
                <div class="form-group form-group-full">
                    <label>Motivo de la anulación *</label>
                    <div class="input-icon">
                        <i class="bi bi-pencil-square"></i>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_motivoAnulacion" placeholder="Ej: Error de digitación..." />
                    </div>
                </div>
            </div>
            <div class="modal-det-footer">
                <button type="button" class="btn-det-cerrar" @onclick="CancelarAnulacion">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <button type="button" class="btn btn-save" @onclick="ConfirmarAnulacionAsync" disabled="@(string.IsNullOrWhiteSpace(_motivoAnulacion))">
                    <i class="bi bi-slash-circle-fill"></i> Confirmar Anulación
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo CulturaCOP = System.Globalization.CultureInfo.GetCultureInfo("es-CO");

    private ResultadoPaginado<EntradaDTO>? _pagina;
    private IEnumerable<Bien> bienes = [];
    private IEnumerable<FuncionarioDTO> funcionarios = [];
    private IEnumerable<ProveedorDTO> proveedores = [];
    private List<SedeDTO> _sedes = new();
    private HashSet<int> _bienesConEntradaIds = new(); // ✅ NUEVO: Guarda los IDs de los bienes que ya tienen entrada

    private EntradaDTO entradaDTO = new();
    private bool editando = false;
    private int entradaEditandoId;
    private bool _mostrarFormulario = false;
    private bool _mostrarFiltros = false;
    private EntradaDTO? _entradaAntesDeEditar;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private string? _filtroTipo;
    private DateTime? _filtroFechaDesde;
    private DateTime? _filtroFechaHasta;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeAnular;

    private bool _modalAnulacionAbierto = false;
    private EntradaDTO? _itemAAnular;
    private string _motivoAnulacion = "";

    private Bien? _bienSeleccionado;
    private string _textoBusquedaBien = string.Empty;
    private bool _mostrarDropdownBien = false;
    private List<Bien> _bienesFiltrados = new();

    private bool _hayFiltrosActivos => !string.IsNullOrEmpty(_filtroTexto) || !string.IsNullOrEmpty(_filtroTipo) || _filtroFechaDesde.HasValue || _filtroFechaHasta.HasValue;
    private bool _hayFiltrosAvanzados => !string.IsNullOrEmpty(_filtroTipo) || _filtroFechaDesde.HasValue || _filtroFechaHasta.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("entradas.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear  = await Seguridad.TienePermisoAsync("entradas.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("entradas.editar");
        puedeAnular = await Seguridad.TienePermisoAsync("entradas.anular");

        // ✅ Cargamos todos los bienes activos
        var todosLosBienes = await BienRepo.ObtenerTodosAsync();
        bienes = todosLosBienes.Where(b => b.Activo).ToList();
        
        // ✅ NUEVO: Cargamos las entradas existentes y guardamos los IDs de los bienes que ya ingresaron
        var entradasExistentes = await EntradaRepo.ObtenerTodasAsync();
        _bienesConEntradaIds = entradasExistentes.Select(e => e.BienId).ToHashSet();

        funcionarios = await FuncRepo.ObtenerTodosAsync();
        proveedores = await ProveedorRepo.ObtenerTodosAsync();
        _sedes = (await SedeRepo.ObtenerTodasAsync()).ToList();
        
        _bienesFiltrados = bienes.Take(20).ToList();

        await Cargar();
    }

    private async Task Cargar()
    {
        var filtro = new FiltroMovimientoDTO
        {
            Texto = string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            Tipo = _filtroTipo,
            FechaDesde = _filtroFechaDesde,
            FechaHasta = _filtroFechaHasta
        };

        if (filtro.HayFiltros)
            _pagina = await EntradaRepo.ObtenerPaginadoConFiltrosAsync(filtro, _paginaActual, _tamanoPagina);
        else
            _pagina = await EntradaRepo.ObtenerPaginadoAsync(_paginaActual, _tamanoPagina, string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
    }

    private void AbrirFormulario()
    {
        entradaDTO = new EntradaDTO
        {
            FechaEntrada = DateTime.Today,
            TipoFuente = "FSE",
            SedeId = Sesion.VeTodasLasSedes ? null : Sesion.SedeId
        };
        editando = false;
        entradaEditandoId = 0;
        _entradaAntesDeEditar = null;
        _mostrarFormulario = true;
        _mostrarFiltros = false;

        _bienSeleccionado = null;
        _textoBusquedaBien = string.Empty;
        _mostrarDropdownBien = false;
        
        // ✅ Filtramos la lista inicial para que no salgan los que ya tienen entrada
        _bienesFiltrados = bienes.Where(b => !_bienesConEntradaIds.Contains(b.Id)).Take(20).ToList();
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
        entradaDTO = new EntradaDTO { FechaEntrada = DateTime.Today, TipoFuente = "FSE" };
        editando = false;
        entradaEditandoId = 0;
        _entradaAntesDeEditar = null;
        _filtroTexto = string.Empty;
        _bienSeleccionado = null;
        _textoBusquedaBien = string.Empty;
        _mostrarDropdownBien = false;
        StateHasChanged();
    }

    private void ToggleFiltros()
    {
        _mostrarFiltros = !_mostrarFiltros;
        if (_mostrarFiltros && _mostrarFormulario)
        {
            _mostrarFormulario = false;
            entradaDTO = new EntradaDTO { FechaEntrada = DateTime.Today, TipoFuente = "FSE" };
            editando = false;
            entradaEditandoId = 0;
            _entradaAntesDeEditar = null;
            _bienSeleccionado = null;
            _textoBusquedaBien = string.Empty;
            _mostrarDropdownBien = false;
        }
    }

    private async Task AplicarFiltrosAvanzados()
    {
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task LimpiarTodosLosFiltros()
    {
        _filtroTexto = string.Empty; _filtroTipo = null; _filtroFechaDesde = null; _filtroFechaHasta = null;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina) { _paginaActual = nuevaPagina; await Cargar(); StateHasChanged(); }
    private async Task CambioTamano(int nuevoTamano) { _tamanoPagina = nuevoTamano; _paginaActual = 1; await Cargar(); StateHasChanged(); }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;
            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro() { _filtroTexto = string.Empty; _paginaActual = 1; await Cargar(); StateHasChanged(); }

    private void OnBusquedaBienFocus() { _mostrarDropdownBien = true; if (string.IsNullOrWhiteSpace(_textoBusquedaBien)) _bienesFiltrados = bienes.Where(b => !_bienesConEntradaIds.Contains(b.Id)).Take(20).ToList(); else FiltrarBienes(); }
    private void OnBusquedaBienInput(ChangeEventArgs e) { _textoBusquedaBien = e.Value?.ToString() ?? string.Empty; _mostrarDropdownBien = true; if (string.IsNullOrWhiteSpace(_textoBusquedaBien)) _bienesFiltrados = bienes.Where(b => !_bienesConEntradaIds.Contains(b.Id)).Take(20).ToList(); else FiltrarBienes(); }

    private void FiltrarBienes()
    {
        var filtro = _textoBusquedaBien.Trim().ToLowerInvariant();
        // ✅ NUEVO: Filtramos por los que NO tienen entrada y luego por texto
        _bienesFiltrados = bienes
            .Where(b => !_bienesConEntradaIds.Contains(b.Id))
            .Where(b => (b.Codigo?.ToLowerInvariant().Contains(filtro) ?? false) || (b.Nombre?.ToLowerInvariant().Contains(filtro) ?? false))
            .OrderBy(b => b.Codigo).ToList();
    }

    private void OnBusquedaBienKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _mostrarDropdownBien = false; return; }
        if (e.Key == "Enter" && _mostrarDropdownBien && _bienesFiltrados.Count > 0) SeleccionarBienEntrada(_bienesFiltrados[0]);
    }

    private void LimpiarBusquedaBien() { _textoBusquedaBien = string.Empty; _bienesFiltrados = bienes.Where(b => !_bienesConEntradaIds.Contains(b.Id)).Take(20).ToList(); _mostrarDropdownBien = true; }
    
    // ✅ BUG 1 y 2 CORREGIDOS: Autocompletar Valor y Sede
    private void SeleccionarBienEntrada(Bien bien) 
    { 
        _bienSeleccionado = bien; 
        entradaDTO.BienId = bien.Id; 
        
        // Autocompletar el valor
        if (bien.ValorAdquisicion > 0)
        {
            entradaDTO.Valor = bien.ValorAdquisicion;
        }

        // Autocompletar la sede (solo si el usuario tiene permisos para ver todas las sedes)
        if (Sesion.VeTodasLasSedes && bien.SedeId.HasValue)
        {
            entradaDTO.SedeId = bien.SedeId;
        }

        _textoBusquedaBien = string.Empty; 
        _bienesFiltrados = new List<Bien>(); 
        _mostrarDropdownBien = false; 
        StateHasChanged(); 
    }
    
    private void CambiarBien() { _bienSeleccionado = null; entradaDTO.BienId = 0; _textoBusquedaBien = string.Empty; _bienesFiltrados = bienes.Where(b => !_bienesConEntradaIds.Contains(b.Id)).Take(20).ToList(); _mostrarDropdownBien = true; StateHasChanged(); }

    private async Task Guardar()
    {
        if (!editando && !puedeCrear) { Toast.Error("No tiene permiso."); return; }
        if (editando && !puedeEditar) { Toast.Error("No tiene permiso."); return; }
        if (entradaDTO.BienId <= 0) { Toast.Error("Debe seleccionar un bien."); return; }

        // ✅ BARRERA DE SEGURIDAD: Validamos en la base de datos antes de guardar (solo si es nueva entrada)
        if (!editando)
        {
            var yaTieneEntrada = await EntradaRepo.BienTieneEntradaAsync(entradaDTO.BienId);
            if (yaTieneEntrada)
            {
                Toast.Error("Este bien ya tiene una entrada registrada. Para moverlo a otra sede, use el módulo de Traslados.");
                return;
            }
        }

        if (!Sesion.VeTodasLasSedes)
            entradaDTO.SedeId = Sesion.SedeId;
        
        if (entradaDTO.SedeId == null)
        {
            Toast.Error("Debe seleccionar una Sede.");
            return;
        }

        try
        {
            if (editando)
            {
                var antes = _entradaAntesDeEditar is null ? null : new { _entradaAntesDeEditar.BienId, _entradaAntesDeEditar.TipoFuente, _entradaAntesDeEditar.NumeroFactura, _entradaAntesDeEditar.FechaEntrada, _entradaAntesDeEditar.Valor, _entradaAntesDeEditar.ProveedorId, _entradaAntesDeEditar.FuncionarioRecibeId, _entradaAntesDeEditar.Observaciones, _entradaAntesDeEditar.SedeId };
                await EntradaRepo.ActualizarAsync(entradaDTO);
                await Auditoria.RegistrarEdicionAsync(modulo: "entradas", objetoTipo: "Entrada", objetoId: entradaDTO.Id, objetoCodigo: entradaDTO.NumeroFactura, objetoDescripcion: $"Entrada de {entradaDTO.TipoFuente}", antes: antes, despues: new { entradaDTO.BienId, entradaDTO.TipoFuente, entradaDTO.NumeroFactura, entradaDTO.FechaEntrada, entradaDTO.Valor, entradaDTO.ProveedorId, entradaDTO.FuncionarioRecibeId, entradaDTO.Observaciones, entradaDTO.SedeId }, motivo: "Edición de entrada");
                Toast.Exito("Entrada actualizada correctamente");
                _filtroTexto = string.Empty;
                await Cargar();
                StateHasChanged();
            }
            else
            {
                await EntradaRepo.CrearAsync(entradaDTO);
                await Auditoria.RegistrarCreacionAsync(modulo: "entradas", objetoTipo: "Entrada", objetoId: entradaDTO.Id, objetoCodigo: entradaDTO.NumeroFactura, objetoDescripcion: $"Entrada de {entradaDTO.TipoFuente}", despues: new { entradaDTO.BienId, entradaDTO.TipoFuente, entradaDTO.NumeroFactura, entradaDTO.FechaEntrada, entradaDTO.Valor, entradaDTO.ProveedorId, entradaDTO.FuncionarioRecibeId, entradaDTO.Observaciones, entradaDTO.SedeId });
                Toast.Exito($"Entrada '{entradaDTO.NumeroFactura}' creada. Puede continuar.");

                // ✅ NUEVO: Al crear, agregamos el bien a la lista negra para que no vuelva a salir
                _bienesConEntradaIds.Add(entradaDTO.BienId);

                var tipoFuenteActual = entradaDTO.TipoFuente;
                var proveedorActual = entradaDTO.ProveedorId;
                var fechaActual = entradaDTO.FechaEntrada;
                var sedeActual = entradaDTO.SedeId;

                entradaDTO = new EntradaDTO { FechaEntrada = fechaActual, TipoFuente = tipoFuenteActual, ProveedorId = proveedorActual, SedeId = sedeActual };
                _bienSeleccionado = null;
                _textoBusquedaBien = string.Empty;
                _mostrarDropdownBien = false;
                
                // ✅ NUEVO: Refrescamos el dropdown con la nueva lista negra
                _bienesFiltrados = bienes.Where(b => !_bienesConEntradaIds.Contains(b.Id)).Take(20).ToList();
                
                try { await JS.InvokeVoidAsync("eval", "setTimeout(() => { const el = document.querySelector('.bien-buscador-input input'); if (el) el.focus(); }, 100);"); } catch { }
                await Cargar();
                StateHasChanged();
            }
        }
        catch (Exception ex) { ErrorHelper.Mostrar(Toast, ex, "la entrada", "guardar"); }
    }

    private void Editar(EntradaDTO e)
    {
        if (!puedeEditar) return;
        editando = true;
        entradaEditandoId = e.Id;
        _entradaAntesDeEditar = e;
        _mostrarFormulario = true;
        _mostrarFiltros = false;
        entradaDTO = new EntradaDTO {
            Id = e.Id, BienId = e.BienId, TipoFuente = e.TipoFuente, NumeroFactura = e.NumeroFactura,
            FechaEntrada = e.FechaEntrada, Valor = e.Valor, ProveedorId = e.ProveedorId, Proveedor = e.Proveedor,
            FuncionarioRecibeId = e.FuncionarioRecibeId, Observaciones = e.Observaciones, SedeId = e.SedeId
        };
        _bienSeleccionado = bienes.FirstOrDefault(b => b.Id == e.BienId);
        _textoBusquedaBien = string.Empty;
        _mostrarDropdownBien = false;
        _bienesFiltrados = bienes.Take(20).ToList();
        _filtroTexto = string.Empty;
        StateHasChanged();
    }

    private async Task IntentarAnular(EntradaDTO e)
    {
        if (!puedeAnular) { Toast.Error("No tiene permiso."); return; }
        try {
            var esUltima = await EntradaRepo.EsUltimaEntradaAsync(e.Id);
            if (!esUltima) { Toast.Warning("No se puede anular: hay entradas o movimientos posteriores."); return; }
        } catch (Exception ex) { ErrorHelper.Mostrar(Toast, ex, "la entrada", "verificar"); return; }
        _itemAAnular = e;
        _motivoAnulacion = "";
        _modalAnulacionAbierto = true;
        StateHasChanged();
    }

    private void CancelarAnulacion() { _modalAnulacionAbierto = false; _itemAAnular = null; _motivoAnulacion = ""; }

    private async Task ConfirmarAnulacionAsync()
    {
        if (_itemAAnular is null) return;
        if (string.IsNullOrWhiteSpace(_motivoAnulacion)) { Toast.Warning("Debe ingresar un motivo."); return; }
        try {
            await EntradaRepo.AnularAsync(_itemAAnular.Id, _motivoAnulacion);
            await Auditoria.RegistrarAnulacionAsync(modulo: "entradas", objetoTipo: "Entrada", objetoId: _itemAAnular.Id, objetoCodigo: _itemAAnular.NumeroFactura, objetoDescripcion: $"Anulación de entrada para '{_itemAAnular.BienNombre}'", antes: new { _itemAAnular.BienId, _itemAAnular.TipoFuente, _itemAAnular.NumeroFactura, _itemAAnular.Valor, Anulada = false }, despues: new { Anulada = true, Motivo = _motivoAnulacion, AnuladaPor = Sesion.UsuarioActual?.Id, AnuladaFecha = DateTime.Now }, motivo: _motivoAnulacion);
            Toast.Exito("Entrada anulada correctamente.");
            
            // ✅ NUEVO: Al anular una entrada, el bien vuelve a estar disponible para una nueva entrada
            if (_itemAAnular.BienId > 0)
            {
                _bienesConEntradaIds.Remove(_itemAAnular.BienId);
            }

            CancelarAnulacion();
            await Cargar();
            StateHasChanged();
        } catch (InvalidOperationException iex) { Toast.Warning(iex.Message); } catch (Exception ex) { ErrorHelper.Mostrar(Toast, ex, "la entrada", "anular"); }
    }
}