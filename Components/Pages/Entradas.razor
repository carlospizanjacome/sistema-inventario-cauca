@page "/entradas"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IEntradaRepository EntradaRepo
@inject IBienRepository BienRepo
@inject IFuncionarioRepository FuncRepo
@inject IProveedorRepository ProveedorRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm


<PageTitle>Entradas · Almacén</PageTitle>

<div class="usuarios-page usuarios-fullscreen">

    <div class="modern-card panel-formulario">

        <div class="card-top-compact d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
            <div class="card-icon-small-inline">
                <i class="bi @(editando ? "bi-pencil-square" : "bi-box-arrow-in-down")" style="color: #4f46e5; font-size: 1.1rem;"></i>
            </div>
            <div class="d-flex align-items-baseline gap-2">
                <h5 class="m-0 fw-bold text-dark" style="font-size: 1rem;">@(editando ? "Editar Entrada" : "Nueva Entrada")</h5>
                <span class="text-muted d-none d-sm-inline" style="font-size: 0.75rem;">| Registro de altas al inventario</span>
            </div>
        </div>

        <EditForm @key="entradaEditandoId" Model="entradaDTO" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="container-fluid p-0">

                <!-- FILA 1 -->
                <div class="row g-2 mb-2">
                    <div class="col-md-5">
                        <div class="modern-group">
                            <label>Bien *</label>
                            <div class="input-modern">
                                <i class="bi bi-box-seam"></i>
                                <InputSelect class="form-select" @bind-Value="entradaDTO.BienId">
                                    <option value="0">— Seleccione bien —</option>
                                    @foreach (var b in bienes)
                                    {
                                        <option value="@b.Id">@b.Codigo — @b.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <ValidationMessage For="() => entradaDTO.BienId" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="modern-group">
                            <label>Tipo Fuente *</label>
                            <div class="input-modern">
                                <i class="bi bi-tag"></i>
                                <InputSelect class="form-select" @bind-Value="entradaDTO.TipoFuente">
                                    <option value="FSE">Compra FSE</option>
                                    <option value="Donacion">Donación</option>
                                    <option value="Transferencia">Transferencia</option>
                                    <option value="Otro">Otro</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>Fecha Entrada *</label>
                            <div class="input-modern">
                                <i class="bi bi-calendar-check"></i>
                                <InputDate class="form-control" @bind-Value="entradaDTO.FechaEntrada" />
                            </div>
                            <ValidationMessage For="() => entradaDTO.FechaEntrada" />
                        </div>
                    </div>
                </div>

                <!-- FILA 2 -->
                <div class="row g-2 mb-2">
                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>N° Factura</label>
                            <div class="input-modern">
                                <i class="bi bi-receipt"></i>
                                <InputText class="form-control" @bind-Value="entradaDTO.NumeroFactura" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="modern-group">
                            <label>Proveedor</label>
                            <div class="input-modern">
                                <i class="bi bi-shop"></i>
                                <InputSelect class="form-select" @bind-Value="entradaDTO.ProveedorId">
                                    <option value="">— Sin proveedor —</option>
                                    @foreach (var p in proveedores)
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="modern-group">
                            <label>Valor</label>
                            <div class="input-modern">
                                <i class="bi bi-currency-dollar"></i>
                                <InputNumber class="form-control" @bind-Value="entradaDTO.Valor" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>Recibe (Funcionario)</label>
                            <div class="input-modern">
                                <i class="bi bi-person-check"></i>
                                <InputSelect class="form-select" @bind-Value="entradaDTO.FuncionarioRecibeId">
                                    <option value="">— Sin asignar —</option>
                                    @foreach (var f in funcionarios)
                                    {
                                        <option value="@f.Id">@f.NombreCompleto</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FILA 3 -->
                <div class="row g-2 mb-2">
                    <div class="col-md-12">
                        <div class="modern-group">
                            <label>Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="entradaDTO.Observaciones" />
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-3 justify-content-end">
                @if (editando)
                {
                    <button type="button" class="btn btn-cancel px-4" @onclick="Cancelar">
                        <i class="bi bi-x-circle me-2"></i> Cancelar
                    </button>
                }
                <button type="submit" class="btn btn-save px-4">
                    <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill") me-2"></i>
                    @(editando ? "Actualizar Entrada" : "Guardar Entrada")
                </button>
            </div>
        </EditForm>

        @if (editando && entradaEditandoId > 0)
        {
        <div class="mt-3">
            <AdjuntosUploader EntidadTipo="entrada" EntidadId="entradaEditandoId" />
        </div>
        }
    </div>

    <!-- ═══════════ TABLA CON PAGINACIÓN ═══════════ -->
    <div class="modern-card panel-tabla-elastic position-relative">

        <!-- Barra de búsqueda -->
        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por bien, factura o proveedor…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
            <div class="filtro-info">
                <span class="badge-total">
                    <i class="bi bi-arrow-down-circle"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> entradas
                </span>
            </div>
        </div>

        <div class="table-responsive style-scrollbar">
            <table class="table modern-table align-middle m-0">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Bien</th>
                        <th>Fuente</th>
                        <th>Proveedor</th>
                        <th>Factura</th>
                        <th class="text-end">Valor</th>
                        <th>Recibe</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="8" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Cargando...
                        </td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center py-3 text-muted">Sin entradas registradas.</td></tr>
                    }
                    else
                    {
                        @foreach (var e in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td>@e.FechaEntrada?.ToString("dd/MM/yyyy")</td>
                                <td><code>@e.BienCodigo</code> @e.BienNombre</td>
                                <td>
                                    <span class="badge bg-info text-dark">@e.TipoFuente</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(e.ProveedorNombre))
                                    {
                                        <span>@e.ProveedorNombre</span>
                                    }
                                    else if (!string.IsNullOrEmpty(e.Proveedor))
                                    {
                                        <span class="text-muted">@e.Proveedor</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@e.NumeroFactura</td>
                                <td class="text-end">@e.Valor.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-CO"))</td>
                                <td>@(e.FuncionarioNombre ?? "—")</td>
                                <td class="text-center">
                                    @if (puedeEditar)
                                    {
                                        <button class="btn-icon me-1" @onclick="() => Editar(e)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        <button class="btn-icon danger" @onclick="() => Eliminar(e.Id)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="EntradaDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    // ── Datos paginados ──
    private ResultadoPaginado<EntradaDTO>? _pagina;

    // ── Catálogos ──
    private IEnumerable<Bien> bienes = [];
    private IEnumerable<FuncionarioDTO> funcionarios = [];
    private IEnumerable<ProveedorDTO> proveedores = [];

    // ── Formulario ──
    private EntradaDTO entradaDTO = new();
    private bool editando = false;
    private int entradaEditandoId;

    // ── Paginación ──
    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    // ── Permisos ──
    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("entradas.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("entradas.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("entradas.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("entradas.eliminar");

        bienes = await BienRepo.ObtenerTodosAsync();
        funcionarios = await FuncRepo.ObtenerTodosAsync();
        proveedores = await ProveedorRepo.ObtenerTodosAsync();

        await Cargar();
    }

    private async Task Cargar()
    {
        _pagina = await EntradaRepo.ObtenerPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para registrar entradas.");
            return;
        }

        if (editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar entradas.");
            return;
        }

        if (entradaDTO.BienId <= 0)
        {
            Toast.Error("Debe seleccionar un bien.");
            return;
        }

        try
        {
            if (editando)
            {
                await EntradaRepo.ActualizarAsync(entradaDTO);
                Toast.Exito("Entrada actualizada correctamente");
            }
            else
            {
                if (await EntradaRepo.BienTieneEntradaAsync(entradaDTO.BienId))
                {
                    Toast.Error("Este bien ya tiene una entrada registrada.");
                    return;
                }

                await EntradaRepo.CrearAsync(entradaDTO);
                Toast.Exito("Entrada registrada correctamente");
            }

            Cancelar();
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(EntradaDTO e)
    {
        if (!puedeEditar) return;

        editando = true;
        entradaEditandoId = e.Id;

        entradaDTO.Id = e.Id;
        entradaDTO.BienId = e.BienId;
        entradaDTO.TipoFuente = e.TipoFuente;
        entradaDTO.NumeroFactura = e.NumeroFactura;
        entradaDTO.FechaEntrada = e.FechaEntrada;
        entradaDTO.Valor = e.Valor;
        entradaDTO.ProveedorId = e.ProveedorId;
        entradaDTO.Proveedor = e.Proveedor;
        entradaDTO.FuncionarioRecibeId = e.FuncionarioRecibeId;
        entradaDTO.Observaciones = e.Observaciones;

        StateHasChanged();
    }

    private async Task Eliminar(int id)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar entradas.");
            return;
        }

        var ok = await Confirm.Peligroso("¿Eliminar esta entrada? Esta acción no se puede deshacer.");
        if (!ok) return;

        try
        {
            await EntradaRepo.EliminarAsync(id);
            Toast.Exito("Entrada eliminada correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Cancelar()
    {
        entradaDTO = new EntradaDTO
        {
            FechaEntrada = DateTime.Today,
            TipoFuente = "FSE"
        };
        editando = false;
        entradaEditandoId = 0;
        StateHasChanged();
    }
}