@page "/bienes"
@rendermode InteractiveServer

@using Almacen.Models
@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IBienRepository BienRepository
@inject ICategoriaRepository CategoriaRepository
@inject IAulaRepository AulaRepository
@inject IFuncionarioRepository FuncionarioRepository
@inject IVidaUtilRepository VidaUtilRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject ExcelExportService ExcelService
@inject UsuarioSesionService Sesion
@inject IInstitucionRepository InstRepo

<PageTitle>Bienes · Almacén</PageTitle>

<div class="page-container page-crud">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-box-seam"></i> Bienes</h1>
                <p class="subtitle">Catálogo de bienes devolutivos y de consumo</p>
            </div>

            <div class="header-actions">
                @if (puedeCrear)
                {
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nuevo Bien
                    </button>
                }
            </div>
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Bien" : "Nuevo Bien")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-box-seam"></i>
                    <div>
                        <div class="form-header-title">Bienes</div>
                        <div class="form-header-subtitle">Catálogo de bienes devolutivos y de consumo</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="CerrarFormulario" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="bienEditandoId" Model="bienDTO" OnValidSubmit="GuardarBien">
                <DataAnnotationsValidator />

                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="bi bi-card-list"></i> Identificación
                    </h4>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label>Código *</label>
                            <div class="input-icon">
                                <i class="bi bi-upc-scan"></i>
                                <InputText class="form-control" @bind-Value="bienDTO.Codigo" placeholder="Ej: 4555" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Nombre *</label>
                            <div class="input-icon">
                                <i class="bi bi-box-fill"></i>
                                <InputText class="form-control" @bind-Value="bienDTO.Nombre" placeholder="Ej: Monitor Asus" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Categoría *</label>
                            <div class="input-icon">
                                <i class="bi bi-tags-fill"></i>
                                <InputSelect class="form-control" @bind-Value="bienDTO.CategoriaId">
                                    <option value="">Seleccione categoría</option>
                                    @foreach (var cat in categorias)
                                    {
                                        <option value="@cat.Id">@cat.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Tipo Bien *</label>
                            <div class="input-icon">
                                <i class="bi bi-boxes"></i>
                                <InputSelect class="form-control" @bind-Value="bienDTO.TipoBien">
                                    <option value="devolutivo">Devolutivo</option>
                                    <option value="consumo">Consumo</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Marca</label>
                            <div class="input-icon">
                                <i class="bi bi-building"></i>
                                <InputText class="form-control" @bind-Value="bienDTO.Marca" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Modelo</label>
                            <div class="input-icon">
                                <i class="bi bi-cpu"></i>
                                <InputText class="form-control" @bind-Value="bienDTO.Modelo" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Serie</label>
                            <div class="input-icon">
                                <i class="bi bi-upc"></i>
                                <InputText class="form-control" @bind-Value="bienDTO.Serie" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Valor Adquisición</label>
                            <div class="input-icon">
                                <i class="bi bi-currency-dollar"></i>
                                <InputNumber class="form-control" @bind-Value="bienDTO.ValorAdquisicion" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Cantidad</label>
                            <div class="input-icon">
                                <i class="bi bi-hash"></i>
                                <InputNumber class="form-control" @bind-Value="bienDTO.Cantidad" min="1" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="bi bi-geo-alt"></i> Ubicación y Responsable
                    </h4>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label>Ubicación (Aula)</label>
                            <div class="input-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                                <InputSelect class="form-control" @bind-Value="bienDTO.AulaId">
                                    <option value="">— Sin asignar —</option>
                                    @foreach (var a in aulas)
                                    {
                                        <option value="@a.Id">@a.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Responsable</label>
                            <div class="input-icon">
                                <i class="bi bi-person-fill"></i>
                                <InputSelect class="form-control" @bind-Value="bienDTO.FuncionarioId">
                                    <option value="">— Sin asignar —</option>
                                    @foreach (var f in funcionarios)
                                    {
                                        <option value="@f.Id">@f.NombreCompleto (@f.Cedula)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Estado Físico</label>
                            <div class="input-icon">
                                <i class="bi bi-heart-pulse-fill"></i>
                                <InputSelect class="form-control" @bind-Value="bienDTO.EstadoFisico">
                                    <option value="bueno">Bueno</option>
                                    <option value="regular">Regular</option>
                                    <option value="malo">Malo</option>
                                    <option value="baja">Baja</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </div>

                @if (bienDTO.TipoBien == "devolutivo")
                {
                    <div class="form-section">
                        <h4 class="form-section-title">
                            <i class="bi bi-calculator"></i> Depreciación
                        </h4>
                        <div class="form-grid-3">
                            <div class="form-group">
                                <label>Fecha Adquisición</label>
                                <div class="input-icon">
                                    <i class="bi bi-calendar-check"></i>
                                    <InputDate class="form-control" @bind-Value="bienDTO.FechaAdquisicion" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Vida Útil (Tabla CGN)</label>
                                <div class="input-icon">
                                    <i class="bi bi-clock-history"></i>
                                    <InputSelect class="form-control" @bind-Value="bienDTO.VidaUtilId">
                                        <option value="">— Sin asignar —</option>
                                        @foreach (var v in vidasUtiles)
                                        {
                                            <option value="@v.Id">@v.NombreCompleto</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Valor Residual</label>
                                <div class="input-icon">
                                    <i class="bi bi-piggy-bank"></i>
                                    <InputNumber class="form-control" @bind-Value="bienDTO.ValorResidual" />
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="bi bi-chat-left-text"></i> Observaciones
                    </h4>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Descripción</label>
                            <div class="input-icon">
                                <i class="bi bi-card-text"></i>
                                <InputTextArea class="form-control" rows="3"
                                               @bind-Value="bienDTO.Descripcion"
                                               placeholder="Descripción detallada…" />
                            </div>
                        </div>
                        <div class="form-group checkbox-group">
                            <label>
                                <InputCheckbox @bind-Value="bienDTO.Activo" />
                                Bien Activo
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="CerrarFormulario">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">

        <div class="filtros-toolbar">
            <div class="filtro-busqueda-principal">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por código, nombre, marca o serie…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-toolbar-actions">
                <button class="btn-filtros @(_mostrarFiltros ? "active" : "")"
                        @onclick="ToggleFiltros">
                    <i class="bi bi-sliders"></i>
                    <span>Filtros</span>
                    @if (_hayFiltrosAvanzados)
                    {
                        <span class="filtros-badge"></span>
                    }
                    <i class="bi @(_mostrarFiltros ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>

                <button class="btn-export-cgn" @onclick="ExportarExcel" disabled="@(_exportando)">
                    <i class="bi @(_exportando ? "bi-hourglass-split" : "bi-download")"></i>
                    <span>@(_exportando ? "Generando…" : "Exportar")</span>
                </button>
            </div>
        </div>

        @if (_mostrarFiltros)
        {
            <div class="panel-filtros">
                <div class="filtros-grid">
                    <div class="filtro-select">
                        <i class="bi bi-tags"></i>
                        <select @bind="_filtroCategoriaId" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Todas las categorías</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-boxes"></i>
                        <select @bind="_filtroTipoBien" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Todos los tipos</option>
                            <option value="devolutivo">Devolutivo</option>
                            <option value="consumo">Consumo</option>
                        </select>
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-heart-pulse"></i>
                        <select @bind="_filtroEstadoFisico" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Todos los estados</option>
                            <option value="bueno">Bueno</option>
                            <option value="regular">Regular</option>
                            <option value="malo">Malo</option>
                            <option value="baja">Baja</option>
                        </select>
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-check-circle"></i>
                        <select @bind="_filtroActivo" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Activos e inactivos</option>
                            <option value="true">Solo activos</option>
                            <option value="false">Solo inactivos</option>
                        </select>
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-geo-alt"></i>
                        <select @bind="_filtroAulaId" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Todas las aulas</option>
                            @foreach (var a in aulas)
                            {
                                <option value="@a.Id">@a.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-person"></i>
                        <select @bind="_filtroFuncionarioId" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Todos los responsables</option>
                            @foreach (var f in funcionarios)
                            {
                                <option value="@f.Id">@f.NombreCompleto</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="filtros-acciones">
                    <span class="badge-total">
                        <i class="bi bi-box-seam"></i>
                        <strong>@(_pagina?.TotalRegistros ?? 0)</strong> bienes
                        @if (_hayFiltrosActivos)
                        {
                            <span class="filtro-activo-tag">· Filtrado</span>
                        }
                    </span>
                    @if (_hayFiltrosAvanzados)
                    {
                        <button class="btn-limpiar-filtros" @onclick="LimpiarTodosLosFiltros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Limpiar filtros
                        </button>
                    }
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Bien</th>
                        <th>Tipo</th>
                        <th class="text-center">Cant.</th>
                        <th>Ubicación</th>
                        <th>Responsable</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="8" class="text-center py-3 text-muted">Cargando bienes…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center py-3 text-muted">Sin bienes para mostrar.</td></tr>
                    }
                    else
                    {
                        @foreach (var bien in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td><code>@bien.Codigo</code></td>
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@bien.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(bien.CategoriaNombre))
                                        {
                                            <small>@bien.CategoriaNombre</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(bien.TipoBien == "devolutivo" ? "badge-tipo-devolutivo" : "badge-tipo-consumo")">
                                        @bien.TipoBien
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-neutral">@bien.Cantidad</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(bien.AulaNombre))
                                    {
                                        <span>@bien.AulaNombre</span>
                                    }
                                    else if (!string.IsNullOrEmpty(bien.Ubicacion))
                                    {
                                        <span class="text-muted">@bien.Ubicacion</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(bien.FuncionarioNombre))
                                    {
                                        <span>@bien.FuncionarioNombre</span>
                                    }
                                    else if (!string.IsNullOrEmpty(bien.Responsable))
                                    {
                                        <span class="text-muted">@bien.Responsable</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(bien.Activo ? "badge-ok" : "badge-off")">
                                        @(bien.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (puedeEditar)
                                    {
                                        <button class="btn-icon me-1" @onclick="() => Editar(bien)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        <button class="btn-icon danger" @onclick="() => Eliminar(bien.Id, bien.Nombre)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="Bien"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private bool _mostrarFormulario = false;
    private BienDTO bienDTO = new();
    private bool editando;
    private int bienEditandoId;

    private ResultadoPaginado<Bien>? _pagina;
    private List<Categoria> categorias = new();
    private List<AulaDTO> aulas = new();
    private List<FuncionarioDTO> funcionarios = new();
    private List<VidaUtilDTO> vidasUtiles = new();

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    private bool _exportando = false;

    private bool _mostrarFiltros = false;
    private string? _filtroCategoriaId;
    private string? _filtroTipoBien;
    private string? _filtroEstadoFisico;
    private string? _filtroActivo;
    private string? _filtroAulaId;
    private string? _filtroFuncionarioId;

    private bool _hayFiltrosActivos =>
        !string.IsNullOrEmpty(_filtroTexto) ||
        !string.IsNullOrEmpty(_filtroCategoriaId) ||
        !string.IsNullOrEmpty(_filtroTipoBien) ||
        !string.IsNullOrEmpty(_filtroEstadoFisico) ||
        !string.IsNullOrEmpty(_filtroActivo) ||
        !string.IsNullOrEmpty(_filtroAulaId) ||
        !string.IsNullOrEmpty(_filtroFuncionarioId);

    private bool _hayFiltrosAvanzados =>
        !string.IsNullOrEmpty(_filtroCategoriaId) ||
        !string.IsNullOrEmpty(_filtroTipoBien) ||
        !string.IsNullOrEmpty(_filtroEstadoFisico) ||
        !string.IsNullOrEmpty(_filtroActivo) ||
        !string.IsNullOrEmpty(_filtroAulaId) ||
        !string.IsNullOrEmpty(_filtroFuncionarioId);

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("bienes.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("bienes.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("bienes.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("bienes.eliminar");

        var t1 = CategoriaRepository.ObtenerTodosAsync();
        var t2 = AulaRepository.ObtenerTodasAsync();
        var t3 = FuncionarioRepository.ObtenerTodosAsync();
        var t4 = VidaUtilRepo.ObtenerTodosAsync();

        await Task.WhenAll(t1, t2, t3, t4);

        categorias = (await t1).ToList();
        aulas = (await t2).ToList();
        funcionarios = (await t3).ToList();
        vidasUtiles = (await t4).ToList();

        await CargarBienes();
    }

    private void AbrirFormulario()
    {
        bienDTO = new BienDTO
        {
            Activo = true,
            TipoBien = "devolutivo",
            EstadoFisico = "bueno",
            Cantidad = 1
        };
        editando = false;
        bienEditandoId = 0;
        _mostrarFormulario = true;
        _mostrarFiltros = false;
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario = false;
        bienDTO = new();
        editando = false;
        bienEditandoId = 0;
        StateHasChanged();
    }

    private void ToggleFiltros()
    {
        if (_mostrarFormulario)
        {
            _mostrarFormulario = false;
            bienDTO = new();
            editando = false;
            bienEditandoId = 0;
        }

        _mostrarFiltros = !_mostrarFiltros;
    }

    private async Task CargarBienes()
    {
        int? categoriaId = int.TryParse(_filtroCategoriaId, out var c) ? c : null;
        int? aulaId = int.TryParse(_filtroAulaId, out var a) ? a : null;
        int? funcionarioId = int.TryParse(_filtroFuncionarioId, out var f) ? f : null;
        bool? activo = bool.TryParse(_filtroActivo, out var act) ? act : null;

        if (_hayFiltrosAvanzados)
        {
            _pagina = await BienRepository.ObtenerPaginadoConFiltrosAsync(
                new FiltroBienDTO
                {
                    CategoriaId = categoriaId,
                    TipoBien = _filtroTipoBien,
                    EstadoFisico = _filtroEstadoFisico,
                    Activo = activo,
                    AulaId = aulaId,
                    FuncionarioId = funcionarioId
                },
                _paginaActual,
                _tamanoPagina);
        }
        else
        {
            _pagina = await BienRepository.ObtenerPaginadoAsync(
                _paginaActual,
                _tamanoPagina,
                string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
        }
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await CargarBienes();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await CargarBienes();
        StateHasChanged();
    }

    private async Task AplicarFiltrosAvanzados()
    {
        _paginaActual = 1;
        await CargarBienes();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await CargarBienes();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await CargarBienes();
        StateHasChanged();
    }

    private async Task LimpiarTodosLosFiltros()
    {
        _filtroTexto = string.Empty;
        _filtroCategoriaId = null;
        _filtroTipoBien = null;
        _filtroEstadoFisico = null;
        _filtroActivo = null;
        _filtroAulaId = null;
        _filtroFuncionarioId = null;
        _paginaActual = 1;
        await CargarBienes();
        StateHasChanged();
    }

    private async Task GuardarBien()
    {
        if (!editando && !puedeCrear) return;
        if (editando && !puedeEditar) return;

        try
        {
            var bien = new Bien
            {
                Id = bienEditandoId,
                Codigo = bienDTO.Codigo,
                Nombre = bienDTO.Nombre,
                Descripcion = bienDTO.Descripcion,
                CategoriaId = bienDTO.CategoriaId,
                TipoBien = bienDTO.TipoBien,
                Marca = bienDTO.Marca,
                Modelo = bienDTO.Modelo,
                Serie = bienDTO.Serie,
                ValorAdquisicion = bienDTO.ValorAdquisicion,
                FechaAdquisicion = bienDTO.FechaAdquisicion,
                EstadoFisico = string.IsNullOrWhiteSpace(bienDTO.EstadoFisico) ? "bueno" : bienDTO.EstadoFisico.ToLower(),
                Activo = bienDTO.Activo,
                AulaId = bienDTO.AulaId,
                FuncionarioId = bienDTO.FuncionarioId,
                InstitucionId = bienDTO.InstitucionId,
                VidaUtilId = bienDTO.VidaUtilId,
                CodigoQr = bienDTO.CodigoQr,
                ValorResidual = bienDTO.ValorResidual,
                Cantidad = bienDTO.Cantidad > 0 ? bienDTO.Cantidad : 1,
                Ubicacion = bienDTO.Ubicacion,
                Responsable = bienDTO.Responsable
            };

            if (editando)
            {
                // ── EDICIÓN: guardar y MANTENER ABIERTO para seguir editando ──
                await BienRepository.ActualizarAsync(bien);
                Toast.Exito($"Bien '{bien.Nombre}' actualizado. Puede seguir editando.");
            }
            else
            {
                // ── CREACIÓN: guardar y MANTENER ABIERTO para seguir registrando ──
                await BienRepository.CrearAsync(bien);
                Toast.Exito($"Bien '{bien.Nombre}' creado. Puede continuar registrando.");

                var tipoActual = bienDTO.TipoBien;
                var estadoActual = bienDTO.EstadoFisico;
                var categoriaActual = bienDTO.CategoriaId;
                var aulaActual = bienDTO.AulaId;
                var funcionarioActual = bienDTO.FuncionarioId;

                bienDTO = new BienDTO
                {
                    Activo = true,
                    TipoBien = tipoActual,
                    EstadoFisico = estadoActual,
                    Cantidad = 1,
                    CategoriaId = categoriaActual,
                    AulaId = aulaActual,
                    FuncionarioId = funcionarioActual
                };

                await JS.InvokeVoidAsync("eval",
                    "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
            }

            await CargarBienes();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(Bien bien)
    {
        editando = true;
        bienEditandoId = bien.Id;
        _mostrarFormulario = true;
        _mostrarFiltros = false;

        bienDTO = new BienDTO
        {
            Id = bien.Id,
            Codigo = bien.Codigo,
            Nombre = bien.Nombre,
            Descripcion = bien.Descripcion,
            CategoriaId = bien.CategoriaId,
            TipoBien = bien.TipoBien,
            Marca = bien.Marca,
            Modelo = bien.Modelo,
            Serie = bien.Serie,
            ValorAdquisicion = bien.ValorAdquisicion,
            FechaAdquisicion = bien.FechaAdquisicion,
            EstadoFisico = bien.EstadoFisico,
            Activo = bien.Activo,
            AulaId = bien.AulaId,
            FuncionarioId = bien.FuncionarioId,
            InstitucionId = bien.InstitucionId,
            VidaUtilId = bien.VidaUtilId,
            CodigoQr = bien.CodigoQr,
            ValorResidual = bien.ValorResidual,
            Cantidad = bien.Cantidad,
            Ubicacion = bien.Ubicacion,
            Responsable = bien.Responsable
        };

        StateHasChanged();
    }

    private async Task Eliminar(int id, string nombre)
    {
        var ok = await Confirm.Peligroso(
            $"¿Eliminar el bien '{nombre}'? Esta acción no se puede deshacer.");
        if (!ok) return;

        try
        {
            await BienRepository.EliminarAsync(id);
            Toast.Exito("Bien eliminado correctamente");
            await CargarBienes();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private async Task ExportarExcel()
    {
        _exportando = true;
        StateHasChanged();

        try
        {
            var todos = (await BienRepository.ObtenerTodosAsync()).ToList();

            if (!todos.Any())
            {
                Toast.Warning("No hay bienes para exportar.");
                return;
            }

            var institucion = await InstRepo.ObtenerPorIdAsync(Sesion.InstitucionId);
            var nombreInst = institucion?.Nombre ?? "Institución no identificada";

            var bytes = ExcelService.ExportarInventarioCGN(
                nombreInst,
                Sesion.UsuarioActual?.NombreCompleto ?? "N/A",
                todos);

            var nombreArchivo = $"InventarioCGN_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await JS.InvokeVoidAsync("descargarArchivo",
                Convert.ToBase64String(bytes),
                nombreArchivo,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Toast.Exito($"Excel generado con {todos.Count} bienes");
        }
        catch (Exception ex)
        {
            Toast.Error($"Error al exportar: {ex.Message}");
        }
        finally
        {
            _exportando = false;
            StateHasChanged();
        }
    }
}