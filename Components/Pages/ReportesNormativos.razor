@page "/reportes-normativos"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@using Almacen.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Globalization

@inject IReporteNormativoRepository RepoNorm
@inject IBienRepository BienRepo
@inject PlantillaNormativaService PlantillaService
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject IJSRuntime JS
@inject AuditoriaService Auditoria
@inject UsuarioSesionService Sesion

<PageTitle>Reportes Normativos · Almacén</PageTitle>

<div class="page-container page-crud page-reportes-normativos @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-file-earmark-bar-graph"></i> Matriz de Reportes Normativos</h1>
                <p class="subtitle">Catálogo de obligaciones de reporte (V2.0 §19)</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nuevo Reporte
                    </button>
                </div>
            }
        </div>

        <section class="kpi-grid">
            <div class="kpi-card kpi-orange kpi-clicable" @onclick="FiltrarBorradores">
                <div class="kpi-icon"><i class="bi bi-pencil-square"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Borradores</span>
                    <span class="kpi-value">@_metricas.Borradores</span>
                </div>
            </div>
            <div class="kpi-card kpi-green kpi-clicable" @onclick="FiltrarVigentes">
                <div class="kpi-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Vigentes</span>
                    <span class="kpi-value">@_metricas.Vigentes</span>
                </div>
            </div>
            <div class="kpi-card kpi-red kpi-clicable" @onclick="FiltrarRetirados">
                <div class="kpi-icon"><i class="bi bi-archive-fill"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Retirados</span>
                    <span class="kpi-value">@_metricas.Retirados</span>
                </div>
            </div>
            <div class="kpi-card kpi-blue kpi-clicable" @onclick="FiltrarTodos">
                <div class="kpi-icon"><i class="bi bi-list-ul"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Total catálogo</span>
                    <span class="kpi-value">@_metricas.Total</span>
                </div>
            </div>
        </section>

        <div class="pills-filter">
            <button type="button"
                    class="pill-btn @(_pillActivo is null ? "active-indigo" : "inactive")"
                    @onclick="FiltrarTodos">
                <i class="bi bi-list-ul"></i> Todos
            </button>
            <button type="button"
                    class="pill-btn @(_pillActivo == "borradores" ? "active-orange" : "inactive")"
                    @onclick="FiltrarBorradores">
                <i class="bi bi-pencil-square"></i> Borradores
            </button>
            <button type="button"
                    class="pill-btn @(_pillActivo == "vigentes" ? "active-green" : "inactive")"
                    @onclick="FiltrarVigentes">
                <i class="bi bi-check-circle-fill"></i> Vigentes
            </button>
            <button type="button"
                    class="pill-btn @(_pillActivo == "retirados" ? "active-red" : "inactive")"
                    @onclick="FiltrarRetirados">
                <i class="bi bi-archive-fill"></i> Retirados
            </button>
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(_editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(_editando ? "Editar Reporte" : "Nuevo Reporte")</span>
                </div>
                <div class="form-header-center">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <div>
                        <div class="form-header-title">Reporte Normativo</div>
                        <div class="form-header-subtitle">Ficha de obligación de reporte</div>
                    </div>
                </div>
                <button class="btn-cerrar-form" @onclick="Cancelar" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="_dto" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid-3">
                    <div class="form-group form-group-full">
                        <label>Entidad receptora *</label>
                        <div class="input-icon">
                            <i class="bi bi-building"></i>
                            <InputText class="form-control" @bind-Value="_dto.EntidadReceptora"
                                       placeholder="Ej: Contaduría General de la Nación" />
                        </div>
                        <ValidationMessage For="() => _dto.EntidadReceptora" class="form-error" />
                    </div>

                    <div class="form-group form-group-full">
                        <label>Nombre del reporte *</label>
                        <div class="input-icon">
                            <i class="bi bi-file-earmark-text"></i>
                            <InputText class="form-control" @bind-Value="_dto.NombreReporte"
                                       placeholder="Ej: Formato CGN 2026-001" />
                        </div>
                        <ValidationMessage For="() => _dto.NombreReporte" class="form-error" />
                    </div>

                    <div class="form-group">
                        <label>Periodicidad</label>
                        <div class="input-icon">
                            <i class="bi bi-calendar-repeat"></i>
                            <InputSelect class="form-select" @bind-Value="_dto.Periodicidad">
                                <option value="ANUAL">Anual</option>
                                <option value="SEMESTRAL">Semestral</option>
                                <option value="TRIMESTRAL">Trimestral</option>
                                <option value="MENSUAL">Mensual</option>
                                <option value="OCASIONAL">Ocasional</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Formato salida</label>
                        <div class="input-icon">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                            <InputSelect class="form-select" @bind-Value="_dto.FormatoSalida">
                                <option value="XLSX">XLSX (Excel)</option>
                                <option value="CSV">CSV</option>
                                <option value="PDF">PDF</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Estado</label>
                        <div class="input-icon">
                            <i class="bi bi-toggle-on"></i>
                            <InputSelect class="form-select" @bind-Value="_dto.Estado">
                                <option value="BORRADOR">Borrador</option>
                                <option value="VIGENTE">Vigente</option>
                                <option value="RETIRADO">Retirado</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group form-group-full">
                        <label>Descripción</label>
                        <div class="input-icon">
                            <i class="bi bi-card-text textarea-icon"></i>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_dto.Descripcion"
                                           placeholder="Descripción del reporte" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Fuente oficial (norma)</label>
                        <div class="input-icon">
                            <i class="bi bi-book"></i>
                            <InputText class="form-control" @bind-Value="_dto.FuenteOficial"
                                       placeholder="Ej: Resolución 533/2015" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Fecha límite</label>
                        <div class="input-icon">
                            <i class="bi bi-calendar-x"></i>
                            <InputText class="form-control" @bind-Value="_dto.FechaLimite"
                                       placeholder="Ej: Último día de febrero" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Responsable interno</label>
                        <div class="input-icon">
                            <i class="bi bi-person-badge"></i>
                            <InputText class="form-control" @bind-Value="_dto.ResponsableInterno"
                                       placeholder="Ej: Almacenista" />
                        </div>
                    </div>

                    <div class="form-group form-group-full">
                        <label>URL oficial</label>
                        <div class="input-icon">
                            <i class="bi bi-link-45deg"></i>
                            <InputText class="form-control" @bind-Value="_dto.UrlOficial"
                                       placeholder="https://..." />
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="Cancelar">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(_editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(_editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">
        <div class="filtros-toolbar">
            <div class="filtro-busqueda-principal">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por entidad o nombre…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Entidad</th>
                        <th>Reporte</th>
                        <th class="text-center">Periodicidad</th>
                        <th class="text-center">Formato</th>
                        <th class="text-center">Plantilla</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 220px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_reportes is null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Cargando reportes…</td></tr>
                    }
                    else if (!_reportes.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Sin reportes configurados.</td></tr>
                    }
                    else
                    {
                        @foreach (var r in _reportes)
                        {
                            <tr class="table-row-hover" @key="r.Id">
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@r.EntidadReceptora</strong>
                                        <small>@(r.FuenteOficial ?? "—")</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@r.NombreReporte</strong>
                                        <small>@(r.Descripcion ?? "—")</small>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-info">@r.Periodicidad</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-neutral">@r.FormatoSalida</span>
                                </td>
                                <td class="text-center">
                                    @if (r.TienePlantilla)
                                    {
                                        <span class="badge badge-ok">
                                            <i class="bi bi-check-circle-fill"></i> Cargada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warn">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Sin plantilla
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @GetClaseBadgeEstado(r.Estado)">@r.Estado</span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        @if (puedeEditar)
                                        {
                                            <button class="btn-action btn-action-edit"
                                                    @onclick="() => AbrirModalPlantilla(r)"
                                                    title="Cargar/reemplazar plantilla">
                                                <i class="bi bi-upload"></i>
                                            </button>
                                        }

                                        @if (puedeExportar && r.TienePlantilla)
                                        {
                                            <button class="btn-action btn-action-ok"
                                                    @onclick="() => GenerarReporte(r)"
                                                    title="Generar y descargar reporte">
                                                <i class="bi bi-download"></i>
                                            </button>
                                        }

                                        <button class="btn-action btn-action-view"
                                                @onclick="() => VerDetalle(r)"
                                                title="Ver detalle">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>

                                        @if (puedeEditar)
                                        {
                                            <button class="btn-action btn-action-edit"
                                                    @onclick="() => Editar(r)"
                                                    title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }

                                        @if (puedeEditar)
                                        {
                                            @if (r.Estado == "BORRADOR")
                                            {
                                                <button class="btn-action btn-action-ok"
                                                        @onclick='() => CambiarEstado(r, "VIGENTE")'
                                                        title="Marcar como Vigente">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            }
                                            else if (r.Estado == "VIGENTE")
                                            {
                                                <button class="btn-action btn-action-delete"
                                                        @onclick='() => CambiarEstado(r, "RETIRADO")'
                                                        title="Retirar">
                                                    <i class="bi bi-archive-fill"></i>
                                                </button>
                                            }
                                        }

                                        @if (puedeEliminar)
                                        {
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => Eliminar(r)"
                                                    title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ═══════ MODAL — DETALLE ═══════ *@
@if (_detalleAbierto && _detalle is not null)
{
    var r = _detalle;

    <div class="modal-backdrop-det" @onclick="CerrarDetalle">
        <div class="modal-det" @onclick:stopPropagation="true">
            <div class="modal-det-header">
                <div class="modal-det-header-left">
                    <span class="badge @GetClaseBadgeEstado(r.Estado)">@r.Estado</span>
                    <h3>@r.NombreReporte</h3>
                </div>
                <button type="button" class="modal-det-close" @onclick="CerrarDetalle">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-det-body">
                <div class="det-section">
                    <h4><i class="bi bi-building"></i> Entidad receptora</h4>
                    <dl class="det-dl">
                        <dt>Entidad</dt>
                        <dd>@r.EntidadReceptora</dd>
                        <dt>Fuente oficial</dt>
                        <dd>@(r.FuenteOficial ?? "—")</dd>
                    </dl>
                </div>

                <div class="det-section">
                    <h4><i class="bi bi-file-earmark-bar-graph"></i> Formato</h4>
                    <dl class="det-dl">
                        <dt>Periodicidad</dt>
                        <dd>@r.Periodicidad</dd>
                        <dt>Formato</dt>
                        <dd>@r.FormatoSalida</dd>
                        <dt>Responsable interno</dt>
                        <dd>@(r.ResponsableInterno ?? "—")</dd>
                        <dt>Fecha límite</dt>
                        <dd>@(r.FechaLimite ?? "—")</dd>
                    </dl>
                </div>

                @if (!string.IsNullOrWhiteSpace(r.Descripcion))
                {
                    <div class="det-section">
                        <h4><i class="bi bi-card-text"></i> Descripción</h4>
                        <div class="det-note"><p>@r.Descripcion</p></div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(r.UrlOficial))
                {
                    <div class="det-section">
                        <h4><i class="bi bi-link-45deg"></i> URL oficial</h4>
                        <div class="det-note">
                            <p><a href="@r.UrlOficial" target="_blank" rel="noopener">@r.UrlOficial</a></p>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-det-footer">
                <button type="button" class="btn-det-cerrar" @onclick="CerrarDetalle">
                    <i class="bi bi-x-lg"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
}

@* ═══════ MODAL — CARGAR PLANTILLA ═══════ *@
@if (_modalPlantillaAbierto && _reporteParaPlantilla is not null)
{
    var r = _reporteParaPlantilla;

    <div class="modal-backdrop-det" @onclick="CancelarModalPlantilla">
        <div class="modal-det" @onclick:stopPropagation="true">
            <div class="modal-det-header">
                <div class="modal-det-header-left">
                    <span class="badge badge-info">Cargar plantilla</span>
                    <h3>@r.NombreReporte</h3>
                </div>
                <button type="button" class="modal-det-close" @onclick="CancelarModalPlantilla">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-det-body">
                <div class="det-section" style="background:#eff6ff; border-left: 4px solid #3b82f6;">
                    <h4><i class="bi bi-info-circle-fill"></i> Instrucciones</h4>
                    <p style="margin:0; font-size:0.85rem;">
                        Cargue la plantilla oficial (CSV o XLSX). El sistema la procesará
                        y la guardará como plantilla base para generar el reporte.
                    </p>
                </div>

                <InputFile OnChange="OnArchivoSeleccionado" accept=".xlsx,.xls,.csv" />

                @if (!string.IsNullOrEmpty(_mensajePlantilla))
                {
                    <div class="det-section" style="margin-top:12px;">
                        <p style="margin:0;">@_mensajePlantilla</p>
                    </div>
                }
            </div>

            <div class="modal-det-footer">
                <button type="button" class="btn-det-cerrar" @onclick="CancelarModalPlantilla">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo CulturaCOP = CultureInfo.GetCultureInfo("es-CO");

    private List<ReporteNormativoDTO>? _reportes;
    private (int Borradores, int Vigentes, int Retirados, int Total) _metricas;

    private ReporteNormativoDTO _dto = new();
    private bool _mostrarFormulario = false;
    private bool _editando = false;
    private int _editandoId = 0;

    private string _filtroTexto = string.Empty;
    private string? _filtroEstado;
    private string? _pillActivo;
    private CancellationTokenSource? _debounceCts;

    private bool _detalleAbierto = false;
    private ReporteNormativoDTO? _detalle;

    private bool _modalPlantillaAbierto = false;
    private ReporteNormativoDTO? _reporteParaPlantilla;
    private string _mensajePlantilla = string.Empty;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;
    private bool puedeExportar;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!await Seguridad.TienePermisoAsync("reportes_normativos.ver"))
            {
                Navigation.NavigateTo("/");
                return;
            }

            puedeCrear    = await Seguridad.TienePermisoAsync("reportes_normativos.crear");
            puedeEditar   = await Seguridad.TienePermisoAsync("reportes_normativos.editar");
            puedeEliminar = await Seguridad.TienePermisoAsync("reportes_normativos.eliminar");
            puedeExportar = await Seguridad.TienePermisoAsync("reportes_normativos.exportar");

            await Cargar();
        }
        catch (NavigationException)
        {
            // Redirección esperada durante recarga forzada (Ctrl+Shift+R).
        }
    }

    private async Task Cargar()
    {
        var resultado = await RepoNorm.ObtenerTodosAsync(
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            _filtroEstado,
            null);

        _reportes = resultado.ToList();
        _metricas = await RepoNorm.ObtenerMetricasAsync();
    }

    private Task FiltrarTodos()      => FiltrarPorPill(null);
    private Task FiltrarBorradores() => FiltrarPorPill("borradores");
    private Task FiltrarVigentes()   => FiltrarPorPill("vigentes");
    private Task FiltrarRetirados()  => FiltrarPorPill("retirados");

    private async Task FiltrarPorPill(string? pill)
    {
        _pillActivo = pill;
        _filtroEstado = pill switch
        {
            "borradores" => "BORRADOR",
            "vigentes"   => "VIGENTE",
            "retirados"  => "RETIRADO",
            _ => null
        };
        await Cargar();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        await Cargar();
        StateHasChanged();
    }

    private void VerDetalle(ReporteNormativoDTO r)
    {
        _detalle = r;
        _detalleAbierto = true;
    }

    private void CerrarDetalle()
    {
        _detalleAbierto = false;
        _detalle = null;
    }

    private void AbrirFormulario()
    {
        _dto = new ReporteNormativoDTO
        {
            Estado = "BORRADOR",
            Periodicidad = "ANUAL",
            FormatoSalida = "XLSX"
        };
        _editando = false;
        _editandoId = 0;
        _mostrarFormulario = true;
    }

    private void Editar(ReporteNormativoDTO r)
    {
        _dto = new ReporteNormativoDTO
        {
            Id = r.Id,
            EntidadReceptora = r.EntidadReceptora,
            NombreReporte = r.NombreReporte,
            Descripcion = r.Descripcion,
            Periodicidad = r.Periodicidad,
            FormatoSalida = r.FormatoSalida,
            Estado = r.Estado,
            FuenteOficial = r.FuenteOficial,
            UrlOficial = r.UrlOficial,
            ResponsableInterno = r.ResponsableInterno,
            FechaLimite = r.FechaLimite,
            PlantillaRuta = r.PlantillaRuta
        };
        _editando = true;
        _editandoId = r.Id;
        _mostrarFormulario = true;
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
        _dto = new ReporteNormativoDTO();
        _editando = false;
        _editandoId = 0;
    }

    private async Task Guardar()
    {
        try
        {
            if (_editando)
            {
                await RepoNorm.ActualizarAsync(_dto);
                Toast.Exito("Reporte actualizado");
            }
            else
            {
                await RepoNorm.CrearAsync(_dto);
                Toast.Exito("Reporte creado");
            }

            Cancelar();
            await Cargar();
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "el reporte", "guardar");
        }
    }

    private async Task CambiarEstado(ReporteNormativoDTO r, string nuevoEstado)
    {
        try
        {
            await RepoNorm.CambiarEstadoAsync(r.Id, nuevoEstado);
            Toast.Exito($"Estado cambiado a {nuevoEstado}");
            await Cargar();
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "el reporte", "actualizar");
        }
    }

    private async Task Eliminar(ReporteNormativoDTO r)
    {
        var ok = await Confirm.Peligroso($"¿Eliminar el reporte '{r.NombreReporte}'?");
        if (!ok) return;

        try
        {
            await RepoNorm.EliminarAsync(r.Id);
            Toast.Exito("Reporte eliminado");
            await Cargar();
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "el reporte", "eliminar");
        }
    }

    private void AbrirModalPlantilla(ReporteNormativoDTO r)
    {
        _reporteParaPlantilla = r;
        _mensajePlantilla = string.Empty;
        _modalPlantillaAbierto = true;
    }

    private void CancelarModalPlantilla()
    {
        _modalPlantillaAbierto = false;
        _reporteParaPlantilla = null;
        _mensajePlantilla = string.Empty;
    }

    private async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        if (_reporteParaPlantilla is null) return;
        if (e.File is null) return;

        try
        {
            _mensajePlantilla = $"Procesando '{e.File.Name}'…";

            using var ms = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            var bytesCsv = ms.ToArray();

            var (ok, contenido, nombreArchivo, mensaje) = await PlantillaService.ProcesarPlantillaAsync(
                new MemoryStream(bytesCsv), e.File.Name);

            if (!ok)
            {
                _mensajePlantilla = $"❌ {mensaje}";
                return;
            }

            await RepoNorm.ActualizarPlantillaAsync(_reporteParaPlantilla.Id, contenido, nombreArchivo);

            Toast.Exito($"Plantilla de '{_reporteParaPlantilla.NombreReporte}' cargada.");
            CancelarModalPlantilla();
            await Cargar();
        }
        catch (Exception ex)
        {
            _mensajePlantilla = $"❌ Error: {ex.Message}";
        }
    }

    private async Task GenerarReporte(ReporteNormativoDTO r)
    {
        try
        {
            var plantillaBytes = await RepoNorm.ObtenerContenidoPlantillaAsync(r.Id);

            if (plantillaBytes is null || plantillaBytes.Length == 0)
            {
                Toast.Error("Este reporte no tiene plantilla cargada.");
                return;
            }

            var entradas = (await RepoNorm.ObtenerEntradasAsync()).ToList();
            var bienes = (await BienRepo.ObtenerTodosAsync()).ToList();

            var bytes = PlantillaService.GenerarReporte(
                plantillaBytes,
                bienes,
                entradas,
                Sesion.InstitucionNombre ?? "",
                Sesion.UsuarioActual?.NombreCompleto ?? "");

            var base64 = Convert.ToBase64String(bytes);
            var nombreArchivo = $"{r.NombreReporte.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync("descargarArchivo",
                base64,
                nombreArchivo,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            await Auditoria.RegistrarExportacionAsync(
                modulo: "reportes_normativos",
                descripcion: $"Exportación de '{r.NombreReporte}'");

            Toast.Exito($"Reporte '{r.NombreReporte}' generado.");
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "el reporte", "generar");
        }
    }

    private static string GetClaseBadgeEstado(string estado) => estado switch
    {
        "BORRADOR" => "badge-warn",
        "VIGENTE"  => "badge-ok",
        "RETIRADO" => "badge-off",
        _          => "badge-neutral"
    };
}