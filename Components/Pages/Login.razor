@page "/login"
@rendermode InteractiveServer
@using Almacen.Components.Layout
@using System.ComponentModel.DataAnnotations
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@layout EmptyLayout
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IUsuarioRepository UsuarioRepository
@inject UsuarioSesionService Sesion
@inject SeguridadService Seguridad

<PageTitle>Acceso · AlmacénPro</PageTitle>

<div class="login-scene">

    <!-- Orbes decorativos de fondo -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>

    <div class="login-box">

        <!-- ═══════════════════════════════════════════════
             LADO IZQUIERDO — Marketing
             ═══════════════════════════════════════════════ -->
        <div class="hero-side">

            <div class="hero-top">
                <div class="logo-mark">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
                <div class="logo-text">
                    <span class="logo-name">Almacén<span class="logo-accent">Pro</span></span>
                    <span class="logo-slogan">Inventario Educativo</span>
                </div>
            </div>

            <div class="hero-main">
                <h1>
                    Gestiona tu inventario<br />
                    como un <span class="hero-accent">profesional</span>.
                </h1>

                <p class="hero-sub">
                    Control total de tus bienes, depreciación automática,
                    trazabilidad con QR y reportes listos para auditoría.
                </p>

                <div class="hero-stats">
                    <div class="stat">
                        <span class="stat-num">100%</span>
                        <span class="stat-lbl">Normativa NICSP</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat">
                        <span class="stat-num">∞</span>
                        <span class="stat-lbl">Bienes sin límite</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat">
                        <span class="stat-num">24/7</span>
                        <span class="stat-lbl">Disponible</span>
                    </div>
                </div>
            </div>

            <div class="hero-bottom">
                <div class="aviso-dot"></div>
                <span>Sistema activo · V 2.0</span>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════
             LADO DERECHO — Formulario
             ═══════════════════════════════════════════════ -->
        <div class="form-side">

            <div class="form-top">
                <span class="badge-acceso">
                    <span class="badge-dot"></span>
                    Acceso Seguro
                </span>
            </div>

            <div class="form-head">
                <h2>Bienvenido de nuevo</h2>
                <p>Ingresa tus credenciales para continuar</p>
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="ProcesarLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <div class="campo">
                    <label for="email">Correo institucional</label>
                    <InputText id="email"
                               class="ipt"
                               @bind-Value="loginModel.Email"
                               placeholder="tu@correo.edu.co"
                               autocomplete="username" />
                    <ValidationMessage For="@(() => loginModel.Email)" class="err" />
                </div>

                <div class="campo">
                    <label for="password">Contraseña</label>
                    <InputText id="password"
                               type="password"
                               class="ipt"
                               @bind-Value="loginModel.Password"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                    <ValidationMessage For="@(() => loginModel.Password)" class="err" />
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alerta">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <span>@mensajeError</span>
                    </div>
                }

                <button type="submit" class="btn-entrar" disabled="@cargando">
                    @if (cargando)
                    {
                        <span class="spinner"></span>
                        <span>Ingresando...</span>
                    }
                    else
                    {
                        <span>Ingresar</span>
                        <i class="bi bi-arrow-right-short"></i>
                    }
                </button>

                <div class="form-links">
                    <a href="#" class="link-mini">¿Olvidaste tu contraseña?</a>
                </div>
            </EditForm>

            <div class="form-footer-mini">
                <span>© @DateTime.Now.Year AlmacénPro</span>
                <span class="dot-sep"></span>
                <span>Powered by .NET 9</span>
            </div>
        </div>

    </div>
</div>

@code {
    private LoginInput loginModel = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;

    private async Task ProcesarLogin()
    {
        try
        {
            mensajeError = string.Empty;
            cargando = true;

            Sesion.CerrarSesion();

            bool esValido = await AuthService.ValidarCredencialesAsync(
                loginModel.Email, loginModel.Password);

            if (!esValido)
            {
                mensajeError = "Credenciales inválidas. Verifica tu correo y contraseña.";
                return;
            }

            var usuario = await UsuarioRepository.ObtenerPorEmailAsync(loginModel.Email);
            if (usuario == null)
            {
                mensajeError = "Usuario no encontrado.";
                return;
            }

            var usuarioSesion = new UsuarioSesion
            {
                Id = usuario.Id,
                NombreCompleto = usuario.NombreCompleto,
                Email = usuario.Email,
                RolId = usuario.RolId,
                NombreRol = usuario.NombreRol,
                InstitucionId = usuario.InstitucionId,
                EsSuperAdmin = usuario.EsSuperAdmin,
                InstitucionNombre = usuario.InstitucionNombre
            };

            Sesion.IniciarSesion(usuarioSesion, Array.Empty<string>());
            await Seguridad.CargarPermisosEnSesionAsync();

            Navigation.NavigateTo("/", forceLoad: false);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class LoginInput
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Formato de correo inválido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}