@page "/login"
@rendermode InteractiveServer
@using Almacen.Components.Layout
@using System.ComponentModel.DataAnnotations

@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@layout EmptyLayout
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IUsuarioRepository UsuarioRepository
@inject UsuarioSesionService Sesion
@inject SeguridadService Seguridad

<div class="login-container">
    <!-- Panel Izquierdo: Identidad Oficial -->
    <div class="brand-panel">
        <div class="brand-overlay"></div>
        <div class="brand-content">
            <div class="logo-wrapper-large">
                <svg xmlns="http://www.w3.org/2000/svg" width="44" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022M6 8.694 1.458 10.21A.5.5 0 0 0 1 10.691V15h4v-2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5V15h4v-1.5a.5.5 0 0 1 .5-.5h.5a.5.5 0 0 1 .5.5V15h1V1.309l-7 3.5z" />
                </svg>
            </div>
            <h1>Alcaldía de Popayán</h1>
            <h2>Almacén e Inventarios</h2>
            <p>Módulo oficial para el control, registro, legalización y trazabilidad de bienes devolutivos y de consumo del municipio.</p>
        </div>
        <div class="brand-footer">
            <span>&copy; 2026 Municipio de Popayán - Gestión Pública Transparente</span>
        </div>
    </div>

    <!-- Panel Derecho: Formulario -->
    <div class="form-panel">
        <div class="form-container-box">
            <div class="form-header">
                <h2>Control de Acceso</h2>
                <p>Identifíquese con sus credenciales institucionales</p>
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="ProcesarLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <div class="form-group-custom">
                    <label class="input-title-label">Usuario / Correo Institucional</label>
                    <div class="input-with-icon">
                        <span class="input-icon-inner">@("@")</span>
                        <InputText class="modern-input-field" @bind-Value="loginModel.Email" placeholder="funcionario@popayan.gov.co" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Email)" class="validation-error-message" />
                </div>

                <div class="form-group-custom">
                    <label class="input-title-label">Contraseña del Sistema</label>
                    <div class="input-with-icon">
                        <span class="input-icon-inner">🔑</span>
                        <InputText type="password" class="modern-input-field" @bind-Value="loginModel.Password" placeholder="••••••••••••" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" class="validation-error-message" />
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="modern-alert-error">
                        <span class="alert-icon">⚠️</span>
                        <span class="alert-text">@mensajeError</span>
                    </div>
                }

                <button type="submit" class="modern-btn-primary" disabled="@cargando">
                    @(cargando ? "Validando credenciales..." : "Ingresar de Forma Segura")
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginInput loginModel = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;

    private async Task ProcesarLogin()
    {
        try
        {
            mensajeError = string.Empty;
            cargando = true;

            // 1) Limpia cualquier sesión previa
            Sesion.CerrarSesion();

            // 2) Valida credenciales
            bool esValido = await AuthService.ValidarCredencialesAsync(
                loginModel.Email, loginModel.Password);

            if (!esValido)
            {
                mensajeError = "Las credenciales ingresadas no corresponden a un funcionario autorizado del Municipio.";
                return;
            }

            // 3) Carga el usuario completo
            var usuario = await UsuarioRepository.ObtenerPorEmailAsync(loginModel.Email);
            if (usuario == null)
            {
                mensajeError = "No se encontró información del funcionario autenticado.";
                return;
            }

            // 4) Inicia sesión con contexto multi-institución
            var usuarioSesion = new UsuarioSesion
            {
                Id = usuario.Id,
                NombreCompleto = usuario.NombreCompleto,
                Email = usuario.Email,
                RolId = usuario.RolId,
                NombreRol = usuario.NombreRol,
                InstitucionId = usuario.InstitucionId,
                EsSuperAdmin = usuario.EsSuperAdmin
            };

            Sesion.IniciarSesion(usuarioSesion, Array.Empty<string>());

            // 5) Carga los permisos AHORA (1 sola vez)
            await Seguridad.CargarPermisosEnSesionAsync();

            // 6) Redirige al dashboard
            Navigation.NavigateTo("/", forceLoad: false);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class LoginInput
    {
        [Required(ErrorMessage = "El correo de la Alcaldía de Popayán es obligatorio.")]
        [EmailAddress(ErrorMessage = "El formato de correo institucional no es válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe digitar su contraseña de seguridad.")]
        public string Password { get; set; } = string.Empty;
    }
}