@page "/error"
@layout EmptyLayout
@inject NavigationManager Navigation

<PageTitle>Algo salió mal · Almacén</PageTitle>

<div class="error-page">
    <div class="error-card">
        <div class="error-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <h1>Algo salió mal</h1>

        <p class="error-message">
            Ha ocurrido un error inesperado mientras procesaba tu solicitud.
            El equipo técnico ha sido notificado.
        </p>

        <div class="error-ref">
            <strong>Referencia:</strong>
            <code>@_errorId</code>
        </div>

        <div class="error-actions">
            <button class="btn-primary" @onclick="VolverInicio">
                <i class="bi bi-house-door"></i> Volver al inicio
            </button>

            <button class="btn-secondary" @onclick="Recargar">
                <i class="bi bi-arrow-clockwise"></i> Reintentar
            </button>
        </div>

        <div class="error-footer">
            <p>
                Si el problema persiste, contacta al soporte técnico del
                <strong>Sistema de Inventario — Secretaría de Educación del Cauca</strong>
            </p>
        </div>
    </div>
</div>

@code {
    private string _errorId = string.Empty;

    protected override void OnInitialized()
    {
        _errorId = $"ERR-{DateTime.Now:yyyyMMdd-HHmmss}-{Guid.NewGuid().ToString("N")[..6].ToUpper()}";
    }

    private void VolverInicio()
    {
        Navigation.NavigateTo("/");
    }

    private void Recargar()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}