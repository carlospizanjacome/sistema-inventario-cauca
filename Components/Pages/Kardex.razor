@page "/kardex"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Globalization

@inject IKardexRepository KardexRepo
@inject IProveedorRepository ProveedorRepo
@inject IFuncionarioRepository FuncRepo
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject ToastService Toast
@inject AuditoriaService Auditoria

<PageTitle>Kárdex · Almacén</PageTitle>

<div class="kx-page">

    @* ═══ TOPBAR ═══ *@
    <div class="kx-topbar">
        <div class="kx-topbar-title">
            <i class="bi bi-journal-text"></i>
            <h1>Kárdex</h1>
        </div>

        <div class="kx-buscador kx-buscador-inline">
            <i class="bi bi-search"></i>
            <input type="text"
                   placeholder="Buscar bien…"
                   value="@_textoBusqueda"
                   @oninput="OnBusquedaInput"
                   @onfocus="OnBusquedaFocus"
                   @onkeydown="OnBusquedaKeyDown"
                   autocomplete="off" />
            @if (!string.IsNullOrWhiteSpace(_textoBusqueda))
            {
                <button type="button" class="kx-buscador-clear"
                        @onclick="LimpiarBusqueda"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-x-lg"></i>
                </button>
            }

            @if (_mostrarDropdown)
            {
                <div class="kx-dropdown" @onmousedown:preventDefault="true">
                    @if (_resultadosBusqueda.Count > 0)
                    {
                        @foreach (var b in _resultadosBusqueda.Take(15))
                        {
                            var bien = b;
                            <button type="button" class="kx-dropdown-item"
                                    @onclick="() => SeleccionarBien(bien)"
                                    @onclick:stopPropagation="true">
                                <div class="kx-dropdown-row">
                                    <code>@bien.Codigo</code>
                                    <strong>@bien.Nombre</strong>
                                </div>
                                <div class="kx-dropdown-meta">
                                    <span>@bien.StockActual.ToString("N2") @bien.UnidadMedida</span>
                                    <span>@bien.CppActual.ToString("C0", CulturaCOP)</span>
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="kx-dropdown-empty">
                            <i class="bi bi-search"></i>
                            <span>Sin resultados</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ═══ STRIP DEL BIEN (si hay uno seleccionado) ═══ *@
    @if (_bienSeleccionado != null)
    {
        <div class="kx-strip @(_bienSeleccionado.BajoStockMinimo ? "kx-strip-warn" : "")">
            <div class="kx-strip-bien">
                <code>@_bienSeleccionado.Codigo</code>
                <strong>@_bienSeleccionado.Nombre</strong>
                @if (_bienSeleccionado.BajoStockMinimo)
                {
                    <span class="kx-strip-alerta">
                        <i class="bi bi-exclamation-triangle-fill"></i> Bajo stock
                    </span>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="VolverAVistaGeneral" style="margin-left: 12px; padding: 4px 10px; font-size: 12px;">
                    <i class="bi bi-arrow-left-right"></i> Ver Todos los Movimientos
                </button>
            </div>

            <div class="kx-strip-metrics">
                <span class="kx-metric">
                    <label>Stock</label>
                    <b>@_bienSeleccionado.StockActual.ToString("N2")</b>
                    <small>@_bienSeleccionado.UnidadMedida</small>
                </span>
                <span class="kx-metric-sep">·</span>
                <span class="kx-metric">
                    <label>Mín</label>
                    <b>@_bienSeleccionado.StockMinimo.ToString("N2")</b>
                </span>
                <span class="kx-metric-sep">·</span>
                <span class="kx-metric">
                    <label>CPP</label>
                    <b>@_bienSeleccionado.CppActual.ToString("C2", CulturaCOP)</b>
                </span>
                <span class="kx-metric-sep">·</span>
                <span class="kx-metric kx-metric-highlight">
                    <label>Valor stock</label>
                    <b>@_bienSeleccionado.ValorStock.ToString("C0", CulturaCOP)</b>
                </span>
            </div>
        </div>
    }

    @* ═══ FORMULARIO (siempre visible, deshabilitado si no hay bien) ═══ *@
    <div class="kx-panel">
        <div class="kx-panel-header">
            <div class="kx-panel-title">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Registrar movimiento</span>
            </div>
            <span class="kx-panel-hint">@(_bienSeleccionado == null ? "Seleccione un bien para habilitar" : "Inmutable · use ajustes para corregir")</span>
        </div>

        <EditForm Model="_movDTO" OnValidSubmit="RegistrarMovimiento">
            <DataAnnotationsValidator />

            <div class="kx-form">
                <div class="kx-field">
                    <label for="mov-tipo">Tipo *</label>
                    <div class="kx-input">
                        <i class="bi bi-arrow-left-right"></i>
                        <InputSelect id="mov-tipo" @bind-Value="_movDTO.TipoMovimiento" disabled="@(_bienSeleccionado == null)">
                            <option value="ENTRADA">ENTRADA (+)</option>
                            <option value="SALIDA">SALIDA (−)</option>
                            <option value="AJUSTE_POS">AJUSTE (+)</option>
                            <option value="AJUSTE_NEG">AJUSTE (−)</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="kx-field">
                    <label for="mov-fecha">Fecha *</label>
                    <div class="kx-input">
                        <i class="bi bi-calendar-event"></i>
                        <input id="mov-fecha" type="text" class="kx-input-date" placeholder="dd/mm/aaaa"
                               value="@(_movDTO.FechaMovimiento?.ToString("yyyy-MM-dd"))" @onchange="OnFechaChanged" readonly disabled="@(_bienSeleccionado == null)" />
                    </div>
                </div>

                <div class="kx-field">
                    <label for="mov-cantidad">Cantidad *</label>
                    <div class="kx-input">
                        <i class="bi bi-123"></i>
                        <input id="mov-cantidad" type="text" inputmode="decimal" class="kx-input-number"
                               value="@_cantidadTexto" @oninput="OnCantidadInput" @onblur="OnCantidadBlur" placeholder="0,00" disabled="@(_bienSeleccionado == null)" />
                    </div>
                </div>

                <div class="kx-field">
                    <label for="mov-costo">Costo unit. @if (EsSalida) { <span class="kx-hint">usa CPP</span> }</label>
                    <div class="kx-input">
                        <i class="bi bi-currency-dollar"></i>
                        <input id="mov-costo" type="text" inputmode="decimal" class="kx-input-number"
                               value="@_costoTexto" @oninput="OnCostoInput" @onblur="OnCostoBlur" placeholder="0,00" disabled="@(EsSalida || _bienSeleccionado == null)" />
                    </div>
                </div>

                <div class="kx-field">
                    <label for="mov-doc">Documento</label>
                    <div class="kx-input">
                        <i class="bi bi-receipt"></i>
                        <InputText id="mov-doc" @bind-Value="_movDTO.DocumentoReferencia" placeholder="Factura / Acta" disabled="@(_bienSeleccionado == null)" />
                    </div>
                </div>

                <div class="kx-field">
                    <label for="mov-prov">Proveedor</label>
                    <div class="kx-input">
                        <i class="bi bi-shop"></i>
                        <InputSelect id="mov-prov" @bind-Value="_movDTO.ProveedorId" disabled="@(EsSalida || _bienSeleccionado == null)">
                            <option value="">— Sin proveedor —</option>
                            @foreach (var p in _proveedores) { <option value="@p.Id">@p.Nombre</option> }
                        </InputSelect>
                    </div>
                </div>

                <div class="kx-field kx-field-recibe">
                    <label for="mov-recibe">Recibe</label>
                    <div class="kx-input">
                        <i class="bi bi-person-check"></i>
                        <InputSelect id="mov-recibe" @bind-Value="_movDTO.FuncionarioRecibeId" disabled="@(_bienSeleccionado == null)">
                            <option value="">— Sin asignar —</option>
                            @foreach (var f in _funcionarios) { <option value="@f.Id">@f.NombreCompleto</option> }
                        </InputSelect>
                    </div>
                </div>

                <div class="kx-field kx-field-obs">
                    <label for="mov-obs">Observaciones</label>
                    <div class="kx-input">
                        <i class="bi bi-chat-left-text"></i>
                        <InputText id="mov-obs" @bind-Value="_movDTO.Observaciones" placeholder="Notas opcionales" disabled="@(_bienSeleccionado == null)" />
                    </div>
                </div>

                <div class="kx-field kx-field-btn">
                    <button type="submit" class="kx-btn-primary" disabled="@(_bienSeleccionado == null)">
                        <i class="bi bi-check-circle-fill"></i> Registrar
                    </button>
                </div>
            </div>
        </EditForm>
    </div>

    @* ═══ HISTÓRICO ═══ *@
    <div class="kx-panel">
        <div class="kx-panel-header">
            <div class="kx-panel-title">
                <i class="bi bi-clock-history"></i>
                <span>@(_bienSeleccionado != null ? $"Movimientos de {_bienSeleccionado.Nombre}" : "Todos los movimientos de la sede")</span>
            </div>
        </div>

        <div class="kx-table-wrapper">
            <table class="kx-table">
                <thead>
                    <tr>
                        <th>Bien</th>
                        <th>Tipo</th>
                        <th>Fecha</th>
                        <th class="kx-num">Cant.</th>
                        <th class="kx-num">Costo u.</th>
                        <th class="kx-num">Valor</th>
                        <th class="kx-num">Saldo</th>
                        <th class="kx-num">CPP</th>
                        <th>Doc.</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_movimientos == null || !_movimientos.Any())
                    {
                        <tr>
                            <td colspan="9" class="kx-table-empty">Sin movimientos registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var m in _movimientos)
                        {
                            <tr>
                                <td>
                                    <code style="background: #e0e7ff; color: #4338ca; padding: 2px 6px; border-radius: 4px; font-size: 11px;">@m.BienCodigo</code>
                                    <span style="font-size: 13px; margin-left: 6px;">@m.BienNombre</span>
                                </td>
                                <td><span class="kx-tipo kx-tipo-@m.TipoMovimiento.ToLower()">@m.TipoMovimiento</span></td>
                                <td class="kx-mono">@m.FechaMovimiento?.ToString("dd/MM/yyyy")</td>
                                <td class="kx-num">@m.Cantidad.ToString("N2")</td>
                                <td class="kx-num">@m.CostoUnitario.ToString("C2", CulturaCOP)</td>
                                <td class="kx-num">@m.ValorMovimiento.ToString("C0", CulturaCOP)</td>
                                <td class="kx-num"><strong>@m.SaldoCantidad.ToString("N2")</strong></td>
                                <td class="kx-num">@m.Cpp.ToString("C2", CulturaCOP)</td>
                                <td class="kx-mono">@m.DocumentoReferencia</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo CulturaCOP = CultureInfo.GetCultureInfo("es-CO");

    [SupplyParameterFromQuery(Name = "bienId")]
    public int? BienIdQuery { get; set; }

    private List<BienConsumoDTO> _bienes = new();
    private List<BienConsumoDTO> _resultadosBusqueda = new();
    private List<MovimientoConsumoDTO> _movimientos = new();
    private List<ProveedorDTO> _proveedores = new();
    private List<FuncionarioDTO> _funcionarios = new();

    private int _bienIdSeleccionado = 0;
    private BienConsumoDTO? _bienSeleccionado;
    private string _textoBusqueda = string.Empty;
    private bool _mostrarDropdown = false;

    private MovimientoConsumoDTO _movDTO = new();
    private string _cantidadTexto = "0,00";
    private string _costoTexto = "0,00";
    private string _errorCantidad = "";

    private bool EsSalida => _movDTO.TipoMovimiento == "SALIDA" || _movDTO.TipoMovimiento == "AJUSTE_NEG";

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("kardex.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await Seguridad.TienePermisoAsync("kardex.ver")) return;

        _bienes = (await KardexRepo.ObtenerBienesConsumoAsync()).ToList();
        _proveedores = (await ProveedorRepo.ObtenerTodosAsync()).ToList();
        _funcionarios = (await FuncRepo.ObtenerTodosAsync()).ToList();

        if (BienIdQuery.HasValue && BienIdQuery.Value > 0)
        {
            var b = _bienes.FirstOrDefault(x => x.Id == BienIdQuery.Value);
            if (b != null) await SeleccionarBien(b);
        }
        else
        {
            await CargarMovimientosGlobales();
        }

        StateHasChanged();

        if (_bienSeleccionado != null) await InicializarFlatpickr();
    }

    private async Task CargarMovimientosGlobales()
    {
        _bienSeleccionado = null;
        _bienIdSeleccionado = 0;
        _movimientos = new List<MovimientoConsumoDTO>();

        foreach (var bien in _bienes)
        {
            var movs = await KardexRepo.ObtenerKardexAsync(bien.Id);
            if (movs != null)
            {
                foreach (var m in movs)
                {
                    m.BienCodigo = bien.Codigo;
                    m.BienNombre = bien.Nombre;
                    _movimientos.Add(m);
                }
            }
        }
        _movimientos = _movimientos.OrderByDescending(m => m.FechaMovimiento).ToList();
    }

    private async Task SeleccionarBien(BienConsumoDTO bien)
    {
        _bienIdSeleccionado = bien.Id;
        _bienSeleccionado = bien;
        _textoBusqueda = string.Empty;
        _mostrarDropdown = false;
        _resultadosBusqueda = new List<BienConsumoDTO>();

        var movs = await KardexRepo.ObtenerKardexAsync(bien.Id);
        _movimientos = movs?.ToList() ?? new List<MovimientoConsumoDTO>();
        foreach (var m in _movimientos) { m.BienCodigo = bien.Codigo; m.BienNombre = bien.Nombre; }

        var bienActualizado = await KardexRepo.ObtenerBienConsumoPorIdAsync(bien.Id);
        if (bienActualizado != null) _bienSeleccionado = bienActualizado;

        _movDTO = new MovimientoConsumoDTO { BienId = _bienIdSeleccionado, FechaMovimiento = DateTime.Today, TipoMovimiento = "ENTRADA", Cantidad = 0, CostoUnitario = 0 };
        _cantidadTexto = "0,00"; _costoTexto = "0,00"; _errorCantidad = "";

        StateHasChanged();
        await InicializarFlatpickr();
    }

    private async Task VolverAVistaGeneral()
    {
        await CargarMovimientosGlobales();
        StateHasChanged();
    }

    private async Task InicializarFlatpickr()
    {
        try
        {
            await Task.Delay(150);
            var fechaInicial = _movDTO.FechaMovimiento?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
            await JS.InvokeVoidAsync("initFlatpickr", "#mov-fecha", fechaInicial);
        }
        catch (Exception ex) { Console.WriteLine($"[Kardex] Error Flatpickr: {ex.Message}"); }
    }

    private void OnBusquedaFocus() { _mostrarDropdown = true; _resultadosBusqueda = string.IsNullOrWhiteSpace(_textoBusqueda) ? _bienes.Take(15).ToList() : _resultadosBusqueda; if (!string.IsNullOrWhiteSpace(_textoBusqueda)) FiltrarBienes(); }
    private void OnBusquedaInput(ChangeEventArgs e) { _textoBusqueda = e.Value?.ToString() ?? string.Empty; _mostrarDropdown = true; if (string.IsNullOrWhiteSpace(_textoBusqueda)) _resultadosBusqueda = _bienes.Take(15).ToList(); else FiltrarBienes(); }
    private void FiltrarBienes() { var f = _textoBusqueda.Trim().ToLowerInvariant(); _resultadosBusqueda = _bienes.Where(b => (b.Codigo?.ToLowerInvariant().Contains(f) ?? false) || (b.Nombre?.ToLowerInvariant().Contains(f) ?? false)).OrderBy(b => b.Codigo).ToList(); }
    private void OnBusquedaKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") _mostrarDropdown = false; if (e.Key == "Enter" && _mostrarDropdown && _resultadosBusqueda.Count > 0) _ = SeleccionarBien(_resultadosBusqueda[0]); }
    private void LimpiarBusqueda() { _textoBusqueda = string.Empty; _resultadosBusqueda = _bienes.Take(15).ToList(); _mostrarDropdown = true; }

    private void OnFechaChanged(ChangeEventArgs e) { if (DateTime.TryParse(e.Value?.ToString(), out var f)) _movDTO.FechaMovimiento = f; }
    private void OnCantidadInput(ChangeEventArgs e) { _cantidadTexto = e.Value?.ToString() ?? ""; _errorCantidad = ""; if (TryParseDecimal(_cantidadTexto, out var c)) _movDTO.Cantidad = c; }
    private void OnCantidadBlur() { if (string.IsNullOrWhiteSpace(_cantidadTexto)) { _cantidadTexto = "0,00"; _movDTO.Cantidad = 0; _errorCantidad = ""; return; } if (TryParseDecimal(_cantidadTexto, out var c) && c > 0) { _movDTO.Cantidad = c; _cantidadTexto = c.ToString("N2", CulturaCOP); _errorCantidad = ""; } else _errorCantidad = "Ingrese una cantidad válida mayor a 0"; }
    private void OnCostoInput(ChangeEventArgs e) { _costoTexto = e.Value?.ToString() ?? ""; if (TryParseDecimal(_costoTexto, out var c)) _movDTO.CostoUnitario = c; }
    private void OnCostoBlur() { if (string.IsNullOrWhiteSpace(_costoTexto)) { _costoTexto = "0,00"; _movDTO.CostoUnitario = 0; return; } if (TryParseDecimal(_costoTexto, out var c)) { _movDTO.CostoUnitario = c; _costoTexto = c.ToString("N2", CulturaCOP); } else { _costoTexto = "0,00"; _movDTO.CostoUnitario = 0; } }

    private static bool TryParseDecimal(string? texto, out decimal valor)
    {
        valor = 0; if (string.IsNullOrWhiteSpace(texto)) return false;
        var l = texto.Replace("$", "").Replace(" ", "").Trim();
        if (l.Contains(',')) l = l.Replace(".", "").Replace(",", ".");
        else if (l.Contains('.')) { var p = l.Split('.'); if (p.Length > 1 && p.Last().Length == 3) l = l.Replace(".", ""); }
        return decimal.TryParse(l, NumberStyles.Any, CultureInfo.InvariantCulture, out valor);
    }

    private async Task RegistrarMovimiento()
    {
        if (!await Seguridad.TienePermisoAsync("kardex.movimiento")) { Toast.Error("No tiene permiso."); return; }
        if (_bienSeleccionado is null || _bienIdSeleccionado == 0) { Toast.Error("Debe seleccionar un bien."); return; }
        if (_movDTO.Cantidad <= 0) { _errorCantidad = "Cantidad debe ser mayor a 0"; return; }

        try
        {
            _movDTO.BienId = _bienIdSeleccionado;
            var idMov = await KardexRepo.RegistrarMovimientoAsync(_movDTO);

            await Auditoria.RegistrarCreacionAsync(
                modulo: "kardex", objetoTipo: "MovimientoConsumo", objetoId: idMov,
                objetoCodigo: _movDTO.DocumentoReferencia ?? "SIN-DOC",
                objetoDescripcion: $"Movimiento {_movDTO.TipoMovimiento} · {_bienSeleccionado.Codigo} · Cant {_movDTO.Cantidad:N2}",
                despues: new { BienId = _bienIdSeleccionado, TipoMovimiento = _movDTO.TipoMovimiento, Cantidad = _movDTO.Cantidad });

            Toast.Exito("Movimiento registrado correctamente");

            _bienes = (await KardexRepo.ObtenerBienesConsumoAsync()).ToList();
            var bienAct = await KardexRepo.ObtenerBienConsumoPorIdAsync(_bienIdSeleccionado);
            if (bienAct != null) _bienSeleccionado = bienAct;

            await CargarMovimientosGlobales(); // Volver a cargar todo
            if (_bienSeleccionado != null) await SeleccionarBien(_bienSeleccionado); // O solo el del bien
        }
        catch (Exception ex) { Toast.Error($"Error: {ex.Message}"); }
    }
}