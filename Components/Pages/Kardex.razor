@page "/kardex"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Globalization

@inject IKardexRepository KardexRepo
@inject IProveedorRepository ProveedorRepo
@inject IFuncionarioRepository FuncRepo
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject ToastService Toast
@inject AuditoriaService Auditoria

<PageTitle>Kárdex · Almacén</PageTitle>

<div class="kx-page">

    @* ═══ TOPBAR ═══ *@
    <div class="kx-topbar">
        <div class="kx-topbar-title">
            <i class="bi bi-journal-text"></i>
            <h1>Kárdex</h1>
        </div>

        @if (_bienSeleccionado != null)
        {
            <div class="kx-buscador kx-buscador-inline">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar bien…"
                       value="@_textoBusqueda"
                       @oninput="OnBusquedaInput"
                       @onfocus="OnBusquedaFocus"
                       @onkeydown="OnBusquedaKeyDown"
                       autocomplete="off" />
                @if (!string.IsNullOrWhiteSpace(_textoBusqueda))
                {
                    <button type="button" class="kx-buscador-clear"
                            @onclick="LimpiarBusqueda"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }

                @if (_mostrarDropdown)
                {
                    <div class="kx-dropdown" @onmousedown:preventDefault="true">
                        @if (_resultadosBusqueda.Count > 0)
                        {
                            @foreach (var b in _resultadosBusqueda.Take(15))
                            {
                                var bien = b;
                                <button type="button" class="kx-dropdown-item"
                                        @onclick="() => SeleccionarBien(bien)"
                                        @onclick:stopPropagation="true">
                                    <div class="kx-dropdown-row">
                                        <code>@bien.Codigo</code>
                                        <strong>@bien.Nombre</strong>
                                    </div>
                                    <div class="kx-dropdown-meta">
                                        <span>@bien.StockActual.ToString("N2") @bien.UnidadMedida</span>
                                        <span>@bien.CppActual.ToString("C0", CulturaCOP)</span>
                                    </div>
                                </button>
                            }
                        }
                        else
                        {
                            <div class="kx-dropdown-empty">
                                <i class="bi bi-search"></i>
                                <span>Sin resultados</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @* ═══ CONTENIDO ═══ *@
    @if (_bienSeleccionado != null)
    {
        @* ═══ STRIP ═══ *@
        <div class="kx-strip @(_bienSeleccionado.BajoStockMinimo ? "kx-strip-warn" : "")">
            <div class="kx-strip-bien">
                <code>@_bienSeleccionado.Codigo</code>
                <strong>@_bienSeleccionado.Nombre</strong>
                @if (_bienSeleccionado.BajoStockMinimo)
                {
                    <span class="kx-strip-alerta">
                        <i class="bi bi-exclamation-triangle-fill"></i> Bajo stock
                    </span>
                }
            </div>

            <div class="kx-strip-metrics">
                <span class="kx-metric">
                    <label>Stock</label>
                    <b>@_bienSeleccionado.StockActual.ToString("N2")</b>
                    <small>@_bienSeleccionado.UnidadMedida</small>
                </span>
                <span class="kx-metric-sep">·</span>
                <span class="kx-metric">
                    <label>Mín</label>
                    <b>@_bienSeleccionado.StockMinimo.ToString("N2")</b>
                </span>
                <span class="kx-metric-sep">·</span>
                <span class="kx-metric">
                    <label>CPP</label>
                    <b>@_bienSeleccionado.CppActual.ToString("C2", CulturaCOP)</b>
                </span>
                <span class="kx-metric-sep">·</span>
                <span class="kx-metric kx-metric-highlight">
                    <label>Valor stock</label>
                    <b>@_bienSeleccionado.ValorStock.ToString("C0", CulturaCOP)</b>
                </span>
            </div>
        </div>

        @* ═══ FORMULARIO ═══ *@
        <div class="kx-panel">
            <div class="kx-panel-header">
                <div class="kx-panel-title">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Registrar movimiento</span>
                </div>
                <span class="kx-panel-hint">Inmutable · use ajustes para corregir</span>
            </div>

            <EditForm Model="_movDTO" OnValidSubmit="RegistrarMovimiento">
                <DataAnnotationsValidator />

                <div class="kx-form">
                    <div class="kx-field">
                        <label for="mov-tipo">Tipo *</label>
                        <div class="kx-input">
                            <i class="bi bi-arrow-left-right"></i>
                            <InputSelect id="mov-tipo" @bind-Value="_movDTO.TipoMovimiento">
                                <option value="ENTRADA">ENTRADA (+)</option>
                                <option value="SALIDA">SALIDA (−)</option>
                                <option value="AJUSTE_POS">AJUSTE (+)</option>
                                <option value="AJUSTE_NEG">AJUSTE (−)</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="kx-field">
                        <label for="mov-fecha">Fecha *</label>
                        <div class="kx-input">
                            <i class="bi bi-calendar-event"></i>
                            <input id="mov-fecha"
                                   type="text"
                                   class="kx-input-date"
                                   placeholder="dd/mm/aaaa"
                                   value="@(_movDTO.FechaMovimiento?.ToString("yyyy-MM-dd"))"
                                   @onchange="OnFechaChanged"
                                   readonly />
                        </div>
                    </div>

                    <div class="kx-field">
                        <label for="mov-cantidad">Cantidad *</label>
                        <div class="kx-input">
                            <i class="bi bi-123"></i>
                            <input id="mov-cantidad"
                                   type="text"
                                   inputmode="decimal"
                                   class="kx-input-number"
                                   value="@_cantidadTexto"
                                   @oninput="OnCantidadInput"
                                   @onblur="OnCantidadBlur"
                                   placeholder="0,00" />
                        </div>
                        @if (!string.IsNullOrEmpty(_errorCantidad))
                        {
                            <span class="kx-error">@_errorCantidad</span>
                        }
                    </div>

                    <div class="kx-field">
                        <label for="mov-costo">
                            Costo unit.
                            @if (EsSalida)
                            {
                                <span class="kx-hint">usa CPP</span>
                            }
                        </label>
                        <div class="kx-input">
                            <i class="bi bi-currency-dollar"></i>
                            <input id="mov-costo"
                                   type="text"
                                   inputmode="decimal"
                                   class="kx-input-number"
                                   value="@_costoTexto"
                                   @oninput="OnCostoInput"
                                   @onblur="OnCostoBlur"
                                   placeholder="0,00"
                                   disabled="@EsSalida" />
                        </div>
                    </div>

                    <div class="kx-field">
                        <label for="mov-doc">Documento</label>
                        <div class="kx-input">
                            <i class="bi bi-receipt"></i>
                            <InputText id="mov-doc"
                                       @bind-Value="_movDTO.DocumentoReferencia"
                                       placeholder="Factura / Acta" />
                        </div>
                    </div>

                    <div class="kx-field">
                        <label for="mov-prov">Proveedor</label>
                        <div class="kx-input">
                            <i class="bi bi-shop"></i>
                            <InputSelect id="mov-prov"
                                         @bind-Value="_movDTO.ProveedorId" disabled="@EsSalida">
                                <option value="">— Sin proveedor —</option>
                                @foreach (var p in _proveedores)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="kx-field">
                        <label for="mov-recibe">Recibe</label>
                        <div class="kx-input">
                            <i class="bi bi-person-check"></i>
                            <InputSelect id="mov-recibe"
                                         @bind-Value="_movDTO.FuncionarioRecibeId">
                                <option value="">— Sin asignar —</option>
                                @foreach (var f in _funcionarios)
                                {
                                    <option value="@f.Id">@f.NombreCompleto</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    @* ═══ Fila 2: Observaciones (6/7) + Botón (1/7) ═══ *@
                    <div class="kx-field kx-field-obs">
                        <label for="mov-obs">Observaciones</label>
                        <div class="kx-input">
                            <i class="bi bi-chat-left-text"></i>
                            <InputText id="mov-obs"
                                       @bind-Value="_movDTO.Observaciones"
                                       placeholder="Notas opcionales" />
                        </div>
                    </div>

                    <div class="kx-field kx-field-btn">
                        <button type="submit" class="kx-btn-primary">
                            <i class="bi bi-check-circle-fill"></i>
                            Registrar
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        @* ═══ HISTÓRICO CON FILTROS ═══ *@
        <div class="kx-panel">
            <div class="kx-panel-header">
                <div class="kx-panel-title">
                    <i class="bi bi-clock-history"></i>
                    <span>Histórico de movimientos</span>
                </div>
                <span class="kx-panel-badge">@(_movimientosFiltrados.Count())</span>
            </div>

            @* ═══ BARRA DE FILTROS ═══ *@
            <div class="filtros-tabla">
                <div class="filtro-busqueda">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           placeholder="Buscar por documento…"
                           value="@_filtroDocumento"
                           @oninput="OnFiltroDocumentoChanged" />
                    @if (!string.IsNullOrEmpty(_filtroDocumento))
                    {
                        <button class="filtro-clear" @onclick="LimpiarFiltroDocumento" title="Limpiar búsqueda">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>

                <div class="filtros-tabla-derecha">

                    @* ═══ Dropdown Tipo ═══ *@
                    <details class="dropdown-filtro" id="dropdown-tipo-kx">
                        <summary class="dropdown-filtro-trigger">
                            <i class="bi bi-diagram-3"></i>
                            <span>@(_filtroTipo switch
                                    {
                                        "ENTRADA" => "Entradas",
                                        "SALIDA" => "Salidas",
                                        "AJUSTE_POS" => "Ajustes (+)",
                                        "AJUSTE_NEG" => "Ajustes (−)",
                                        _ => "Todos los tipos"
                                    })</span>
                            <i class="bi bi-chevron-down dropdown-filtro-chevron"></i>
                        </summary>

                        <div class="dropdown-filtro-panel">
                            <div class="dropdown-filtro-item @(string.IsNullOrEmpty(_filtroTipo) ? "active" : "")"
                                 @onclick="SeleccionarTipoTodos">
                                <i class="bi bi-grid-3x3"></i>
                                <span>Todos los tipos</span>
                                @if (string.IsNullOrEmpty(_filtroTipo))
                                {
                                    <i class="bi bi-check2 dropdown-filtro-check"></i>
                                }
                            </div>

                            <div class="dropdown-filtro-divider"></div>

                            <div class="dropdown-filtro-item @(_filtroTipo == "ENTRADA" ? "active" : "")"
                                 @onclick="SeleccionarTipoEntrada">
                                <i class="bi bi-box-arrow-in-down"></i>
                                <span>Entradas (+)</span>
                                @if (_filtroTipo == "ENTRADA")
                                {
                                    <i class="bi bi-check2 dropdown-filtro-check"></i>
                                }
                            </div>

                            <div class="dropdown-filtro-item @(_filtroTipo == "SALIDA" ? "active" : "")"
                                 @onclick="SeleccionarTipoSalida">
                                <i class="bi bi-box-arrow-up"></i>
                                <span>Salidas (−)</span>
                                @if (_filtroTipo == "SALIDA")
                                {
                                    <i class="bi bi-check2 dropdown-filtro-check"></i>
                                }
                            </div>

                            <div class="dropdown-filtro-item @(_filtroTipo == "AJUSTE_POS" ? "active" : "")"
                                 @onclick="SeleccionarTipoAjustePos">
                                <i class="bi bi-plus-circle"></i>
                                <span>Ajustes (+)</span>
                                @if (_filtroTipo == "AJUSTE_POS")
                                {
                                    <i class="bi bi-check2 dropdown-filtro-check"></i>
                                }
                            </div>

                            <div class="dropdown-filtro-item @(_filtroTipo == "AJUSTE_NEG" ? "active" : "")"
                                 @onclick="SeleccionarTipoAjusteNeg">
                                <i class="bi bi-dash-circle"></i>
                                <span>Ajustes (−)</span>
                                @if (_filtroTipo == "AJUSTE_NEG")
                                {
                                    <i class="bi bi-check2 dropdown-filtro-check"></i>
                                }
                            </div>
                        </div>
                    </details>

                    @* ═══ Dropdown Fecha ═══ *@
                    <details class="dropdown-filtro" id="dropdown-fecha-kx">
                        <summary class="dropdown-filtro-trigger">
                            <i class="bi bi-calendar-range"></i>
                            <span>@GetTextoFiltroFecha()</span>
                            <i class="bi bi-chevron-down dropdown-filtro-chevron"></i>
                        </summary>

                        <div class="dropdown-filtro-panel dropdown-filtro-panel-fechas">
                            <div class="dropdown-filtro-fecha-grupo">
                                <label>Desde</label>
                                <input type="date"
                                       class="dropdown-filtro-fecha-input"
                                       value="@(_filtroFechaDesde?.ToString("yyyy-MM-dd"))"
                                       @onchange="OnFiltroFechaDesdeChanged" />
                            </div>

                            <div class="dropdown-filtro-fecha-grupo">
                                <label>Hasta</label>
                                <input type="date"
                                       class="dropdown-filtro-fecha-input"
                                       value="@(_filtroFechaHasta?.ToString("yyyy-MM-dd"))"
                                       @onchange="OnFiltroFechaHastaChanged" />
                            </div>

                            <div class="dropdown-filtro-divider"></div>

                            <div class="dropdown-filtro-item"
                                 @onclick="LimpiarFiltroFecha">
                                <i class="bi bi-x-circle"></i>
                                <span>Limpiar fechas</span>
                            </div>
                        </div>
                    </details>

                    @if (HayFiltrosActivos)
                    {
                        <button class="btn-limpiar-todos" @onclick="LimpiarFiltros" title="Limpiar todos los filtros">
                            <i class="bi bi-x-circle"></i>
                            Limpiar
                        </button>
                    }

                    <span class="badge-total">
                        <i class="bi bi-clock-history"></i>
                        <strong>@_movimientosFiltrados.Count()</strong> movimientos
                        @if (HayFiltrosActivos)
                        {
                            <span class="filtro-activo-tag">· Filtrado</span>
                        }
                    </span>
                </div>
            </div>

            <div class="kx-table-wrapper">
                <table class="kx-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th class="kx-num">Cant.</th>
                            <th class="kx-num">Costo u.</th>
                            <th class="kx-num">Valor</th>
                            <th class="kx-num">Saldo</th>
                            <th class="kx-num">Valor saldo</th>
                            <th class="kx-num">CPP</th>
                            <th>Doc.</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_movimientosFiltrados.Any())
                        {
                            <tr>
                                <td colspan="10" class="kx-table-empty">
                                    @if (HayFiltrosActivos)
                                    {
                                        <text>Sin resultados para los filtros aplicados.</text>
                                    }
                                    else
                                    {
                                        <text>Sin movimientos registrados.</text>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var m in _movimientosPaginados)
                            {
                                <tr>
                                    <td class="kx-mono">@m.FechaMovimiento?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="kx-tipo kx-tipo-@m.TipoMovimiento.ToLower()">
                                            @m.TipoMovimiento
                                        </span>
                                    </td>
                                    <td class="kx-num">@m.Cantidad.ToString("N2")</td>
                                    <td class="kx-num">@m.CostoUnitario.ToString("C2", CulturaCOP)</td>
                                    <td class="kx-num">@m.ValorMovimiento.ToString("C0", CulturaCOP)</td>
                                    <td class="kx-num"><strong>@m.SaldoCantidad.ToString("N2")</strong></td>
                                    <td class="kx-num">@m.SaldoValor.ToString("C0", CulturaCOP)</td>
                                    <td class="kx-num">@m.Cpp.ToString("C2", CulturaCOP)</td>
                                    <td class="kx-mono">@m.DocumentoReferencia</td>
                                    <td class="kx-muted">@m.Observaciones</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (_movimientosFiltrados.Any())
            {
                <div class="kx-pagination">
                    <span class="kx-pagination-info">
                        @((_paginaMovimientos - 1) * _tamanoMovimientos + 1)–@Math.Min(_paginaMovimientos * _tamanoMovimientos, _movimientosFiltrados.Count())
                        de @_movimientosFiltrados.Count()
                    </span>

                    <div class="kx-pagination-controls">
                        <button type="button" class="kx-pg-btn"
                                @onclick="() => CambiarPaginaMovimientos(_paginaMovimientos - 1)"
                                disabled="@(_paginaMovimientos <= 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span class="kx-pg-page">@_paginaMovimientos / @_totalPaginasMovimientos</span>
                        <button type="button" class="kx-pg-btn"
                                @onclick="() => CambiarPaginaMovimientos(_paginaMovimientos + 1)"
                                disabled="@(_paginaMovimientos >= _totalPaginasMovimientos)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>

                    <select class="kx-pg-size" @bind="_tamanoMovimientos" @bind:after="CambiarTamanoMovimientos">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            }
        </div>
    }
    else if (_inicializado)
    {
        <div class="kx-empty">
            <i class="bi bi-journal-text"></i>
            <p>No hay bienes de consumo registrados.</p>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo CulturaCOP = CultureInfo.GetCultureInfo("es-CO");

    [SupplyParameterFromQuery(Name = "bienId")]
    public int? BienIdQuery { get; set; }

    private List<BienConsumoDTO> _bienes = new();
    private List<BienConsumoDTO> _resultadosBusqueda = new();
    private List<MovimientoConsumoDTO>? _movimientos;
    private List<ProveedorDTO> _proveedores = new();
    private List<FuncionarioDTO> _funcionarios = new();

    private int _bienIdSeleccionado = 0;
    private BienConsumoDTO? _bienSeleccionado;
    private string _textoBusqueda = string.Empty;
    private bool _mostrarDropdown = false;
    private bool _inicializado = false;

    private MovimientoConsumoDTO _movDTO = new();

    private int _paginaMovimientos = 1;
    private int _tamanoMovimientos = 25;

    private string _cantidadTexto = "0,00";
    private string _costoTexto = "0,00";
    private string _errorCantidad = "";

    // ═══ Filtros ═══
    private DateTime? _filtroFechaDesde;
    private DateTime? _filtroFechaHasta;
    private string _filtroTipo = "";
    private string _filtroDocumento = "";

    private bool HayFiltrosActivos =>
        _filtroFechaDesde.HasValue ||
        _filtroFechaHasta.HasValue ||
        !string.IsNullOrWhiteSpace(_filtroTipo) ||
        !string.IsNullOrWhiteSpace(_filtroDocumento);

    private string GetTextoFiltroFecha()
    {
        if (!_filtroFechaDesde.HasValue && !_filtroFechaHasta.HasValue)
            return "Cualquier fecha";

        if (_filtroFechaDesde.HasValue && _filtroFechaHasta.HasValue)
            return $"{_filtroFechaDesde.Value:dd/MM} – {_filtroFechaHasta.Value:dd/MM}";

        if (_filtroFechaDesde.HasValue)
            return $"Desde {_filtroFechaDesde.Value:dd/MM/yyyy}";

        return $"Hasta {_filtroFechaHasta!.Value:dd/MM/yyyy}";
    }

    private IEnumerable<MovimientoConsumoDTO> _movimientosFiltrados
    {
        get
        {
            if (_movimientos is null) return Enumerable.Empty<MovimientoConsumoDTO>();

            var query = _movimientos.AsEnumerable();

            if (_filtroFechaDesde.HasValue)
            {
                var desde = _filtroFechaDesde.Value.Date;
                query = query.Where(m => m.FechaMovimiento.HasValue && m.FechaMovimiento.Value.Date >= desde);
            }

            if (_filtroFechaHasta.HasValue)
            {
                var hasta = _filtroFechaHasta.Value.Date;
                query = query.Where(m => m.FechaMovimiento.HasValue && m.FechaMovimiento.Value.Date <= hasta);
            }

            if (!string.IsNullOrWhiteSpace(_filtroTipo))
            {
                query = query.Where(m => m.TipoMovimiento == _filtroTipo);
            }

            if (!string.IsNullOrWhiteSpace(_filtroDocumento))
            {
                var doc = _filtroDocumento.Trim().ToLowerInvariant();
                query = query.Where(m =>
                    (m.DocumentoReferencia?.ToLowerInvariant().Contains(doc) ?? false));
            }

            return query.ToList();
        }
    }

    private IEnumerable<MovimientoConsumoDTO> _movimientosPaginados =>
        _movimientosFiltrados
            .Skip((_paginaMovimientos - 1) * _tamanoMovimientos)
            .Take(_tamanoMovimientos);

    private int _totalPaginasMovimientos
    {
        get
        {
            var total = _movimientosFiltrados.Count();
            return total == 0 ? 1 : (int)Math.Ceiling((double)total / _tamanoMovimientos);
        }
    }

    private bool EsSalida => _movDTO.TipoMovimiento == "SALIDA" || _movDTO.TipoMovimiento == "AJUSTE_NEG";

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("kardex.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await Seguridad.TienePermisoAsync("kardex.ver")) return;

        try
        {
            _bienes = (await KardexRepo.ObtenerBienesConsumoAsync()).ToList();
            _proveedores = (await ProveedorRepo.ObtenerTodosAsync()).ToList();
            _funcionarios = (await FuncRepo.ObtenerTodosAsync()).ToList();

            BienConsumoDTO? bienInicial = null;

            if (BienIdQuery.HasValue && BienIdQuery.Value > 0)
            {
                bienInicial = _bienes.FirstOrDefault(b => b.Id == BienIdQuery.Value);
            }

            if (bienInicial == null && _bienes.Any())
            {
                bienInicial = _bienes.First();
            }

            if (bienInicial != null)
            {
                await SeleccionarBien(bienInicial);
            }

            _inicializado = true;
            StateHasChanged();

            // ═══ Inicializar Flatpickr ═══
            await InicializarFlatpickr();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Kardex] Error en OnAfterRenderAsync: {ex.Message}");
            _inicializado = true;
            StateHasChanged();
        }
    }

    private async Task InicializarFlatpickr()
    {
        try
        {
            await Task.Delay(150);
            var fechaInicial = _movDTO.FechaMovimiento?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
            await JS.InvokeVoidAsync("initFlatpickr", "#mov-fecha", fechaInicial);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Kardex] Error al inicializar Flatpickr: {ex.Message}");
        }
    }

    // ═══ BÚSQUEDA ═══

    private void OnBusquedaFocus()
    {
        _mostrarDropdown = true;
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            _resultadosBusqueda = _bienes.Take(15).ToList();
        }
        else
        {
            FiltrarBienes();
        }
    }

    private void OnBusquedaInput(ChangeEventArgs e)
    {
        _textoBusqueda = e.Value?.ToString() ?? string.Empty;
        _mostrarDropdown = true;

        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            _resultadosBusqueda = _bienes.Take(15).ToList();
        }
        else
        {
            FiltrarBienes();
        }
    }

    private void FiltrarBienes()
    {
        var filtro = _textoBusqueda.Trim().ToLowerInvariant();
        _resultadosBusqueda = _bienes
            .Where(b =>
                (b.Codigo?.ToLowerInvariant().Contains(filtro) ?? false) ||
                (b.Nombre?.ToLowerInvariant().Contains(filtro) ?? false))
            .OrderBy(b => b.Codigo)
            .ToList();
    }

    private void OnBusquedaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _mostrarDropdown = false;
            return;
        }

        if (e.Key == "Enter" && _mostrarDropdown && _resultadosBusqueda.Count > 0)
        {
            _ = SeleccionarBien(_resultadosBusqueda[0]);
        }
    }

    private void LimpiarBusqueda()
    {
        _textoBusqueda = string.Empty;
        _resultadosBusqueda = _bienes.Take(15).ToList();
        _mostrarDropdown = true;
    }

