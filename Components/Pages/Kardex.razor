    // ═══ PARSER MEJORADO ═══

    private static bool TryParseDecimal(string? texto, out decimal valor)
    {
        valor = 0;
        if (string.IsNullOrWhiteSpace(texto)) return false;

        var limpio = texto.Replace("$", "").Replace(" ", "").Trim();

        if (limpio.Contains(','))
        {
            limpio = limpio.Replace(".", "").Replace(",", ".");
        }
        else if (limpio.Contains('.'))
        {
            var partes = limpio.Split('.');

            if (partes.Length > 1 && partes.Last().Length == 3)
            {
                limpio = limpio.Replace(".", "");
            }
        }

        return decimal.TryParse(limpio,
            NumberStyles.Any,
            CultureInfo.InvariantCulture,
            out valor);
    }

    // ═══ REGISTRAR — CON AUDITORÍA ═══

    private async Task RegistrarMovimiento()
    {
        if (!await Seguridad.TienePermisoAsync("kardex.movimiento"))
        {
            Toast.Error("No tiene permiso para registrar movimientos.");
            return;
        }

        if (_bienSeleccionado is null || _bienIdSeleccionado == 0)
        {
            Toast.Error("Debe seleccionar un bien antes de registrar el movimiento.");
            return;
        }

        if (_movDTO.Cantidad <= 0)
        {
            _errorCantidad = "Ingrese una cantidad válida mayor a 0";
            Toast.Error("La cantidad debe ser mayor a 0");
            return;
        }

        try
        {
            _movDTO.BienId = _bienIdSeleccionado;
            var idMovimiento = await KardexRepo.RegistrarMovimientoAsync(_movDTO);

            // ═══ AUDITORÍA: CREAR movimiento de Kardex ═══
            await Auditoria.RegistrarCreacionAsync(
                modulo: "kardex",
                objetoTipo: "MovimientoConsumo",
                objetoId: idMovimiento,
                objetoCodigo: _movDTO.DocumentoReferencia ?? "SIN-DOC",
                objetoDescripcion: $"Movimiento {_movDTO.TipoMovimiento} · {_bienSeleccionado.Codigo} · Cant {_movDTO.Cantidad:N2}",
                despues: new
                {
                    BienId = _bienIdSeleccionado,
                    BienCodigo = _bienSeleccionado.Codigo,
                    BienNombre = _bienSeleccionado.Nombre,
                    TipoMovimiento = _movDTO.TipoMovimiento,
                    Cantidad = _movDTO.Cantidad,
                    CostoUnitario = _movDTO.CostoUnitario,
                    FechaMovimiento = _movDTO.FechaMovimiento,
                    DocumentoReferencia = _movDTO.DocumentoReferencia,
                    FuncionarioRecibeId = _movDTO.FuncionarioRecibeId,
                    Observaciones = _movDTO.Observaciones
                },
                motivo: $"Registro de movimiento de {_movDTO.TipoMovimiento} en Kardex"
            );

            Toast.Exito("Movimiento registrado correctamente");

            _bienes = (await KardexRepo.ObtenerBienesConsumoAsync()).ToList();

            var bienActualizado = await KardexRepo.ObtenerBienConsumoPorIdAsync(_bienIdSeleccionado);
            if (bienActualizado != null)
            {
                _bienSeleccionado = bienActualizado;
            }

            await CargarMovimientos();

            _movDTO = new MovimientoConsumoDTO
            {
                BienId = _bienIdSeleccionado,
                FechaMovimiento = DateTime.Today,
                TipoMovimiento = "ENTRADA",
                Cantidad = 0,
                CostoUnitario = 0
            };

            _cantidadTexto = "0,00";
            _costoTexto = "0,00";
            _errorCantidad = "";

            StateHasChanged();

            // Re-inicializar Flatpickr con la nueva fecha
            await InicializarFlatpickr();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

