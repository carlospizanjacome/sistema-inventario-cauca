        _filtroFechaDesde = null;
        _filtroFechaHasta = null;
        _filtroTipo = "";
        _filtroDocumento = "";

        await CargarMovimientos();

        var bienActualizado = await KardexRepo.ObtenerBienConsumoPorIdAsync(bien.Id);
        if (bienActualizado != null)
        {
            _bienSeleccionado = bienActualizado;
        }

        _movDTO = new MovimientoConsumoDTO
        {
            BienId = _bienIdSeleccionado,
            FechaMovimiento = DateTime.Today,
            TipoMovimiento = "ENTRADA",
            Cantidad = 0,
            CostoUnitario = 0
        };

        _cantidadTexto = "0,00";
        _costoTexto = "0,00";
        _errorCantidad = "";

        StateHasChanged();

        // Re-inicializar Flatpickr cada vez que se cambia de bien
        await InicializarFlatpickr();
    }

