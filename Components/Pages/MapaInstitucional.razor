@page "/mapa-institucional"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Microsoft.JSInterop

@inject ISedeRepository SedeRepo
@inject IInstitucionRepository InstRepo
@inject IReporteRepository ReporteRepo
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>Mapa Institucional · Almacén</PageTitle>

<div class="page-container page-crud">
    <div class="page-header">
        <div>
            <h1><i class="bi bi-geo-alt-fill"></i> Mapa de Popayán</h1>
            <p class="subtitle">Ubicación de sedes con resumen de inventario</p>
        </div>

        <!-- SELECTOR DE INSTITUCIÓN -->
        <div class="header-actions">
            <div class="input-icon" style="width: 320px; background: white;">
                <i class="bi bi-bank"></i>
                <select class="form-control" @bind="InstitucionSeleccionadaId" @bind:after="FiltrarMapaAsync">
                    <option value="0">🌍 Todas las Instituciones (Popayán)</option>
                    @foreach (var inst in _instituciones)
                    {
                        <option value="@inst.Id">@inst.Nombre</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="card-table" style="padding: 40px; text-align: center;">
            <div class="spinner-border text-primary" role="status"></div>
            <p style="margin-top: 15px; color: #64748b;">Cargando mapa e inventario…</p>
        </div>
    }
    else
    {
        <div style="display: flex; gap: 20px; height: calc(100vh - 220px);">

            <!-- MAPA -->
            <div class="card-table" style="flex: 7; padding: 0; overflow: hidden; position: relative;">
                <div id="mapa-institucional" style="height: 100%; width: 100%;"></div>
            </div>

            <!-- PANEL DE DATOS -->
            <div class="card-table" style="flex: 3; padding: 20px; display: flex; flex-direction: column; overflow-y: auto;">

                @if (_sedeSeleccionada is null)
                {
                    <div style="text-align: center; margin: auto; color: #64748b;">
                        <i class="bi bi-hand-index-thumb" style="font-size: 3rem; color: #cbd5e1;"></i>
                        <h4 style="margin-top: 15px;">Selecciona una Sede</h4>
                        <p>Haz clic en uno de los pines del mapa para visualizar su inventario.</p>
                    </div>
                }
                else
                {
                    <h3 style="color: var(--primary); border-bottom: 2px solid var(--primary-light); padding-bottom: 10px; margin-bottom: 15px;">
                        @_sedeSeleccionada.Nombre
                    </h3>

                    <div style="margin-bottom: 10px;">
                        <span class="badge" style="background: #e0e7ff; color: #3730a3; padding: 5px 10px;">@_sedeSeleccionada.Tipo</span>
                        <span class="text-muted" style="font-size: 0.85rem; margin-left: 5px;">
                            <i class="bi bi-geo"></i> @_sedeSeleccionada.Direccion
                        </span>
                    </div>

                    <hr />

                    @if (_statsSeleccionada is null)
                    {
                        <div class="alert alert-warning" style="font-size: 0.85rem;">
                            <i class="bi bi-exclamation-triangle"></i>
                            Esta sede aún no tiene datos consolidados de inventario.
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 10px;">
                            <div style="background: #f8fafc; border-left: 4px solid #1e40af; padding: 12px; border-radius: 4px;">
                                <span style="font-size: 0.8rem; color: #64748b; font-weight: 600;">TOTAL BIENES</span>
                                <div style="font-size: 1.5rem; font-weight: 800; color: #0f172a;">@_statsSeleccionada.TotalBienes</div>
                            </div>

                            <div style="background: #f0fdf4; border-left: 4px solid #059669; padding: 12px; border-radius: 4px;">
                                <span style="font-size: 0.8rem; color: #64748b; font-weight: 600;">VALOR PPE (DEVOLUTIVOS)</span>
                                <div style="font-size: 1.5rem; font-weight: 800; color: #065f46;">@_statsSeleccionada.ValorAdquisicion.ToString("C0")</div>
                            </div>

                            <div style="background: #fffbeb; border-left: 4px solid #d97706; padding: 12px; border-radius: 4px;">
                                <span style="font-size: 0.8rem; color: #64748b; font-weight: 600;">STOCK CONSUMO</span>
                                <div style="font-size: 1.5rem; font-weight: 800; color: #92400e;">@_statsSeleccionada.ValorStockConsumo.ToString("C0")</div>
                            </div>
                        </div>
                    }

                    <button class="btn btn-outline-primary btn-sm" style="margin-top: 15px;"
                            @onclick="CentrarSedeSeleccionada">
                        <i class="bi bi-crosshair"></i> Centrar en el mapa
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<SedeDTO> _sedes = new();
    private List<InstitucionDTO> _instituciones = new();
    private List<ConsolidadoInstitucionDTO> _stats = new();

    private int InstitucionSeleccionadaId = 0;
    private SedeDTO? _sedeSeleccionada;
    private ConsolidadoInstitucionDTO? _statsSeleccionada;
    private DotNetObjectReference<MapaInstitucional>? _objRef;

    private bool _cargando = true;
    private bool _jsListo = false;

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);

        try
        {
            var t1 = SedeRepo.ObtenerTodasAsync();
            var t2 = ReporteRepo.ObtenerConsolidadoInstitucionesAsync();
            var t3 = InstRepo.ObtenerTodasAsync();

            await Task.WhenAll(t1, t2, t3);

            _sedes = (await t1).ToList();
            _stats = (await t2).ToList();
            _instituciones = (await t3).ToList();
        }
        catch (Exception ex)
        {
            Toast.Error("Error cargando datos del mapa: " + ex.Message);
        }
        finally
        {
            _cargando = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Cargar el script una sola vez, esperando a que exista la función
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    if (window.__mapaInstitucionalCargado) return;
                    window.__mapaInstitucionalCargado = true;
                    const s = document.createElement('script');
                    s.src = '/js/mapa-institucional.js';
                    s.onload = function() { window.__mapaInstitucionalListo = true; };
                    document.head.appendChild(s);
                })();
            ");

            // Esperar hasta que la función esté disponible (máx 5s)
            for (int i = 0; i < 50; i++)
            {
                var listo = await JS.InvokeAsync<bool>("eval",
                    "typeof window.inicializarMapaInstitucional === 'function'");
                if (listo) { _jsListo = true; break; }
                await Task.Delay(100);
            }

            if (!_jsListo)
            {
                Toast.Error("No se pudo cargar el script del mapa. Revisa la consola.");
                return;
            }

            await FiltrarMapaAsync();
        }
        catch (Exception ex)
        {
            Toast.Error("Error inicializando el mapa: " + ex.Message);
        }
    }

    private async Task FiltrarMapaAsync()
    {
        if (!_jsListo) return;

        var sedesFiltradas = InstitucionSeleccionadaId == 0
            ? _sedes
            : _sedes.Where(s => s.InstitucionId == InstitucionSeleccionadaId).ToList();

        _sedeSeleccionada = null;
        _statsSeleccionada = null;

        var sedesConMapa = sedesFiltradas
            .Where(s => s.Latitud.HasValue && s.Longitud.HasValue)
            .Select(s =>
            {
                var stat = _stats.FirstOrDefault(x => x.SedeId == s.Id);
                return new
                {
                    id = s.Id,
                    nombre = s.Nombre,
                    tipo = s.Tipo,

                    // ✅ CORRECCIÓN: Ahora sí le pasamos la dirección al mapa
                    direccion = s.Direccion,

                    lat = (double)s.Latitud!.Value,
                    lng = (double)s.Longitud!.Value,
                    bienes = stat?.TotalBienes ?? 0,
                    ppe = stat?.ValorAdquisicion ?? 0,
                    consumo = stat?.ValorStockConsumo ?? 0
                };
            })
            .ToList();

        try
        {
            await JS.InvokeVoidAsync("inicializarMapaInstitucional", _objRef, sedesConMapa);
        }
        catch (Exception ex)
        {
            Toast.Error("Error pintando el mapa: " + ex.Message);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void SeleccionarSedeEnMapa(int sedeId)
    {
        _sedeSeleccionada = _sedes.FirstOrDefault(s => s.Id == sedeId);
        _statsSeleccionada = _stats.FirstOrDefault(x => x.SedeId == sedeId);
        StateHasChanged();
    }

    private async Task CentrarSedeSeleccionada()
    {
        if (_sedeSeleccionada is null) return;
        try
        {
            // Si tienes un método para centrar en el JS, lo llamas aquí
            await JS.InvokeVoidAsync("eval", $"window._mapaInst.setView([{_sedeSeleccionada.Latitud}, {_sedeSeleccionada.Longitud}], 16)");
        }
        catch { /* silencioso */ }
    }

    public ValueTask DisposeAsync()
    {
        try
        {
            _ = JS.InvokeVoidAsync("eval",
                "if (window._mapaInst) { window._mapaInst.remove(); window._mapaInst = null; }");
        }
        catch { }
        _objRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}