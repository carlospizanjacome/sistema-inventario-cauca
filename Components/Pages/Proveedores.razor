@page "/proveedores"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IProveedorRepository ProveedorRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Proveedores · Almacén</PageTitle>

<div class="usuarios-page usuarios-fullscreen">

    <div class="modern-card panel-formulario">

        <div class="card-top-compact d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
            <div class="card-icon-small-inline">
                <i class="bi @(editando ? "bi-pencil-square" : "bi-shop")" style="color: #4f46e5; font-size: 1.1rem;"></i>
            </div>
            <div class="d-flex align-items-baseline gap-2">
                <h5 class="m-0 fw-bold text-dark" style="font-size: 1rem;">@(editando ? "Editar Proveedor" : "Nuevo Proveedor")</h5>
                <span class="text-muted d-none d-sm-inline" style="font-size: 0.75rem;">| Registro de proveedores del sistema</span>
            </div>
        </div>

        <EditForm @key="proveedorEditandoId" Model="proveedorDTO" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="container-fluid p-0">

                <div class="row g-2 mb-2">
                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>NIT</label>
                            <div class="input-modern">
                                <i class="bi bi-hash"></i>
                                <InputText class="form-control" @bind-Value="proveedorDTO.Nit" placeholder="900123456-7" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="modern-group">
                            <label>Nombre *</label>
                            <div class="input-modern">
                                <i class="bi bi-shop"></i>
                                <InputText class="form-control" @bind-Value="proveedorDTO.Nombre" />
                            </div>
                            <ValidationMessage For="() => proveedorDTO.Nombre" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="modern-group">
                            <label>Contacto</label>
                            <div class="input-modern">
                                <i class="bi bi-person"></i>
                                <InputText class="form-control" @bind-Value="proveedorDTO.Contacto" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <div class="modern-group">
                            <label>Dirección</label>
                            <div class="input-modern">
                                <i class="bi bi-geo-alt"></i>
                                <InputText class="form-control" @bind-Value="proveedorDTO.Direccion" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>Teléfono</label>
                            <div class="input-modern">
                                <i class="bi bi-telephone"></i>
                                <InputText class="form-control" @bind-Value="proveedorDTO.Telefono" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>Email</label>
                            <div class="input-modern">
                                <i class="bi bi-envelope"></i>
                                <InputText class="form-control" type="email" @bind-Value="proveedorDTO.Email" />
                            </div>
                            <ValidationMessage For="() => proveedorDTO.Email" />
                        </div>
                    </div>
                    <div class="col-md-2 d-flex align-items-end pb-2">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="proveedorDTO.Activo" id="chkActivoProv" />
                            <label class="form-check-label" for="chkActivoProv">Activo</label>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-12">
                        <div class="modern-group">
                            <label>Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="proveedorDTO.Observaciones" />
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-3 justify-content-end">
                @if (editando)
                {
                    <button type="button" class="btn btn-cancel px-4" @onclick="Cancelar">
                        <i class="bi bi-x-circle me-2"></i> Cancelar
                    </button>
                }
                <button type="submit" class="btn btn-save px-4">
                    <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill") me-2"></i>
                    @(editando ? "Actualizar Proveedor" : "Guardar Proveedor")
                </button>
            </div>
        </EditForm>
    </div>

    <!-- ═══════════ TABLA CON PAGINACIÓN ═══════════ -->
    <div class="modern-card panel-tabla-elastic position-relative">

        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por NIT, nombre o email…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
            <div class="filtro-info">
                <span class="badge-total">
                    <i class="bi bi-shop"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> proveedores
                </span>
            </div>
        </div>

        <div class="table-responsive style-scrollbar">
            <table class="table modern-table align-middle m-0">
                <thead>
                    <tr>
                        <th>NIT</th>
                        <th>Nombre</th>
                        <th>Contacto</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Cargando...
                        </td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Sin proveedores registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td><code>@p.Nit</code></td>
                                <td><strong>@p.Nombre</strong></td>
                                <td>@p.Contacto</td>
                                <td>@p.Telefono</td>
                                <td>@p.Email</td>
                                <td>
                                    <span class="badge @(p.Activo ? "badge-ok" : "badge-off")">
                                        @(p.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (puedeEditar)
                                    {
                                        <button class="btn-icon me-1" @onclick="() => Editar(p)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        <button class="btn-icon danger" @onclick="() => Eliminar(p)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="ProveedorDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private ResultadoPaginado<ProveedorDTO>? _pagina;
    private ProveedorDTO proveedorDTO = new();
    private bool editando = false;
    private int proveedorEditandoId;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("proveedores.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("proveedores.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("proveedores.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("proveedores.eliminar");

        await Cargar();
    }

    private async Task Cargar()
    {
        _pagina = await ProveedorRepo.ObtenerPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para crear proveedores.");
            return;
        }

        if (editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar proveedores.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(proveedorDTO.Nit))
        {
            if (await ProveedorRepo.ExisteNitAsync(proveedorDTO.Nit, editando ? proveedorEditandoId : null))
            {
                Toast.Error($"El NIT '{proveedorDTO.Nit}' ya está registrado.");
                return;
            }
        }

        try
        {
            if (editando)
            {
                await ProveedorRepo.ActualizarAsync(proveedorDTO);
                Toast.Exito("Proveedor actualizado correctamente");
            }
            else
            {
                await ProveedorRepo.CrearAsync(proveedorDTO);
                Toast.Exito("Proveedor creado correctamente");
            }

            Cancelar();
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(ProveedorDTO p)
    {
        if (!puedeEditar) return;

        editando = true;
        proveedorEditandoId = p.Id;

        proveedorDTO.Id = p.Id;
        proveedorDTO.Nit = p.Nit;
        proveedorDTO.Nombre = p.Nombre;
        proveedorDTO.Direccion = p.Direccion;
        proveedorDTO.Telefono = p.Telefono;
        proveedorDTO.Email = p.Email;
        proveedorDTO.Contacto = p.Contacto;
        proveedorDTO.Observaciones = p.Observaciones;
        proveedorDTO.Activo = p.Activo;

        StateHasChanged();
    }

    private async Task Eliminar(ProveedorDTO p)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar proveedores.");
            return;
        }

        var ok = await Confirm.Peligroso($"¿Eliminar el proveedor '{p.Nombre}'?");
        if (!ok) return;

        if (await ProveedorRepo.TieneEntradasAsync(p.Id))
        {
            Toast.Error("No se puede eliminar: tiene entradas asociadas.");
            return;
        }

        try
        {
            await ProveedorRepo.EliminarAsync(p.Id);
            Toast.Exito("Proveedor eliminado correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Cancelar()
    {
        proveedorDTO = new ProveedorDTO();
        editando = false;
        proveedorEditandoId = 0;
        StateHasChanged();
    }
}