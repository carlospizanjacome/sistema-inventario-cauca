@page "/proveedores"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IProveedorRepository ProveedorRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Proveedores · Almacén</PageTitle>

<div class="page-container page-crud">

    @* ═══════════════ PAGE HEADER (oculto si form abierto) ═══════════════ *@
    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-shop"></i> Proveedores</h1>
                <p class="subtitle">Registro de proveedores del sistema</p>
            </div>

            <div class="header-actions">
                @if (puedeCrear)
                {
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nuevo Proveedor
                    </button>
                }
            </div>
        </div>
    }

    @* ═══════════════ FORM COLAPSABLE ═══════════════ *@
    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Proveedor" : "Nuevo Proveedor")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-shop"></i>
                    <div>
                        <div class="form-header-title">Proveedores</div>
                        <div class="form-header-subtitle">Registro de proveedores del sistema</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="CerrarFormulario" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="proveedorEditandoId" Model="proveedorDTO" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="form-group">
                        <label>NIT</label>
                        <div class="input-icon">
                            <i class="bi bi-hash"></i>
                            <InputText class="form-control" @bind-Value="proveedorDTO.Nit"
                                       placeholder="Ej: 900123456-7" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Nombre *</label>
                        <div class="input-icon">
                            <i class="bi bi-shop"></i>
                            <InputText class="form-control" @bind-Value="proveedorDTO.Nombre"
                                       placeholder="Nombre del proveedor" />
                        </div>
                        <ValidationMessage For="() => proveedorDTO.Nombre" />
                    </div>

                    <div class="form-group">
                        <label>Contacto</label>
                        <div class="input-icon">
                            <i class="bi bi-person"></i>
                            <InputText class="form-control" @bind-Value="proveedorDTO.Contacto"
                                       placeholder="Persona de contacto" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Dirección</label>
                        <div class="input-icon">
                            <i class="bi bi-geo-alt"></i>
                            <InputText class="form-control" @bind-Value="proveedorDTO.Direccion"
                                       placeholder="Dirección física" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Teléfono</label>
                        <div class="input-icon">
                            <i class="bi bi-telephone"></i>
                            <InputText class="form-control" @bind-Value="proveedorDTO.Telefono"
                                       placeholder="Ej: 8201234" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-icon">
                            <i class="bi bi-envelope"></i>
                            <InputText class="form-control" type="email" @bind-Value="proveedorDTO.Email"
                                       placeholder="correo@proveedor.com" />
                        </div>
                        <ValidationMessage For="() => proveedorDTO.Email" />
                    </div>

                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label>Observaciones</label>
                        <div class="input-icon">
                            <i class="bi bi-chat-left-text"></i>
                            <InputText class="form-control" @bind-Value="proveedorDTO.Observaciones"
                                       placeholder="Notas adicionales" />
                        </div>
                    </div>

                    <div class="form-group checkbox-group">
                        <label>
                            <InputCheckbox @bind-Value="proveedorDTO.Activo" />
                            Activo
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="CerrarFormulario">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }
    
    @* ═══════════════ CARD TABLE ═══════════════ *@
    <div class="card-table">

        @if (!_mostrarFormulario)
        {
            <div class="filtros-tabla">
                <div class="filtro-busqueda">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           placeholder="Buscar por NIT, nombre o email…"
                           @bind="_filtroTexto"
                           @bind:event="oninput"
                           @bind:after="BuscarConDebounce" />
                    @if (!string.IsNullOrEmpty(_filtroTexto))
                    {
                        <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
                <div class="filtro-info">
                    <span class="badge-total">
                        <i class="bi bi-shop"></i>
                        <strong>@(_pagina?.TotalRegistros ?? 0)</strong> proveedores
                    </span>
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>NIT</th>
                        <th>Nombre</th>
                        <th>Contacto</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Cargando...</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Sin proveedores registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td><code>@p.Nit</code></td>
                                <td><strong>@p.Nombre</strong></td>
                                <td>@p.Contacto</td>
                                <td>@p.Telefono</td>
                                <td>@p.Email</td>
                                <td>
                                    <span class="badge @(p.Activo ? "badge-ok" : "badge-off")">
                                        @(p.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (puedeEditar)
                                    {
                                        <button class="btn-icon me-1" @onclick="() => Editar(p)" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        <button class="btn-icon danger" @onclick="() => Eliminar(p)" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="ProveedorDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private ResultadoPaginado<ProveedorDTO>? _pagina;
    private ProveedorDTO proveedorDTO = new();
    private bool editando = false;
    private bool _mostrarFormulario = false;
    private int proveedorEditandoId;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("proveedores.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("proveedores.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("proveedores.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("proveedores.eliminar");

        await Cargar();
    }

    private async Task Cargar()
    {
        _pagina = await ProveedorRepo.ObtenerPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
    }

    private void AbrirFormulario()
    {
        proveedorDTO = new ProveedorDTO { Activo = true };
        editando = false;
        proveedorEditandoId = 0;
        _mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario = false;
        proveedorDTO = new ProveedorDTO();
        editando = false;
        proveedorEditandoId = 0;
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para crear proveedores.");
            return;
        }

        if (editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar proveedores.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(proveedorDTO.Nit))
        {
            if (await ProveedorRepo.ExisteNitAsync(proveedorDTO.Nit, editando ? proveedorEditandoId : null))
            {
                Toast.Error($"El NIT '{proveedorDTO.Nit}' ya está registrado.");
                return;
            }
        }

        try
        {
            if (editando)
            {
                // ── EDICIÓN: guardar y MANTENER ABIERTO con los datos ──
                await ProveedorRepo.ActualizarAsync(proveedorDTO);
                Toast.Exito($"Proveedor '{proveedorDTO.Nombre}' actualizado. Puede seguir editando.");
            }
            else
            {
                // ── CREACIÓN: guardar y MANTENER ABIERTO, limpiar form ──
                await ProveedorRepo.CrearAsync(proveedorDTO);
                Toast.Exito($"Proveedor '{proveedorDTO.Nombre}' creado. Puede continuar registrando.");

                // Limpiar el form manteniendo Activo = true
                proveedorDTO = new ProveedorDTO { Activo = true };

                // Enfocar el primer campo
                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { /* silencioso */ }
            }

            await Cargar();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(ProveedorDTO p)
    {
        if (!puedeEditar) return;

        editando = true;
        proveedorEditandoId = p.Id;
        _mostrarFormulario = true;

        proveedorDTO.Id = p.Id;
        proveedorDTO.Nit = p.Nit;
        proveedorDTO.Nombre = p.Nombre;
        proveedorDTO.Direccion = p.Direccion;
        proveedorDTO.Telefono = p.Telefono;
        proveedorDTO.Email = p.Email;
        proveedorDTO.Contacto = p.Contacto;
        proveedorDTO.Observaciones = p.Observaciones;
        proveedorDTO.Activo = p.Activo;

        StateHasChanged();
    }

    private async Task Eliminar(ProveedorDTO p)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar proveedores.");
            return;
        }

        var ok = await Confirm.Peligroso($"¿Eliminar el proveedor '{p.Nombre}'?");
        if (!ok) return;

        if (await ProveedorRepo.TieneEntradasAsync(p.Id))
        {
            Toast.Error("No se puede eliminar: tiene entradas asociadas.");
            return;
        }

        try
        {
            await ProveedorRepo.EliminarAsync(p.Id);
            Toast.Exito("Proveedor eliminado correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }
}