@page "/permisos"
@rendermode InteractiveServer

@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.DTOs
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IPermisoRepository PermisoRepository
@inject IJSRuntime JS
@inject UsuarioSesionService Sesion
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Permisos · Almacén</PageTitle>

<div class="page-container page-crud">

    @* ═══════════════ PAGE HEADER (oculto cuando el form está abierto) ═══════════════ *@
    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-shield-lock-fill"></i> Gestión de Permisos</h1>
                <p class="subtitle">Administración de permisos y módulos del sistema</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo" @onclick="AbrirFormularioNuevo">
                        <i class="bi bi-plus-lg"></i> Nuevo Permiso
                    </button>
                </div>
            }
        </div>
    }

    @* ═══════════════ FORM ═══════════════ *@
    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Permiso" : "Nuevo Permiso")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-shield-lock-fill"></i>
                    <div>
                        <div class="form-header-title">Permisos</div>
                        <div class="form-header-subtitle">Registro de permisos del sistema</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="CerrarFormulario" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="permisoEditandoId" Model="permisoDTO" OnValidSubmit="GuardarPermiso">
                <DataAnnotationsValidator />

                <div class="form-grid-3">

                    <div class="form-group">
                        <label>Código *</label>
                        <div class="input-icon">
                            <i class="bi bi-key-fill"></i>
                            <InputText class="form-control" @bind-Value="permisoDTO.Codigo" placeholder="Ej: bienes.ver" />
                        </div>
                        <ValidationMessage For="@(() => permisoDTO.Codigo)" class="form-error" />
                    </div>

                    <div class="form-group">
                        <label>Módulo *</label>
                        <div class="input-icon">
                            <i class="bi bi-grid-fill"></i>
                            @if (nuevoModulo)
                            {
                                <InputText class="form-control" @bind-Value="permisoDTO.Modulo" placeholder="Ej: Reportes" />
                            }
                            else
                            {
                                <select class="form-select" value="@permisoDTO.Modulo" @onchange="CambioModulo">
                                    <option value="">— Seleccione módulo —</option>
                                    @foreach (var m in modulosDisponibles)
                                    {
                                        <option value="@m">@m</option>
                                    }
                                    <option value="__NUEVO__">➕ Crear nuevo módulo…</option>
                                </select>
                            }
                        </div>
                        <ValidationMessage For="@(() => permisoDTO.Modulo)" class="form-error" />
                        @if (!nuevoModulo)
                        {
                            <small class="form-hint">¿Falta un módulo? Selecciona "Crear nuevo módulo…"</small>
                        }
                        else
                        {
                            <small class="form-hint text-brand" style="cursor:pointer;" @onclick="VolverAlListado">
                                ← Volver al listado
                            </small>
                        }
                    </div>

                    <div class="form-group">
                        <label>Estado</label>
                        <div class="input-icon">
                            <i class="bi bi-check-circle-fill"></i>
                            <InputSelect class="form-select" @bind-Value="estadoString">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group form-group-full">
                        <label>Descripción</label>
                        <div class="input-icon">
                            <i class="bi bi-chat-left-text"></i>
                            <InputTextArea class="form-control" rows="3" @bind-Value="permisoDTO.Descripcion"
                                           placeholder="Descripción del permiso y su alcance" />
                        </div>
                    </div>

                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="CerrarFormulario">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    @if ((!editando && puedeCrear) || (editando && puedeEditar))
                    {
                        <button type="submit" class="btn btn-save">
                            <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                            @(editando ? "Actualizar" : "Guardar")
                        </button>
                    }
                </div>
            </EditForm>
        </div>
    }

    @* ═══════════════ CARD TABLE ═══════════════ *@
    <div class="card-table">

        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por código, módulo o descripción…"
                       value="@_filtroTexto"
                       @oninput="OnFiltroInput" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
            <div class="filtro-info">
                <span class="badge-total">
                    <i class="bi bi-shield-lock-fill"></i>
                    <strong>@(_permisosFiltrados?.Count() ?? 0)</strong> permisos
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Módulo</th>
                        <th>Descripción</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (permisos == null)
                    {
                        <tr><td colspan="5" class="text-center py-3 text-muted">Cargando permisos…</td></tr>
                    }
                    else if (!permisos.Any())
                    {
                        <tr><td colspan="5" class="text-center py-3 text-muted">No existen permisos registrados.</td></tr>
                    }
                    else if (!_permisosFiltrados!.Any())
                    {
                        <tr><td colspan="5" class="text-center py-3 text-muted">Sin resultados para "@_filtroTexto".</td></tr>
                    }
                    else
                    {
                        @foreach (var permiso in _permisosFiltrados!)
                        {
                            <tr class="table-row-hover">
                                <td><code>@permiso.Codigo</code></td>
                                <td><span class="badge badge-neutral">@permiso.Modulo</span></td>
                                <td>@permiso.Descripcion</td>
                                <td class="text-center">
                                    <span class="badge @(permiso.Activo ? "badge-ok" : "badge-off")">
                                        @(permiso.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        @if (puedeEditar)
                                        {
                                            <button class="btn-action btn-action-edit"
                                                    @onclick="() => EditarPermiso(permiso)"
                                                    title="Editar permiso">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }
                                        @if (puedeEliminar)
                                        {
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => ConfirmarEliminar(permiso.Id, permiso.Codigo)"
                                                    title="Eliminar permiso">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private IEnumerable<Permiso>? permisos;
    private PermisoDTO permisoDTO = new();
    private bool editando = false;
    private int permisoEditandoId;
    private bool _mostrarFormulario = false;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    private List<string> modulosDisponibles = new();
    private bool nuevoModulo = false;

    private string _filtroTexto = string.Empty;
    private IEnumerable<Permiso>? _permisosFiltrados;

    private string estadoString
    {
        get => permisoDTO.Activo.ToString().ToLower();
        set => permisoDTO.Activo = bool.Parse(value);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("permisos.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("permisos.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("permisos.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("permisos.eliminar");

        await CargarPermisos();
    }

    private async Task CargarPermisos()
    {
        permisos = await PermisoRepository.ObtenerTodosAsync();

        modulosDisponibles = permisos
            .Select(p => p.Modulo ?? string.Empty)
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .Distinct()
            .OrderBy(m => m)
            .ToList();

        AplicarFiltro();
    }

    // ═══════════ FILTRO ═══════════
    private void AplicarFiltro()
    {
        if (permisos == null) { _permisosFiltrados = null; return; }

        if (string.IsNullOrWhiteSpace(_filtroTexto))
        {
            _permisosFiltrados = permisos;
        }
        else
        {
            var f = _filtroTexto.ToLower().Trim();
            _permisosFiltrados = permisos.Where(p =>
                (p.Codigo?.ToLower().Contains(f) ?? false) ||
                (p.Modulo?.ToLower().Contains(f) ?? false) ||
                (p.Descripcion?.ToLower().Contains(f) ?? false)
            );
        }
    }

    private void OnFiltroInput(ChangeEventArgs e)
    {
        _filtroTexto = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        AplicarFiltro();
    }

    // ═══════════ ABRIR / CERRAR FORM ═══════════
    private void AbrirFormularioNuevo()
    {
        LimpiarFormulario();
        _mostrarFormulario = true;
        _filtroTexto = string.Empty;
        AplicarFiltro();
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario = false;
        LimpiarFormulario();
        _filtroTexto = string.Empty;
        AplicarFiltro();
        StateHasChanged();
    }

    // ═══════════ MÓDULOS ═══════════
    private void CambioModulo(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString() ?? string.Empty;

        if (valor == "__NUEVO__")
        {
            nuevoModulo = true;
            permisoDTO.Modulo = string.Empty;
        }
        else
        {
            nuevoModulo = false;
            permisoDTO.Modulo = valor;
        }
    }

    private void VolverAlListado()
    {
        nuevoModulo = false;
        permisoDTO.Modulo = string.Empty;
    }

    // ═══════════ GUARDAR ═══════════
    private async Task GuardarPermiso()
    {
        if (!editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para crear permisos.");
            return;
        }

        if (editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar permisos.");
            return;
        }

        try
        {
            if (editando)
            {
                await PermisoRepository.ActualizarAsync(new Permiso
                {
                    Id = permisoEditandoId,
                    Codigo = permisoDTO.Codigo,
                    Descripcion = permisoDTO.Descripcion,
                    Modulo = permisoDTO.Modulo,
                    Activo = permisoDTO.Activo
                });
                Toast.Exito($"Permiso '{permisoDTO.Codigo}' actualizado.");
            }
            else
            {
                await PermisoRepository.CrearAsync(new Permiso
                {
                    Codigo = permisoDTO.Codigo,
                    Descripcion = permisoDTO.Descripcion,
                    Modulo = permisoDTO.Modulo,
                    Activo = permisoDTO.Activo
                });
                Toast.Exito($"Permiso '{permisoDTO.Codigo}' creado. Puede continuar registrando.");

                // Mantener módulo seleccionado si no estamos creando uno nuevo
                var moduloActual = nuevoModulo ? string.Empty : permisoDTO.Modulo;
                permisoDTO = new PermisoDTO { Activo = true, Modulo = moduloActual };

                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { /* silencioso */ }
            }

            _filtroTexto = string.Empty;
            await CargarPermisos();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    // ═══════════ EDITAR ═══════════
    private void EditarPermiso(Permiso permiso)
    {
        if (!puedeEditar) return;

        editando = true;
        permisoEditandoId = permiso.Id;
        _mostrarFormulario = true;

        permisoDTO.Id = permiso.Id;
        permisoDTO.Codigo = permiso.Codigo;
        permisoDTO.Descripcion = permiso.Descripcion;
        permisoDTO.Modulo = permiso.Modulo ?? string.Empty;
        permisoDTO.Activo = permiso.Activo;

        nuevoModulo = false;

        _filtroTexto = string.Empty;
        AplicarFiltro();

        StateHasChanged();
    }

    // ═══════════ ELIMINAR ═══════════
    private async Task ConfirmarEliminar(int id, string codigo)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar permisos.");
            return;
        }

        var ok = await Confirm.Peligroso(
            $"¿Eliminar el permiso '{codigo}'? Esta acción no se puede deshacer.");
        if (!ok) return;

        try
        {
            bool eliminado = await PermisoRepository.EliminarAsync(id);
            if (eliminado)
            {
                Toast.Exito("Permiso eliminado correctamente");
                await CargarPermisos();
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    // ═══════════ LIMPIAR ═══════════
    private void LimpiarFormulario()
    {
        permisoDTO.Id = 0;
        permisoDTO.Codigo = string.Empty;
        permisoDTO.Descripcion = string.Empty;
        permisoDTO.Modulo = string.Empty;
        permisoDTO.Activo = true;

        editando = false;
        permisoEditandoId = 0;
        nuevoModulo = false;

        StateHasChanged();
    }
}