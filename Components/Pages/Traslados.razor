@page "/traslados"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject ITrasladoRepository TrasladoRepo
@inject IBienRepository BienRepo
@inject IAulaRepository AulaRepo
@inject IFuncionarioRepository FuncRepo
@inject ISedeRepository SedeRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject AuditoriaService Auditoria
@inject UsuarioSesionService Sesion

<PageTitle>Traslados · Almacén</PageTitle>

<div class="page-container page-crud @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-arrow-left-right"></i> Traslados</h1>
                <p class="subtitle">Movimientos internos de bienes entre aulas y responsables</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo btn-nuevo-traslado" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nuevo Traslado
                    </button>
                </div>
            }
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "eye-fill" : "plus-circle")"></i>
                    <span>@(editando ? "Ver Traslado" : "Nuevo Traslado")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-arrow-left-right"></i>
                    <div>
                        <div class="form-header-title">Traslados</div>
                        <div class="form-header-subtitle">Movimientos internos de bienes</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="Cancelar" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (!editando)
            {
                <div class="info-banner">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>Al cambiar la Sede Destino, el sistema asignará automáticamente la Bodega de esa sede.</span>
                </div>
            }

            <EditForm @key="trasladoEditandoId" Model="trasladoDTO" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                @* ═══ FILA 1: Bien | Fecha | Sede Destino ═══ *@
                <div class="form-fila-1" style="grid-template-columns: 2fr 1fr 1.2fr;">
                    <div class="ff-bien">
                        <label>Bien *</label>
                        @if (_bienSeleccionado != null)
                        {
                            <div class="bien-chip">
                                <i class="bi bi-box-seam-fill"></i>
                                <div class="bien-chip-info">
                                    <span class="bien-chip-codigo">@_bienSeleccionado.Codigo</span>
                                    <span class="bien-chip-nombre">@_bienSeleccionado.Nombre</span>
                                </div>
                                @if (!editando)
                                {
                                    <button type="button" class="bien-chip-cambiar" @onclick="CambiarBien" title="Cambiar bien">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bien-buscador">
                                <div class="bien-buscador-input">
                                    <i class="bi bi-search"></i>
                                    <input type="text"
                                           id="traslado-bien-input"
                                           placeholder="Buscar por código o nombre…"
                                           value="@_textoBusquedaBien"
                                           @oninput="OnBusquedaBienInput"
                                           @onfocus="OnBusquedaBienFocus"
                                           @onkeydown="OnBusquedaBienKeyDown"
                                           autocomplete="off"
                                           disabled="@editando" />
                                    @if (!string.IsNullOrWhiteSpace(_textoBusquedaBien))
                                    {
                                        <button type="button" class="bien-buscador-clear" @onclick="LimpiarBusquedaBien" @onclick:stopPropagation="true">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>
                                @if (_mostrarDropdownBien && !editando)
                                {
                                    <div class="bien-dropdown" id="traslado-bien-dropdown" @onmousedown:preventDefault="true">
                                        @if (_bienesFiltrados.Any())
                                        {
                                            <div class="bien-dropdown-header">
                                                <span>@_bienesFiltrados.Count resultado(s)</span>
                                            </div>
                                            @foreach (var b in _bienesFiltrados.Take(20))
                                            {
                                                var bien = b;
                                                <button type="button" class="bien-dropdown-item" @onclick="() => SeleccionarBienTraslado(bien)" @onclick:stopPropagation="true">
                                                    <div class="bien-dropdown-item-top">
                                                        <code>@bien.Codigo</code>
                                                        <strong>@bien.Nombre</strong>
                                                    </div>
                                                    <div class="bien-dropdown-item-bottom">
                                                        @if (!string.IsNullOrWhiteSpace(bien.CategoriaNombre))
                                                        {
                                                            <span>@bien.CategoriaNombre</span>
                                                        }
                                                        <span>@bien.ValorAdquisicion.ToString("C0", CulturaCOP)</span>
                                                    </div>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="bien-dropdown-empty">
                                                <i class="bi bi-search"></i>
                                                <span>Sin resultados para "@_textoBusquedaBien"</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <ValidationMessage For="() => trasladoDTO.BienId" class="form-error" />
                    </div>

                    <div class="ff-fecha">
                        <label>Fecha Traslado *</label>
                        <div class="input-icon">
                            <i class="bi bi-calendar-event"></i>
                            <InputDate class="form-control" @bind-Value="trasladoDTO.FechaTraslado" disabled="@editando" />
                        </div>
                        <ValidationMessage For="() => trasladoDTO.FechaTraslado" class="form-error" />
                    </div>

                    <div class="ff-sede">
                        <label>Sede Destino *</label>
                        <div class="input-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                            <InputSelect class="form-control"
                                         @bind-Value="trasladoDTO.SedeId"
                                         @bind-Value:after="OnSedeChanged"
                                         disabled="@(editando)">
                                @if (!Sesion.VeTodasLasSedes)
                                {
                                    <option value="@Sesion.SedeId">@Sesion.SedeNombre</option>
                                }
                                else
                                {
                                    <option value="">— Seleccione sede —</option>
                                    @foreach (var s in _sedes)
                                    {
                                        <option value="@s.Id">@s.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                @* ═══ FILA 2: Aula Origen | Aula Destino | Func. Anterior ═══ *@
                <div class="form-fila-2" style="grid-template-columns: 1fr 1fr 1fr;">
                    <div class="ff-aula-origen">
                        <label>Aula Origen</label>
                        <div class="input-icon input-icon-readonly" title="@_aulaOrigenNombre">
                            <i class="bi bi-geo-alt-fill"></i>
                            <span class="readonly-value">@_aulaOrigenNombre</span>
                        </div>
                    </div>

                    <div class="ff-aula-destino">
                        <label>Aula Destino *</label>
                        <div class="input-icon">
                            <i class="bi bi-door-open"></i>
                            <InputSelect class="form-select" @bind-Value="trasladoDTO.AulaDestinoId" disabled="@(editando || EsTrasladoInterSede)">
                                <option value="0">— Seleccione aula —</option>
                                @foreach (var a in _aulasFiltradas)
                                {
                                    <option value="@a.Id">@a.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="() => trasladoDTO.AulaDestinoId" class="form-error" />
                    </div>

                    <div class="ff-func-anterior">
                        <label>Funcionario Anterior</label>
                        <div class="input-icon input-icon-readonly" title="@_funcionarioAnteriorNombre">
                            <i class="bi bi-person-dash-fill"></i>
                            <span class="readonly-value">@_funcionarioAnteriorNombre</span>
                        </div>
                    </div>
                </div>

                @* ═══ FILA 3: Func. Nuevo | Motivo | Botones ═══ *@
                <div class="form-fila-3" style="display: grid; grid-template-columns: 1.2fr 2fr 0.8fr; gap: 10px; align-items: end; padding-top: 10px; border-top: 1px solid #f1f5f9;">
                    
                    <div class="ff-func-nuevo">
                        <label>Funcionario Nuevo</label>
                        <div class="input-icon">
                            @if (EsTrasladoInterSede)
                            {
                                <!-- Si es Inter-Sede, se bloquea y se muestra un mensaje claro -->
                                <i class="bi bi-building"></i>
                                <input type="text" class="form-control" value="Lo recibe Almacén de Sede Destino" disabled style="background: #f1f5f9; color: #64748b; font-size: 0.75rem;" />
                            }
                            else
                            {
                                <!-- Si es traslado interno, se deja elegir al funcionario -->
                                <i class="bi bi-person-check-fill"></i>
                                <InputSelect class="form-select" @bind-Value="trasladoDTO.FuncionarioNuevoId" disabled="@editando">
                                    <option value="">— Sin asignar —</option>
                                    @foreach (var f in _funcionariosFiltrados)
                                    {
                                        <option value="@f.Id">@f.NombreCompleto (@f.Cedula)</option>
                                    }
                                </InputSelect>
                            }
                        </div>
                    </div>

                    <div class="ff-motivo">
                        <label>Motivo del Traslado *</label>
                        <div class="input-icon">
                            <i class="bi bi-chat-left-text"></i>
                            <InputText class="form-control" @bind-Value="trasladoDTO.Motivo"
                                       disabled="@editando"
                                       placeholder="Justifique el motivo (ej: Acta 045 del Rector)" />
                        </div>
                    </div>

                    <div class="ff-botones">
                        <button type="button" class="btn btn-cancel" @onclick="Cancelar">
                            <i class="bi bi-x-lg"></i> @(editando ? "Cerrar" : "Cancelar")
                        </button>
                        @if (!editando)
                        {
                            <button type="submit" class="btn btn-save btn-save-traslado">
                                <i class="bi bi-arrow-left-right"></i> Registrar
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">
        @* ═══ BARRA SUPERIOR — SIEMPRE VISIBLE ═══ *@
        <div class="filtros-toolbar">
            <div class="filtro-busqueda-principal">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por bien o motivo…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-toolbar-actions">
                <span class="badge-total">
                    <i class="bi bi-arrow-left-right"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> traslados
                    @if (_hayFiltrosActivos)
                    {
                        <span class="filtro-activo-tag">· Filtrado</span>
                    }
                </span>

                <button class="btn-filtros @(_mostrarFiltros ? "active" : "")" @onclick="ToggleFiltros">
                    <i class="bi bi-sliders"></i>
                    <span>Filtros</span>
                    @if (_hayFiltrosAvanzados)
                    {
                        <span class="filtros-badge"></span>
                    }
                    <i class="bi @(_mostrarFiltros ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>

                <button class="btn-export-cgn" @onclick="ExportarExcel" disabled="@(_exportando)">
                    <i class="bi @(_exportando ? "bi-hourglass-split" : "bi-download")"></i>
                    <span>@(_exportando ? "Generando…" : "Exportar")</span>
                </button>
            </div>
        </div>

        @* ═══ PANEL DE FILTROS ═══ *@
        @if (_mostrarFiltros)
        {
            <div class="panel-filtros">
                <div class="filtros-grid">
                    <div class="filtro-select">
                        <i class="bi bi-calendar"></i>
                        <input type="date" placeholder="Desde" @bind="_filtroFechaDesde" @bind:after="AplicarFiltrosAvanzados" />
                    </div>

                    <div class="filtro-select">
                        <i class="bi bi-calendar"></i>
                        <input type="date" placeholder="Hasta" @bind="_filtroFechaHasta" @bind:after="AplicarFiltrosAvanzados" />
                    </div>

                    @if (_hayFiltrosAvanzados)
                    {
                        <button class="btn-limpiar-filtros" @onclick="LimpiarTodosLosFiltros">
                            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
                        </button>
                    }
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Bien</th>
                        <th>Aula Origen</th>
                        <th>Aula Destino</th>
                        <th>Func. Anterior</th>
                        <th>Func. Nuevo</th>
                        <th>Motivo</th>
                        <th class="text-center" style="width: 90px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">Cargando traslados…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">Sin traslados registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in _pagina.Items)
                        {
                            <tr class="table-row-hover" @key="t.Id">
                                <td class="text-mono">@t.FechaTraslado?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@t.BienNombre</strong>
                                        <small>@t.BienCodigo</small>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrEmpty(t.AulaOrigenNombre) ? "—" : t.AulaOrigenNombre)</td>
                                <td>
                                    <span class="badge badge-traslado-destino">
                                        <i class="bi bi-arrow-right-short"></i> @t.AulaDestinoNombre
                                    </span>
                                </td>
                                <td>@(string.IsNullOrEmpty(t.FuncionarioAnteriorNombre) ? "—" : t.FuncionarioAnteriorNombre)</td>
                                <td>@(t.FuncionarioNuevoNombre ?? "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(t.Motivo) ? "—" : t.Motivo)</td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        @if (puedeAnular)
                                        {
                                            <button type="button" class="btn-action btn-action-delete"
                                                    @onclick="() => IntentarAnular(t)" @onclick:stopPropagation="true"
                                                    title="Anular traslado (soft-delete)">
                                                <i class="bi bi-slash-circle-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ═══ PAGINADOR ═══ *@
        @if (_pagina is not null && _pagina.TotalRegistros > 0 && !_mostrarFormulario)
        {
            <Paginador T="TrasladoDTO" Resultado="_pagina" OnCambioPagina="CambioPagina" OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@* ═══ MODAL DE ANULACIÓN ═══ *@
@if (_modalAnulacionAbierto && _itemAAnular is not null)
{
    var t = _itemAAnular;
    <div class="modal-backdrop-det" @onclick="CancelarAnulacion">
        <div class="modal-det" @onclick:stopPropagation="true">
            <div class="modal-det-header">
                <div class="modal-det-header-left">
                    <span class="badge badge-off">Anular traslado</span>
                    <h3>@t.BienNombre</h3>
                </div>
                <button type="button" class="modal-det-close" @onclick="CancelarAnulacion" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-det-body">
                <div class="det-section" style="background: #fffbeb; border-left: 4px solid #f59e0b;">
                    <h4><i class="bi bi-exclamation-triangle-fill"></i> ¿Qué es anular?</h4>
                    <p style="margin: 0;">
                        El registro <strong>NO se elimina de la base de datos</strong>. Se marca como "Anulado" y se excluye de los reportes operativos.
                        El historial completo queda disponible para auditoría y para el expediente del bien.
                    </p>
                    <p style="margin: 8px 0 0 0; font-size: 0.85rem;">
                        <i class="bi bi-info-circle"></i> <strong>Regla:</strong> solo se puede anular si es el <strong>último traslado</strong> del bien.
                    </p>
                </div>
                <div class="det-section">
                    <h4><i class="bi bi-info-circle"></i> Traslado a anular</h4>
                    <dl class="det-dl">
                        <dt>Bien</dt><dd><code>@t.BienCodigo</code> — @t.BienNombre</dd>
                        <dt>Aula origen</dt><dd>@(t.AulaOrigenNombre ?? "—")</dd>
                        <dt>Aula destino</dt><dd>@t.AulaDestinoNombre</dd>
                        <dt>Funcionario anterior</dt><dd>@(t.FuncionarioAnteriorNombre ?? "—")</dd>
                        <dt>Funcionario nuevo</dt><dd>@(t.FuncionarioNuevoNombre ?? "—")</dd>
                        <dt>Fecha</dt><dd>@t.FechaTraslado?.ToString("dd/MM/yyyy")</dd>
                    </dl>
                </div>
                <div class="form-group form-group-full">
                    <label>Motivo de la anulación *</label>
                    <div class="input-icon">
                        <i class="bi bi-pencil-square"></i>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_motivoAnulacion" placeholder="Ej: Error de digitación..." />
                    </div>
                </div>
            </div>

            <div class="modal-det-footer">
                <button type="button" class="btn-det-cerrar" @onclick="CancelarAnulacion">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <button type="button" class="btn btn-save" @onclick="ConfirmarAnulacionAsync" disabled="@(string.IsNullOrWhiteSpace(_motivoAnulacion))">
                    <i class="bi bi-slash-circle-fill"></i> Confirmar Anulación
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo CulturaCOP = System.Globalization.CultureInfo.GetCultureInfo("es-CO");

    private ResultadoPaginado<TrasladoDTO>? _pagina;
    private List<Bien> bienes = new();
    private List<AulaDTO> aulas = new();
    private List<AulaDTO> _aulasFiltradas = new();
    private List<FuncionarioDTO> funcionarios = new();
    private List<FuncionarioDTO> _funcionariosFiltrados = new();
    private List<SedeDTO> _sedes = new();

    private TrasladoDTO trasladoDTO = new();
    private bool editando = false;
    private int trasladoEditandoId;
    private bool _mostrarFormulario = false;
    private bool _mostrarFiltros = false;

    private string _aulaOrigenNombre = "— Sin ubicación previa —";
    private string _funcionarioAnteriorNombre = "— Sin responsable previo —";

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private DateTime? _filtroFechaDesde;
    private DateTime? _filtroFechaHasta;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeAnular;

    private Bien? _bienSeleccionado;
    private string _textoBusquedaBien = string.Empty;
    private bool _mostrarDropdownBien = false;
    private List<Bien> _bienesFiltrados = new();
    private bool _bloquearAperturaDropdown = false;

    private bool _modalAnulacionAbierto = false;
    private TrasladoDTO? _itemAAnular;
    private string _motivoAnulacion = "";

    private bool _exportando = false;

    // ✅ Propiedad para saber si es un traslado a otra sede
    private bool EsTrasladoInterSede => 
        _bienSeleccionado?.SedeId != null && trasladoDTO.SedeId != null && 
        _bienSeleccionado.SedeId != trasladoDTO.SedeId;

    private bool _hayFiltrosActivos =>
        !string.IsNullOrEmpty(_filtroTexto) ||
        _filtroFechaDesde.HasValue ||
        _filtroFechaHasta.HasValue;

    private bool _hayFiltrosAvanzados =>
        _filtroFechaDesde.HasValue ||
        _filtroFechaHasta.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("traslados.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear  = await Seguridad.TienePermisoAsync("traslados.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("traslados.editar");
        puedeAnular = await Seguridad.TienePermisoAsync("traslados.anular");

        bienes = (await BienRepo.ObtenerTodosAsync()).Where(b => b.Activo).ToList();
        aulas = (await AulaRepo.ObtenerTodasAsync()).ToList();
        _aulasFiltradas = aulas.ToList();
        funcionarios = (await FuncRepo.ObtenerTodosAsync()).ToList();
        _funcionariosFiltrados = funcionarios.ToList();
        _sedes = (await SedeRepo.ObtenerTodasAsync()).ToList();
        _bienesFiltrados = bienes.Take(20).ToList();

        await Cargar();
    }

    private async Task Cargar()
    {
        var filtro = new FiltroMovimientoDTO
        {
            Texto = string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            FechaDesde = _filtroFechaDesde,
            FechaHasta = _filtroFechaHasta
        };

        if (filtro.HayFiltros)
        {
            _pagina = await TrasladoRepo.ObtenerPaginadoConFiltrosAsync(filtro, _paginaActual, _tamanoPagina);
        }
        else
        {
            _pagina = await TrasladoRepo.ObtenerPaginadoAsync(_paginaActual, _tamanoPagina, string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
        }
    }

    private void AbrirFormulario()
    {
        trasladoDTO = new TrasladoDTO { 
            FechaTraslado = DateTime.Today,
            SedeId = Sesion.VeTodasLasSedes ? null : Sesion.SedeId
        };
        editando = false;
        trasladoEditandoId = 0;
        _aulaOrigenNombre = "— Sin ubicación previa —";
        _funcionarioAnteriorNombre = "— Sin responsable previo —";
        _mostrarFormulario = true;
        _mostrarFiltros = false;

        _bienSeleccionado = null;
        _textoBusquedaBien = string.Empty;
        _mostrarDropdownBien = false;
        _bloquearAperturaDropdown = false;
        _bienesFiltrados = bienes.Take(20).ToList();
        _aulasFiltradas = aulas.ToList();
        _funcionariosFiltrados = funcionarios.ToList();
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
        trasladoDTO = new TrasladoDTO { FechaTraslado = DateTime.Today };
        editando = false;
        trasladoEditandoId = 0;
        _aulaOrigenNombre = "— Sin ubicación previa —";
        _funcionarioAnteriorNombre = "— Sin responsable previo —";
        _filtroTexto = string.Empty;

        _bienSeleccionado = null;
        _textoBusquedaBien = string.Empty;
        _mostrarDropdownBien = false;
        _bloquearAperturaDropdown = false;
        _aulasFiltradas = aulas.ToList();
        _funcionariosFiltrados = funcionarios.ToList();

        StateHasChanged();
    }

    private void ToggleFiltros()
    {
        _mostrarFiltros = !_mostrarFiltros;
        if (_mostrarFiltros && _mostrarFormulario)
        {
            _mostrarFormulario = false;
            trasladoDTO = new TrasladoDTO { FechaTraslado = DateTime.Today };
            editando = false;
            trasladoEditandoId = 0;
            _aulaOrigenNombre = "— Sin ubicación previa —";
            _funcionarioAnteriorNombre = "— Sin responsable previo —";
            _bienSeleccionado = null;
            _textoBusquedaBien = string.Empty;
            _mostrarDropdownBien = false;
            _bloquearAperturaDropdown = false;
            _aulasFiltradas = aulas.ToList();
            _funcionariosFiltrados = funcionarios.ToList();
        }
    }

    private async Task CambioPagina(int nuevaPagina) { _paginaActual = nuevaPagina; await Cargar(); StateHasChanged(); }
    private async Task CambioTamano(int nuevoTamano) { _tamanoPagina = nuevoTamano; _paginaActual = 1; await Cargar(); StateHasChanged(); }
    private async Task AplicarFiltrosAvanzados() { _paginaActual = 1; await Cargar(); StateHasChanged(); }

    private async Task LimpiarTodosLosFiltros()
    {
        _filtroTexto = string.Empty; _filtroFechaDesde = null; _filtroFechaHasta = null;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;
            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro() { _filtroTexto = string.Empty; _paginaActual = 1; await Cargar(); StateHasChanged(); }

    private void OnBusquedaBienFocus()
    {
        if (_bloquearAperturaDropdown)
        {
            _bloquearAperturaDropdown = false;
            return;
        }
        _mostrarDropdownBien = true;
        if (string.IsNullOrWhiteSpace(_textoBusquedaBien)) _bienesFiltrados = bienes.Take(20).ToList();
        else FiltrarBienes();
    }

    private void OnBusquedaBienInput(ChangeEventArgs e)
    {
        _textoBusquedaBien = e.Value?.ToString() ?? string.Empty;
        _mostrarDropdownBien = true;
        _bloquearAperturaDropdown = false;
        if (string.IsNullOrWhiteSpace(_textoBusquedaBien)) _bienesFiltrados = bienes.Take(20).ToList();
        else FiltrarBienes();
    }

    private void FiltrarBienes()
    {
        var filtro = _textoBusquedaBien.Trim().ToLowerInvariant();
        _bienesFiltrados = bienes.Where(b => (b.Codigo?.ToLowerInvariant().Contains(filtro) ?? false) || (b.Nombre?.ToLowerInvariant().Contains(filtro) ?? false)).OrderBy(b => b.Codigo).ToList();
    }

    private void OnBusquedaBienKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _mostrarDropdownBien = false; return; }
        if (e.Key == "Enter" && _mostrarDropdownBien && _bienesFiltrados.Count > 0) SeleccionarBienTraslado(_bienesFiltrados[0]);
    }

    private void LimpiarBusquedaBien() { _textoBusquedaBien = string.Empty; _bienesFiltrados = bienes.Take(20).ToList(); _mostrarDropdownBien = true; }

    private async Task SeleccionarBienTraslado(Bien bien)
    {
        _bienSeleccionado = bien;
        trasladoDTO.BienId = bien.Id;
        trasladoDTO.SedeId = bien.SedeId; 

        _textoBusquedaBien = string.Empty;
        _bienesFiltrados = new List<Bien>();
        _mostrarDropdownBien = false;
        _bloquearAperturaDropdown = false;
        
        await CargarUbicacionActualAsync(bien.Id);
        
        ActualizarAulasFiltradas();
        ActualizarFuncionariosFiltrados();

        StateHasChanged();
    }

    private void CambiarBien()
    {
        _bienSeleccionado = null;
        trasladoDTO.BienId = 0;
        trasladoDTO.AulaOrigenId = null;
        trasladoDTO.FuncionarioAnteriorId = null;
        
        trasladoDTO.SedeId = Sesion.VeTodasLasSedes ? null : Sesion.SedeId;
        _aulasFiltradas = aulas.ToList();
        _funcionariosFiltrados = funcionarios.ToList();

        _aulaOrigenNombre = "— Sin ubicación previa —";
        _funcionarioAnteriorNombre = "— Sin responsable previo —";
        _textoBusquedaBien = string.Empty;
        _bienesFiltrados = bienes.Take(20).ToList();
        _mostrarDropdownBien = true;
        _bloquearAperturaDropdown = false;
        StateHasChanged();
    }

    private async Task CargarUbicacionActualAsync(int bienId)
    {
        if (bienId <= 0) return;
        var (aulaId, funcId) = await TrasladoRepo.ObtenerUbicacionActualAsync(bienId);
        trasladoDTO.AulaOrigenId = aulaId;
        trasladoDTO.FuncionarioAnteriorId = funcId;
        var aula = aulas.FirstOrDefault(a => a.Id == aulaId);
        var func = funcionarios.FirstOrDefault(f => f.Id == funcId);
        _aulaOrigenNombre = aula != null ? $"{aula.SedeNombre} / {aula.BloqueNombre} / {aula.Nombre}" : "— Sin ubicación previa —";
        _funcionarioAnteriorNombre = func != null ? $"{func.NombreCompleto} ({func.Cedula})" : "— Sin responsable previo —";
    }

    private void OnSedeChanged()
    {
        trasladoDTO.AulaDestinoId = 0;
        trasladoDTO.FuncionarioNuevoId = null; 
        
        ActualizarAulasFiltradas();
        ActualizarFuncionariosFiltrados();

        // ✅ Si es traslado inter-sede, seleccionamos automáticamente la Bodega
        if (EsTrasladoInterSede)
        {
            var bodegaDestino = _aulasFiltradas.FirstOrDefault(a => a.Nombre.ToLower().Contains("bodega"));
            if (bodegaDestino != null)
            {
                trasladoDTO.AulaDestinoId = bodegaDestino.Id;
            }
        }
    }

    private void ActualizarAulasFiltradas()
    {
        if (trasladoDTO.SedeId.HasValue)
        {
            var sedeSeleccionada = _sedes.FirstOrDefault(s => s.Id == trasladoDTO.SedeId.Value);
            if (sedeSeleccionada != null)
            {
                _aulasFiltradas = aulas.Where(a => a.SedeNombre == sedeSeleccionada.Nombre).ToList();
            }
            else
            {
                _aulasFiltradas = new List<AulaDTO>();
            }
        }
        else
        {
            _aulasFiltradas = aulas.ToList();
        }
    }

    private void ActualizarFuncionariosFiltrados()
    {
        var query = funcionarios.AsQueryable();

        if (trasladoDTO.SedeId.HasValue)
        {
            query = query.Where(f => f.SedeId == trasladoDTO.SedeId.Value);
        }

        if (trasladoDTO.FuncionarioAnteriorId.HasValue)
        {
            query = query.Where(f => f.Id != trasladoDTO.FuncionarioAnteriorId.Value);
        }

        _funcionariosFiltrados = query.ToList();
    }

    private async Task Guardar()
    {
        if (!puedeCrear) { Toast.Error("No tiene permiso para registrar traslados."); return; }
        if (trasladoDTO.BienId <= 0) { Toast.Error("Debe seleccionar un bien."); return; }
        if (trasladoDTO.AulaDestinoId <= 0) { Toast.Error("Debe seleccionar un aula destino."); return; }

        if (!Sesion.VeTodasLasSedes) trasladoDTO.SedeId = Sesion.SedeId;
        
        if (trasladoDTO.SedeId == null) 
        { 
            Toast.Error("Debe seleccionar la Sede Destino."); 
            return; 
        }

        // ✅ VALIDACIÓN: Si es intra-sede, el funcionario es obligatorio. Si es inter-sede, se ignora.
        if (!EsTrasladoInterSede && (trasladoDTO.FuncionarioNuevoId == null || trasladoDTO.FuncionarioNuevoId == 0))
        {
            Toast.Warning("Para traslados dentro de la misma sede, debe asignar el funcionario que recibe.");
            return;
        }

        // ✅ Si es inter-sede, forzamos el funcionario a nulo en la BD
        if (EsTrasladoInterSede)
        {
            trasladoDTO.FuncionarioNuevoId = null;
        }

        if (string.IsNullOrWhiteSpace(trasladoDTO.Motivo))
        {
            Toast.Warning("Debe justificar el motivo del traslado para que quede el soporte legal en la Contraloría.");
            return;
        }

        if (trasladoDTO.AulaOrigenId == trasladoDTO.AulaDestinoId && trasladoDTO.FuncionarioAnteriorId == trasladoDTO.FuncionarioNuevoId)
        {
            Toast.Error("El aula y funcionario destino son iguales a los actuales.");
            return;
        }

        try
        {
            var nuevoId = await TrasladoRepo.CrearAsync(trasladoDTO);
            await TrasladoRepo.ActualizarUbicacionBienAsync(trasladoDTO.BienId, trasladoDTO.AulaDestinoId, trasladoDTO.FuncionarioNuevoId, trasladoDTO.SedeId);

            await Auditoria.RegistrarCreacionAsync(
                modulo: "traslados", objetoTipo: "Traslado", objetoId: nuevoId, objetoCodigo: null, objetoDescripcion: $"Traslado de bien ID {trasladoDTO.BienId}",
                despues: new { trasladoDTO.BienId, trasladoDTO.AulaOrigenId, trasladoDTO.AulaDestinoId, trasladoDTO.FuncionarioAnteriorId, trasladoDTO.FuncionarioNuevoId, trasladoDTO.FechaTraslado, trasladoDTO.Motivo, trasladoDTO.SedeId }
            );

            Toast.Exito("Traslado registrado. Puede continuar registrando.");

            var fechaActual = trasladoDTO.FechaTraslado;
            var sedeActual = trasladoDTO.SedeId;

            trasladoDTO = new TrasladoDTO { FechaTraslado = fechaActual, SedeId = sedeActual };
            _bienSeleccionado = null;
            _textoBusquedaBien = string.Empty;
            _mostrarDropdownBien = false;
            _bloquearAperturaDropdown = true;
            _bienesFiltrados = bienes.Take(20).ToList();
            _aulaOrigenNombre = "— Sin ubicación previa —";
            _funcionarioAnteriorNombre = "— Sin responsable previo —";
            _aulasFiltradas = aulas.ToList();
            _funcionariosFiltrados = funcionarios.ToList();

            await Cargar();
            StateHasChanged();
        }
        catch (Exception ex) { ErrorHelper.Mostrar(Toast, ex, "el traslado", "guardar"); }
    }

    private async Task ExportarExcel()
    {
        _exportando = true;
        StateHasChanged();
        try
        {
            var todos = _pagina?.Items?.ToList() ?? new List<TrasladoDTO>();
            if (!todos.Any()) { Toast.Warning("No hay traslados para exportar."); return; }
            Toast.Info($"Exportación a Excel en desarrollo ({todos.Count} traslados).");
            await Task.CompletedTask;
        }
        catch (Exception ex) { Toast.Error($"Error al exportar: {ex.Message}"); }
        finally { _exportando = false; StateHasChanged(); }
    }

    private void IntentarAnular(TrasladoDTO t)
    {
        if (!puedeAnular) { Toast.Error("No tiene permiso para anular traslados."); return; }
        _itemAAnular = t;
        _motivoAnulacion = "";
        _modalAnulacionAbierto = true;
        StateHasChanged();
    }

    private void CancelarAnulacion()
    {
        _modalAnulacionAbierto = false;
        _itemAAnular = null;
        _motivoAnulacion = "";
    }

    private async Task ConfirmarAnulacionAsync()
    {
        if (_itemAAnular is null) return;
        if (string.IsNullOrWhiteSpace(_motivoAnulacion)) { Toast.Warning("Debe ingresar un motivo para la anulación."); return; }

        try
        {
            await TrasladoRepo.AnularAsync(_itemAAnular.Id, _motivoAnulacion);
            await Auditoria.RegistrarAnulacionAsync(
                modulo: "traslados", objetoTipo: "Traslado", objetoId: _itemAAnular.Id, objetoCodigo: _itemAAnular.BienCodigo, objetoDescripcion: $"Anulación de traslado para '{_itemAAnular.BienNombre}'",
                antes: new { AulaOrigen = _itemAAnular.AulaOrigenNombre, AulaDestino = _itemAAnular.AulaDestinoNombre, FuncionarioAnterior = _itemAAnular.FuncionarioAnteriorNombre, FuncionarioNuevo = _itemAAnular.FuncionarioNuevoNombre, Anulada = false },
                despues: new { Anulada = true, Motivo = _motivoAnulacion, AnuladaPor = Sesion.UsuarioActual?.Id, AnuladaFecha = DateTime.Now }, motivo: _motivoAnulacion
            );
            Toast.Exito("Traslado anulado correctamente.");
            CancelarAnulacion();
            await Cargar();
            StateHasChanged();
        }
        catch (InvalidOperationException iex) { Toast.Warning(iex.Message); }
        catch (Exception ex) { ErrorHelper.Mostrar(Toast, ex, "el traslado", "anular"); }
    }
}