@page "/consumo"
@rendermode InteractiveServer

@using Almacen.Components.Shared
@using Almacen.DTOs
@using Almacen.Helpers
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IKardexRepository KardexRepo
@inject ICategoriaRepository CategoriaRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Consumo · Almacén</PageTitle>

<div class="page-container page-crud @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-boxes"></i> Consumo</h1>
                <p class="subtitle">Papelería, tintas, aseo y demás consumibles</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nuevo Bien de Consumo
                    </button>
                </div>
            }
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Bien de Consumo" : "Nuevo Bien de Consumo")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-boxes"></i>
                    <div>
                        <div class="form-header-title">Consumo</div>
                        <div class="form-header-subtitle">Papelería, tintas, aseo y demás consumibles</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="Cancelar" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="bienEditandoId" Model="bienDTO" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid-3">

                    @if (editando)
                    {
                        <div class="form-group">
                            <label>Código</label>
                            <div class="input-icon">
                                <i class="bi bi-upc"></i>
                                <input type="text" class="form-control" value="@bienDTO.Codigo" disabled />
                            </div>
                            <small class="form-hint">El código no es editable</small>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label>Código</label>
                            <div class="input-icon" style="display: flex; align-items: center; gap: 8px; padding: 0.55rem 0.85rem; background: var(--brand-soft); border: 1.5px dashed var(--brand-border); border-radius: var(--radius);">
                                <i class="bi bi-magic" style="color: var(--brand); font-size: 1.1rem;"></i>
                                <div>
                                    <strong style="color: var(--brand); font-size: 0.85rem;">Automático</strong>
                                    <div style="font-size: 0.72rem; color: var(--text-muted);">Ej: CONS-@DateTime.Now.Year-XXX</div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="form-group" style="grid-column: span 2;">
                        <label>Nombre *</label>
                        <div class="input-icon">
                            <i class="bi bi-tag"></i>
                            <InputText class="form-control" @bind-Value="bienDTO.Nombre" placeholder="Papel bond carta" />
                        </div>
                        <ValidationMessage For="() => bienDTO.Nombre" class="form-error" />
                    </div>

                    <div class="form-group">
                        <label>Categoría</label>
                        <div class="input-icon">
                            <i class="bi bi-tags"></i>
                            <InputSelect class="form-select" @bind-Value="bienDTO.CategoriaId">
                                <option value="">— Sin categoría —</option>
                                @foreach (var c in categorias)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Unidad de medida *</label>
                        <div class="input-icon">
                            <i class="bi bi-rulers"></i>
                            <InputSelect class="form-select" @bind-Value="bienDTO.UnidadMedida">
                                <option value="Unidad">Unidad</option>
                                <option value="Caja">Caja</option>
                                <option value="Paquete">Paquete</option>
                                <option value="Resma">Resma</option>
                                <option value="Litro">Litro</option>
                                <option value="Kilo">Kilo</option>
                                <option value="Metro">Metro</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Stock mínimo</label>
                        <div class="input-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                            <InputNumber class="form-control" @bind-Value="bienDTO.StockMinimo" min="0" />
                        </div>
                        <small class="form-hint">Alerta cuando baje de este valor</small>
                    </div>

                    <div class="form-group form-group-full">
                        <label>Descripción</label>
                        <div class="input-icon">
                            <i class="bi bi-card-text"></i>
                            <InputText class="form-control" @bind-Value="bienDTO.Descripcion"
                                       placeholder="Descripción del consumible" />
                        </div>
                    </div>

                    <div class="form-group checkbox-group">
                        <label>
                            <InputCheckbox @bind-Value="bienDTO.Activo" />
                            Bien Activo
                        </label>
                    </div>

                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="Cancelar">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    @if (_bajoStock.Any() && !_mostrarFormulario)
    {
        <div class="alert-stock">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>@_bajoStock.Count bienes bajo stock mínimo</strong>
                <span>Requieren reposición inmediata</span>
            </div>
        </div>
    }

    <div class="card-table">

        @* ═══ Barra: buscador + dropdown categoría + dropdown stock + total ═══ *@
        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por código o nombre…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-tabla-derecha">

                @* ═══ Dropdown Categoría ═══ *@
                <details class="dropdown-filtro" id="dropdown-cat-cons">
                    <summary class="dropdown-filtro-trigger">
                        <i class="bi bi-tags"></i>
                        <span>@(string.IsNullOrEmpty(_categoriaSeleccionadaNombre) ? "Todas las categorías" : _categoriaSeleccionadaNombre)</span>
                        <i class="bi bi-chevron-down dropdown-filtro-chevron"></i>
                    </summary>

                    <div class="dropdown-filtro-panel">
                        <div class="dropdown-filtro-item @(_categoriaSeleccionadaId is null ? "active" : "")"
                             @onclick="() => SeleccionarCategoria(null)">
                            <i class="bi bi-grid-3x3"></i>
                            <span>Todas las categorías</span>
                            @if (_categoriaSeleccionadaId is null)
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-divider"></div>

                        @foreach (var c in categorias)
                        {
                            <div class="dropdown-filtro-item @(_categoriaSeleccionadaId == c.Id ? "active" : "")"
                                 @onclick="() => SeleccionarCategoria(c)">
                                <i class="bi bi-tag"></i>
                                <span>@c.Nombre</span>
                                @if (_categoriaSeleccionadaId == c.Id)
                                {
                                    <i class="bi bi-check2 dropdown-filtro-check"></i>
                                }
                            </div>
                        }
                    </div>
                </details>

                @* ═══ Dropdown Stock ═══ *@
                <details class="dropdown-filtro" id="dropdown-stock-cons">
                    <summary class="dropdown-filtro-trigger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>@(_filtroBajoStock switch { true => "Solo bajo stock", false => "Solo stock normal", null => "Todo el stock" })</span>
                        <i class="bi bi-chevron-down dropdown-filtro-chevron"></i>
                    </summary>

                    <div class="dropdown-filtro-panel">
                        <div class="dropdown-filtro-item @(_filtroBajoStock is null ? "active" : "")"
                             @onclick="() => SeleccionarBajoStock(null)">
                            <i class="bi bi-list-ul"></i>
                            <span>Todo el stock</span>
                            @if (_filtroBajoStock is null)
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-divider"></div>

                        <div class="dropdown-filtro-item @(_filtroBajoStock == true ? "active" : "")"
                             @onclick="() => SeleccionarBajoStock(true)">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>Solo bajo stock</span>
                            @if (_filtroBajoStock == true)
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-item @(_filtroBajoStock == false ? "active" : "")"
                             @onclick="() => SeleccionarBajoStock(false)">
                            <i class="bi bi-check-circle"></i>
                            <span>Solo stock normal</span>
                            @if (_filtroBajoStock == false)
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>
                    </div>
                </details>

                <span class="badge-total">
                    <i class="bi bi-boxes"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> bienes
                    @if (!string.IsNullOrEmpty(_filtroTexto) || _categoriaSeleccionadaId.HasValue || _filtroBajoStock.HasValue)
                    {
                        <span class="filtro-activo-tag">· Filtrado</span>
                    }
                </span>
            </div>
        </div>

        @* ═══ Tabla ═══ *@
        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Unidad</th>
                        <th class="text-end">Stock actual</th>
                        <th class="text-end">Stock mínimo</th>
                        <th class="text-end">CPP</th>
                        <th class="text-end">Valor total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 130px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="9" class="text-center py-3 text-muted">Cargando bienes de consumo…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-3 text-muted">
                                @(string.IsNullOrEmpty(_filtroTexto) && !_categoriaSeleccionadaId.HasValue && !_filtroBajoStock.HasValue
                                    ? "Sin bienes de consumo registrados."
                                    : "Sin resultados para los filtros aplicados.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in _pagina.Items)
                        {
                            <tr class="table-row-hover @(b.BajoStockMinimo ? "row-warning" : "")">
                                <td><code>@b.Codigo</code></td>
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@b.Nombre</strong>
                                        @if (!string.IsNullOrWhiteSpace(b.Descripcion))
                                        {
                                            <small>@b.Descripcion</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-neutral">@b.UnidadMedida</span>
                                </td>
                                <td class="text-end num"><strong>@b.StockActual.ToString("N2")</strong></td>
                                <td class="text-end num text-muted">@b.StockMinimo.ToString("N2")</td>
                                <td class="text-end num">@b.CppActual.ToString("N4")</td>
                                <td class="text-end num">@b.ValorStock.ToString("C2")</td>
                                <td class="text-center">
                                    @if (b.BajoStockMinimo)
                                    {
                                        <span class="badge badge-warn">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Bajo stock
                                        </span>
                                    }
                                    else if (b.Activo)
                                    {
                                        <span class="badge badge-ok">
                                            <i class="bi bi-check-circle-fill"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-off">
                                            <i class="bi bi-x-circle-fill"></i> Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <button class="btn-action btn-action-edit"
                                                @onclick="() => VerKardex(b)"
                                                title="Ver kárdex">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        @if (puedeEditar)
                                        {
                                            <button class="btn-action btn-action-edit"
                                                    @onclick="() => Editar(b)"
                                                    title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }
                                        @if (puedeEliminar)
                                        {
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => Eliminar(b)"
                                                    title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ═══ Paginador ═══ *@
        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="BienConsumoDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private ResultadoPaginado<BienConsumoDTO>? _pagina;
    private IEnumerable<Categoria> categorias = [];
    private List<BienConsumoDTO> _bajoStock = new();

    private BienConsumoDTO bienDTO = new();
    private bool editando = false;
    private int bienEditandoId;
    private bool _mostrarFormulario = false;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    // ─── Filtros ───
    private int? _categoriaSeleccionadaId;
    private string _categoriaSeleccionadaNombre = string.Empty;
    private bool? _filtroBajoStock;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("consumo.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("consumo.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("consumo.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("consumo.eliminar");

        categorias = await CategoriaRepo.ObtenerTodosAsync();
        await Cargar();
        await CargarBajoStock();
    }

    private async Task Cargar()
    {
        _pagina = await KardexRepo.ObtenerBienesConsumoPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            _categoriaSeleccionadaId,
            _filtroBajoStock);
    }

    private async Task CargarBajoStock()
    {
        _bajoStock = (await KardexRepo.ObtenerBajoStockMinimoAsync()).ToList();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task SeleccionarCategoria(Categoria? cat)
    {
        _categoriaSeleccionadaId = cat?.Id;
        _categoriaSeleccionadaNombre = cat?.Nombre ?? string.Empty;
        _paginaActual = 1;

        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('dropdown-cat-cons')?.removeAttribute('open')");
        }
        catch { }

        await Cargar();
        StateHasChanged();
    }

    private async Task SeleccionarBajoStock(bool? valor)
    {
        _filtroBajoStock = valor;
        _paginaActual = 1;

        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('dropdown-stock-cons')?.removeAttribute('open')");
        }
        catch { }

        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private void AbrirFormulario()
    {
        bienDTO = new BienConsumoDTO
        {
            Activo = true,
            UnidadMedida = "Unidad",
            StockMinimo = 0
        };
        editando = false;
        bienEditandoId = 0;
        _mostrarFormulario = true;
        _filtroTexto = string.Empty;
    }

    private async Task Guardar()
    {
        if (!editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para crear bienes de consumo.");
            return;
        }
        if (editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(bienDTO.Codigo)
            && await KardexRepo.ExisteCodigoConsumoAsync(bienDTO.Codigo, editando ? bienEditandoId : null))
        {
            Toast.Error($"El código '{bienDTO.Codigo}' ya existe.");
            return;
        }

        try
        {
            if (editando)
            {
                await KardexRepo.ActualizarBienConsumoAsync(bienDTO);
                Toast.Exito($"Bien '{bienDTO.Nombre}' actualizado.");
            }
            else
            {
                await KardexRepo.CrearBienConsumoAsync(bienDTO);
                Toast.Exito($"Bien '{bienDTO.Nombre}' creado con código {bienDTO.Codigo}.");

                var unidadActual = bienDTO.UnidadMedida;
                var categoriaActual = bienDTO.CategoriaId;

                bienDTO = new BienConsumoDTO
                {
                    Activo = true,
                    UnidadMedida = unidadActual,
                    CategoriaId = categoriaActual,
                    StockMinimo = 0
                };

                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { }
            }

            _filtroTexto = string.Empty;
            await Cargar();
            await CargarBajoStock();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(BienConsumoDTO b)
    {
        if (!puedeEditar) return;

        editando = true;
        bienEditandoId = b.Id;
        _mostrarFormulario = true;

        bienDTO.Id = b.Id;
        bienDTO.Codigo = b.Codigo;
        bienDTO.Nombre = b.Nombre;
        bienDTO.Descripcion = b.Descripcion;
        bienDTO.CategoriaId = b.CategoriaId;
        bienDTO.UnidadMedida = b.UnidadMedida;
        bienDTO.StockMinimo = b.StockMinimo;
        bienDTO.Activo = b.Activo;

        _filtroTexto = string.Empty;
        StateHasChanged();
    }

    private async Task Eliminar(BienConsumoDTO b)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar.");
            return;
        }

        if (b.StockActual > 0)
        {
            Toast.Error("No se puede eliminar: aún tiene stock. Registre salidas primero.");
            return;
        }

        var ok = await Confirm.Peligroso($"¿Eliminar '{b.Nombre}'?");
        if (!ok) return;

        try
        {
            await KardexRepo.EliminarBienConsumoAsync(b.Id);
            Toast.Exito("Bien eliminado");
            await Cargar();
            await CargarBajoStock();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void VerKardex(BienConsumoDTO b)
    {
        Navigation.NavigateTo($"/kardex?bienId={b.Id}");
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
        bienDTO = new BienConsumoDTO();
        editando = false;
        bienEditandoId = 0;
        _filtroTexto = string.Empty;
        StateHasChanged();
    }
}