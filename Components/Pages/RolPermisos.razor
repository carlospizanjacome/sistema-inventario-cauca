@page "/rol-permisos"
@rendermode InteractiveServer

@using Almacen.Models
@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services

@inject IRolRepository RolRepository
@inject IPermisoRepository PermisoRepository
@inject IRolPermisoRepository RolPermisoRepository
@inject UsuarioSesionService Sesion
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Asignar Permisos · Almacén</PageTitle>

<div class="page-container">

    @* ═══════════════ HEADER ═══════════════ *@
    <div class="page-header">
        <div>
            <h1><i class="bi bi-shield-lock-fill"></i> Asignación de Permisos</h1>
            <p class="subtitle">Administración de accesos por rol dentro del sistema</p>
        </div>
    </div>

    @* ═══════════════ SELECTOR DE ROL + BOTÓN GUARDAR ═══════════════ *@
    <div class="modern-card mb-4" style="padding: var(--space-5);">
        <div class="form-grid-2" style="align-items: end;">
            <div class="form-group">
                <label>Seleccione un Rol</label>
                <div class="input-icon">
                    <i class="bi bi-person-badge-fill"></i>
                    <select class="form-select" @onchange="RolSeleccionadoCambio">
                        <option value="0">Seleccione un rol…</option>
                        @foreach (var rol in roles)
                        {
                            <option value="@rol.Id">@rol.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group" style="align-items: end; display: flex;">
                @if (rolSeleccionadoId > 0 && puedeAsignarPermisos)
                {
                    <button type="button" class="btn btn-save" @onclick="Guardar">
                        <i class="bi bi-save-fill"></i>
                        Guardar Cambios
                    </button>
                }
            </div>
        </div>
    </div>

    @* ═══════════════ BUSCADOR + RESUMEN ═══════════════ *@
    @if (rolSeleccionadoId > 0 && permisosPantalla.Any())
    {
        <div class="card-table mb-4">
            <div class="filtros-tabla">
                <div class="filtro-busqueda">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           placeholder="Buscar permiso por código, módulo o descripción…"
                           @bind="_filtroTexto"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_filtroTexto))
                    {
                        <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
                <div class="filtro-info">
                    <span class="badge-total">
                        <i class="bi bi-check-circle-fill"></i>
                        <strong>@permisosPantalla.Count(p => p.Asignado)</strong> de @permisosPantalla.Count asignados
                    </span>
                </div>
            </div>
        </div>
    }

    @* ═══════════════ MATRIZ DE PERMISOS DINÁMICA ═══════════════ *@
    @if (rolSeleccionadoId > 0)
    {
        var gruposModulo = PermisosFiltrados.GroupBy(x => x.Modulo).OrderBy(g => g.Key).ToList();

        @if (!gruposModulo.Any())
        {
            <div class="card-table">
                <div class="empty-state">
                    <i class="bi bi-search"></i>
                    <h4>Sin resultados</h4>
                    <p>No hay permisos que coincidan con "@_filtroTexto".</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var grupoModulo in gruposModulo)
            {
                var permisosModulo = grupoModulo.ToList();
                var acciones = permisosModulo
                    .Select(p => ObtenerAccion(p.Codigo))
                    .Where(a => !string.IsNullOrEmpty(a))
                    .Distinct()
                    .OrderBy(OrdenAccion)
                    .ToList();

                var componentes = permisosModulo
                    .GroupBy(p => ObtenerComponente(p.Codigo))
                    .OrderBy(g => g.Key)
                    .ToList();

                <div class="card-table mb-4">
                    <div class="filtros-tabla">
                        <div class="filtros-titulo">
                            <i class="bi bi-folder-fill" style="color: var(--warning);"></i>
                            <span>@grupoModulo.Key</span>
                        </div>
                        <div class="filtro-info">
                            <span class="badge-total">
                                <i class="bi bi-list-ul"></i>
                                <strong>@componentes.Count</strong> componentes ·
                                <strong>@permisosModulo.Count(p => p.Asignado)</strong>/@permisosModulo.Count asignados
                            </span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table modern-table" style="min-width: 600px;">
                            <thead>
                                <tr>
                                    <th style="min-width: 200px;">Componente</th>
                                    @foreach (var accion in acciones)
                                    {
                                        <th class="text-center" style="min-width: 90px;">
                                            <div style="display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 4px 0;">
                                                <i class="bi @IconoAccion(accion)" style="font-size: 1.1rem; color: var(--brand);"></i>
                                                <span style="font-size: 0.7rem;">@NombreAccion(accion)</span>
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       style="cursor: pointer;"
                                                       title="Seleccionar / deseleccionar toda la columna"
                                                       checked="@TodosAsignadosEnColumna(permisosModulo, accion)"
                                                       @onchange="e => ToggleColumna(permisosModulo, accion, (bool)(e.Value ?? false))" />
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comp in componentes)
                                {
                                    <tr class="table-row-hover">
                                        <td>
                                            <div class="table-cell-primary">
                                                <strong>@comp.Key</strong>
                                                <small>Gestión de @comp.Key</small>
                                            </div>
                                        </td>
                                        @foreach (var accion in acciones)
                                        {
                                            var perm = comp.FirstOrDefault(p => ObtenerAccion(p.Codigo) == accion);
                                            <td class="text-center">
                                                @if (perm != null)
                                                {
                                                    <div class="form-check form-switch d-inline-block">
                                                        <InputCheckbox class="form-check-input permiso-switch" @bind-Value="perm.Asignado" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="card-table">
            <div class="empty-state">
                <i class="bi bi-shield-lock"></i>
                <h4>Selecciona un rol</h4>
                <p>Elige un rol arriba para ver y editar sus permisos asignados.</p>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<Rol> roles = [];
    private IEnumerable<Permiso> permisos = [];
    private List<PermisoRolDTO> permisosPantalla = [];
    private int rolSeleccionadoId;
    private bool puedeAsignarPermisos;
    private string _filtroTexto = string.Empty;

    // ═══════════ FILTRO ═══════════
    private IEnumerable<PermisoRolDTO> PermisosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filtroTexto)) return permisosPantalla;

            var f = _filtroTexto.Trim().ToLower();
            return permisosPantalla.Where(p =>
                (p.Codigo?.ToLower().Contains(f) ?? false) ||
                (p.Descripcion?.ToLower().Contains(f) ?? false) ||
                (p.Modulo?.ToLower().Contains(f) ?? false));
        }
    }

    private void LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
    }

    // ═══════════ HELPERS PARA PARSING ═══════════
    private static string ObtenerComponente(string? codigo)
    {
        if (string.IsNullOrWhiteSpace(codigo)) return "";
        var idx = codigo.IndexOf('.');
        return idx > 0 ? codigo.Substring(0, idx) : codigo;
    }

    private static string ObtenerAccion(string? codigo)
    {
        if (string.IsNullOrWhiteSpace(codigo)) return "";
        var idx = codigo.IndexOf('.');
        return (idx > 0 && idx < codigo.Length - 1) ? codigo.Substring(idx + 1) : "";
    }

    private static int OrdenAccion(string accion) => accion switch
    {
        "ver" => 1,
        "crear" => 2,
        "editar" => 3,
        "actualizar" => 3,
        "movimiento" => 4,
        "calcular" => 5,
        "exportar" => 6,
        "abrir" => 7,
        "cerrar" => 8,
        "escanear" => 9,
        "permisos" => 10,
        "eliminar" => 11,
        "borrar" => 11,
        _ => 99
    };

    private static string NombreAccion(string accion) => accion switch
    {
        "ver" => "Ver",
        "crear" => "Crear",
        "editar" => "Editar",
        "actualizar" => "Actualizar",
        "eliminar" => "Eliminar",
        "borrar" => "Borrar",
        "movimiento" => "Movimiento",
        "calcular" => "Calcular",
        "exportar" => "Exportar",
        "abrir" => "Abrir",
        "cerrar" => "Cerrar",
        "escanear" => "Escanear",
        "permisos" => "Permisos",
        _ => string.IsNullOrEmpty(accion) ? "—" : char.ToUpper(accion[0]) + accion.Substring(1)
    };

    private static string IconoAccion(string accion) => accion switch
    {
        "ver" => "bi-eye-fill",
        "crear" => "bi-plus-circle-fill",
        "editar" => "bi-pencil-fill",
        "actualizar" => "bi-arrow-clockwise",
        "eliminar" => "bi-trash-fill",
        "borrar" => "bi-trash-fill",
        "movimiento" => "bi-arrow-left-right",
        "calcular" => "bi-calculator-fill",
        "exportar" => "bi-download",
        "abrir" => "bi-unlock-fill",
        "cerrar" => "bi-lock-fill",
        "escanear" => "bi-upc-scan",
        "permisos" => "bi-key-fill",
        _ => "bi-circle"
    };

    // ═══════════ SELECCIÓN MASIVA POR COLUMNA ═══════════
    private bool TodosAsignadosEnColumna(IEnumerable<PermisoRolDTO> permisosModulo, string accion)
    {
        var enColumna = permisosModulo.Where(p => ObtenerAccion(p.Codigo) == accion).ToList();
        return enColumna.Any() && enColumna.All(p => p.Asignado);
    }

    private void ToggleColumna(IEnumerable<PermisoRolDTO> permisosModulo, string accion, bool valor)
    {
        foreach (var p in permisosModulo.Where(x => ObtenerAccion(x.Codigo) == accion))
        {
            p.Asignado = valor;
        }
        StateHasChanged();
    }

    // ═══════════ CICLO DE VIDA ═══════════
    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("roles.permisos"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeAsignarPermisos = await Seguridad.TienePermisoAsync("roles.permisos");

        await CargarRoles();
        permisos = await PermisoRepository.ObtenerTodosAsync();
    }

    private async Task CargarPermisosRol()
    {
        permisosPantalla.Clear();

        var permisosRol = await RolPermisoRepository.ObtenerPorRolAsync(rolSeleccionadoId);

        foreach (var permiso in permisos)
        {
            permisosPantalla.Add(new PermisoRolDTO
            {
                PermisoId = permiso.Id,
                Codigo = permiso.Codigo,
                Descripcion = permiso.Descripcion,
                Modulo = permiso.Modulo,
                Asignado = permisosRol.Any(x => x.PermisoId == permiso.Id)
            });
        }
    }

    private async Task Guardar()
    {
        if (!puedeAsignarPermisos) return;

        try
        {
            var idsAsignados = permisosPantalla
                .Where(p => p.Asignado)
                .Select(p => p.PermisoId)
                .ToList();

            await RolPermisoRepository.ReemplazarPermisosAsync(rolSeleccionadoId, idsAsignados);

            Toast.Exito($"Permisos guardados: {idsAsignados.Count} asignados.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Error al guardar permisos: {ex.Message}");
        }
    }

    private async Task RolSeleccionadoCambio(ChangeEventArgs e)
    {
        rolSeleccionadoId = Convert.ToInt32(e.Value);

        if (rolSeleccionadoId > 0)
        {
            await CargarPermisosRol();
        }
        else
        {
            permisosPantalla.Clear();
        }

        _filtroTexto = string.Empty;
        StateHasChanged();
    }

    private async Task CargarRoles()
    {
        roles = await RolRepository.ObtenerTodosAsync();
        permisos = await PermisoRepository.ObtenerTodosAsync();
    }
}