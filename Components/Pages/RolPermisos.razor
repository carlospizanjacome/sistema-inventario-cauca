@page "/rol-permisos"
@rendermode InteractiveServer

@using Almacen.Models
@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services

@inject IRolRepository RolRepository
@inject IPermisoRepository PermisoRepository
@inject IRolPermisoRepository RolPermisoRepository
@inject UsuarioSesionService Sesion
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Asignar Permisos · Almacén</PageTitle>

<div class="page-container">

    @* ═══════════════ HEADER ═══════════════ *@
    <div class="page-header">
        <div>
            <h1><i class="bi bi-shield-lock-fill"></i> Asignación de Permisos</h1>
            <p class="subtitle">Administración de accesos por rol dentro del sistema</p>
        </div>
    </div>

    @* ═══════════════ SELECTOR DE ROL + BOTÓN GUARDAR ═══════════════ *@
    <div class="modern-card mb-4" style="padding: var(--space-5);">
        <div class="form-grid-2" style="align-items: end;">
            <div class="form-group">
                <label>Seleccione un Rol</label>
                <div class="input-icon">
                    <i class="bi bi-person-badge-fill"></i>
                    <select class="form-select" @onchange="RolSeleccionadoCambio">
                        <option value="0">Seleccione un rol…</option>
                        @foreach (var rol in roles)
                        {
                            <option value="@rol.Id">@rol.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group" style="align-items: end; display: flex;">
                @if (rolSeleccionadoId > 0 && puedeAsignarPermisos)
                {
                    <button type="button" class="btn btn-save" @onclick="Guardar">
                        <i class="bi bi-save-fill"></i>
                        Guardar Cambios
                    </button>
                }
            </div>
        </div>
    </div>

    @* ═══════════════ MATRIZ DE PERMISOS ═══════════════ *@
    @if (rolSeleccionadoId > 0)
    {
        @foreach (var grupo in permisosPantalla.GroupBy(x => x.Modulo))
        {
            <div class="card-table mb-4">
                <div class="filtros-tabla" style="background: var(--bg-muted);">
                    <div class="filtros-titulo" style="display: flex; align-items: center; gap: var(--space-2); font-weight: var(--fw-bold); color: var(--text-primary); text-transform: uppercase; letter-spacing: 1px; font-size: var(--fs-xs);">
                        <i class="bi bi-folder-fill" style="color: var(--warning);"></i>
                        @grupo.Key
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table modern-table" style="min-width: 600px;">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Objeto / Componente</th>
                                <th class="text-center" style="width: 15%;">Ver</th>
                                <th class="text-center" style="width: 15%;">Crear</th>
                                <th class="text-center" style="width: 15%;">Editar</th>
                                <th class="text-center" style="width: 15%;">Eliminar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var objetoGrupo in grupo.GroupBy(p => p.Codigo.Contains('.') ? p.Codigo.Substring(0, p.Codigo.IndexOf('.')) : p.Codigo))
                            {
                                var nombreComponente = objetoGrupo.Key;
                                var permisoVer = objetoGrupo.FirstOrDefault(p => p.Codigo.EndsWith(".ver") || p.Codigo == nombreComponente);
                                var permisoCrear = objetoGrupo.FirstOrDefault(p => p.Codigo.EndsWith(".crear"));
                                var permisoEditar = objetoGrupo.FirstOrDefault(p => p.Codigo.EndsWith(".editar") || p.Codigo.EndsWith(".actualizar"));
                                var permisoEliminar = objetoGrupo.FirstOrDefault(p => p.Codigo.EndsWith(".eliminar") || p.Codigo.EndsWith(".borrar"));

                                <tr class="table-row-hover">
                                    <td>
                                        <div class="table-cell-primary">
                                            <strong>@nombreComponente</strong>
                                            <small>Gestión de @nombreComponente</small>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (permisoVer != null)
                                        {
                                            <div class="form-check form-switch d-inline-block">
                                                <InputCheckbox class="form-check-input permiso-switch" @bind-Value="permisoVer.Asignado" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (permisoCrear != null)
                                        {
                                            <div class="form-check form-switch d-inline-block">
                                                <InputCheckbox class="form-check-input permiso-switch" @bind-Value="permisoCrear.Asignado" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (permisoEditar != null)
                                        {
                                            <div class="form-check form-switch d-inline-block">
                                                <InputCheckbox class="form-check-input permiso-switch" @bind-Value="permisoEditar.Asignado" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (permisoEliminar != null)
                                        {
                                            <div class="form-check form-switch d-inline-block">
                                                <InputCheckbox class="form-check-input permiso-switch" @bind-Value="permisoEliminar.Asignado" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card-table">
            <div class="empty-state">
                <i class="bi bi-shield-lock"></i>
                <h4>Selecciona un rol</h4>
                <p>Elige un rol arriba para ver y editar sus permisos asignados.</p>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<Rol> roles = [];
    private IEnumerable<Permiso> permisos = [];
    private List<PermisoRolDTO> permisosPantalla = [];
    private int rolSeleccionadoId;
    private bool puedeAsignarPermisos;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("roles.permisos"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeAsignarPermisos = await Seguridad.TienePermisoAsync("roles.permisos");

        await CargarRoles();

        permisos = await PermisoRepository.ObtenerTodosAsync();
    }

    private async Task CargarPermisosRol()
    {
        permisosPantalla.Clear();

        var permisosRol = await RolPermisoRepository.ObtenerPorRolAsync(rolSeleccionadoId);

        foreach (var permiso in permisos)
        {
            permisosPantalla.Add(new PermisoRolDTO
            {
                PermisoId = permiso.Id,
                Codigo = permiso.Codigo,
                Descripcion = permiso.Descripcion,
                Modulo = permiso.Modulo,
                Asignado = permisosRol.Any(x => x.PermisoId == permiso.Id)
            });
        }
    }

    private async Task Guardar()
    {
        if (!puedeAsignarPermisos) return;

        try
        {
            var idsAsignados = permisosPantalla
                .Where(p => p.Asignado)
                .Select(p => p.PermisoId);

            await RolPermisoRepository.ReemplazarPermisosAsync(rolSeleccionadoId, idsAsignados);

            Toast.Exito("Permisos guardados correctamente");
        }
        catch (Exception ex)
        {
            Toast.Error($"Error al guardar permisos: {ex.Message}");
        }
    }

    private async Task RolSeleccionadoCambio(ChangeEventArgs e)
    {
        rolSeleccionadoId = Convert.ToInt32(e.Value);

        if (rolSeleccionadoId > 0)
        {
            await CargarPermisosRol();
        }
        else
        {
            permisosPantalla.Clear();
        }

        StateHasChanged();
    }

    private async Task CargarRoles()
    {
        roles = await RolRepository.ObtenerTodosAsync();
        permisos = await PermisoRepository.ObtenerTodosAsync();
    }
}