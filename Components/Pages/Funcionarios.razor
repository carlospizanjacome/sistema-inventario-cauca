@page "/funcionarios"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IFuncionarioRepository FuncRepo
@inject ISedeRepository SedeRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Funcionarios · Almacén</PageTitle>

<div class="usuarios-page usuarios-fullscreen">

    <div class="modern-card panel-formulario">

        <div class="card-top-compact d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
            <div class="card-icon-small-inline">
                <i class="bi @(editando ? "bi-pencil-square" : "bi-person-badge-fill")" style="color: #4f46e5; font-size: 1.1rem;"></i>
            </div>
            <div class="d-flex align-items-baseline gap-2">
                <h5 class="m-0 fw-bold text-dark" style="font-size: 1rem;">@(editando ? "Editar Funcionario" : "Nuevo Funcionario")</h5>
                <span class="text-muted d-none d-sm-inline" style="font-size: 0.75rem;">| Cuentandantes y personal con responsabilidad sobre bienes</span>
            </div>
        </div>

        <EditForm @key="funcionarioEditandoId" Model="funcionarioDTO" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="container-fluid p-0">

                <div class="row g-2 mb-2">
                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>Cédula *</label>
                            <div class="input-modern">
                                <i class="bi bi-person-vcard"></i>
                                <InputText class="form-control" @bind-Value="funcionarioDTO.Cedula" placeholder="Ej: 1061123456" />
                            </div>
                            <ValidationMessage For="() => funcionarioDTO.Cedula" />
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="modern-group">
                            <label>Nombre Completo *</label>
                            <div class="input-modern">
                                <i class="bi bi-person-fill"></i>
                                <InputText class="form-control" @bind-Value="funcionarioDTO.NombreCompleto" />
                            </div>
                            <ValidationMessage For="() => funcionarioDTO.NombreCompleto" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="modern-group">
                            <label>Cargo</label>
                            <div class="input-modern">
                                <i class="bi bi-briefcase"></i>
                                <InputText class="form-control" @bind-Value="funcionarioDTO.Cargo" placeholder="Ej: Docente" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>Tipo Vinculación</label>
                            <div class="input-modern">
                                <i class="bi bi-file-earmark-text"></i>
                                <InputSelect class="form-select" @bind-Value="funcionarioDTO.TipoVinculacion">
                                    <option value="">— Seleccione —</option>
                                    <option value="Planta">Planta</option>
                                    <option value="Provisional">Provisional</option>
                                    <option value="Contratista">Contratista</option>
                                    <option value="Temporal">Temporal</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="modern-group">
                            <label>Email</label>
                            <div class="input-modern">
                                <i class="bi bi-envelope"></i>
                                <InputText class="form-control" type="email" @bind-Value="funcionarioDTO.Email" />
                            </div>
                            <ValidationMessage For="() => funcionarioDTO.Email" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="modern-group">
                            <label>Teléfono</label>
                            <div class="input-modern">
                                <i class="bi bi-telephone"></i>
                                <InputText class="form-control" @bind-Value="funcionarioDTO.Telefono" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 d-flex align-items-end pb-2">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="funcionarioDTO.Activo" id="chkActivo" />
                            <label class="form-check-label" for="chkActivo">Activo</label>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <div class="modern-group">
                            <label>Sede</label>
                            <div class="input-modern">
                                <i class="bi bi-building"></i>
                                <InputSelect class="form-select" @bind-Value="funcionarioDTO.SedeId">
                                    <option value="">— Sin sede asignada —</option>
                                    @foreach (var s in sedes)
                                    {
                                        <option value="@s.Id">@s.InstitucionNombre — @s.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-3 justify-content-end">
                @if (editando)
                {
                    <button type="button" class="btn btn-cancel px-4" @onclick="Cancelar">
                        <i class="bi bi-x-circle me-2"></i> Cancelar
                    </button>
                }
                <button type="submit" class="btn btn-save px-4">
                    <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill") me-2"></i>
                    @(editando ? "Actualizar Funcionario" : "Guardar Funcionario")
                </button>
            </div>
        </EditForm>
    </div>

    <!-- ═══════════ TABLA CON PAGINACIÓN ═══════════ -->
    <div class="modern-card panel-tabla-elastic position-relative">

        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por cédula, nombre o email…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
            <div class="filtro-info">
                <span class="badge-total">
                    <i class="bi bi-person-badge"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> funcionarios
                </span>
            </div>
        </div>

        <div class="table-responsive style-scrollbar">
            <table class="table modern-table align-middle m-0">
                <thead>
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Cargo</th>
                        <th>Sede</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Cargando...
                        </td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Sin funcionarios registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var f in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td><code>@f.Cedula</code></td>
                                <td><strong>@f.NombreCompleto</strong></td>
                                <td>@f.Cargo</td>
                                <td>@f.SedeNombre</td>
                                <td>
                                    <div class="contact-cell">
                                        @if (!string.IsNullOrEmpty(f.Email))
                                        {
                                            <span><i class="bi bi-envelope"></i> @f.Email</span>
                                        }
                                        @if (!string.IsNullOrEmpty(f.Telefono))
                                        {
                                            <span><i class="bi bi-telephone"></i> @f.Telefono</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(f.Activo ? "badge-ok" : "badge-off")">
                                        @(f.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (puedeEditar)
                                    {
                                        <button class="btn-icon me-1" @onclick="() => Editar(f)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        <button class="btn-icon danger" @onclick="() => Eliminar(f)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="FuncionarioDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private ResultadoPaginado<FuncionarioDTO>? _pagina;
    private IEnumerable<SedeDTO> sedes = [];

    private FuncionarioDTO funcionarioDTO = new();
    private bool editando = false;
    private int funcionarioEditandoId;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("funcionarios.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("funcionarios.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("funcionarios.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("funcionarios.eliminar");

        sedes = await SedeRepo.ObtenerTodasAsync();

        await Cargar();
    }

    private async Task Cargar()
    {
        _pagina = await FuncRepo.ObtenerPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para crear funcionarios.");
            return;
        }
        if (editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar funcionarios.");
            return;
        }

        if (await FuncRepo.ExisteCedulaAsync(funcionarioDTO.Cedula, editando ? funcionarioEditandoId : null))
        {
            Toast.Error($"La cédula '{funcionarioDTO.Cedula}' ya existe.");
            return;
        }

        try
        {
            if (editando)
            {
                await FuncRepo.ActualizarAsync(funcionarioDTO);
                Toast.Exito("Funcionario actualizado correctamente");
            }
            else
            {
                await FuncRepo.CrearAsync(funcionarioDTO);
                Toast.Exito("Funcionario creado correctamente");
            }

            Cancelar();
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(FuncionarioDTO f)
    {
        if (!puedeEditar) return;

        editando = true;
        funcionarioEditandoId = f.Id;

        funcionarioDTO.Id = f.Id;
        funcionarioDTO.Cedula = f.Cedula;
        funcionarioDTO.NombreCompleto = f.NombreCompleto;
        funcionarioDTO.Cargo = f.Cargo;
        funcionarioDTO.TipoVinculacion = f.TipoVinculacion;
        funcionarioDTO.Email = f.Email;
        funcionarioDTO.Telefono = f.Telefono;
        funcionarioDTO.SedeId = f.SedeId;
        funcionarioDTO.UsuarioId = f.UsuarioId;
        funcionarioDTO.Activo = f.Activo;

        StateHasChanged();
    }

    private async Task Eliminar(FuncionarioDTO f)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar funcionarios.");
            return;
        }

        var ok = await Confirm.Peligroso(
            $"¿Eliminar a '{f.NombreCompleto}'?");
        if (!ok) return;

        if (await FuncRepo.TieneBienesAsync(f.Id))
        {
            Toast.Error("No se puede eliminar: el funcionario tiene bienes asignados.");
            return;
        }

        try
        {
            await FuncRepo.EliminarAsync(f.Id);
            Toast.Exito("Funcionario eliminado correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Cancelar()
    {
        funcionarioDTO = new FuncionarioDTO();
        editando = false;
        funcionarioEditandoId = 0;
        StateHasChanged();
    }
}