@page "/funcionarios"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Almacen.Helpers
@using Almacen.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IFuncionarioRepository FuncRepo
@inject ISedeRepository SedeRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Funcionarios · Almacén</PageTitle>

<div class="page-container page-crud">

    @* ═══════════════ PAGE HEADER (oculto si form abierto) ═══════════════ *@
    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-person-badge"></i> Funcionarios</h1>
                <p class="subtitle">Cuentandantes y personal con responsabilidad sobre bienes</p>
            </div>

            <div class="header-actions">
                @if (puedeCrear)
                {
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nuevo Funcionario
                    </button>
                }
            </div>
        </div>
    }

    @* ═══════════════ FORM COLAPSABLE ═══════════════ *@
    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(editando ? "Editar Funcionario" : "Nuevo Funcionario")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-person-badge"></i>
                    <div>
                        <div class="form-header-title">Funcionarios</div>
                        <div class="form-header-subtitle">Cuentandantes y personal con responsabilidad sobre bienes</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="() => CerrarFormulario()" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="funcionarioEditandoId" Model="funcionarioDTO" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid-3">
                    <div class="form-group">
                        <label>Cédula *</label>
                        <div class="input-icon">
                            <i class="bi bi-person-vcard"></i>
                            <InputText class="form-control" @bind-Value="funcionarioDTO.Cedula" placeholder="Ej: 1061123456" />
                        </div>
                        <ValidationMessage For="() => funcionarioDTO.Cedula" />
                    </div>

                    <div class="form-group" style="grid-column: span 2;">
                        <label>Nombre Completo *</label>
                        <div class="input-icon">
                            <i class="bi bi-person-fill"></i>
                            <InputText class="form-control" @bind-Value="funcionarioDTO.NombreCompleto" placeholder="Ej: Juan Pérez Rodríguez" />
                        </div>
                        <ValidationMessage For="() => funcionarioDTO.NombreCompleto" />
                    </div>

                    <div class="form-group">
                        <label>Cargo</label>
                        <div class="input-icon">
                            <i class="bi bi-briefcase"></i>
                            <InputText class="form-control" @bind-Value="funcionarioDTO.Cargo" placeholder="Ej: Docente" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Tipo Vinculación</label>
                        <div class="input-icon">
                            <i class="bi bi-file-earmark-text"></i>
                            <InputSelect class="form-control" @bind-Value="funcionarioDTO.TipoVinculacion">
                                <option value="">— Seleccione —</option>
                                <option value="Planta">Planta</option>
                                <option value="Provisional">Provisional</option>
                                <option value="Contratista">Contratista</option>
                                <option value="Temporal">Temporal</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Sede</label>
                        <div class="input-icon">
                            <i class="bi bi-building"></i>
                            <InputSelect class="form-control" @bind-Value="funcionarioDTO.SedeId">
                                <option value="">— Sin sede asignada —</option>
                                @foreach (var s in sedes)
                                {
                                    <option value="@s.Id">@s.InstitucionNombre — @s.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-icon">
                            <i class="bi bi-envelope"></i>
                            <InputText class="form-control" type="email" @bind-Value="funcionarioDTO.Email" placeholder="correo@ejemplo.com" />
                        </div>
                        <ValidationMessage For="() => funcionarioDTO.Email" />
                    </div>

                    <div class="form-group">
                        <label>Teléfono</label>
                        <div class="input-icon">
                            <i class="bi bi-telephone"></i>
                            <InputText class="form-control" @bind-Value="funcionarioDTO.Telefono" placeholder="Ej: 3001234567" />
                        </div>
                    </div>

                    <div class="form-group checkbox-group">
                        <label>
                            <InputCheckbox @bind-Value="funcionarioDTO.Activo" />
                            Activo
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="() => CerrarFormulario()">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    @* ═══════════════ CARD TABLE ═══════════════ *@
    <div class="card-table">

        @* Barra de búsqueda SIEMPRE visible *@
        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por cédula, nombre o email…"
                       value="@_filtroTexto"
                       @oninput="OnFiltroInput" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
            <div class="filtro-info">
                <span class="badge-total">
                    <i class="bi bi-person-badge"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> funcionarios
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Cargo</th>
                        <th>Sede</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Cargando...</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Sin funcionarios registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var f in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td><code>@f.Cedula</code></td>
                                <td><strong>@f.NombreCompleto</strong></td>
                                <td>@f.Cargo</td>
                                <td>@f.SedeNombre</td>
                                <td>
                                    <div class="contact-cell">
                                        @if (!string.IsNullOrEmpty(f.Email))
                                        {
                                            <span><i class="bi bi-envelope"></i> @f.Email</span>
                                        }
                                        @if (!string.IsNullOrEmpty(f.Telefono))
                                        {
                                            <span><i class="bi bi-telephone"></i> @f.Telefono</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(f.Activo ? "badge-ok" : "badge-off")">
                                        @(f.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (puedeEditar)
                                    {
                                        <button class="btn-icon me-1" @onclick="() => Editar(f)" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        <button class="btn-icon danger" @onclick="() => Eliminar(f)" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="FuncionarioDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private ResultadoPaginado<FuncionarioDTO>? _pagina;
    private IEnumerable<SedeDTO> sedes = [];

    private FuncionarioDTO funcionarioDTO = new();
    private bool editando = false;
    private bool _mostrarFormulario = false;
    private int funcionarioEditandoId;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("funcionarios.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear = await Seguridad.TienePermisoAsync("funcionarios.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("funcionarios.editar");
        puedeEliminar = await Seguridad.TienePermisoAsync("funcionarios.eliminar");

        sedes = await SedeRepo.ObtenerTodasAsync();

        await Cargar();
    }

    private async Task Cargar()
    {
        _pagina = await FuncRepo.ObtenerPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto);
    }

    // ═══════════ INPUT BÚSQUEDA ═══════════
    private void OnFiltroInput(ChangeEventArgs e)
    {
        _filtroTexto = e.Value?.ToString() ?? string.Empty;
        _ = BuscarConDebounce();
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    // ═══════════ ABRIR / CERRAR FORM ═══════════
    private void AbrirFormulario()
    {
        funcionarioDTO = new FuncionarioDTO { Activo = true };
        editando = false;
        funcionarioEditandoId = 0;
        _mostrarFormulario = true;

        // Limpiar filtro y recargar la tabla
        _filtroTexto = string.Empty;
        _paginaActual = 1;
    }

    private async Task CerrarFormulario()
    {
        _mostrarFormulario = false;
        funcionarioDTO = new FuncionarioDTO();
        editando = false;
        funcionarioEditandoId = 0;

        // Limpiar filtro y recargar la tabla
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    // ═══════════ GUARDAR ═══════════
    private async Task Guardar()
    {
        if (!editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para crear funcionarios.");
            return;
        }
        if (editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar funcionarios.");
            return;
        }

        if (await FuncRepo.ExisteCedulaAsync(funcionarioDTO.Cedula, editando ? funcionarioEditandoId : null))
        {
            Toast.Error($"La cédula '{funcionarioDTO.Cedula}' ya existe.");
            return;
        }

        try
        {
            if (editando)
            {
                // ── EDICIÓN: guardar y MANTENER ABIERTO con los datos ──
                await FuncRepo.ActualizarAsync(funcionarioDTO);
                Toast.Exito($"Funcionario '{funcionarioDTO.NombreCompleto}' actualizado. Puede seguir editando.");
            }
            else
            {
                // ── CREACIÓN: guardar y MANTENER ABIERTO, limpiar form ──
                await FuncRepo.CrearAsync(funcionarioDTO);
                Toast.Exito($"Funcionario '{funcionarioDTO.NombreCompleto}' creado. Puede continuar registrando.");

                // Mantener cargo, tipo vinculación y sede para registros masivos
                var cargoActual = funcionarioDTO.Cargo;
                var tipoActual = funcionarioDTO.TipoVinculacion;
                var sedeActual = funcionarioDTO.SedeId;

                funcionarioDTO = new FuncionarioDTO
                {
                    Activo = true,
                    Cargo = cargoActual,
                    TipoVinculacion = tipoActual,
                    SedeId = sedeActual
                };

                // Enfocar el primer campo (Cédula)
                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { /* silencioso */ }
            }

            // Limpiar filtro y recargar la tabla
            _filtroTexto = string.Empty;
            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    // ═══════════ EDITAR ═══════════
    private void Editar(FuncionarioDTO f)
    {
        if (!puedeEditar) return;

        editando = true;
        funcionarioEditandoId = f.Id;
        _mostrarFormulario = true;

        funcionarioDTO.Id = f.Id;
        funcionarioDTO.Cedula = f.Cedula;
        funcionarioDTO.NombreCompleto = f.NombreCompleto;
        funcionarioDTO.Cargo = f.Cargo;
        funcionarioDTO.TipoVinculacion = f.TipoVinculacion;
        funcionarioDTO.Email = f.Email;
        funcionarioDTO.Telefono = f.Telefono;
        funcionarioDTO.SedeId = f.SedeId;
        funcionarioDTO.UsuarioId = f.UsuarioId;
        funcionarioDTO.Activo = f.Activo;

        // Limpiar filtro al entrar en modo edición
        _filtroTexto = string.Empty;
        _paginaActual = 1;

        StateHasChanged();
    }

    // ═══════════ ELIMINAR ═══════════
    private async Task Eliminar(FuncionarioDTO f)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar funcionarios.");
            return;
        }

        var ok = await Confirm.Peligroso(
            $"¿Eliminar a '{f.NombreCompleto}'? Esta acción no se puede deshacer.");
        if (!ok) return;

        if (await FuncRepo.TieneBienesAsync(f.Id))
        {
            Toast.Error("No se puede eliminar: el funcionario tiene bienes asignados.");
            return;
        }

        try
        {
            await FuncRepo.EliminarAsync(f.Id);
            Toast.Exito("Funcionario eliminado correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }
}