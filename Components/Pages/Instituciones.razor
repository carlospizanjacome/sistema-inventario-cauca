@page "/instituciones"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms

@inject IInstitucionRepository InstRepo
@inject UsuarioSesionService Sesion
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject IJSRuntime JS

<PageTitle>Instituciones · Almacén</PageTitle>

<div class="page-container page-crud">

    @* ═══════════════ PAGE HEADER (oculto si form abierto) ═══════════════ *@
    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-bank"></i> Instituciones Educativas</h1>
                <p class="subtitle">Registro de IE administradas por el sistema</p>
            </div>

            <div class="header-actions">
                @if (Sesion.EsSuperAdmin)
                {
                    <span class="badge-super">🔑 Super-Admin</span>
                }

                <button class="btn-nuevo" @onclick="AbrirFormulario">
                    <i class="bi bi-plus-lg"></i> Nueva Institución
                </button>
            </div>
        </div>
    }

    @* ═══════════════ FORM COLAPSABLE ═══════════════ *@
    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(_editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(_editando ? "Editar Institución" : "Nueva Institución")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-bank"></i>
                    <div>
                        <div class="form-header-title">Instituciones</div>
                        <div class="form-header-subtitle">Registro de IE administradas por el sistema</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="CerrarFormulario" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="institucionEditandoId" Model="_model" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="form-group">
                        <label>Nombre *</label>
                        <div class="input-icon">
                            <i class="bi bi-bank"></i>
                            <InputText class="form-control" @bind-Value="_model.Nombre" placeholder="Ej: IE Ciudad de Popayán" />
                        </div>
                        <ValidationMessage For="() => _model.Nombre" />
                    </div>

                    <div class="form-group">
                        <label>NIT</label>
                        <div class="input-icon">
                            <i class="bi bi-hash"></i>
                            <InputText class="form-control" @bind-Value="_model.Nit" placeholder="Ej: 900123456-7" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Código DANE</label>
                        <div class="input-icon">
                            <i class="bi bi-bookmark"></i>
                            <InputText class="form-control" @bind-Value="_model.CodigoDane" placeholder="Ej: 219001000123" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Rector</label>
                        <div class="input-icon">
                            <i class="bi bi-person-badge"></i>
                            <InputText class="form-control" @bind-Value="_model.Rector" placeholder="Nombre del rector" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Dirección</label>
                        <div class="input-icon">
                            <i class="bi bi-geo-alt"></i>
                            <InputText class="form-control" @bind-Value="_model.Direccion" placeholder="Dirección física" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Teléfono</label>
                        <div class="input-icon">
                            <i class="bi bi-telephone"></i>
                            <InputText class="form-control" @bind-Value="_model.Telefono" placeholder="Ej: 8201234" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-icon">
                            <i class="bi bi-envelope"></i>
                            <InputText class="form-control" type="email" @bind-Value="_model.Email" placeholder="correo@institucion.edu.co" />
                        </div>
                        <ValidationMessage For="() => _model.Email" />
                    </div>

                    <div class="form-group checkbox-group">
                        <label>
                            <InputCheckbox @bind-Value="_model.Activo" />
                            Activa
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="CerrarFormulario">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(_editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(_editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    @* ═══════════════ CARD TABLE ═══════════════ *@
    <div class="card-table">

        @* Barra superior: búsqueda + contador *@
        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por nombre, NIT o rector…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="AplicarFiltro" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
            <div class="filtro-info">
                <span class="badge-total">
                    <i class="bi bi-bank"></i>
                    <strong>@(Filtradas.Count())</strong> instituciones
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>NIT</th>
                        <th>DANE</th>
                        <th>Rector</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_instituciones == null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Cargando...</td></tr>
                    }
                    else if (!Filtradas.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Sin instituciones para mostrar.</td></tr>
                    }
                    else
                    {
                        @foreach (var i in Paginadas)
                        {
                            <tr class="table-row-hover">
                                <td><strong>@i.Nombre</strong></td>
                                <td><code>@i.Nit</code></td>
                                <td>@i.CodigoDane</td>
                                <td>@i.Rector</td>
                                <td>
                                    <div class="contact-cell">
                                        @if (!string.IsNullOrEmpty(i.Telefono))
                                        {
                                            <span><i class="bi bi-telephone"></i> @i.Telefono</span>
                                        }
                                        @if (!string.IsNullOrEmpty(i.Email))
                                        {
                                            <span><i class="bi bi-envelope"></i> @i.Email</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(i.Activo ? "badge-ok" : "badge-off")">
                                        @(i.Activo ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <button class="btn-action btn-action-edit" @onclick="() => Editar(i)" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn-action btn-action-delete" @onclick="() => Eliminar(i)" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ═══ PAGINADOR ═══ *@
        @if (_instituciones != null && Filtradas.Any())
        {
            <div class="paginador-container">
                <div class="paginador-info">
                    Mostrando
                    <strong>@(((_paginaActual - 1) * _tamanoPagina) + 1)</strong>
                    -
                    <strong>@Math.Min(_paginaActual * _tamanoPagina, Filtradas.Count())</strong>
                    de <strong>@Filtradas.Count()</strong> registros
                </div>

                <div class="paginador-controles">
                    <button class="pg-btn" @onclick="() => IrAPagina(1)" disabled="@(_paginaActual <= 1)" title="Primera">
                        <i class="bi bi-chevron-double-left"></i>
                    </button>
                    <button class="pg-btn" @onclick="() => IrAPagina(_paginaActual - 1)" disabled="@(_paginaActual <= 1)" title="Anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="pg-page">
                        Página <strong>@_paginaActual</strong> de <strong>@TotalPaginas</strong>
                    </span>
                    <button class="pg-btn" @onclick="() => IrAPagina(_paginaActual + 1)" disabled="@(_paginaActual >= TotalPaginas)" title="Siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button class="pg-btn" @onclick="() => IrAPagina(TotalPaginas)" disabled="@(_paginaActual >= TotalPaginas)" title="Última">
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                </div>

                <div class="paginador-size">
                    <label>Mostrar:</label>
                    <select value="@_tamanoPagina" @onchange="CambioTamano">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<InstitucionDTO>? _instituciones;
    private InstitucionDTO _model = new();
    private bool _editando = false;
    private bool _mostrarFormulario = false;
    private int institucionEditandoId;

    // ── Filtro + Paginación ──
    private string _filtroTexto = string.Empty;
    private int _paginaActual = 1;
    private int _tamanoPagina = 25;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
        => _instituciones = (await InstRepo.ObtenerTodasAsync()).ToList();

    // ═══════════ FILTRO ═══════════
    private IEnumerable<InstitucionDTO> Filtradas
    {
        get
        {
            if (_instituciones is null) return Enumerable.Empty<InstitucionDTO>();
            if (string.IsNullOrWhiteSpace(_filtroTexto)) return _instituciones;

            var f = _filtroTexto.Trim().ToLower();
            return _instituciones.Where(i =>
                (i.Nombre?.ToLower().Contains(f) ?? false) ||
                (i.Nit?.ToLower().Contains(f) ?? false) ||
                (i.Rector?.ToLower().Contains(f) ?? false));
        }
    }

    // ═══════════ PAGINACIÓN ═══════════
    private IEnumerable<InstitucionDTO> Paginadas
    {
        get
        {
            var lista = Filtradas.ToList();
            var skip = (_paginaActual - 1) * _tamanoPagina;
            return lista.Skip(skip).Take(_tamanoPagina);
        }
    }

    private int TotalPaginas
    {
        get
        {
            var total = Filtradas.Count();
            return total == 0 ? 1 : (int)Math.Ceiling((double)total / _tamanoPagina);
        }
    }

    private void IrAPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > TotalPaginas) return;
        _paginaActual = nuevaPagina;
    }

    private void CambioTamano(ChangeEventArgs e)
    {
        _tamanoPagina = int.Parse(e.Value?.ToString() ?? "25");
        _paginaActual = 1;
    }

    private void AplicarFiltro()
    {
        _paginaActual = 1;
    }

    private void LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
    }

    // ═══════════ FORM ═══════════
    private void AbrirFormulario()
    {
        _model = new InstitucionDTO { Activo = true };
        _editando = false;
        institucionEditandoId = 0;
        _mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario = false;
        _model = new InstitucionDTO();
        _editando = false;
        institucionEditandoId = 0;
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!Sesion.EsSuperAdmin)
        {
            Toast.Error("Solo el super-administrador puede gestionar instituciones.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(_model.Nit))
        {
            if (await InstRepo.ExisteNitAsync(_model.Nit, _editando ? institucionEditandoId : null))
            {
                Toast.Error($"El NIT '{_model.Nit}' ya está registrado.");
                return;
            }
        }

        try
        {
            if (_editando)
            {
                await InstRepo.ActualizarAsync(_model);
                Toast.Exito($"Institución '{_model.Nombre}' actualizada. Puede seguir editando.");
            }
            else
            {
                await InstRepo.CrearAsync(_model);
                Toast.Exito($"Institución '{_model.Nombre}' creada. Puede continuar registrando.");

                _model = new InstitucionDTO { Activo = true };

                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { /* silencioso */ }
            }

            await Cargar();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(InstitucionDTO i)
    {
        if (!Sesion.EsSuperAdmin) return;

        _editando = true;
        institucionEditandoId = i.Id;
        _mostrarFormulario = true;

        _model.Id = i.Id;
        _model.Nombre = i.Nombre;
        _model.Nit = i.Nit;
        _model.CodigoDane = i.CodigoDane;
        _model.Direccion = i.Direccion;
        _model.Telefono = i.Telefono;
        _model.Email = i.Email;
        _model.Rector = i.Rector;
        _model.Activo = i.Activo;

        StateHasChanged();
    }

       private async Task Eliminar(InstitucionDTO i)
    {
        if (!Sesion.EsSuperAdmin)
        {
            Toast.Error("Solo el super-administrador puede eliminar instituciones.");
            return;
        }

        var ok = await Confirm.Peligroso(
            $"¿Eliminar la institución '{i.Nombre}'? Esta acción no se puede deshacer.");
        if (!ok) return;

        // Validaciones previas
        if (await InstRepo.TieneSedesAsync(i.Id))
        {
            Toast.Error("No se puede eliminar: la institución tiene sedes asociadas.");
            return;
        }

        try
        {
            await InstRepo.EliminarAsync(i.Id);
            Toast.Exito("Institución eliminada correctamente");
            await Cargar();
        }
        catch (Npgsql.PostgresException pgEx) when (pgEx.SqlState == "23503")
        {
            // Error de FK: hay dependencias
            var mensaje = ObtenerMensajeDependencia(pgEx.ConstraintName);
            Toast.Error(mensaje);
        }
        catch (Exception ex)
        {
            Toast.Error($"Error al eliminar: {ex.Message}");
        }
    }

    private static string ObtenerMensajeDependencia(string? constraintName)
    {
        return constraintName switch
        {
            "usuarios_institucion_id_fkey"    => "No se puede eliminar: hay usuarios asociados a esta institución.",
            "sedes_institucion_id_fkey"       => "No se puede eliminar: hay sedes asociadas a esta institución.",
            "bienes_institucion_id_fkey"      => "No se puede eliminar: hay bienes registrados en esta institución.",
            "funcionarios_institucion_id_fkey"=> "No se puede eliminar: hay funcionarios asociados a esta institución.",
            _                                  => "No se puede eliminar: la institución tiene registros dependientes."
        };
    }
}