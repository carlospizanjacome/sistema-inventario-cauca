@page "/prestamos"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Almacen.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Globalization

@inject IPrestamoRepository PrestamoRepo
@inject IBienRepository BienRepo
@inject IFuncionarioRepository FuncRepo
@inject IInstitucionRepository InstRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject UsuarioSesionService Sesion
@inject AuditoriaService Auditoria

<PageTitle>Préstamos · Almacén</PageTitle>

<div class="page-container page-crud page-prestamos @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-arrow-repeat"></i> Préstamos</h1>
                <p class="subtitle">Gestión de préstamos temporales de bienes devolutivos</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nuevo Préstamo
                    </button>
                </div>
            }
        </div>

        <section class="kpi-grid">
            <div class="kpi-card kpi-indigo kpi-clicable" @onclick="FiltrarActivos">
                <div class="kpi-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Activos</span>
                    <span class="kpi-value">@_metricas.Activos</span>
                </div>
            </div>
            <div class="kpi-card kpi-red kpi-clicable" @onclick="FiltrarVencidos">
                <div class="kpi-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Vencidos</span>
                    <span class="kpi-value">@_metricas.Vencidos</span>
                </div>
            </div>
            <div class="kpi-card kpi-green kpi-clicable" @onclick="FiltrarDevueltos">
                <div class="kpi-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Devueltos</span>
                    <span class="kpi-value">@_metricas.Devueltos</span>
                </div>
            </div>
            <div class="kpi-card kpi-blue kpi-clicable" @onclick="FiltrarTodos">
                <div class="kpi-icon"><i class="bi bi-list-ul"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Total histórico</span>
                    <span class="kpi-value">@_metricas.Total</span>
                </div>
            </div>
        </section>

        <div class="pills-filter">
            <button type="button" class="pill-btn @(_pillActivo is null ? "active-indigo" : "inactive")" @onclick="FiltrarTodos">
                <i class="bi bi-list-ul"></i> Todos
            </button>
            <button type="button" class="pill-btn @(_pillActivo == "activos" ? "active-indigo" : "inactive")" @onclick="FiltrarActivos">
                <i class="bi bi-hourglass-split"></i> Activos
            </button>
            <button type="button" class="pill-btn @(_pillActivo == "vencidos" ? "active-red" : "inactive")" @onclick="FiltrarVencidos">
                <i class="bi bi-exclamation-triangle-fill"></i> Vencidos
            </button>
            <button type="button" class="pill-btn @(_pillActivo == "devueltos" ? "active-green" : "inactive")" @onclick="FiltrarDevueltos">
                <i class="bi bi-check-circle-fill"></i> Devueltos
            </button>
            <button type="button" class="pill-btn @(_pillActivo == "historico" ? "active-gray" : "inactive")" @onclick="FiltrarHistorico">
                <i class="bi bi-archive-fill"></i> Histórico
            </button>
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-plus-circle"></i>
                    <span>Nuevo Préstamo</span>
                </div>
                <div class="form-header-center">
                    <i class="bi bi-arrow-repeat"></i>
                    <div>
                        <div class="form-header-title">Préstamos</div>
                        <div class="form-header-subtitle">Solicitud de préstamo temporal</div>
                    </div>
                </div>
                <button class="btn-cerrar-form" @onclick="Cancelar" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="dto" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid-3">
                    <div class="form-group" style="grid-column: span 2;">
                        <label>Bien a prestar *</label>
                        <div class="input-icon">
                            <i class="bi bi-box-seam"></i>
                            <InputSelect class="form-select" @bind-Value="dto.BienId">
                                <option value="0">— Seleccione bien —</option>
                                @foreach (var b in bienes)
                                {
                                    <option value="@b.Id">@b.Codigo — @b.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="() => dto.BienId" class="form-error" />
                    </div>

                    <div class="form-group">
                        <label>Solicitante *</label>
                        <div class="input-icon">
                            <i class="bi bi-person-fill"></i>
                            <InputSelect class="form-select" @bind-Value="dto.FuncionarioSolicitaId">
                                <option value="0">— Seleccione funcionario —</option>
                                @foreach (var f in funcionarios)
                                {
                                    <option value="@f.Id">@f.NombreCompleto (@f.Cedula)</option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="() => dto.FuncionarioSolicitaId" class="form-error" />
                    </div>

                    <div class="form-group">
                        <label>Fecha devolución prevista *</label>
                        <div class="input-icon">
                            <i class="bi bi-calendar-check"></i>
                            <InputDate class="form-control" @bind-Value="dto.FechaDevolucionPrevista" />
                        </div>
                    </div>

                    <div class="form-group" style="grid-column: span 2;">
                        <label>Motivo del préstamo *</label>
                        <div class="input-icon">
                            <i class="bi bi-chat-left-text"></i>
                            <InputText class="form-control" @bind-Value="dto.Motivo"
                                       placeholder="Ej: Capacitación docente, evento institucional…" />
                        </div>
                        <ValidationMessage For="() => dto.Motivo" class="form-error" />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="Cancelar">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi bi-save-fill"></i> Crear solicitud
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">

        <div class="filtros-toolbar">
            <div class="filtro-busqueda-principal">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por bien, funcionario o motivo…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-toolbar-actions">
                <button class="btn-filtros @(_mostrarFiltros ? "active" : "")" @onclick="ToggleFiltros">
                    <i class="bi bi-sliders"></i>
                    <span>Filtros</span>
                    @if (_hayFiltrosAvanzados) { <span class="filtros-badge"></span> }
                    <i class="bi @(_mostrarFiltros ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
        </div>

        @if (_mostrarFiltros)
        {
            <div class="panel-filtros">
                <div class="filtros-grid">
                    <div class="filtro-select">
                        <i class="bi bi-circle-square"></i>
                        <select @bind="_filtroEstado" @bind:after="AplicarFiltrosAvanzados">
                            <option value="">Todos los estados</option>
                            <option value="SOLICITADO">Solicitado</option>
                            <option value="APROBADO">Aprobado</option>
                            <option value="PRESTADO">Prestado</option>
                            <option value="VENCIDO">Vencido</option>
                            <option value="DEVUELTO">Devuelto</option>
                            <option value="RECHAZADO">Rechazado</option>
                            <option value="ANULADO">Anulado</option>
                        </select>
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-calendar"></i>
                        <input type="date" @bind="_filtroFechaDesde" @bind:after="AplicarFiltrosAvanzados" />
                    </div>
                    <div class="filtro-select">
                        <i class="bi bi-calendar"></i>
                        <input type="date" @bind="_filtroFechaHasta" @bind:after="AplicarFiltrosAvanzados" />
                    </div>
                </div>

                <div class="filtros-acciones">
                    <span class="badge-total">
                        <i class="bi bi-arrow-repeat"></i>
                        <strong>@(_pagina?.TotalRegistros ?? 0)</strong> préstamos
                        @if (_hayFiltrosActivos) { <span class="filtro-activo-tag">· Filtrado</span> }
                    </span>
                    @if (_hayFiltrosAvanzados)
                    {
                        <button class="btn-limpiar-filtros" @onclick="LimpiarTodosLosFiltros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Limpiar filtros
                        </button>
                    }
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Bien</th>
                        <th>En poder de</th>
                        <th>Solicitado</th>
                        <th>Devolución prevista</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 220px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="6" class="text-center py-3 text-muted">Cargando préstamos…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center py-3 text-muted">Sin préstamos para mostrar.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in _pagina.Items)
                        {
                            <tr class="table-row-hover @(p.Estado == "VENCIDO" ? "row-warning" : "")" @key="p.Id">
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@p.BienNombre</strong>
                                        <small><code>@p.BienCodigo</code> · @p.BienCategoriaNombre</small>
                                    </div>
                                </td>
                                <td>
                                    @if (p.Estado == "PRESTADO" || p.Estado == "VENCIDO")
                                    {
                                        <div class="table-cell-primary">
                                            <strong class="@(p.Estado == "VENCIDO" ? "text-danger" : "")">
                                                <i class="bi bi-person-fill"></i> @p.FuncionarioSolicitaNombre
                                            </strong>
                                            <small>@p.FuncionarioSolicitaCedula</small>
                                        </div>
                                    }
                                    else if (p.Estado == "DEVUELTO")
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-check-circle-fill"></i> Devuelto a la IE
                                        </span>
                                    }
                                    else if (p.Estado == "SOLICITADO" || p.Estado == "APROBADO")
                                    {
                                        <span class="text-muted">
                                            <i class="bi bi-building"></i> En almacén
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-mono">@p.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="table-cell-primary">
                                        <span class="text-mono">@p.FechaDevolucionPrevista.ToString("dd/MM/yyyy")</span>
                                        @if (p.DiasRestantes.HasValue && (p.Estado == "PRESTADO" || p.Estado == "VENCIDO"))
                                        {
                                            <small class="@(p.DiasRestantes < 0 ? "text-danger" : "text-muted")">
                                                @if (p.DiasRestantes < 0)
                                                {
                                                    <span>@Math.Abs(p.DiasRestantes.Value) días vencido</span>
                                                }
                                                else
                                                {
                                                    <span>@p.DiasRestantes.Value días restantes</span>
                                                }
                                            </small>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @GetClaseBadgeEstado(p.Estado)">@p.Estado</span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <button class="btn-action btn-action-view"
                                                @onclick="() => VerDetalle(p)" title="Ver detalle">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>

                                        @if (p.Estado == "SOLICITADO" && puedeAprobar)
                                        {
                                            <button class="btn-action btn-action-ok"
                                                    @onclick="() => Aprobar(p)" title="Aprobar">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => Rechazar(p)" title="Rechazar">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }

                                        @if (p.Estado == "APROBADO" && puedeEntregar)
                                        {
                                            <button class="btn-action btn-action-ok"
                                                    @onclick="() => Entregar(p)" title="Registrar entrega">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </button>
                                        }

                                        @if ((p.Estado == "PRESTADO" || p.Estado == "VENCIDO") && puedeDevolver)
                                        {
                                            <button class="btn-action btn-action-ok"
                                                    @onclick="() => Devolver(p)" title="Registrar devolución">
                                                <i class="bi bi-box-arrow-in-down"></i>
                                            </button>
                                        }

                                        @if ((p.Estado == "SOLICITADO" || p.Estado == "APROBADO") && puedeAprobar)
                                        {
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => Anular(p)" title="Anular">
                                                <i class="bi bi-slash-circle"></i>
                                            </button>
                                        }

                                        @if (p.EsTerminal && puedeEliminar)
                                        {
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => IntentarAnularRegistro(p)"
                                                    title="Anular registro (soft-delete)">
                                                <i class="bi bi-slash-circle-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="PrestamoDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@* ═══════════════════════════════════════════════════════════
   MODAL DE ANULACIÓN DE REGISTRO (SOFT-DELETE)
   FUERA del page-container
   ═══════════════════════════════════════════════════════════ *@
@if (_modalAnularRegistroAbierto && _prestamoAAnular is not null)
{
    var p = _prestamoAAnular;

    <div class="modal-backdrop-anular" @onclick="CerrarModalAnularRegistro">
        <div class="modal-anular" @onclick:stopPropagation="true">
            <div class="modal-anular-header">
                <div class="modal-anular-header-left">
                    <span class="badge badge-warn">
                        <i class="bi bi-exclamation-triangle-fill"></i> Anular
                    </span>
                    <h3>Anular Registro de Préstamo</h3>
                </div>
                <button type="button" class="modal-anular-close" @onclick="CerrarModalAnularRegistro">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-anular-body">
                <div class="alerta-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>@p.BienNombre</strong>
                        <p style="margin: 4px 0 0; font-size: 0.85rem;">
                            Código: <code>@p.BienCodigo</code><br>
                            Estado: <strong>@p.Estado</strong><br>
                            Solicitante: @p.FuncionarioSolicitaNombre
                        </p>
                    </div>
                </div>

                <div class="alerta-warning" style="margin-top: 12px;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        <strong>Esta acción no elimina el registro.</strong>
                        <p style="margin: 4px 0 0; font-size: 0.85rem;">
                            El préstamo queda <strong>ANULADO</strong> con auditoría completa
                            (quién, cuándo, por qué). No aparecerá en los listados operativos,
                            pero permanece en el expediente para trazabilidad.
                        </p>
                    </div>
                </div>

                <div class="form-group" style="margin-top: 16px;">
                    <label class="mini-label">Motivo de la anulación *</label>
                    <InputTextArea class="form-control"
                                   rows="3"
                                   @bind-Value="_motivoAnulacionRegistro"
                                   placeholder="Ej: Préstamo creado por error, duplicado, datos incorrectos…" />
                    <small style="color: #64748b;">Este motivo queda registrado en auditoría (mín. 10 caracteres).</small>
                </div>
            </div>

            <div class="modal-anular-footer">
                <button type="button" class="btn-secondary-custom" @onclick="CerrarModalAnularRegistro">
                    Cancelar
                </button>
                <button type="button"
                        class="btn-peligro"
                        @onclick="ConfirmarAnulacionRegistro"
                        disabled="@_procesandoAnulacionRegistro">
                    @if (_procesandoAnulacionRegistro)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-slash-circle-fill me-1"></i>
                    }
                    Anular Registro
                </button>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════
   MODAL DE DETALLE / ACTA DE PRÉSTAMO
   ═══════════════════════════════════════════════════════════ *@
@if (_detalleAbierto && _prestamoDetalle is not null)
{
    var p = _prestamoDetalle;

    <div class="modal-backdrop-det" @onclick="CerrarDetalle">
        <div class="modal-det" @onclick:stopPropagation="true">

            <div class="modal-det-header no-print">
                <div class="modal-det-header-left">
                    <span class="badge @GetClaseBadgeEstado(p.Estado)">@p.Estado</span>
                    <h3>Préstamo #@p.Id</h3>
                </div>
                <button class="modal-det-close no-print" @onclick="CerrarDetalle" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-det-body">

                <div class="acta-header">
                    <div class="acta-header-left">
                        <h2>@Sesion.InstitucionNombre</h2>
                        <p>NIT: @_institucionNit</p>
                        @if (!string.IsNullOrEmpty(_institucionDane))
                        {
                            <p>Código DANE: @_institucionDane</p>
                        }
                    </div>
                    <div class="acta-header-right">
                        <div class="acta-title">ACTA DE PRÉSTAMO</div>
                        <div class="acta-code">N° PRE-@DateTime.Now.Year-@p.Id.ToString("D4")</div>
                        <div class="acta-date">Expedida: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>

                <div class="det-section">
                    <h4><i class="bi bi-box-seam"></i> Bien prestado</h4>
                    <dl class="det-dl">
                        <dt>Código</dt>
                        <dd><code>@p.BienCodigo</code></dd>
                        <dt>Nombre</dt>
                        <dd><strong>@p.BienNombre</strong></dd>
                        <dt>Categoría</dt>
                        <dd>@(p.BienCategoriaNombre ?? "—")</dd>
                    </dl>
                </div>

                <div class="det-section">
                    <h4><i class="bi bi-people"></i> Personas involucradas</h4>
                    <dl class="det-dl">
                        <dt>Solicitante</dt>
                        <dd>
                            <strong>@p.FuncionarioSolicitaNombre</strong>
                            @if (!string.IsNullOrEmpty(p.FuncionarioSolicitaCedula))
                            {
                                <small class="text-muted"> · CC @p.FuncionarioSolicitaCedula</small>
                            }
                        </dd>
                        <dt>Aprobado por</dt>
                        <dd>@(p.FuncionarioApruebaNombre ?? "—")</dd>
                        <dt>En poder de</dt>
                        <dd>
                            @if (p.Estado == "PRESTADO" || p.Estado == "VENCIDO")
                            {
                                <span class="@(p.Estado == "VENCIDO" ? "text-danger" : "text-success")">
                                    <i class="bi bi-person-fill"></i> @p.FuncionarioSolicitaNombre
                                </span>
                            }
                            else if (p.Estado == "DEVUELTO")
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill"></i> En la institución</span>
                            }
                            else
                            {
                                <span class="text-muted"><i class="bi bi-building"></i> En almacén</span>
                            }
                        </dd>
                    </dl>
                </div>

                <div class="det-section">
                    <h4><i class="bi bi-calendar-event"></i> Trazabilidad de fechas</h4>
                    <div class="det-timeline">
                        <div class="det-tl-row">
                            <div class="det-tl-dot dot-blue"></div>
                            <div class="det-tl-content">
                                <strong>Solicitud creada</strong>
                                <span>@p.FechaSolicitud.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        @if (p.FechaAprobacion.HasValue)
                        {
                            <div class="det-tl-row">
                                <div class="det-tl-dot dot-green"></div>
                                <div class="det-tl-content">
                                    <strong>Aprobado</strong>
                                    <span>@p.FechaAprobacion.Value.ToString("dd/MM/yyyy") · por @p.FuncionarioApruebaNombre</span>
                                </div>
                            </div>
                        }

                        @if (p.FechaPrestamo.HasValue)
                        {
                            <div class="det-tl-row">
                                <div class="det-tl-dot dot-indigo"></div>
                                <div class="det-tl-content">
                                    <strong>Entregado físicamente</strong>
                                    <span>@p.FechaPrestamo.Value.ToString("dd/MM/yyyy")</span>
                                    @if (!string.IsNullOrEmpty(p.EstadoBienEntrega))
                                    {
                                        <small class="text-muted">Estado al salir: @p.EstadoBienEntrega</small>
                                    }
                                </div>
                            </div>
                        }

                        <div class="det-tl-row">
                            <div class="det-tl-dot @(p.Estado == "VENCIDO" ? "dot-red" : "dot-orange")"></div>
                            <div class="det-tl-content">
                                <strong>Devolución prevista</strong>
                                <span>@p.FechaDevolucionPrevista.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        @if (p.FechaDevolucionReal.HasValue)
                        {
                            <div class="det-tl-row">
                                <div class="det-tl-dot dot-green"></div>
                                <div class="det-tl-content">
                                    <strong>Devuelto</strong>
                                    <span>@p.FechaDevolucionReal.Value.ToString("dd/MM/yyyy")</span>
                                    @if (!string.IsNullOrEmpty(p.EstadoBienDevolucion))
                                    {
                                        <small class="text-muted">Estado al volver: @p.EstadoBienDevolucion</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="det-section">
                    <h4><i class="bi bi-chat-left-text"></i> Motivo y observaciones</h4>
                    <div class="det-note">
                        <strong>Motivo:</strong>
                        <p>@p.Motivo</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(p.ObservacionesEntrega))
                    {
                        <div class="det-note">
                            <strong>Observaciones de entrega:</strong>
                            <p>@p.ObservacionesEntrega</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(p.ObservacionesDevolucion))
                    {
                        <div class="det-note">
                            <strong>Observaciones de devolución:</strong>
                            <p>@p.ObservacionesDevolucion</p>
                        </div>
                    }
                </div>

                <div class="acta-firmas">
                    <div class="firma-block">
                        <div class="firma-line"></div>
                        <div class="firma-name">@p.FuncionarioSolicitaNombre</div>
                        <div class="firma-role">CC @(p.FuncionarioSolicitaCedula ?? "—")</div>
                        <div class="firma-label">Recibí conforme (Solicitante)</div>
                    </div>

                    <div class="firma-block">
                        <div class="firma-line"></div>
                        <div class="firma-name">@(string.IsNullOrEmpty(p.FuncionarioApruebaNombre) ? "_________________________" : p.FuncionarioApruebaNombre)</div>
                        <div class="firma-role">@(string.IsNullOrEmpty(p.FuncionarioApruebaNombre) ? "" : "Funcionario")</div>
                        <div class="firma-label">Autorizó (Aprobador)</div>
                    </div>

                    <div class="firma-block">
                        <div class="firma-line"></div>
                        <div class="firma-name">_________________________</div>
                        <div class="firma-role">Almacén / Inventario</div>
                        <div class="firma-label">Entregué conforme</div>
                    </div>
                </div>

                <div class="acta-pie">
                    Documento generado por el Sistema de Inventario Educativo · @DateTime.Now.ToString("dd/MM/yyyy HH:mm") · @Sesion.UsuarioActual?.NombreCompleto
                </div>

            </div>

            <div class="modal-det-footer no-print">
                <button class="btn-det-print" @onclick="ImprimirDetalle">
                    <i class="bi bi-printer-fill"></i> Imprimir / PDF
                </button>
                <button class="btn-det-cerrar" @onclick="CerrarDetalle">
                    <i class="bi bi-x-lg"></i> Cerrar
                </button>
            </div>

        </div>
    </div>
}

@code {
    private static readonly CultureInfo CulturaCOP = CultureInfo.GetCultureInfo("es-CO");

    private ResultadoPaginado<PrestamoDTO>? _pagina;
    private List<Bien> bienes = new();
    private List<FuncionarioDTO> funcionarios = new();
    private PrestamoDTO dto = new();
    private (int Activos, int Vencidos, int Devueltos, int Total) _metricas;

    private bool _mostrarFormulario = false;
    private bool _mostrarFiltros = false;
    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private string? _filtroEstado;
    private DateTime? _filtroFechaDesde;
    private DateTime? _filtroFechaHasta;
    private string? _pillActivo;
    private CancellationTokenSource? _debounceCts;

    private bool _detalleAbierto = false;
    private PrestamoDTO? _prestamoDetalle;

    // ── Modal de anulación de registro (soft-delete) ──
    private bool _modalAnularRegistroAbierto = false;
    private PrestamoDTO? _prestamoAAnular;
    private string _motivoAnulacionRegistro = string.Empty;
    private bool _procesandoAnulacionRegistro = false;

    private string _institucionNit = "—";
    private string _institucionDane = string.Empty;

    private bool puedeCrear;
    private bool puedeAprobar;
    private bool puedeEntregar;
    private bool puedeDevolver;
    private bool puedeEliminar;

    private bool _hayFiltrosActivos =>
        !string.IsNullOrEmpty(_filtroTexto) ||
        !string.IsNullOrEmpty(_filtroEstado) ||
        !string.IsNullOrEmpty(_pillActivo) ||
        _filtroFechaDesde.HasValue || _filtroFechaHasta.HasValue;

    private bool _hayFiltrosAvanzados =>
        !string.IsNullOrEmpty(_filtroEstado) ||
        _filtroFechaDesde.HasValue || _filtroFechaHasta.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("prestamos.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear    = await Seguridad.TienePermisoAsync("prestamos.crear");
        puedeAprobar  = await Seguridad.TienePermisoAsync("prestamos.aprobar");
        puedeEntregar = await Seguridad.TienePermisoAsync("prestamos.entregar");
        puedeDevolver = await Seguridad.TienePermisoAsync("prestamos.devolver");
        puedeEliminar = await Seguridad.TienePermisoAsync("prestamos.eliminar");

        try
        {
            var inst = await InstRepo.ObtenerPorIdAsync(Sesion.InstitucionId);
            if (inst is not null)
            {
                _institucionNit = string.IsNullOrWhiteSpace(inst.Nit) ? "—" : inst.Nit;
                _institucionDane = inst.CodigoDane ?? string.Empty;
            }
        }
        catch { }

        await PrestamoRepo.ActualizarVencidosAsync();

        var t1 = BienRepo.ObtenerTodosAsync();
        var t2 = FuncRepo.ObtenerTodosAsync();
        await Task.WhenAll(t1, t2);

        bienes = (await t1).ToList();
        funcionarios = (await t2).ToList();

        await Cargar();
    }

    private async Task Cargar()
    {
        var estadoFinal = !string.IsNullOrEmpty(_filtroEstado) ? _filtroEstado : null;

        if (!string.IsNullOrEmpty(_pillActivo))
        {
            estadoFinal = _pillActivo switch
            {
                "vencidos"  => "VENCIDO",
                "devueltos" => "DEVUELTO",
                _ => estadoFinal
            };
        }

        if (_pillActivo == "activos")
        {
            _pagina = await PrestamoRepo.ObtenerPaginadoAsync(
                _paginaActual, _tamanoPagina,
                string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
                null,
                _filtroFechaDesde,
                _filtroFechaHasta);

            var activos = _pagina.Items
                .Where(x => x.Estado == "SOLICITADO" || x.Estado == "APROBADO"
                         || x.Estado == "PRESTADO" || x.Estado == "VENCIDO")
                .ToList();

            _pagina = new ResultadoPaginado<PrestamoDTO>
            {
                Items = activos,
                TotalRegistros = activos.Count,
                PaginaActual = _paginaActual,
                TamanoPagina = _tamanoPagina
            };
        }
        else if (_pillActivo == "historico")
        {
            _pagina = await PrestamoRepo.ObtenerPaginadoAsync(
                _paginaActual, _tamanoPagina,
                string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
                null,
                _filtroFechaDesde,
                _filtroFechaHasta);

            var historicos = _pagina.Items
                .Where(x => x.Estado == "DEVUELTO" || x.Estado == "RECHAZADO" || x.Estado == "ANULADO")
                .ToList();

            _pagina = new ResultadoPaginado<PrestamoDTO>
            {
                Items = historicos,
                TotalRegistros = historicos.Count,
                PaginaActual = _paginaActual,
                TamanoPagina = _tamanoPagina
            };
        }
        else
        {
            _pagina = await PrestamoRepo.ObtenerPaginadoAsync(
                _paginaActual, _tamanoPagina,
                string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
                estadoFinal,
                _filtroFechaDesde,
                _filtroFechaHasta);
        }

        _metricas = await PrestamoRepo.ObtenerMetricasAsync();
    }

    private Task FiltrarTodos()     => FiltrarPorPill(null);
    private Task FiltrarActivos()   => FiltrarPorPill("activos");
    private Task FiltrarVencidos()  => FiltrarPorPill("vencidos");
    private Task FiltrarDevueltos() => FiltrarPorPill("devueltos");
    private Task FiltrarHistorico() => FiltrarPorPill("historico");

    private async Task FiltrarPorPill(string? pill)
    {
        _pillActivo = pill;
        _filtroEstado = null;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private void VerDetalle(PrestamoDTO prestamo)
    {
        _prestamoDetalle = prestamo;
        _detalleAbierto = true;
        StateHasChanged();
    }

    private void CerrarDetalle()
    {
        _detalleAbierto = false;
        _prestamoDetalle = null;
    }

    private async Task ImprimirDetalle()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "el acta", "imprimir");
        }
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;
            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task LimpiarTodosLosFiltros()
    {
        _filtroTexto = string.Empty;
        _filtroEstado = null;
        _pillActivo = null;
        _filtroFechaDesde = null;
        _filtroFechaHasta = null;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task AplicarFiltrosAvanzados()
    {
        _pillActivo = null;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private void ToggleFiltros()
    {
        if (_mostrarFormulario)
        {
            _mostrarFormulario = false;
        }
        _mostrarFiltros = !_mostrarFiltros;
    }

    private void AbrirFormulario()
    {
        dto = new PrestamoDTO
        {
            FechaDevolucionPrevista = DateTime.Today.AddDays(7)
        };
        _mostrarFormulario = true;
        _mostrarFiltros = false;
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
        dto = new PrestamoDTO();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!puedeCrear) { Toast.Error("No tiene permiso."); return; }
        if (dto.BienId <= 0) { Toast.Error("Debe seleccionar un bien."); return; }
        if (dto.FuncionarioSolicitaId <= 0) { Toast.Error("Debe seleccionar el solicitante."); return; }
        if (dto.FechaDevolucionPrevista.Date < DateTime.Today) { Toast.Error("La fecha prevista no puede ser anterior a hoy."); return; }

        try
        {
            await PrestamoRepo.CrearAsync(dto);

            await Auditoria.RegistrarCreacionAsync(
                modulo: "prestamos",
                objetoTipo: "Préstamo",
                objetoId: dto.Id,
                objetoCodigo: null,
                objetoDescripcion: $"Préstamo de bien ID {dto.BienId}",
                despues: new
                {
                    dto.BienId,
                    dto.FuncionarioSolicitaId,
                    dto.FechaDevolucionPrevista,
                    dto.Motivo
                }
            );

            Toast.Exito("Solicitud creada. Pendiente de aprobación.");
            Cancelar();
            await Cargar();
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "el préstamo", "guardar");
        }
    }

    private async Task Aprobar(PrestamoDTO p)
    {
        var ok = await Confirm.Preguntar(new ConfirmOpciones
        {
            Titulo = "Aprobar préstamo",
            Mensaje = $"¿Aprobar el préstamo del bien '{p.BienNombre}' a {p.FuncionarioSolicitaNombre}?",
            Icono = "bi-check-circle-fill",
            ColorBoton = "#16a34a",
            TextoConfirmar = "Sí, aprobar"
        });
