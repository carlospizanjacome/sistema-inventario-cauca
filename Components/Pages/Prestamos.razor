            }

            await PrestamoRepo.AprobarAsync(p.Id, funcionarioAprueba.Id);

            await Auditoria.RegistrarAprobacionAsync(
                modulo: "prestamos",
                objetoTipo: "Préstamo",
                objetoId: p.Id,
                objetoCodigo: null,
                objetoDescripcion: $"Préstamo de {p.BienNombre}",
                motivo: "Préstamo aprobado"
            );

