    // ═══════════════════════════════════════════════════════
    // SOFT-DELETE (anular registro del histórico)
    // ═══════════════════════════════════════════════════════

    private void IntentarAnularRegistro(PrestamoDTO p)
    {
        if (!puedeEliminar)
        {
            Toast.Warning("No tiene permiso para anular registros.");
            return;
        }

        if (!p.EsTerminal)
        {
            Toast.Warning($"Solo se anulan préstamos en estados terminales. Estado actual: {p.Estado}.");
            return;
        }

        if (p.Anulada)
        {
            Toast.Warning("Este préstamo ya está anulado.");
            return;
        }

        _prestamoAAnular = p;
        _motivoAnulacionRegistro = string.Empty;
        _modalAnularRegistroAbierto = true;
    }

    private void CerrarModalAnularRegistro()
    {
        _modalAnularRegistroAbierto = false;
        _prestamoAAnular = null;
        _motivoAnulacionRegistro = string.Empty;
        _procesandoAnulacionRegistro = false;
    }

    private async Task ConfirmarAnulacionRegistro()
    {
        if (_prestamoAAnular is null) return;

        if (string.IsNullOrWhiteSpace(_motivoAnulacionRegistro))
        {
            Toast.Warning("El motivo es obligatorio.");
            return;
        }

        if (_motivoAnulacionRegistro.Trim().Length < 10)
        {
            Toast.Warning("El motivo debe tener al menos 10 caracteres.");
            return;
        }

        _procesandoAnulacionRegistro = true;
        StateHasChanged();

        try
        {
            var p = _prestamoAAnular;
            await PrestamoRepo.AnularRegistroAsync(p.Id, _motivoAnulacionRegistro.Trim());

            try
            {
                await Auditoria.RegistrarAnulacionAsync(
                    modulo: "prestamos",
                    objetoTipo: "Préstamo",
                    objetoId: p.Id,
                    objetoCodigo: null,
                    objetoDescripcion: $"Préstamo de {p.BienNombre}",
                    motivo: _motivoAnulacionRegistro.Trim());
            }
            catch { }

            Toast.Exito($"Préstamo #{p.Id} anulado correctamente.");
            CerrarModalAnularRegistro();
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error al anular: {ex.Message}");
        }
        finally
        {
            _procesandoAnulacionRegistro = false;
            StateHasChanged();
        }
    }

    private static string GetClaseBadgeEstado(string estado) => estado switch
    {
        "SOLICITADO" => "badge-info",
        "APROBADO"   => "badge-neutral",
        "PRESTADO"   => "badge-ok",
        "VENCIDO"    => "badge-danger",
        "DEVUELTO"   => "badge-ok",
        "RECHAZADO"  => "badge-off",
        "ANULADO"    => "badge-off",
        _            => "badge-neutral"
    };
}