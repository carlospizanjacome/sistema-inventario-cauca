@page "/aulas"
@rendermode InteractiveServer

@using Almacen.Components.Shared
@using Almacen.DTOs
@using Almacen.Helpers
@using Almacen.Interfaces
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IAulaRepository AulaRepo
@inject IBloqueRepository BloqueRepo
@inject ToastService Toast
@inject ConfirmService Confirm
@inject IJSRuntime JS

<PageTitle>Aulas · Almacén</PageTitle>

<div class="page-container page-crud @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-door-open"></i> Aulas y Espacios</h1>
                <p class="subtitle">Aulas, laboratorios, oficinas y demás espacios físicos</p>
            </div>

            <div class="header-actions">
                <button class="btn-nuevo" @onclick="AbrirFormulario">
                    <i class="bi bi-plus-lg"></i> Nueva Aula
                </button>
            </div>
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(_editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(_editando ? "Editar Aula" : "Nueva Aula")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-door-open"></i>
                    <div>
                        <div class="form-header-title">Aulas y Espacios</div>
                        <div class="form-header-subtitle">Aulas, laboratorios, oficinas y demás espacios físicos</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="CerrarFormulario" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="_model" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="form-group">
                        <label>Bloque *</label>
                        <div class="input-icon">
                            <i class="bi bi-box"></i>
                            <InputSelect @bind-Value="_model.BloqueId" class="form-control">
                                <option value="0">— Seleccione —</option>
                                @foreach (var b in _bloques)
                                {
                                    <option value="@b.Id">
                                        @b.InstitucionNombre / @b.SedeNombre / @b.Nombre
                                    </option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="() => _model.BloqueId" />
                    </div>

                    <div class="form-group">
                        <label>Nombre *</label>
                        <div class="input-icon">
                            <i class="bi bi-door-open"></i>
                            <InputText @bind-Value="_model.Nombre" class="form-control"
                                       placeholder="Ej: Aula 101" />
                        </div>
                        <ValidationMessage For="() => _model.Nombre" />
                    </div>

                    <div class="form-group">
                        <label>Tipo</label>
                        <div class="input-icon">
                            <i class="bi bi-tag"></i>
                            <InputSelect @bind-Value="_model.Tipo" class="form-control">
                                <option value="Aula">Aula</option>
                                <option value="Laboratorio">Laboratorio</option>
                                <option value="Oficina">Oficina</option>
                                <option value="Bodega">Bodega</option>
                                <option value="Biblioteca">Biblioteca</option>
                                <option value="Baño">Baño</option>
                                <option value="Otro">Otro</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Capacidad</label>
                        <div class="input-icon">
                            <i class="bi bi-people"></i>
                            <InputNumber @bind-Value="_model.Capacidad" class="form-control" />
                        </div>
                        <ValidationMessage For="() => _model.Capacidad" />
                    </div>

                    <div class="form-group checkbox-group">
                        <label>
                            <InputCheckbox @bind-Value="_model.Activo" />
                            Activa
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="CerrarFormulario">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(_editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(_editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">

        @* ═══ Barra de filtros ═══ *@
        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar aula por nombre…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-tabla-derecha">

                @* ═══ Dropdown Bloque ═══ *@
                <details class="dropdown-filtro" id="dropdown-bloque-aulas">
                    <summary class="dropdown-filtro-trigger">
                        <i class="bi bi-box"></i>
                        <span>@(string.IsNullOrEmpty(_bloqueSeleccionadoNombre) ? "Todos los bloques" : _bloqueSeleccionadoNombre)</span>
                        <i class="bi bi-chevron-down dropdown-filtro-chevron"></i>
                    </summary>

                    <div class="dropdown-filtro-panel">
                        <div class="dropdown-filtro-item @(_bloqueSeleccionadoId is null ? "active" : "")"
                             @onclick="() => SeleccionarBloque(null)">
                            <i class="bi bi-grid-3x3"></i>
                            <span>Todos los bloques</span>
                            @if (_bloqueSeleccionadoId is null)
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-divider"></div>

                        @foreach (var b in _bloques)
                        {
                            <div class="dropdown-filtro-item @(_bloqueSeleccionadoId == b.Id ? "active" : "")"
                                 @onclick="() => SeleccionarBloque(b)">
                                <i class="bi bi-box"></i>
                                <span>@b.SedeNombre / @b.Nombre</span>
                                @if (_bloqueSeleccionadoId == b.Id)
                                {
                                    <i class="bi bi-check2 dropdown-filtro-check"></i>
                                }
                            </div>
                        }
                    </div>
                </details>

                @* ═══ Dropdown Tipo ═══ *@
                <details class="dropdown-filtro" id="dropdown-tipo-aulas">
                    <summary class="dropdown-filtro-trigger">
                        <i class="bi bi-tag"></i>
                        <span>@(string.IsNullOrEmpty(_tipoSeleccionado) ? "Todos los tipos" : _tipoSeleccionado)</span>
                        <i class="bi bi-chevron-down dropdown-filtro-chevron"></i>
                    </summary>

                    <div class="dropdown-filtro-panel">
                        <div class="dropdown-filtro-item @(string.IsNullOrEmpty(_tipoSeleccionado) ? "active" : "")"
                             @onclick="() => SeleccionarTipo(null)">
                            <i class="bi bi-grid-3x3"></i>
                            <span>Todos los tipos</span>
                            @if (string.IsNullOrEmpty(_tipoSeleccionado))
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-divider"></div>

                        @foreach (var t in _tiposDisponibles)
                        {
                            <div class="dropdown-filtro-item @(_tipoSeleccionado == t ? "active" : "")"
                                 @onclick="() => SeleccionarTipo(t)">
                                <i class="bi bi-tag"></i>
                                <span>@t</span>
                                @if (_tipoSeleccionado == t)
                                {
                                    <i class="bi bi-check2 dropdown-filtro-check"></i>
                                }
                            </div>
                        }
                    </div>
                </details>

                <span class="badge-total">
                    <i class="bi bi-door-open"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> aulas
                    @if (!string.IsNullOrEmpty(_filtroTexto) || _bloqueSeleccionadoId.HasValue || !string.IsNullOrEmpty(_tipoSeleccionado))
                    {
                        <span class="filtro-activo-tag">· Filtrado</span>
                    }
                </span>
            </div>
        </div>

        @* ═══ Tabla ═══ *@
        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Bloque</th>
                        <th>Aula</th>
                        <th>Tipo</th>
                        <th>Capacidad</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="6" class="text-center py-3 text-muted">Cargando aulas…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-3 text-muted">
                                @(SinFiltros() ? "Sin aulas registradas." : "Sin resultados para los filtros aplicados.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in _pagina.Items)
                        {
                            <tr class="table-row-hover">
                                <td>@a.InstitucionNombre / @a.SedeNombre / @a.BloqueNombre</td>
                                <td><strong>@a.Nombre</strong></td>
                                <td>@a.Tipo</td>
                                <td>@a.Capacidad</td>
                                <td>
                                    <span class="badge @(a.Activo ? "badge-ok" : "badge-off")">
                                        @(a.Activo ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn-icon me-1" @onclick="() => Editar(a)" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <button class="btn-icon danger" @onclick="() => Eliminar(a)" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="AulaDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private ResultadoPaginado<AulaDTO>? _pagina;
    private List<BloqueDTO> _bloques = new();
    private AulaDTO _model = new();
    private bool _editando = false;
    private bool _mostrarFormulario = false;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private CancellationTokenSource? _debounceCts;

    private int? _bloqueSeleccionadoId;
    private string _bloqueSeleccionadoNombre = string.Empty;

    private string? _tipoSeleccionado;

    private static readonly string[] _tiposDisponibles =
    {
        "Aula", "Laboratorio", "Oficina", "Bodega", "Biblioteca", "Baño", "Otro"
    };

    protected override async Task OnInitializedAsync()
    {
        _bloques = (await BloqueRepo.ObtenerTodosAsync()).ToList();
        await Cargar();
    }

    private async Task Cargar()
    {
        _pagina = await AulaRepo.ObtenerPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            _bloqueSeleccionadoId,
            string.IsNullOrWhiteSpace(_tipoSeleccionado) ? null : _tipoSeleccionado);
    }

    private bool SinFiltros()
        => string.IsNullOrEmpty(_filtroTexto)
           && _bloqueSeleccionadoId is null
           && string.IsNullOrEmpty(_tipoSeleccionado);

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task SeleccionarBloque(BloqueDTO? bloque)
    {
        _bloqueSeleccionadoId = bloque?.Id;
        _bloqueSeleccionadoNombre = bloque is null
            ? string.Empty
            : $"{bloque.SedeNombre} / {bloque.Nombre}";
        _paginaActual = 1;

        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('dropdown-bloque-aulas')?.removeAttribute('open')");
        }
        catch { /* silencioso */ }

        await Cargar();
        StateHasChanged();
    }

    private async Task SeleccionarTipo(string? tipo)
    {
        _tipoSeleccionado = tipo;
        _paginaActual = 1;

        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('dropdown-tipo-aulas')?.removeAttribute('open')");
        }
        catch { /* silencioso */ }

        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private void AbrirFormulario()
    {
        _model = new AulaDTO { Activo = true, Tipo = "Aula" };
        _editando = false;
        _mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario = false;
        _model = new AulaDTO();
        _editando = false;
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (_model.BloqueId <= 0)
        {
            Toast.Error("Debe seleccionar un bloque.");
            return;
        }

        try
        {
            if (_editando)
            {
                await AulaRepo.ActualizarAsync(_model);
                Toast.Exito($"Aula '{_model.Nombre}' actualizada. Puede seguir editando.");
            }
            else
            {
                await AulaRepo.CrearAsync(_model);
                Toast.Exito($"Aula '{_model.Nombre}' creada. Puede continuar registrando.");

                var bloqueActual = _model.BloqueId;
                var tipoActual = _model.Tipo;
                var capacidadActual = _model.Capacidad;

                _model = new AulaDTO
                {
                    Activo = true,
                    BloqueId = bloqueActual,
                    Tipo = tipoActual,
                    Capacidad = capacidadActual
                };

                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { /* silencioso */ }
            }

            await Cargar();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(AulaDTO a)
    {
        _model = new AulaDTO
        {
            Id = a.Id,
            BloqueId = a.BloqueId,
            Nombre = a.Nombre,
            Tipo = a.Tipo,
            Capacidad = a.Capacidad,
            Activo = a.Activo
        };
        _editando = true;
        _mostrarFormulario = true;
        StateHasChanged();
    }

    private async Task Eliminar(AulaDTO a)
    {
        var ok = await Confirm.Peligroso(
            $"¿Eliminar el aula '{a.Nombre}'? Esta acción no se puede deshacer.");
        if (!ok) return;

        if (await AulaRepo.TieneBienesAsync(a.Id))
        {
            Toast.Error("No se puede eliminar: el aula tiene bienes asignados.");
            return;
        }

        try
        {
            await AulaRepo.EliminarAsync(a.Id);
            Toast.Exito("Aula eliminada correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }
}