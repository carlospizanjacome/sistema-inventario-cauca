@page "/"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Helpers
@using Almacen.Interfaces
@using Almacen.Services
@using System.Globalization

@inject IDashboardRepository DashboardRepo
@inject UsuarioSesionService Sesion
@inject IJSRuntime JS

<PageTitle>Dashboard · Almacén</PageTitle>

<div class="dash-container">

    <!-- ═══ HEADER CARD ═══ -->
    <div class="dash-header-card">
        <div class="dash-header-info">
            <h2>Dashboard Institucional</h2>
            <p>
                <i class="bi bi-calendar3"></i>
                @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", CulturaCOP)
                <span class="dot">•</span>
                @DateTime.Now.ToString("hh:mm tt")
            </p>
        </div>
        <button class="btn-dash-primary" @onclick="Recargar" disabled="@_cargando">
            <i class="bi @(_cargando ? "bi-hourglass-split" : "bi-arrow-clockwise")"></i>
            <span>@(_cargando ? "Actualizando…" : "Actualizar Datos")</span>
        </button>
    </div>

    @if (_cargando)
    {
        <div class="dash-loading">
            <div class="dash-spinner"></div>
            <p>Cargando indicadores…</p>
        </div>
    }
    else if (_kpis is not null)
    {
        <!-- ═══ 4 KPIs (icono a la derecha) ═══ -->
        <div class="kpi-dash-grid">

            <div class="kpi-dash-card">
                <div class="kpi-dash-info">
                    <span class="kpi-dash-title">Bienes Registrados</span>
                    <h3 class="kpi-dash-value">@Moneda.Numero(_kpis.TotalBienes)</h3>
                    <p class="kpi-dash-sub">
                        @_kpis.TotalDevolutivos devolutivo@(_kpis.TotalDevolutivos != 1 ? "s" : "")
                        <span class="dot">•</span>
                        @_kpis.TotalConsumibles consumible@(_kpis.TotalConsumibles != 1 ? "s" : "")
                    </p>
                </div>
                <div class="kpi-dash-icon kpi-icon-indigo">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>

            <div class="kpi-dash-card">
                <div class="kpi-dash-info">
                    <span class="kpi-dash-title">Valor Inventario</span>
                    <h3 class="kpi-dash-value">@Moneda.Kpi(_kpis.ValorInventario)</h3>
                    <p class="kpi-dash-sub">
                        PPE: @Moneda.Kpi(_kpis.ValorPPE)
                        <span class="dot">•</span>
                        Stock: @Moneda.Kpi(_kpis.ValorStockConsumo)
                    </p>
                </div>
                <div class="kpi-dash-icon kpi-icon-emerald">
                    <i class="bi bi-cash-coin"></i>
                </div>
            </div>

            <div class="kpi-dash-card">
                <div class="kpi-dash-info">
                    <span class="kpi-dash-title">Depreciación Acum.</span>
                    <h3 class="kpi-dash-value">@Moneda.Kpi(_kpis.DepreciacionAcumulada)</h3>
                    <p class="kpi-dash-sub">
                        Valor Neto: @Moneda.Kpi(_kpis.ValorNeto)
                    </p>
                </div>
                <div class="kpi-dash-icon kpi-icon-amber">
                    <i class="bi bi-graph-down-arrow"></i>
                </div>
            </div>

            <div class="kpi-dash-card">
                <div class="kpi-dash-info">
                    <span class="kpi-dash-title">Usuarios Activos</span>
                    <h3 class="kpi-dash-value">@Moneda.Numero(_kpis.UsuariosActivos)</h3>
                    <p class="kpi-dash-sub">@Sesion.InstitucionNombre</p>
                </div>
                <div class="kpi-dash-icon kpi-icon-sky">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>

        </div>

        <!-- ═══ ALERTAS ═══ -->
        @if (HayAlertas())
        {
            <div class="alerts-dash-card">
                <div class="alerts-dash-header">
                    <i class="bi bi-bell-fill"></i>
                    <h4>Alertas y Notificaciones</h4>
                </div>
                <div class="alerts-dash-grid">

                    @if (_kpis.GarantiasPorVencer > 0)
                    {
                        <a href="/garantias" class="alert-dash-item alert-dash-warn">
                            <i class="bi bi-shield-exclamation"></i>
                            <div>
                                <strong>@_kpis.GarantiasPorVencer</strong>
                                <span>Garantía@(_kpis.GarantiasPorVencer != 1 ? "s" : "") por vencer</span>
                            </div>
                            <i class="bi bi-chevron-right alert-arrow"></i>
                        </a>
                    }

                    @if (_kpis.PrestamosVencidos > 0)
                    {
                        <a href="/prestamos" class="alert-dash-item alert-dash-danger">
                            <i class="bi bi-clock-history"></i>
                            <div>
                                <strong>@_kpis.PrestamosVencidos</strong>
                                <span>Préstamo@(_kpis.PrestamosVencidos != 1 ? "s" : "") vencido@(_kpis.PrestamosVencidos != 1 ? "s" : "")</span>
                            </div>
                            <i class="bi bi-chevron-right alert-arrow"></i>
                        </a>
                    }

                    @if (_kpis.BienesBajoStock > 0)
                    {
                        <a href="/consumo" class="alert-dash-item alert-dash-warn">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                <strong>@_kpis.BienesBajoStock</strong>
                                <span>Bajo stock mínimo</span>
                            </div>
                            <i class="bi bi-chevron-right alert-arrow"></i>
                        </a>
                    }

                    @if (_kpis.BienesSinUbicacion > 0)
                    {
                        <a href="/bienes" class="alert-dash-item alert-dash-info">
                            <i class="bi bi-geo-alt-fill"></i>
                            <div>
                                <strong>@_kpis.BienesSinUbicacion</strong>
                                <span>Bien@(_kpis.BienesSinUbicacion != 1 ? "es" : "") sin ubicación</span>
                            </div>
                            <i class="bi bi-chevron-right alert-arrow"></i>
                        </a>
                    }

                    @if (_kpis.BienesSinResponsable > 0)
                    {
                        <a href="/bienes" class="alert-dash-item alert-dash-info">
                            <i class="bi bi-person-x-fill"></i>
                            <div>
                                <strong>@_kpis.BienesSinResponsable</strong>
                                <span>Bien@(_kpis.BienesSinResponsable != 1 ? "es" : "") sin responsable</span>
                            </div>
                            <i class="bi bi-chevron-right alert-arrow"></i>
                        </a>
                    }

                </div>
            </div>
        }

        <!-- ═══ FILA 1: BAR CHART + DONUT ═══ -->
        <div class="dash-charts-row">

            <div class="dash-chart-card dash-chart-wide">
                <div class="dash-chart-head">
                    <div>
                        <h3>Bienes por categoría</h3>
                        <p>Distribución del inventario según clasificación contable</p>
                    </div>
                    <div class="dash-chart-icon">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                </div>
                <div class="dash-chart-body">
                    @if (_porCategoria.Count == 0)
                    {
                        <p class="empty">Sin datos.</p>
                    }
                    else
                    {
                        <canvas id="barChart"></canvas>
                    }
                </div>
            </div>

            <div class="dash-chart-card">
                <div class="dash-chart-head">
                    <div>
                        <h3>Distribución por tipo</h3>
                        <p>Devolutivos vs Consumibles</p>
                    </div>
                    <div class="dash-chart-icon">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                </div>
                <div class="dash-chart-body dash-chart-body-donut">
                    @if (_kpis.TotalDevolutivos > 0 || _kpis.TotalConsumibles > 0)
                    {
                        <canvas id="doughnutChart"></canvas>
                    }
                    else
                    {
                        <p class="empty">Sin datos.</p>
                    }
                </div>
            </div>

        </div>

        <!-- ═══ FILA 2: LINE CHART + TOP 5 ═══ -->
        <div class="dash-charts-row">

            <div class="dash-chart-card dash-chart-wide">
                <div class="dash-chart-head">
                    <div>
                        <h3>Depreciación mensual</h3>
                        <p>Evolución del último año</p>
                    </div>
                    <div class="dash-chart-icon">
                        <i class="bi bi-graph-down-arrow"></i>
                    </div>
                </div>
                <div class="dash-chart-body">
                    @if (_depreciacion.Count == 0)
                    {
                        <p class="empty">Sin datos de depreciación.</p>
                    }
                    else
                    {
                        <canvas id="lineChart"></canvas>
                    }
                </div>
            </div>

            <div class="dash-chart-card">
                <div class="dash-chart-head">
                    <div>
                        <h3>Top 5 bienes</h3>
                        <p>Por valor de adquisición</p>
                    </div>
                    <div class="dash-chart-icon">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                </div>
                <div class="dash-chart-body dash-chart-body-list">
                    @if (_topBienes.Count == 0)
                    {
                        <p class="empty">Sin datos.</p>
                    }
                    else
                    {
                        <ul class="top-dash-list">
                            @foreach (var (b, i) in _topBienes.Select((x, idx) => (x, idx)))
                            {
                                <li class="top-dash-item">
                                    <span class="top-dash-rank top-dash-rank-@(i + 1)">@(i + 1)</span>
                                    <div class="top-dash-info">
                                        <strong>@b.Nombre</strong>
                                        <small>@b.CategoriaNombre</small>
                                    </div>
                                    <span class="top-dash-valor">@Moneda.Kpi(b.ValorAdquisicion)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

        </div>

        <!-- ═══ TABLA ÚLTIMOS BIENES ═══ -->
        <div class="dash-chart-card">
            <div class="dash-chart-head">
                <div>
                    <h3>Últimos bienes registrados</h3>
                    <p>Los 5 más recientes del inventario</p>
                </div>
                <div class="dash-chart-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="dash-chart-body dash-chart-body-table">
                @if (_ultimos.Count == 0)
                {
                    <p class="empty">Aún no hay bienes registrados.</p>
                }
                else
                {
                    <table class="tabla-dash">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Bien</th>
                                <th>Categoría</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in _ultimos)
                            {
                                <tr>
                                    <td><code>@b.Codigo</code></td>
                                    <td>@b.Nombre</td>
                                    <td>@b.CategoriaNombre</td>
                                    <td class="text-center">
                                        <span class="badge-dash badge-dash-ok">Activo</span>
                                    </td>
                                    <td class="text-end"><strong>@Moneda.Entero(b.Valor)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
    else
    {
        <div class="dash-error">
            <i class="bi bi-exclamation-triangle"></i>
            <p>No se pudieron cargar los indicadores. Revisá la conexión a la base de datos.</p>
        </div>
    }

</div>

@code {
    private static readonly CultureInfo CulturaCOP = CultureInfo.GetCultureInfo("es-CO");

    private bool _cargando = true;
    private bool _redirigiendo = false;

    private DashboardKpisDto? _kpis;
    private List<BienesPorCategoriaDto> _porCategoria = new();
    private List<UltimoBienDto> _ultimos = new();
    private List<DepreciacionMensualDto> _depreciacion = new();
    private List<TopBienDto> _topBienes = new();

    private bool _chartsInit = false;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            _redirigiendo = true;
            _cargando = false;
            return;
        }
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        StateHasChanged();

        try
        {
            var t1 = DashboardRepo.ObtenerKpisAsync();
            var t2 = DashboardRepo.ObtenerBienesPorCategoriaAsync(10);
            var t3 = DashboardRepo.ObtenerUltimosBienesAsync(5);
            var t4 = DashboardRepo.ObtenerDepreciacionMensualAsync(12);
            var t5 = DashboardRepo.ObtenerTopBienesAsync(5);

            await Task.WhenAll(t1, t2, t3, t4, t5);

            _kpis = await t1;
            _porCategoria = (await t2).ToList();
            _ultimos = (await t3).ToList();
            _depreciacion = (await t4).ToList();
            _topBienes = (await t5).ToList();

            _chartsInit = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard] Error: {ex.Message}");
            _kpis = null;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task Recargar() => await Cargar();

    private bool HayAlertas() =>
        _kpis is not null && (
            _kpis.BienesSinResponsable > 0 ||
            _kpis.BienesSinUbicacion > 0 ||
            _kpis.BienesBajoStock > 0 ||
            _kpis.PrestamosVencidos > 0 ||
            _kpis.GarantiasPorVencer > 0
        );

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _redirigiendo)
        {
            await JS.InvokeVoidAsync("eval", "window.location.replace('/login')");
            return;
        }

        if (!_cargando && _kpis is not null && !_chartsInit)
        {
            _chartsInit = true;
            await Task.Delay(150);

            // Bar chart
            if (_porCategoria.Any())
            {
                var labels = _porCategoria.Select(c => c.CategoriaNombre).ToArray();
                var data = _porCategoria.Select(c => c.Cantidad).ToArray();
                await JS.InvokeVoidAsync("dashboardCharts.crearBarCategorias",
                    "barChart", labels, data);
            }

            // Donut chart
            if (_kpis.TotalDevolutivos > 0 || _kpis.TotalConsumibles > 0)
            {
                await JS.InvokeVoidAsync("dashboardCharts.crearDonutTipo",
                    "doughnutChart", _kpis.TotalDevolutivos, _kpis.TotalConsumibles);
            }

            // Line chart
            if (_depreciacion.Any())
            {
                var labels = _depreciacion.Select(d => d.Etiqueta).ToArray();
                var depMes = _depreciacion.Select(d => d.DepreciacionMes).ToArray();
                var depAcum = _depreciacion.Select(d => d.DepreciacionAcumulada).ToArray();
                await JS.InvokeVoidAsync("dashboardCharts.crearLineDepreciacion",
                    "lineChart", labels, depMes, depAcum);
            }
        }
    }
}