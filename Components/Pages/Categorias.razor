@page "/categorias"
@rendermode InteractiveServer

@using Almacen.Components.Shared
@using Almacen.DTOs
@using Almacen.Helpers
@using Almacen.Interfaces
@using Almacen.Models
@using Almacen.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject ICategoriaRepository CategoriaRepository
@inject IVidaUtilRepository VidaUtilRepo
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject IJSRuntime JS

<PageTitle>Categorías · Almacén</PageTitle>

<div class="page-container page-crud @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-tags"></i> Categorías</h1>
                <p class="subtitle">Administración de categorías de inventario</p>
            </div>

            <div class="header-actions">
                @if (puedeCrear)
                {
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nueva Categoría
                    </button>
                }
            </div>
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(_editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(_editando ? "Editar Categoría" : "Nueva Categoría")</span>
                </div>

                <div class="form-header-center">
                    <i class="bi bi-tags"></i>
                    <div>
                        <div class="form-header-title">Categorías</div>
                        <div class="form-header-subtitle">Administración de categorías de inventario</div>
                    </div>
                </div>

                <button class="btn-cerrar-form" @onclick="CerrarFormulario" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm @key="categoriaEditandoId" Model="categoriaDTO" OnValidSubmit="GuardarCategoria">
                <DataAnnotationsValidator />

                <div class="form-grid-3">

                    <div class="form-group">
                        <label>Código CGN</label>
                        <div class="input-icon">
                            <i class="bi bi-upc-scan"></i>
                            <InputSelect class="form-control"
                                         @bind-Value="categoriaDTO.CodigoCgn"
                                         @bind-Value:after="OnCodigoCgnChanged">
                                <option value="">— Sin código CGN —</option>
                                @foreach (var grupo in CodigosCgnAgrupados)
                                {
                                    <optgroup label="@grupo.Key">
                                        @foreach (var item in grupo.Value)
                                        {
                                            <option value="@item.CodigoCgn">
                                                @item.CodigoCgn — @item.Descripcion
                                            </option>
                                        }
                                    </optgroup>
                                }
                            </InputSelect>
                        </div>
                        <small class="form-hint">Al seleccionar, se sugiere el tipo de bien automáticamente.</small>
                    </div>

                    <div class="form-group">
                        <label>Tipo de bien *</label>
                        <div class="input-icon">
                            <i class="bi bi-diagram-3"></i>
                            <InputSelect class="form-control" @bind-Value="categoriaDTO.TipoBien">
                                <option value="devolutivo">Devolutivo (PPE)</option>
                                <option value="consumo">Consumo (Inventario)</option>
                                <option value="ambos">Ambos</option>
                            </InputSelect>
                        </div>
                        <small class="form-hint">Determina en qué módulos aparecerá la categoría.</small>
                    </div>

                    <div class="form-group">
                        <label>Nombre *</label>
                        <div class="input-icon">
                            <i class="bi bi-tag"></i>
                            <InputText class="form-control" @bind-Value="categoriaDTO.Nombre"
                                       placeholder="Ej: Equipos de Cómputo" />
                        </div>
                        <ValidationMessage For="() => categoriaDTO.Nombre" />
                    </div>

                    <div class="form-group">
                        <label>Estado</label>
                        <div class="input-icon">
                            <i class="bi bi-toggle-on"></i>
                            <InputSelect class="form-control" @bind-Value="estadoString">
                                <option value="true">Activa</option>
                                <option value="false">Inactiva</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group form-group-full" style="grid-column: span 2;">
                        <label>Descripción</label>
                        <div class="input-icon">
                            <i class="bi bi-chat-left-text"></i>
                            <InputText class="form-control"
                                       placeholder="Descripción de la categoría"
                                       @bind-Value="categoriaDTO.Descripcion" />
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="CerrarFormulario">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(_editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(_editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">

        <div class="filtros-tabla">
            <div class="filtro-busqueda">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por nombre, código CGN o descripción…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="filtros-tabla-derecha">

                @* ═══ Dropdown Tipo ═══ *@
                <details class="dropdown-filtro" id="dropdown-tipo-cat">
                    <summary class="dropdown-filtro-trigger">
                        <i class="bi bi-diagram-3"></i>
                        <span>@(_filtroTipo switch { "devolutivo" => "Devolutivos", "consumo" => "Consumo", "ambos" => "Ambos", _ => "Todos los tipos" })</span>
                        <i class="bi bi-chevron-down dropdown-filtro-chevron"></i>
                    </summary>

                    <div class="dropdown-filtro-panel">
                        <div class="dropdown-filtro-item @(string.IsNullOrEmpty(_filtroTipo) ? "active" : "")"
                             @onclick="SeleccionarTipoTodos">
                            <i class="bi bi-grid-3x3"></i>
                            <span>Todos los tipos</span>
                            @if (string.IsNullOrEmpty(_filtroTipo))
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-divider"></div>

                        <div class="dropdown-filtro-item @(_filtroTipo == "devolutivo" ? "active" : "")"
                             @onclick="SeleccionarTipoDevolutivo">
                            <i class="bi bi-box-seam"></i>
                            <span>Devolutivos</span>
                            @if (_filtroTipo == "devolutivo")
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-item @(_filtroTipo == "consumo" ? "active" : "")"
                             @onclick="SeleccionarTipoConsumo">
                            <i class="bi bi-boxes"></i>
                            <span>Consumo</span>
                            @if (_filtroTipo == "consumo")
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-item @(_filtroTipo == "ambos" ? "active" : "")"
                             @onclick="SeleccionarTipoAmbos">
                            <i class="bi bi-arrow-left-right"></i>
                            <span>Ambos</span>
                            @if (_filtroTipo == "ambos")
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>
                    </div>
                </details>

                @* ═══ Dropdown Estado ═══ *@
                <details class="dropdown-filtro" id="dropdown-estado-cat">
                    <summary class="dropdown-filtro-trigger">
                        <i class="bi bi-toggle-on"></i>
                        <span>@(_filtroEstado switch { true => "Solo activas", false => "Solo inactivas", null => "Activas e inactivas" })</span>
                        <i class="bi bi-chevron-down dropdown-filtro-chevron"></i>
                    </summary>

                    <div class="dropdown-filtro-panel">
                        <div class="dropdown-filtro-item @(_filtroEstado is null ? "active" : "")"
                             @onclick="SeleccionarEstadoTodos">
                            <i class="bi bi-list-ul"></i>
                            <span>Activas e inactivas</span>
                            @if (_filtroEstado is null)
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-divider"></div>

                        <div class="dropdown-filtro-item @(_filtroEstado == true ? "active" : "")"
                             @onclick="SeleccionarEstadoActivas">
                            <i class="bi bi-check-circle"></i>
                            <span>Solo activas</span>
                            @if (_filtroEstado == true)
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>

                        <div class="dropdown-filtro-item @(_filtroEstado == false ? "active" : "")"
                             @onclick="SeleccionarEstadoInactivas">
                            <i class="bi bi-x-circle"></i>
                            <span>Solo inactivas</span>
                            @if (_filtroEstado == false)
                            {
                                <i class="bi bi-check2 dropdown-filtro-check"></i>
                            }
                        </div>
                    </div>
                </details>

                <span class="badge-total">
                    <i class="bi bi-tags"></i>
                    <strong>@(_pagina?.TotalRegistros ?? 0)</strong> categorías
                    @if (HayFiltros())
                    {
                        <span class="filtro-activo-tag">· Filtrado</span>
                    }
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>CGN</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th class="text-end">Bienes</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Cargando categorías…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3 text-muted">
                                @(SinFiltros()
                                    ? "Sin categorías registradas."
                                    : "Sin resultados para los filtros aplicados.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var categoria in _pagina.Items)
                        {
                            <tr class="table-row-hover" @key="categoria.Id">
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(categoria.CodigoCgn))
                                    {
                                        <code>@categoria.CodigoCgn</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><strong>@categoria.Nombre</strong></td>
                                <td>
                                    <span class="badge @GetClaseBadgeTipo(categoria.TipoBien)">
                                        <i class="bi @GetIconoTipo(categoria.TipoBien)"></i>
                                        @GetTexto(categoria.TipoBien)
                                    </span>
                                </td>
                                <td>@categoria.Descripcion</td>
                                <td class="text-end num">
                                    @if (categoria.TotalBienes > 0)
                                    {
                                        <strong>@categoria.TotalBienes</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(categoria.Estado ? "badge-ok" : "badge-off")">
                                        @(categoria.Estado ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (puedeEditar)
                                    {
                                        <button class="btn-icon me-1" @onclick="() => Editar(categoria)" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    @if (puedeEliminar)
                                    {
                                        <button class="btn-icon danger" @onclick="() => Eliminar(categoria.Id)" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="Categoria"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@code {
    private ResultadoPaginado<Categoria>? _pagina;
    private CategoriaDTO categoriaDTO = new();
    private bool _editando;
    private int categoriaEditandoId;
    private bool _mostrarFormulario = false;

    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private bool? _filtroEstado;
    private string? _filtroTipo;
    private CancellationTokenSource? _debounceCts;

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    private List<VidaUtilDTO> _catalogoCgn = new();

    private Dictionary<string, List<VidaUtilDTO>> CodigosCgnAgrupados =>
        _catalogoCgn
            .GroupBy(c => (c.Tipo ?? "devolutivo") == "consumo" ? "BIENES DE CONSUMO" : "PROPIEDAD, PLANTA Y EQUIPO")
            .ToDictionary(
                g => g.Key,
                g => g.OrderBy(x => x.CodigoCgn).ToList());

    private string estadoString
    {
        get => categoriaDTO.Estado.ToString().ToLower();
        set => categoriaDTO.Estado = bool.Parse(value);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!await Seguridad.TienePermisoAsync("categorias.ver"))
            {
                Navigation.NavigateTo("/");
                return;
            }

            puedeCrear = await Seguridad.TienePermisoAsync("categorias.crear");
            puedeEditar = await Seguridad.TienePermisoAsync("categorias.editar");
            puedeEliminar = await Seguridad.TienePermisoAsync("categorias.eliminar");

            try
            {
                _catalogoCgn = (await VidaUtilRepo.ObtenerTodosAsync()).ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Categorias] Error al cargar catálogo CGN: {ex.Message}");
                _catalogoCgn = new List<VidaUtilDTO>();
            }

            await Cargar();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Categorias] Error crítico: {ex.Message}");
            Toast.Error($"Error al cargar la página: {ex.Message}");
        }
    }

    private async Task Cargar()
    {
        _pagina = await CategoriaRepository.ObtenerPaginadoAsync(
            _paginaActual,
            _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            _filtroEstado,
            _filtroTipo);
    }

    private bool SinFiltros()
        => string.IsNullOrEmpty(_filtroTexto)
           && _filtroEstado is null
           && string.IsNullOrEmpty(_filtroTipo);

    private bool HayFiltros() => !SinFiltros();

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;

            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    // ═══ Dropdown Estado — métodos dedicados ═══
    private Task SeleccionarEstadoTodos() => SeleccionarEstado(null);
    private Task SeleccionarEstadoActivas() => SeleccionarEstado(true);
    private Task SeleccionarEstadoInactivas() => SeleccionarEstado(false);

    private async Task SeleccionarEstado(bool? estado)
    {
        _filtroEstado = estado;
        _paginaActual = 1;

        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('dropdown-estado-cat')?.removeAttribute('open')");
        }
        catch { }

        await Cargar();
        StateHasChanged();
    }

    // ═══ Dropdown Tipo — métodos dedicados ═══
    private Task SeleccionarTipoTodos() => SeleccionarTipo(null);
    private Task SeleccionarTipoDevolutivo() => SeleccionarTipo("devolutivo");
    private Task SeleccionarTipoConsumo() => SeleccionarTipo("consumo");
    private Task SeleccionarTipoAmbos() => SeleccionarTipo("ambos");

    private async Task SeleccionarTipo(string? tipo)
    {
        _filtroTipo = tipo;
        _paginaActual = 1;

        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('dropdown-tipo-cat')?.removeAttribute('open')");
        }
        catch { }

        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private void AbrirFormulario()
    {
        Limpiar();
        _mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario = false;
        Limpiar();
    }

    // ✅ Se dispara DESPUÉS de que cambia categoriaDTO.CodigoCgn
    private void OnCodigoCgnChanged()
    {
        var nuevoCodigo = categoriaDTO.CodigoCgn;

        if (!string.IsNullOrWhiteSpace(nuevoCodigo))
        {
            if (nuevoCodigo == "1905")
                categoriaDTO.TipoBien = "consumo";
            else if (nuevoCodigo.StartsWith("1635"))
                categoriaDTO.TipoBien = "devolutivo";
        }
    }

    private async Task GuardarCategoria()
    {
        if (!_editando && !puedeCrear)
        {
            Toast.Error("No tiene permiso para crear categorías.");
            return;
        }

        if (_editando && !puedeEditar)
        {
            Toast.Error("No tiene permiso para editar categorías.");
            return;
        }

        if (string.IsNullOrWhiteSpace(categoriaDTO.TipoBien))
        {
            Toast.Error("Debe seleccionar el tipo de bien.");
            return;
        }

        try
        {
            if (_editando)
            {
                await CategoriaRepository.ActualizarAsync(new Categoria
                {
                    Id = categoriaEditandoId,
                    Nombre = categoriaDTO.Nombre,
                    Descripcion = categoriaDTO.Descripcion,
                    CodigoCgn = string.IsNullOrWhiteSpace(categoriaDTO.CodigoCgn) ? null : categoriaDTO.CodigoCgn.Trim(),
                    TipoBien = categoriaDTO.TipoBien,
                    Estado = categoriaDTO.Estado
                });
                Toast.Exito($"Categoría '{categoriaDTO.Nombre}' actualizada.");
            }
            else
            {
                await CategoriaRepository.CrearAsync(new Categoria
                {
                    Nombre = categoriaDTO.Nombre,
                    Descripcion = categoriaDTO.Descripcion,
                    CodigoCgn = string.IsNullOrWhiteSpace(categoriaDTO.CodigoCgn) ? null : categoriaDTO.CodigoCgn.Trim(),
                    TipoBien = categoriaDTO.TipoBien,
                    Estado = categoriaDTO.Estado
                });
                Toast.Exito($"Categoría '{categoriaDTO.Nombre}' creada.");

                categoriaDTO = new CategoriaDTO { Estado = true, TipoBien = "devolutivo" };

                try
                {
                    await JS.InvokeVoidAsync("eval",
                        "setTimeout(() => { const el = document.querySelector('.card-form input'); if (el) el.focus(); }, 100);");
                }
                catch { }
            }

            await Cargar();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void Editar(Categoria categoria)
    {
        if (!puedeEditar) return;

        _editando = true;
        categoriaEditandoId = categoria.Id;
        _mostrarFormulario = true;

        categoriaDTO.Id = categoria.Id;
        categoriaDTO.Nombre = categoria.Nombre;
        categoriaDTO.Descripcion = categoria.Descripcion;
        categoriaDTO.CodigoCgn = categoria.CodigoCgn;
        categoriaDTO.TipoBien = categoria.TipoBien ?? "devolutivo";
        categoriaDTO.Estado = categoria.Estado;

        StateHasChanged();
    }

    private async Task Eliminar(int id)
    {
        if (!puedeEliminar)
        {
            Toast.Error("No tiene permiso para eliminar categorías.");
            return;
        }

        var ok = await Confirm.Peligroso("¿Eliminar la categoría? Esta acción no se puede deshacer.");
        if (!ok) return;

        try
        {
            await CategoriaRepository.EliminarAsync(id);
            Toast.Exito("Categoría eliminada correctamente");
            await Cargar();
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (msg.Contains("23503") || msg.Contains("foreign key"))
            {
                Toast.Warning("No se puede eliminar: tiene bienes asociados.");
            }
            else
            {
                Toast.Error($"Error: {msg}");
            }
        }
    }

    private void Limpiar()
    {
        categoriaDTO.Id = 0;
        categoriaDTO.Nombre = string.Empty;
        categoriaDTO.Descripcion = string.Empty;
        categoriaDTO.CodigoCgn = null;
        categoriaDTO.TipoBien = "devolutivo";
        categoriaDTO.Estado = true;

        _editando = false;
        categoriaEditandoId = 0;
    }

    // ═══ Helpers de badge/ícono por tipo ═══
    private static string GetClaseBadgeTipo(string? tipo) => tipo switch
    {
        "consumo" => "badge-info",
        "ambos" => "badge-neutral",
        _ => "badge-ok"
    };

    private static string GetIconoTipo(string? tipo) => tipo switch
    {
        "consumo" => "bi-boxes",
        "ambos" => "bi-arrow-left-right",
        _ => "bi-box-seam"
    };

    private static string GetTexto(string? tipo) => tipo switch
    {
        "consumo" => "Consumo",
        "ambos" => "Ambos",
        _ => "Devolutivo"
    };
}