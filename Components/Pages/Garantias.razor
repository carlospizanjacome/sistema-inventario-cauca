@page "/garantias"
@rendermode InteractiveServer

@using Almacen.Components.Shared
@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using Almacen.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IGarantiaRepository GarantiaRepo
@inject IBienRepository BienRepo
@inject IProveedorRepository ProveedorRepo
@inject IJSRuntime JS
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast
@inject ConfirmService Confirm
@inject UsuarioSesionService Sesion
@inject AuditoriaService Auditoria

<PageTitle>Garantías · Almacén</PageTitle>

<div class="page-container page-crud page-garantias @(_mostrarFormulario ? "form-abierto" : "")">

    @if (!_mostrarFormulario)
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-shield-check"></i> Garantías</h1>
                <p class="subtitle">Control de garantías vigentes y por vencer</p>
            </div>

            @if (puedeCrear)
            {
                <div class="header-actions">
                    <button class="btn-nuevo" @onclick="AbrirFormulario">
                        <i class="bi bi-plus-lg"></i> Nueva Garantía
                    </button>
                </div>
            }
        </div>

        <section class="kpi-grid">
            <div class="kpi-card kpi-green kpi-clicable" @onclick="FiltrarVigentes">
                <div class="kpi-icon"><i class="bi bi-shield-fill-check"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Vigentes</span>
                    <span class="kpi-value">@_metricas.Vigentes</span>
                </div>
            </div>
            <div class="kpi-card kpi-orange kpi-clicable" @onclick="FiltrarPorVencer">
                <div class="kpi-icon"><i class="bi bi-clock-history"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Por vencer (30 días)</span>
                    <span class="kpi-value">@_metricas.PorVencer</span>
                </div>
            </div>
            <div class="kpi-card kpi-red kpi-clicable" @onclick="FiltrarVencidas">
                <div class="kpi-icon"><i class="bi bi-shield-slash"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Vencidas</span>
                    <span class="kpi-value">@_metricas.Vencidas</span>
                </div>
            </div>
            <div class="kpi-card kpi-blue kpi-clicable" @onclick="FiltrarTodas">
                <div class="kpi-icon"><i class="bi bi-list-ul"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Total histórico</span>
                    <span class="kpi-value">@_metricas.Total</span>
                </div>
            </div>
        </section>

        <div class="pills-filter">
            <button type="button"
                    class="pill-btn @(_pillActivo is null ? "active-indigo" : "inactive")"
                    @onclick="FiltrarTodas">
                <i class="bi bi-list-ul"></i> Todas
            </button>
            <button type="button"
                    class="pill-btn @(_pillActivo == "vigentes" ? "active-green" : "inactive")"
                    @onclick="FiltrarVigentes">
                <i class="bi bi-shield-fill-check"></i> Vigentes
            </button>
            <button type="button"
                    class="pill-btn @(_pillActivo == "por_vencer" ? "active-orange" : "inactive")"
                    @onclick="FiltrarPorVencer">
                <i class="bi bi-clock-history"></i> Por vencer
            </button>
            <button type="button"
                    class="pill-btn @(_pillActivo == "vencidas" ? "active-red" : "inactive")"
                    @onclick="FiltrarVencidas">
                <i class="bi bi-shield-slash"></i> Vencidas
            </button>
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card-form">
            <div class="form-header">
                <div class="form-header-left">
                    <i class="bi bi-@(_editando ? "pencil-square" : "plus-circle")"></i>
                    <span>@(_editando ? "Editar Garantía" : "Nueva Garantía")</span>
                </div>
                <div class="form-header-center">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <div class="form-header-title">Garantías</div>
                        <div class="form-header-subtitle">Registro de cobertura y vigencia</div>
                    </div>
                </div>
                <button class="btn-cerrar-form" @onclick="Cancelar" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="dto" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid-3">
                    <div class="form-group" style="grid-column: span 2;">
                        <label>Bien *</label>
                        <div class="input-icon">
                            <i class="bi bi-box-seam"></i>
                            <InputSelect TValue="int" class="form-select" @bind-Value="dto.BienId" disabled="@_editando">
                                <option value="0">— Seleccione bien —</option>
                                @foreach (var b in bienes)
                                {
                                    <option value="@b.Id">@b.Codigo — @b.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="() => dto.BienId" class="form-error" />
                    </div>

                    <div class="form-group">
                        <label>Tipo *</label>
                        <div class="input-icon">
                            <i class="bi bi-shield"></i>
                            <InputSelect TValue="string" class="form-select" @bind-Value="dto.Tipo">
                                <option value="FABRICA">Fábrica</option>
                                <option value="EXTENDIDA">Extendida</option>
                                <option value="PROVEEDOR">Proveedor</option>
                                <option value="OTRA">Otra</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>N° Garantía / Póliza</label>
                        <div class="input-icon">
                            <i class="bi bi-hash"></i>
                            <InputText class="form-control" @bind-Value="dto.NumeroGarantia"
                                       placeholder="Ej: GAR-2026-001" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Proveedor</label>
                        <div class="input-icon">
                            <i class="bi bi-shop"></i>
                            <InputSelect TValue="int?" class="form-select" @bind-Value="dto.ProveedorId">
                                <option value="">— Sin asignar —</option>
                                @foreach (var p in proveedores)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Fecha inicio *</label>
                        <div class="input-icon">
                            <i class="bi bi-calendar-check"></i>
                            <InputDate TValue="DateTime" class="form-control" @bind-Value="dto.FechaInicio" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Fecha vencimiento *</label>
                        <div class="input-icon">
                            <i class="bi bi-calendar-x"></i>
                            <InputDate TValue="DateTime" class="form-control" @bind-Value="dto.FechaVencimiento" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Contacto del proveedor</label>
                        <div class="input-icon">
                            <i class="bi bi-telephone"></i>
                            <InputText class="form-control" @bind-Value="dto.ContactoProveedor"
                                       placeholder="Teléfono o email" />
                        </div>
                    </div>

                    <div class="form-group form-group-full">
                        <label>Condiciones</label>
                        <div class="input-icon">
                            <i class="bi bi-file-text"></i>
                            <InputTextArea class="form-control" rows="2" @bind-Value="dto.Condiciones"
                                           placeholder="Condiciones de la garantía" />
                        </div>
                    </div>

                    <div class="form-group form-group-full">
                        <label>Observaciones</label>
                        <div class="input-icon">
                            <i class="bi bi-chat-left-text"></i>
                            <InputTextArea class="form-control" rows="2" @bind-Value="dto.Observaciones" />
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" @onclick="Cancelar">
                        <i class="bi bi-x-lg"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-save">
                        <i class="bi @(_editando ? "bi-check-circle-fill" : "bi-save-fill")"></i>
                        @(_editando ? "Actualizar" : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card-table">

        <div class="filtros-toolbar">
            <div class="filtro-busqueda-principal">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="Buscar por bien, N° garantía o proveedor…"
                       @bind="_filtroTexto"
                       @bind:event="oninput"
                       @bind:after="BuscarConDebounce" />
                @if (!string.IsNullOrEmpty(_filtroTexto))
                {
                    <button class="filtro-clear" @onclick="LimpiarFiltro" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Bien</th>
                        <th>N° Garantía</th>
                        <th class="text-center">Tipo</th>
                        <th>Proveedor</th>
                        <th>Vence</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 130px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagina is null)
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Cargando garantías…</td></tr>
                    }
                    else if (!_pagina.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center py-3 text-muted">Sin garantías para mostrar.</td></tr>
                    }
                    else
                    {
                        @foreach (var g in _pagina.Items)
                        {
                            // ═══ REGLA DE NEGOCIO: solo se anulan VENCIDAS ═══
                            var esAnulable = g.EstadoCalculado == "VENCIDA" && !g.Anulada;

                            <tr class="table-row-hover @(g.EstaVencida ? "row-danger" : g.PorVencer ? "row-warning" : "")" @key="g.Id">
                                <td>
                                    <div class="table-cell-primary">
                                        <strong>@g.BienNombre</strong>
                                        <small><code>@g.BienCodigo</code></small>
                                    </div>
                                </td>
                                <td class="text-mono">@(g.NumeroGarantia ?? "—")</td>
                                <td class="text-center">
                                    <span class="badge @GetClaseBadgeTipo(g.Tipo)">@g.Tipo</span>
                                </td>
                                <td>@(g.ProveedorNombre ?? "—")</td>
                                <td>
                                    <div class="table-cell-primary">
                                        <span class="text-mono">@g.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                                        <small class="@(g.EstaVencida ? "text-danger" : g.PorVencer ? "text-warning" : "text-muted")">
                                            @if (g.EstaVencida)
                                            {
                                                <span>Vencida hace @Math.Abs(g.DiasRestantes) días</span>
                                            }
                                            else
                                            {
                                                <span>@g.DiasRestantes días</span>
                                            }
                                        </small>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (g.Anulada)
                                    {
                                        <span class="badge badge-off" title="Motivo: @g.AnuladaMotivo">ANULADA</span>
                                    }
                                    else
                                    {
                                        <span class="badge @GetClaseBadgeEstado(g.EstadoCalculado)">@g.EstadoCalculado</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <button class="btn-action btn-action-view"
                                                @onclick="() => VerDetalle(g)" title="Ver detalle">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>

                                        @if (puedeEditar && !g.Anulada)
                                        {
                                            <button class="btn-action btn-action-edit"
                                                    @onclick="() => Editar(g)" title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }

                                        @* ═══ BOTÓN DE ANULAR (reemplaza al de eliminar) ═══ *@
                                        @if (esAnulable && puedeAnular)
                                        {
                                            <button class="btn-action btn-action-delete"
                                                    @onclick="() => IntentarAnular(g)"
                                                    title="Anular garantía (soft-delete)">
                                                <i class="bi bi-slash-circle-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_pagina is not null && _pagina.TotalRegistros > 0)
        {
            <Paginador T="GarantiaDTO"
                       Resultado="_pagina"
                       OnCambioPagina="CambioPagina"
                       OnCambioTamano="CambioTamano" />
        }
    </div>
</div>

@* ═══════════════ MODAL — Detalle ═══════════════ *@
@if (_detalleAbierto && _detalle is not null)
{
    var g = _detalle;

    <div class="modal-backdrop-det" @onclick="CerrarDetalle">
        <div class="modal-det" @onclick:stopPropagation="true">
            <div class="modal-det-header">
                <div class="modal-det-header-left">
                    @if (g.Anulada)
                    {
                        <span class="badge badge-off">ANULADA</span>
                    }
                    else
                    {
                        <span class="badge @GetClaseBadgeEstado(g.EstadoCalculado)">@g.EstadoCalculado</span>
                    }
                    <h3>Garantía #@g.Id</h3>
                </div>
                <button class="modal-det-close" @onclick="CerrarDetalle">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-det-body">
                @if (g.Anulada)
                {
                    <div class="det-section" style="background: #fef2f2; border-left: 4px solid #dc2626;">
                        <h4><i class="bi bi-exclamation-triangle-fill"></i> Garantía Anulada</h4>
                        <dl class="det-dl">
                            <dt>Motivo</dt>
                            <dd>@(g.AnuladaMotivo ?? "—")</dd>
                            <dt>Fecha</dt>
                            <dd>@(g.AnuladaFecha?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
                        </dl>
                    </div>
                }

                <div class="det-section">
                    <h4><i class="bi bi-box-seam"></i> Bien</h4>
                    <dl class="det-dl">
                        <dt>Código</dt>
                        <dd><code>@g.BienCodigo</code></dd>
                        <dt>Nombre</dt>
                        <dd><strong>@g.BienNombre</strong></dd>
                        <dt>Categoría</dt>
                        <dd>@(g.BienCategoriaNombre ?? "—")</dd>
                    </dl>
                </div>

                <div class="det-section">
                    <h4><i class="bi bi-shield-check"></i> Garantía</h4>
                    <dl class="det-dl">
                        <dt>Tipo</dt>
                        <dd>@g.Tipo</dd>
                        <dt>N°</dt>
                        <dd>@(g.NumeroGarantia ?? "—")</dd>
                        <dt>Proveedor</dt>
                        <dd>@(g.ProveedorNombre ?? "—")</dd>
                        <dt>Contacto</dt>
                        <dd>@(g.ContactoProveedor ?? "—")</dd>
                        <dt>Inicio</dt>
                        <dd>@g.FechaInicio.ToString("dd/MM/yyyy")</dd>
                        <dt>Vence</dt>
                        <dd>@g.FechaVencimiento.ToString("dd/MM/yyyy")</dd>
                    </dl>
                </div>

                @if (!string.IsNullOrWhiteSpace(g.Condiciones))
                {
                    <div class="det-section">
                        <h4><i class="bi bi-file-text"></i> Condiciones</h4>
                        <div class="det-note"><p>@g.Condiciones</p></div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(g.Observaciones))
                {
                    <div class="det-section">
                        <h4><i class="bi bi-chat-left-text"></i> Observaciones</h4>
                        <div class="det-note"><p>@g.Observaciones</p></div>
                    </div>
                }
            </div>

            <div class="modal-det-footer">
                <button class="btn-det-cerrar" @onclick="CerrarDetalle">
                    <i class="bi bi-x-lg"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
}

@* ═══════════════ MODAL — Anular ═══════════════ *@
@if (_modalAnulacionAbierto && _itemAAnular is not null)
{
    var g = _itemAAnular;

    <div class="modal-backdrop-det" @onclick="CancelarAnulacion">
        <div class="modal-det" @onclick:stopPropagation="true">

            <div class="modal-det-header">
                <div class="modal-det-header-left">
                    <span class="badge badge-off">Anular garantía</span>
                    <h3>@g.BienNombre</h3>
                </div>
                <button class="modal-det-close" @onclick="CancelarAnulacion" title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-det-body">
                <div class="det-section" style="background: #fffbeb; border-left: 4px solid #f59e0b;">
                    <h4><i class="bi bi-exclamation-triangle-fill"></i> ¿Qué es anular?</h4>
                    <p style="margin: 0;">
                        El registro <strong>NO se elimina de la base de datos</strong>. Se marca como "Anulada" y se excluye de los reportes operativos.
                        El historial completo queda disponible para auditoría y para el expediente del bien.
                    </p>
                </div>

                <div class="det-section">
                    <h4><i class="bi bi-info-circle"></i> Garantía a anular</h4>
                    <dl class="det-dl">
                        <dt>Garantía</dt>
                        <dd>#@g.Id</dd>
                        <dt>Bien</dt>
                        <dd><code>@g.BienCodigo</code> — @g.BienNombre</dd>
                        <dt>Tipo</dt>
                        <dd><span class="badge @GetClaseBadgeTipo(g.Tipo)">@g.Tipo</span></dd>
                        <dt>Estado</dt>
                        <dd><span class="badge badge-danger">VENCIDA</span></dd>
                        <dt>Venció el</dt>
                        <dd>@g.FechaVencimiento.ToString("dd/MM/yyyy")</dd>
                    </dl>
                </div>

                <div class="form-group form-group-full">
                    <label>Motivo de la anulación *</label>
                    <div class="input-icon">
                        <i class="bi bi-pencil-square"></i>
                        <InputTextArea class="form-control" rows="3"
                                       @bind-Value="_motivoAnulacion"
                                       placeholder="Ej: Garantía vencida, limpieza de registros..." />
                    </div>
                    <small class="text-muted">Este motivo quedará registrado en la bitácora de auditoría.</small>
                </div>
            </div>

            <div class="modal-det-footer">
                <button class="btn-det-cerrar" @onclick="CancelarAnulacion">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <button class="btn btn-save" @onclick="ConfirmarAnulacionAsync" disabled="@(string.IsNullOrWhiteSpace(_motivoAnulacion))">
                    <i class="bi bi-slash-circle-fill"></i> Confirmar Anulación
                </button>
            </div>

        </div>
    </div>
}

@code {
    private ResultadoPaginado<GarantiaDTO>? _pagina;
    private List<Bien> bienes = new();
    private List<ProveedorDTO> proveedores = new();
    private GarantiaDTO dto = new();
    private (int Vigentes, int PorVencer, int Vencidas, int Total) _metricas;

    private bool _mostrarFormulario = false;
    private bool _editando = false;
    private int _editandoId = 0;
    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private string _filtroTexto = string.Empty;
    private string? _pillActivo;
    private CancellationTokenSource? _debounceCts;

    private bool _detalleAbierto = false;
    private GarantiaDTO? _detalle;

    // ═══ Estado del modal de anulación ═══
    private bool _modalAnulacionAbierto = false;
    private GarantiaDTO? _itemAAnular;
    private string _motivoAnulacion = "";

    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeAnular;

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("garantias.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        puedeCrear  = await Seguridad.TienePermisoAsync("garantias.crear");
        puedeEditar = await Seguridad.TienePermisoAsync("garantias.editar");
        // ═══ Permiso nuevo: garantias.anular ═══
        puedeAnular = await Seguridad.TienePermisoAsync("garantias.anular");

        var t1 = BienRepo.ObtenerTodosAsync();
        var t2 = ProveedorRepo.ObtenerTodosAsync();
        await Task.WhenAll(t1, t2);

        bienes = (await t1).ToList();
        proveedores = (await t2).ToList();

        await Cargar();
    }

    private async Task Cargar()
    {
        var estadoFinal = _pillActivo switch
        {
            "vigentes"   => "VIGENTE",
            "por_vencer" => "POR_VENCER",
            "vencidas"   => "VENCIDA",
            _ => null
        };

        _pagina = await GarantiaRepo.ObtenerPaginadoAsync(
            _paginaActual, _tamanoPagina,
            string.IsNullOrWhiteSpace(_filtroTexto) ? null : _filtroTexto,
            estadoFinal,
            null);

        _metricas = await GarantiaRepo.ObtenerMetricasAsync();
    }

    private Task FiltrarTodas()    => FiltrarPorPill(null);
    private Task FiltrarVigentes() => FiltrarPorPill("vigentes");
    private Task FiltrarPorVencer() => FiltrarPorPill("por_vencer");
    private Task FiltrarVencidas() => FiltrarPorPill("vencidas");

    private async Task FiltrarPorPill(string? pill)
    {
        _pillActivo = pill;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private void VerDetalle(GarantiaDTO g)
    {
        _detalle = g;
        _detalleAbierto = true;
        StateHasChanged();
    }

    private void CerrarDetalle()
    {
        _detalleAbierto = false;
        _detalle = null;
    }

    private async Task BuscarConDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(350, token);
            if (token.IsCancellationRequested) return;
            _paginaActual = 1;
            await Cargar();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarFiltro()
    {
        _filtroTexto = string.Empty;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioPagina(int nuevaPagina)
    {
        _paginaActual = nuevaPagina;
        await Cargar();
        StateHasChanged();
    }

    private async Task CambioTamano(int nuevoTamano)
    {
        _tamanoPagina = nuevoTamano;
        _paginaActual = 1;
        await Cargar();
        StateHasChanged();
    }

    private void AbrirFormulario()
    {
        dto = new GarantiaDTO
        {
            FechaInicio = DateTime.Today,
            FechaVencimiento = DateTime.Today.AddYears(1),
            Tipo = "FABRICA"
        };
        _editando = false;
        _editandoId = 0;
        _mostrarFormulario = true;
    }

    private void Editar(GarantiaDTO g)
    {
        dto = new GarantiaDTO
        {
            Id = g.Id,
            BienId = g.BienId,
            ProveedorId = g.ProveedorId,
            NumeroGarantia = g.NumeroGarantia,
            Tipo = g.Tipo,
            FechaInicio = g.FechaInicio,
            FechaVencimiento = g.FechaVencimiento,
            Condiciones = g.Condiciones,
            ContactoProveedor = g.ContactoProveedor,
            Observaciones = g.Observaciones
        };
        _editando = true;
        _editandoId = g.Id;
        _mostrarFormulario = true;
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
        dto = new GarantiaDTO();
        _editando = false;
        _editandoId = 0;
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!_editando && !puedeCrear) { Toast.Error("No tiene permiso."); return; }
        if (_editando && !puedeEditar) { Toast.Error("No tiene permiso."); return; }
        if (dto.BienId <= 0) { Toast.Error("Debe seleccionar un bien."); return; }

        try
        {
            if (_editando)
            {
                await GarantiaRepo.ActualizarAsync(dto);

                // ═══ AUDITORÍA — EDITAR ═══
                await Auditoria.RegistrarEdicionAsync(
                    modulo: "garantias",
                    objetoTipo: "Garantia",
                    objetoId: dto.Id,
                    objetoCodigo: null,
                    objetoDescripcion: $"Garantía de bien ID {dto.BienId}",
                    antes: null,
                    despues: new
                    {
                        dto.BienId,
                        dto.Tipo,
                        dto.NumeroGarantia,
                        dto.FechaInicio,
                        dto.FechaVencimiento,
                        dto.ProveedorId
                    },
                    motivo: "Edición de garantía"
                );

                Toast.Exito("Garantía actualizada.");
            }
            else
            {
                await GarantiaRepo.CrearAsync(dto);

                // ═══ AUDITORÍA — CREAR ═══
                await Auditoria.RegistrarCreacionAsync(
                    modulo: "garantias",
                    objetoTipo: "Garantia",
                    objetoId: dto.Id,
                    objetoCodigo: null,
                    objetoDescripcion: $"Garantía {dto.Tipo} de bien ID {dto.BienId}",
                    despues: new
                    {
                        dto.BienId,
                        dto.Tipo,
                        dto.NumeroGarantia,
                        dto.FechaInicio,
                        dto.FechaVencimiento,
                        dto.ProveedorId
                    }
                );

                Toast.Exito("Garantía registrada.");
            }

            Cancelar();
            await Cargar();
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "la garantía", "guardar");
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // MÉTODOS DE ANULACIÓN (Soft-Delete)
    // ═══════════════════════════════════════════════════════════════

    private void IntentarAnular(GarantiaDTO g)
    {
        if (!puedeAnular)
        {
            Toast.Error("No tiene permiso para anular garantías.");
            return;
        }

        // ═══ VALIDACIÓN: solo garantías VENCIDAS ═══
        if (g.EstadoCalculado != "VENCIDA")
        {
            Toast.Warning(
                $"No se puede anular la garantía de '{g.BienNombre}': " +
                $"está en estado '{g.EstadoCalculado}'. Solo se pueden anular garantías vencidas.");
            return;
        }

        if (g.Anulada)
        {
            Toast.Warning("Esta garantía ya está anulada.");
            return;
        }

        // Abrir modal de anulación
        _itemAAnular = g;
        _motivoAnulacion = "";
        _modalAnulacionAbierto = true;
        StateHasChanged();
    }

    private void CancelarAnulacion()
    {
        _modalAnulacionAbierto = false;
        _itemAAnular = null;
        _motivoAnulacion = "";
    }

    private async Task ConfirmarAnulacionAsync()
    {
        if (_itemAAnular is null) return;
        if (string.IsNullOrWhiteSpace(_motivoAnulacion))
        {
            Toast.Warning("Debe ingresar un motivo para la anulación.");
            return;
        }

        try
        {
            await GarantiaRepo.AnularAsync(_itemAAnular.Id, _motivoAnulacion);

            // ═══ AUDITORÍA — ANULAR (operación CRÍTICA) ═══
            await Auditoria.RegistrarAnulacionAsync(
                modulo: "garantias",
                objetoTipo: "Garantia",
                objetoId: _itemAAnular.Id,
                objetoCodigo: _itemAAnular.BienCodigo,
                objetoDescripcion: $"Anulación de garantía para '{_itemAAnular.BienNombre}'",
                antes: new
                {
                    Estado = _itemAAnular.EstadoCalculado,
                    Anulada = false,
                    FechaVencimiento = _itemAAnular.FechaVencimiento,
                    Tipo = _itemAAnular.Tipo
                },
                despues: new
                {
                    Estado = "ANULADA",
                    Anulada = true,
                    Motivo = _motivoAnulacion,
                    AnuladaPor = Sesion.UsuarioActual?.Id,
                    AnuladaFecha = DateTime.Now
                },
                motivo: _motivoAnulacion
            );

            Toast.Exito("Garantía anulada correctamente.");
            CancelarAnulacion();
            await Cargar();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorHelper.Mostrar(Toast, ex, "la garantía", "anular");
        }
    }

    private static string GetClaseBadgeTipo(string tipo) => tipo switch
    {
        "FABRICA"    => "badge-ok",
        "EXTENDIDA"  => "badge-info",
        "PROVEEDOR"  => "badge-neutral",
        "OTRA"       => "badge-neutral",
        _            => "badge-neutral"
    };

    private static string GetClaseBadgeEstado(string estado) => estado switch
    {
        "VIGENTE"    => "badge-ok",
        "POR_VENCER" => "badge-warn",
        "VENCIDA"    => "badge-danger",
        _            => "badge-neutral"
    };
}