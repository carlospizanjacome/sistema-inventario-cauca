@page "/expediente/{Id:int}"
@rendermode InteractiveServer

@using Almacen.DTOs
@using Almacen.Interfaces
@using Almacen.Services
@using System.Globalization

@inject IExpedienteRepository ExpedienteRepo
@inject IMantenimientoRepository MantRepo
@inject IGarantiaRepository GarantiaRepo
@inject SeguridadService Seguridad
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Expediente del Bien · Almacén</PageTitle>

<style>
    .app-content:has(.page-expediente) {
        padding-left: 16px !important;
        padding-right: 16px !important;
    }
    .page-container.page-expediente {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
    }
</style>

<div class="page-container page-expediente">

    @if (_cargando)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Cargando expediente…</p>
        </div>
    }
    else if (_expediente is null)
    {
        <div class="card-table">
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h4>Bien no encontrado</h4>
                <p>El bien solicitado no existe o no pertenece a su institución.</p>
                <button class="btn-nuevo" style="margin-top:16px;" @onclick="Volver">
                    <i class="bi bi-arrow-left"></i> Volver a Bienes
                </button>
            </div>
        </div>
    }
    else
    {
        var e = _expediente;

        <div class="exp-header">
            <button class="btn-back" @onclick="Volver" title="Volver">
                <i class="bi bi-arrow-left"></i>
            </button>

            <div class="exp-header-main">
                <div class="exp-header-codigo">
                    <code>@e.Codigo</code>
                    @if (!string.IsNullOrEmpty(e.CodigoQr))
                    {
                        <span class="exp-header-qr" title="Código QR: @e.CodigoQr">
                            <i class="bi bi-qr-code"></i>
                        </span>
                    }
                </div>
                <h1>@e.Nombre</h1>
                @if (!string.IsNullOrWhiteSpace(e.Descripcion))
                {
                    <p class="exp-header-desc">@e.Descripcion</p>
                }
            </div>

            <div class="exp-header-badges">
                <span class="badge @GetClaseEstadoFisico(e.EstadoFisico)">
                    <i class="bi bi-heart-pulse-fill"></i>
                    @GetTextoEstadoFisico(e.EstadoFisico)
                </span>
                <span class="badge @(e.Activo ? "badge-ok" : "badge-off")">
                    <i class="bi @(e.Activo ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                    @(e.Activo ? "Activo" : "Inactivo")
                </span>
                <span class="badge @GetClaseTipoBien(e.TipoBien)">
                    <i class="bi @GetIconoTipoBien(e.TipoBien)"></i>
                    @GetTextoTipoBien(e.TipoBien)
                </span>
            </div>
        </div>

        <section class="kpi-grid">
            <div class="kpi-card kpi-blue">
                <div class="kpi-icon"><i class="bi bi-currency-dollar"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Valor adquisición</span>
                    <span class="kpi-value">@e.ValorAdquisicion.ToString("C0", CulturaCOP)</span>
                </div>
            </div>
            <div class="kpi-card kpi-orange">
                <div class="kpi-icon"><i class="bi bi-graph-down-arrow"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Depreciación acumulada</span>
                    <span class="kpi-value">@e.DepreciacionAcumulada.ToString("C0", CulturaCOP)</span>
                </div>
            </div>
            <div class="kpi-card kpi-green">
                <div class="kpi-icon"><i class="bi bi-safe"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">Valor neto en libros</span>
                    <span class="kpi-value">@e.ValorNeto.ToString("C0", CulturaCOP)</span>
                </div>
            </div>
            <div class="kpi-card kpi-indigo">
                <div class="kpi-icon"><i class="bi bi-activity"></i></div>
                <div class="kpi-body">
                    <span class="kpi-label">% Depreciado</span>
                    <span class="kpi-value">@e.PorcentajeDepreciado.ToString("N2")%</span>
                </div>
            </div>
        </section>

        <div class="exp-tabs">
            <button class="exp-tab @(_tabActiva == "resumen" ? "active" : "")" @onclick="TabResumen">
                <i class="bi bi-card-heading"></i> Resumen
            </button>
            <button class="exp-tab @(_tabActiva == "movimientos" ? "active" : "")" @onclick="TabMovimientos">
                <i class="bi bi-arrow-left-right"></i> Movimientos
                <span class="tab-badge">@e.TotalMovimientos</span>
            </button>
            <button class="exp-tab @(_tabActiva == "depreciacion" ? "active" : "")" @onclick="TabDepreciacion">
                <i class="bi bi-graph-down-arrow"></i> Depreciación
                <span class="tab-badge">@e.Depreciaciones.Count</span>
            </button>
            <button class="exp-tab @(_tabActiva == "tomas" ? "active" : "")" @onclick="TabTomas">
                <i class="bi bi-clipboard-check"></i> Tomas físicas
                <span class="tab-badge">@e.TomasFisicas.Count</span>
            </button>
            <button class="exp-tab @(_tabActiva == "mantenimiento" ? "active" : "")" @onclick="TabMantenimiento">
                <i class="bi bi-tools"></i> Mantenimiento
                @if (_mantCargado) { <span class="tab-badge">@_mantenimientos.Count</span> }
            </button>
            <button class="exp-tab @(_tabActiva == "garantias" ? "active" : "")" @onclick="TabGarantias">
                <i class="bi bi-shield-check"></i> Garantías
                @if (_garCargado) { <span class="tab-badge">@_garantias.Count</span> }
            </button>
        </div>

        @if (_tabActiva == "resumen")
        {
            <div class="exp-grid-2">
                <div class="exp-card">
                    <div class="exp-card-header"><i class="bi bi-card-list"></i><h3>Identificación</h3></div>
                    <dl class="exp-dl">
                        <dt>Código</dt><dd><code>@e.Codigo</code></dd>
                        <dt>Categoría</dt><dd>@(e.CategoriaNombre ?? "—")</dd>
                        <dt>Código CGN</dt><dd>@(string.IsNullOrEmpty(e.CodigoCgn) ? "—" : e.CodigoCgn)</dd>
                        <dt>Marca</dt><dd>@(e.Marca ?? "—")</dd>
                        <dt>Modelo</dt><dd>@(e.Modelo ?? "—")</dd>
                        <dt>Serie</dt><dd>@(e.Serie ?? "—")</dd>
                        <dt>Cantidad</dt><dd>@e.Cantidad</dd>
                    </dl>
                </div>

                <div class="exp-card">
                    <div class="exp-card-header"><i class="bi bi-geo-alt"></i><h3>Ubicación y Responsable</h3></div>
                    <dl class="exp-dl">
                        <dt>Institución</dt><dd>@(e.InstitucionNombre ?? "—")</dd>
                        <dt>Sede</dt><dd>@(e.SedeNombre ?? "—")</dd>
                        <dt>Bloque</dt><dd>@(e.BloqueNombre ?? "—")</dd>
                        <dt>Aula</dt><dd>@(e.AulaNombre ?? "—")</dd>
                        <dt>Responsable</dt><dd>@(e.FuncionarioNombre ?? "—")</dd>
                        <dt>Cédula</dt><dd>@(e.FuncionarioCedula ?? "—")</dd>
                        <dt>Cargo</dt><dd>@(e.FuncionarioCargo ?? "—")</dd>
                    </dl>
                </div>

                <div class="exp-card">
                    <div class="exp-card-header"><i class="bi bi-calculator"></i><h3>Valoración</h3></div>
                    <dl class="exp-dl">
                        <dt>Valor adquisición</dt><dd>@e.ValorAdquisicion.ToString("C0", CulturaCOP)</dd>
                        <dt>Valor residual</dt><dd>@e.ValorResidual.ToString("C0", CulturaCOP)</dd>
                        <dt>Depreciación acumulada</dt><dd class="text-warning">@e.DepreciacionAcumulada.ToString("C0", CulturaCOP)</dd>
                        <dt>Valor neto</dt><dd class="text-success"><strong>@e.ValorNeto.ToString("C0", CulturaCOP)</strong></dd>
                        <dt>Vida útil</dt><dd>@(e.VidaUtilMeses.HasValue ? $"{e.VidaUtilMeses.Value} meses ({e.AniosVidaUtil} años)" : "—")</dd>
                        <dt>Fecha adquisición</dt><dd>@(e.FechaAdquisicion?.ToString("dd/MM/yyyy") ?? "—")</dd>
                        <dt>Último cálculo</dt><dd>@(e.FechaUltimoCalculo?.ToString("dd/MM/yyyy HH:mm") ?? "Sin calcular")</dd>
                    </dl>
                </div>

                <div class="exp-card">
                    <div class="exp-card-header"><i class="bi bi-clock-history"></i><h3>Auditoría</h3></div>
                    <dl class="exp-dl">
                        <dt>Creado</dt><dd>@e.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                        <dt>Última modificación</dt><dd>@e.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                        <dt>Total movimientos</dt><dd><strong>@e.TotalMovimientos</strong></dd>
                        <dt>Tomas físicas</dt><dd><strong>@e.TomasFisicas.Count</strong></dd>
                        <dt>Registros depreciación</dt><dd><strong>@e.Depreciaciones.Count</strong></dd>
                    </dl>
                </div>
            </div>
        }

        @if (_tabActiva == "movimientos")
        {
            @if (e.TotalMovimientos == 0)
            {
                <div class="exp-empty"><i class="bi bi-inbox"></i><p>Sin movimientos registrados para este bien.</p></div>
            }
            else
            {
                <div class="exp-timeline">
                    @foreach (var en in e.Entradas)
                    {
                        <div class="exp-tl-item exp-tl-entrada">
                            <div class="exp-tl-icon"><i class="bi bi-box-arrow-in-down"></i></div>
                            <div class="exp-tl-body">
                                <div class="exp-tl-head">
                                    <strong>Entrada — @en.TipoFuente</strong>
                                    <span class="exp-tl-date">@(en.FechaEntrada?.ToString("dd/MM/yyyy") ?? "—")</span>
                                </div>
                                <div class="exp-tl-details">
                                    @if (!string.IsNullOrEmpty(en.NumeroFactura))
                                    {
                                        <span><i class="bi bi-receipt"></i> Factura: <code>@en.NumeroFactura</code></span>
                                    }
                                    @if (!string.IsNullOrEmpty(en.ProveedorNombre))
                                    {
                                        <span><i class="bi bi-shop"></i> @en.ProveedorNombre</span>
                                    }
                                    @if (!string.IsNullOrEmpty(en.FuncionarioNombre))
                                    {
                                        <span><i class="bi bi-person-check"></i> Recibió: @en.FuncionarioNombre</span>
                                    }
                                    <span><i class="bi bi-currency-dollar"></i> Valor: @en.Valor.ToString("C0", CulturaCOP)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(en.Observaciones))
                                {
                                    <p class="exp-tl-obs">@en.Observaciones</p>
                                }
                            </div>
                        </div>
                    }

                    @foreach (var tr in e.Traslados)
                    {
                        <div class="exp-tl-item exp-tl-traslado">
                            <div class="exp-tl-icon"><i class="bi bi-arrow-left-right"></i></div>
                            <div class="exp-tl-body">
                                <div class="exp-tl-head">
                                    <strong>Traslado</strong>
                                    <span class="exp-tl-date">@(tr.FechaTraslado?.ToString("dd/MM/yyyy") ?? "—")</span>
                                </div>
                                <div class="exp-tl-details">
                                    <span><i class="bi bi-geo-alt"></i> @(tr.AulaOrigenNombre ?? "—") → <strong>@(tr.AulaDestinoNombre ?? "—")</strong></span>
                                    @if (!string.IsNullOrEmpty(tr.FuncionarioAnteriorNombre) || !string.IsNullOrEmpty(tr.FuncionarioNuevoNombre))
                                    {
                                        <span><i class="bi bi-person"></i> @(tr.FuncionarioAnteriorNombre ?? "—") → <strong>@(tr.FuncionarioNuevoNombre ?? "—")</strong></span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(tr.Motivo))
                                {
                                    <p class="exp-tl-obs">@tr.Motivo</p>
                                }
                            </div>
                        </div>
                    }

                    @foreach (var sa in e.Salidas)
                    {
                        <div class="exp-tl-item exp-tl-salida">
                            <div class="exp-tl-icon"><i class="bi bi-box-arrow-up"></i></div>
                            <div class="exp-tl-body">
                                <div class="exp-tl-head">
                                    <strong>Salida / Baja — @sa.TipoBaja</strong>
                                    <span class="exp-tl-date">@(sa.FechaSalida?.ToString("dd/MM/yyyy") ?? "—")</span>
                                </div>
                                <div class="exp-tl-details">
                                    @if (!string.IsNullOrEmpty(sa.NumeroActaComite))
                                    {
                                        <span><i class="bi bi-file-earmark-text"></i> Acta: <code>@sa.NumeroActaComite</code></span>
                                    }
                                    @if (!string.IsNullOrEmpty(sa.NumeroDenuncia))
                                    {
                                        <span class="text-danger"><i class="bi bi-shield-exclamation"></i> Denuncia: <code>@sa.NumeroDenuncia</code></span>
                                    }
                                    @if (!string.IsNullOrEmpty(sa.FuncionarioApruebaNombre))
                                    {
                                        <span><i class="bi bi-person-check"></i> Aprobó: @sa.FuncionarioApruebaNombre</span>
                                    }
                                    <span><i class="bi bi-currency-dollar"></i> Valor: @sa.ValorSalida.ToString("C0", CulturaCOP)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(sa.Motivo))
                                {
                                    <p class="exp-tl-obs">@sa.Motivo</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @if (_tabActiva == "depreciacion")
        {
            @if (!e.Depreciaciones.Any())
            {
                <div class="exp-empty"><i class="bi bi-inbox"></i><p>Sin registros de depreciación.</p></div>
            }
            else
            {
                <div class="exp-card">
                    <div class="table-responsive">
                        <table class="table modern-table">
                            <thead>
                                <tr>
                                    <th>Periodo</th>
                                    <th class="text-end">Valor inicial</th>
                                    <th class="text-end">Deprec. mes</th>
                                    <th class="text-end">Deprec. acum.</th>
                                    <th class="text-end">Valor neto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in e.Depreciaciones)
                                {
                                    <tr @key="d.Id">
                                        <td><strong>@d.PeriodoMes.ToString("00")/@d.PeriodoAnio</strong></td>
                                        <td class="text-end num">@d.ValorInicial.ToString("C0", CulturaCOP)</td>
                                        <td class="text-end num text-warning">@d.DepreciacionMes.ToString("C0", CulturaCOP)</td>
                                        <td class="text-end num">@d.DepreciacionAcumulada.ToString("C0", CulturaCOP)</td>
                                        <td class="text-end num text-success"><strong>@d.ValorNeto.ToString("C0", CulturaCOP)</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (_tabActiva == "tomas")
        {
            @if (!e.TomasFisicas.Any())
            {
                <div class="exp-empty"><i class="bi bi-inbox"></i><p>Este bien no ha participado en ninguna toma física.</p></div>
            }
            else
            {
                <div class="exp-card">
                    <div class="table-responsive">
                        <table class="table modern-table">
                            <thead>
                                <tr>
                                    <th>Toma</th>
                                    <th>Resultado</th>
                                    <th>Fecha escaneo</th>
                                    <th>Ubicación real</th>
                                    <th>Funcionario real</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in e.TomasFisicas)
                                {
                                    <tr @key="t.Id">
                                        <td>
                                            <div class="table-cell-primary">
                                                <strong>@t.TomaNombre</strong>
                                                <small><code>@t.TomaCodigo</code></small>
                                            </div>
                                        </td>
                                        <td><span class="badge @GetClaseBadgeToma(t.Tipo)">@t.Tipo</span></td>
                                        <td class="text-mono">@(t.FechaEscaneo?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                        <td>@(t.UbicacionReal ?? "—")</td>
                                        <td>@(t.FuncionarioRealNombre ?? "—")</td>
                                        <td class="text-muted">@(t.Observaciones ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (_tabActiva == "mantenimiento")
        {
            @if (_cargandoMant)
            {
                <div class="loading"><div class="spinner"></div><p>Cargando…</p></div>
            }
            else if (!_mantenimientos.Any())
            {
                <div class="exp-empty"><i class="bi bi-tools"></i><p>Este bien no tiene mantenimientos registrados.</p></div>
            }
            else
            {
                <div class="exp-timeline">
                    @foreach (var m in _mantenimientos)
                    {
                        <div class="exp-tl-item exp-tl-mantenimiento">
                            <div class="exp-tl-icon"><i class="bi bi-tools"></i></div>
                            <div class="exp-tl-body">
                                <div class="exp-tl-head">
                                    <strong>@m.Tipo — @m.Estado</strong>
                                    <span class="exp-tl-date">@m.FechaIngreso.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="exp-tl-details">
                                    @if (!string.IsNullOrEmpty(m.ProveedorNombre))
                                    {
                                        <span><i class="bi bi-shop"></i> @m.ProveedorNombre</span>
                                    }
                                    @if (!string.IsNullOrEmpty(m.TecnicoResponsable))
                                    {
                                        <span><i class="bi bi-person-gear"></i> @m.TecnicoResponsable</span>
                                    }
                                    <span><i class="bi bi-currency-dollar"></i> Costo: @m.Costo.ToString("C0", CulturaCOP)</span>
                                    @if (m.FechaSalida.HasValue)
                                    {
                                        <span><i class="bi bi-calendar-check"></i> Salida: @m.FechaSalida.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(m.Diagnostico))
                                {
                                    <p class="exp-tl-obs"><strong>Diagnóstico:</strong> @m.Diagnostico</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.TrabajoRealizado))
                                {
                                    <p class="exp-tl-obs"><strong>Trabajo:</strong> @m.TrabajoRealizado</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @if (_tabActiva == "garantias")
        {
            @if (_cargandoGar)
            {
                <div class="loading"><div class="spinner"></div><p>Cargando…</p></div>
            }
            else if (!_garantias.Any())
            {
                <div class="exp-empty"><i class="bi bi-shield-check"></i><p>Este bien no tiene garantías registradas.</p></div>
            }
            else
            {
                <div class="exp-card">
                    <div class="table-responsive">
                        <table class="table modern-table">
                            <thead>
                                <tr>
                                    <th>N° Garantía</th>
                                    <th class="text-center">Tipo</th>
                                    <th>Proveedor</th>
                                    <th>Contacto</th>
                                    <th>Inicio</th>
                                    <th>Vence</th>
                                    <th class="text-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in _garantias)
                                {
                                    <tr @key="g.Id" class="@(g.EstaVencida ? "row-danger" : g.PorVencer ? "row-warning" : "")">
                                        <td><code>@(g.NumeroGarantia ?? "—")</code></td>
                                        <td class="text-center"><span class="badge @GetClaseBadgeTipoGar(g.Tipo)">@g.Tipo</span></td>
                                        <td>@(g.ProveedorNombre ?? "—")</td>
                                        <td class="text-muted">@(g.ContactoProveedor ?? "—")</td>
                                        <td>@g.FechaInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@g.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">
                                            <span class="badge @GetClaseBadgeEstadoGar(g.EstadoCalculado)">@g.EstadoCalculado</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ExpedienteBienDTO? _expediente;
    private List<MantenimientoDTO> _mantenimientos = new();
    private List<GarantiaDTO> _garantias = new();

    private bool _cargando = true;
    private bool _cargandoMant = false;
    private bool _cargandoGar = false;
    private bool _mantCargado = false;
    private bool _garCargado = false;

    private string _tabActiva = "resumen";

    private static readonly CultureInfo CulturaCOP = CultureInfo.GetCultureInfo("es-CO");

    protected override async Task OnInitializedAsync()
    {
        if (!await Seguridad.TienePermisoAsync("bienes.ver"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        try
        {
            _expediente = await ExpedienteRepo.ObtenerExpedienteAsync(Id);
        }
        catch (Exception ex)
        {
            Toast.Error($"Error al cargar expediente: {ex.Message}");
        }
        finally
        {
            _cargando = false;
        }
    }

    private void Volver() => Navigation.NavigateTo("/bienes");

    private void TabResumen() => _tabActiva = "resumen";
    private void TabMovimientos() => _tabActiva = "movimientos";
    private void TabDepreciacion() => _tabActiva = "depreciacion";
    private void TabTomas() => _tabActiva = "tomas";

    private async Task TabMantenimiento()
    {
        _tabActiva = "mantenimiento";

        if (_mantCargado) return;

        _cargandoMant = true;
        StateHasChanged();

        try
        {
            _mantenimientos = (await MantRepo.ObtenerPorBienAsync(Id)).ToList();
            _mantCargado = true;
        }
        catch (Exception ex)
        {
            Toast.Error($"Error al cargar mantenimientos: {ex.Message}");
        }
        finally
        {
            _cargandoMant = false;
            StateHasChanged();
        }
    }

    private async Task TabGarantias()
    {
        _tabActiva = "garantias";

        if (_garCargado) return;

        _cargandoGar = true;
        StateHasChanged();

        try
        {
            _garantias = (await GarantiaRepo.ObtenerPorBienAsync(Id)).ToList();
            _garCargado = true;
        }
        catch (Exception ex)
        {
            Toast.Error($"Error al cargar garantías: {ex.Message}");
        }
        finally
        {
            _cargandoGar = false;
            StateHasChanged();
        }
    }

    private static string GetClaseEstadoFisico(string? estado) => estado?.ToLower() switch
    {
        "bueno"   => "badge-ok",
        "regular" => "badge-warn",
        "malo"    => "badge-danger",
